<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - MuhleOps</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        :root {
            --sidebar-width: 250px;
            --header-height: 60px;
            --primary-dark: #16202C;
            --primary-gold: #F5A623;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: #f4f6f9;
            overflow-x: hidden;
        }

        /* Sidebar */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: var(--sidebar-width);
            height: 100vh;
            background: var(--primary-dark);
            color: #fff;
            z-index: 1000;
            transition: transform 0.3s ease;
            display: flex;
            flex-direction: column;
        }

        .sidebar-brand {
            padding: 20px 24px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sidebar-brand .brand-icon {
            width: 36px;
            height: 36px;
            background: var(--primary-gold);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            font-size: 18px;
            color: var(--primary-dark);
        }

        .sidebar-brand .brand-text {
            font-weight: 800;
            font-size: 18px;
            letter-spacing: 0.5px;
        }

        .sidebar-brand .brand-text span {
            color: var(--primary-gold);
        }

        .sidebar-menu {
            flex: 1;
            overflow-y: auto;
            padding: 16px 0;
        }

        .sidebar-menu .menu-label {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: rgba(255,255,255,0.35);
            padding: 12px 24px 6px;
            font-weight: 600;
        }

        .sidebar-menu .nav-item {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 10px 24px;
            color: rgba(255,255,255,0.7);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.15s ease;
            border-left: 3px solid transparent;
            cursor: pointer;
        }

        .sidebar-menu .nav-item:hover {
            background: rgba(255,255,255,0.06);
            color: #fff;
            border-left-color: var(--primary-gold);
        }

        .sidebar-menu .nav-item.active {
            background: rgba(245,166,35,0.12);
            color: #fff;
            border-left-color: var(--primary-gold);
        }

        .sidebar-menu .nav-item i {
            width: 20px;
            text-align: center;
            font-size: 16px;
            color: rgba(255,255,255,0.5);
        }

        .sidebar-menu .nav-item:hover i,
        .sidebar-menu .nav-item.active i {
            color: var(--primary-gold);
        }

        .sidebar-footer {
            padding: 16px 24px;
            border-top: 1px solid rgba(255,255,255,0.08);
        }

        .sidebar-footer .user-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sidebar-footer .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--primary-gold);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 14px;
            color: var(--primary-dark);
        }

        .sidebar-footer .user-name {
            font-size: 13px;
            font-weight: 600;
        }

        .sidebar-footer .user-email {
            font-size: 11px;
            color: rgba(255,255,255,0.5);
        }

        /* Main Content */
        .main-content {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            transition: margin-left 0.3s ease;
        }

        /* Header */
        .header {
            height: var(--header-height);
            background: #fff;
            border-bottom: 1px solid #e9ecef;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
            position: sticky;
            top: 0;
            z-index: 999;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .header-left .toggle-sidebar {
            background: none;
            border: none;
            font-size: 20px;
            color: #6b7280;
            cursor: pointer;
            display: none;
            padding: 4px;
        }

        .header-left .page-title {
            font-size: 16px;
            font-weight: 600;
            color: #1a202c;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .header-right .notification-btn {
            position: relative;
            background: none;
            border: none;
            font-size: 18px;
            color: #6b7280;
            cursor: pointer;
            padding: 4px;
        }

        .header-right .notification-btn .badge-dot {
            position: absolute;
            top: 0;
            right: 0;
            width: 8px;
            height: 8px;
            background: #e74c3c;
            border-radius: 50%;
            border: 2px solid #fff;
        }

        .header-right .logout-btn {
            background: none;
            border: none;
            color: #6b7280;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            padding: 8px 12px;
            border-radius: 6px;
            transition: all 0.15s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .header-right .logout-btn:hover {
            background: #f3f4f6;
            color: #1a202c;
        }

        /* Page Content */
        .page-content {
            padding: 24px 30px 40px;
        }

        /* Alert Styles */
        .alert {
            padding: 12px 20px;
            border-radius: 6px;
            margin-bottom: 20px;
            border: 1px solid transparent;
        }

        .alert-success {
            color: #155724;
            background-color: #d4edda;
            border-color: #c3e6cb;
        }

        .alert-danger {
            color: #721c24;
            background-color: #f8d7da;
            border-color: #f5c6cb;
        }

        .alert-warning {
            color: #856404;
            background-color: #fff3cd;
            border-color: #ffeeba;
        }

        .alert-info {
            color: #0c5460;
            background-color: #d1ecf1;
            border-color: #bee5eb;
        }

        .alert-dismissible {
            position: relative;
            padding-right: 40px;
        }

        .alert-dismissible .btn-close {
            position: absolute;
            top: 50%;
            right: 10px;
            transform: translateY(-50%);
            background: none;
            border: none;
            font-size: 20px;
            cursor: pointer;
            color: inherit;
            opacity: 0.7;
        }

        .alert-dismissible .btn-close:hover {
            opacity: 1;
        }

        .fade {
            transition: opacity 0.15s linear;
        }

        .show {
            opacity: 1;
        }

        /* Button Styles */
        .btn {
            display: inline-block;
            font-weight: 600;
            text-align: center;
            white-space: nowrap;
            vertical-align: middle;
            user-select: none;
            border: 1px solid transparent;
            padding: 0.5rem 1rem;
            font-size: 14px;
            line-height: 1.5;
            border-radius: 4px;
            transition: all 0.15s ease;
            text-decoration: none;
            cursor: pointer;
        }

        .btn-primary {
            color: #fff;
            background-color: #4e73df;
            border-color: #4e73df;
        }

        .btn-primary:hover {
            background-color: #2e59d9;
            border-color: #2e59d9;
        }

        .btn-success {
            color: #fff;
            background-color: #1cc88a;
            border-color: #1cc88a;
        }

        .btn-success:hover {
            background-color: #17a673;
            border-color: #17a673;
        }

        .btn-danger {
            color: #fff;
            background-color: #e74a3b;
            border-color: #e74a3b;
        }

        .btn-danger:hover {
            background-color: #be2617;
            border-color: #be2617;
        }

        .btn-warning {
            color: #fff;
            background-color: #f6c23e;
            border-color: #f6c23e;
        }

        .btn-warning:hover {
            background-color: #dda20a;
            border-color: #dda20a;
        }

        .btn-secondary {
            color: #fff;
            background-color: #858796;
            border-color: #858796;
        }

        .btn-secondary:hover {
            background-color: #717384;
            border-color: #717384;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
            }

            .sidebar.open {
                transform: translateX(0);
            }

            .main-content {
                margin-left: 0;
            }

            .header-left .toggle-sidebar {
                display: block;
            }

            .header {
                padding: 0 16px;
            }

            .page-content {
                padding: 16px;
            }

            .header-right .logout-btn span {
                display: none;
            }
        }

        /* Scrollbar */
        .sidebar-menu::-webkit-scrollbar {
            width: 4px;
        }

        .sidebar-menu::-webkit-scrollbar-track {
            background: transparent;
        }

        .sidebar-menu::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.15);
            border-radius: 4px;
        }

        .sidebar-menu::-webkit-scrollbar-thumb:hover {
            background: rgba(255,255,255,0.25);
        }

        /* Utility */
        .text-gold {
            color: var(--primary-gold);
        }

        .bg-gold {
            background: var(--primary-gold);
        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon">M</div>
            <div class="brand-text">Muhle<span>Ops</span></div>
        </div>

        <nav class="sidebar-menu">
            <div class="menu-label">Main</div>
            <a href="@Url.Action("Dashboard", "Home")" class="nav-item">
                <i class="fas fa-th-large"></i>
                <span>Dashboard</span>
            </a>

            <!-- Check if user is in Admin role -->
            @if (User.IsInRole("Admin"))
            {
                <div class="menu-label">Recruitment</div>
                <a href="@Url.Action("Index", "JobPost")" class="nav-item">
                    <i class="fas fa-bullhorn"></i>
                    <span>Job Posts</span>
                </a>
                <a href="#" class="nav-item" onclick="alert('Applications feature coming soon!')">
                    <i class="fas fa-users"></i>
                    <span>Applications</span>
                </a>
                <a href="#" class="nav-item" onclick="alert('Hire Staff feature coming soon!')">
                    <i class="fas fa-user-check"></i>
                    <span>Hire Staff</span>
                </a>

                <div class="menu-label">Clients</div>
                <a href="#" class="nav-item" onclick="alert('Register Client feature coming soon!')">
                    <i class="fas fa-building"></i>
                    <span>Register Client</span>
                </a>
                <a href="#" class="nav-item" onclick="alert('Contracts feature coming soon!')">
                    <i class="fas fa-file-contract"></i>
                    <span>Contracts</span>
                </a>

                <div class="menu-label">Projects</div>
                <a href="#" class="nav-item" onclick="alert('All Projects feature coming soon!')">
                    <i class="fas fa-folder-open"></i>
                    <span>All Projects</span>
                </a>
                <a href="#" class="nav-item" onclick="alert('Initiate Project feature coming soon!')">
                    <i class="fas fa-plus-circle"></i>
                    <span>Initiate Project</span>
                </a>
                <a href="#" class="nav-item" onclick="alert('Assign Staff feature coming soon!')">
                    <i class="fas fa-user-friends"></i>
                    <span>Assign Staff</span>
                </a>
                <a href="#" class="nav-item" onclick="alert('Assign Equipment feature coming soon!')">
                    <i class="fas fa-tools"></i>
                    <span>Assign Equipment</span>
                </a>

                <div class="menu-label">Operations</div>
                <a href="#" class="nav-item" onclick="alert('Daily Tasks feature coming soon!')">
                    <i class="fas fa-clipboard-list"></i>
                    <span>Daily Tasks</span>
                </a>
                <a href="#" class="nav-item" onclick="alert('Timesheets feature coming soon!')">
                    <i class="fas fa-clock"></i>
                    <span>Timesheets</span>
                </a>
                <a href="#" class="nav-item" onclick="alert('Equipment Maintenance feature coming soon!')">
                    <i class="fas fa-wrench"></i>
                    <span>Equipment Maintenance</span>
                </a>

                <div class="menu-label">Quality</div>
                <a href="#" class="nav-item" onclick="alert('Inspections feature coming soon!')">
                    <i class="fas fa-check-double"></i>
                    <span>Inspections</span>
                </a>
                <a href="#" class="nav-item" onclick="alert('Variations feature coming soon!')">
                    <i class="fas fa-exchange-alt"></i>
                    <span>Variations</span>
                </a>

                <div class="menu-label">Finance</div>
                <a href="#" class="nav-item" onclick="alert('Payroll feature coming soon!')">
                    <i class="fas fa-coins"></i>
                    <span>Payroll</span>
                </a>
                <a href="#" class="nav-item" onclick="alert('Invoices feature coming soon!')">
                    <i class="fas fa-file-invoice"></i>
                    <span>Invoices</span>
                </a>

                <div class="menu-label">Close Out</div>
                <a href="#" class="nav-item" onclick="alert('Project Handover feature coming soon!')">
                    <i class="fas fa-flag-checkered"></i>
                    <span>Project Handover</span>
                </a>
            }
            else
            {
                // Non-admin users see limited menu
                <div class="menu-label">My Work</div>
                <a href="#" class="nav-item" onclick="alert('My Tasks feature coming soon!')">
                    <i class="fas fa-tasks"></i>
                    <span>My Tasks</span>
                </a>
                <a href="#" class="nav-item" onclick="alert('My Timesheets feature coming soon!')">
                    <i class="fas fa-clock"></i>
                    <span>My Timesheets</span>
                </a>
                <a href="#" class="nav-item" onclick="alert('My Projects feature coming soon!')">
                    <i class="fas fa-project-diagram"></i>
                    <span>My Projects</span>
                </a>
            }
        </nav>

        <div class="sidebar-footer">
            <div class="user-info">
                <div class="user-avatar">@(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")</div>
                <div>
                    <div class="user-name">@User.Identity.Name</div>
                    <div class="user-email">@User.Identity.Name</div>
                </div>
            </div>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Header -->
        <header class="header">
            <div class="header-left">
                <button class="toggle-sidebar" id="toggleSidebar" aria-label="Toggle sidebar">
                    <i class="fas fa-bars"></i>
                </button>
                <span class="page-title">@ViewBag.Title</span>
            </div>
            <div class="header-right">
                <button class="notification-btn" aria-label="Notifications">
                    <i class="fas fa-bell"></i>
                    <span class="badge-dot"></span>
                </button>
                @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", style = "display:inline;" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="logout-btn">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>Logout</span>
                    </button>
                }
            </div>
        </header>

        <!-- Page Content -->
        <div class="page-content">
            @RenderBody()
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

    <script>
        // Toggle sidebar on mobile
        document.getElementById('toggleSidebar')?.addEventListener('click', function () {
            document.getElementById('sidebar').classList.toggle('open');
        });

        // Close sidebar when clicking outside on mobile
        document.addEventListener('click', function (e) {
            const sidebar = document.getElementById('sidebar');
            const toggle = document.getElementById('toggleSidebar');
            if (window.innerWidth <= 768 &&
                sidebar.classList.contains('open') &&
                !sidebar.contains(e.target) &&
                !toggle.contains(e.target)) {
                sidebar.classList.remove('open');
            }
        });

        // Active nav link highlighting based on current URL
        document.addEventListener('DOMContentLoaded', function () {
            const currentUrl = window.location.pathname;
            document.querySelectorAll('.nav-item').forEach(item => {
                const href = item.getAttribute('href');
                if (href && href !== '#' && currentUrl.includes(href)) {
                    item.classList.add('active');
                }
            });
        });

        // Auto-dismiss alerts after 5 seconds
        document.addEventListener('DOMContentLoaded', function () {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                setTimeout(function () {
                    alert.classList.remove('show');
                    setTimeout(function () {
                        alert.remove();
                    }, 150);
                }, 5000);
            });
        });
    </script>
</body>
</html>