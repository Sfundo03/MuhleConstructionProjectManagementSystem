<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - MuhleOps</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        :root {
            --sidebar-width: 250px;
            --header-height: 60px;
            --primary-dark: #16202C;
            --primary-gold: #F5A623;

            /* Light Mode Colors */
            --bg-body: #f4f6f9;
            --bg-card: #ffffff;
            --bg-header: #ffffff;
            --text-primary: #1a202c;
            --text-secondary: #6b7280;
            --border-color: #e9ecef;
            --shadow-color: rgba(0,0,0,0.08);
            --bg-input: #ffffff;
            --bg-hover: #f3f4f6;
            --bg-sidebar: #16202C;
            --text-sidebar: rgba(255,255,255,0.7);
            --text-sidebar-hover: #ffffff;
            --bg-sidebar-hover: rgba(255,255,255,0.06);
            --bg-sidebar-active: rgba(245,166,35,0.12);
        }

        [data-theme="dark"] {
            --bg-body: #0f1419;
            --bg-card: #1a202c;
            --bg-header: #1a202c;
            --text-primary: #e2e8f0;
            --text-secondary: #a0aec0;
            --border-color: #2d3748;
            --shadow-color: rgba(0,0,0,0.3);
            --bg-input: #2d3748;
            --bg-hover: #2d3748;
            --bg-sidebar: #0f1419;
            --text-sidebar: rgba(255,255,255,0.6);
            --text-sidebar-hover: #ffffff;
            --bg-sidebar-hover: rgba(255,255,255,0.05);
            --bg-sidebar-active: rgba(245,166,35,0.08);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: var(--bg-body);
            color: var(--text-primary);
            overflow-x: hidden;
            transition: background 0.3s ease, color 0.3s ease;
        }

        /* Sidebar */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: var(--sidebar-width);
            height: 100vh;
            background: var(--bg-sidebar);
            color: #fff;
            z-index: 1000;
            transition: transform 0.3s ease, background 0.3s ease;
            display: flex;
            flex-direction: column;
        }

        .sidebar-brand {
            padding: 20px 24px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sidebar-brand .brand-icon {
            width: 36px;
            height: 36px;
            background: var(--primary-gold);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            font-size: 18px;
            color: var(--primary-dark);
        }

        .sidebar-brand .brand-text {
            font-weight: 800;
            font-size: 18px;
            letter-spacing: 0.5px;
        }

        .sidebar-brand .brand-text span {
            color: var(--primary-gold);
        }

        .sidebar-menu {
            flex: 1;
            overflow-y: auto;
            padding: 16px 0;
        }

        .sidebar-menu .menu-label {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: rgba(255,255,255,0.35);
            padding: 12px 24px 6px;
            font-weight: 600;
        }

        .sidebar-menu .nav-item {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 10px 24px;
            color: var(--text-sidebar);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.15s ease;
            border-left: 3px solid transparent;
            cursor: pointer;
        }

        .sidebar-menu .nav-item:hover {
            background: var(--bg-sidebar-hover);
            color: var(--text-sidebar-hover);
            border-left-color: var(--primary-gold);
        }

        .sidebar-menu .nav-item.active {
            background: var(--bg-sidebar-active);
            color: #fff;
            border-left-color: var(--primary-gold);
        }

        .sidebar-menu .nav-item i {
            width: 20px;
            text-align: center;
            font-size: 16px;
            color: rgba(255,255,255,0.5);
        }

        .sidebar-menu .nav-item:hover i,
        .sidebar-menu .nav-item.active i {
            color: var(--primary-gold);
        }

        .sidebar-footer {
            padding: 16px 24px;
            border-top: 1px solid rgba(255,255,255,0.08);
        }

        .sidebar-footer .user-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sidebar-footer .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--primary-gold);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 14px;
            color: var(--primary-dark);
        }

        .sidebar-footer .user-name {
            font-size: 13px;
            font-weight: 600;
            color: rgba(255,255,255,0.9);
        }

        .sidebar-footer .user-email {
            font-size: 11px;
            color: rgba(255,255,255,0.5);
        }

        /* Main Content */
        .main-content {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            transition: margin-left 0.3s ease;
        }

        /* Header */
        .header {
            height: var(--header-height);
            background: var(--bg-header);
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
            position: sticky;
            top: 0;
            z-index: 999;
            transition: background 0.3s ease, border-color 0.3s ease;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .header-left .toggle-sidebar {
            background: none;
            border: none;
            font-size: 20px;
            color: var(--text-secondary);
            cursor: pointer;
            display: none;
            padding: 4px;
        }

        .header-left .page-title {
            font-size: 16px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .header-right .theme-toggle {
            background: none;
            border: none;
            font-size: 18px;
            color: var(--text-secondary);
            cursor: pointer;
            padding: 6px 10px;
            border-radius: 6px;
            transition: background 0.15s ease;
        }

        .header-right .theme-toggle:hover {
            background: var(--bg-hover);
        }

        .header-right .notification-btn {
            position: relative;
            background: none;
            border: none;
            font-size: 18px;
            color: var(--text-secondary);
            cursor: pointer;
            padding: 4px;
        }

        .header-right .notification-btn .badge-dot {
            position: absolute;
            top: 0;
            right: 0;
            width: 8px;
            height: 8px;
            background: #e74c3c;
            border-radius: 50%;
            border: 2px solid var(--bg-header);
        }

        .header-right .logout-btn {
            background: none;
            border: none;
            color: var(--text-secondary);
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            padding: 8px 12px;
            border-radius: 6px;
            transition: all 0.15s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .header-right .logout-btn:hover {
            background: var(--bg-hover);
            color: var(--text-primary);
        }

        /* Page Content */
        .page-content {
            padding: 24px 30px 40px;
        }

        /* Card Styles */
        .card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            transition: background 0.3s ease, border-color 0.3s ease;
        }

        .card-header {
            background: var(--bg-card);
            border-bottom: 1px solid var(--border-color);
            padding: 16px 20px;
        }

        .card-body {
            padding: 20px;
        }

        /* Alert Styles */
        .alert {
            padding: 12px 20px;
            border-radius: 6px;
            margin-bottom: 20px;
            border: 1px solid transparent;
        }

        .alert-success {
            color: #155724;
            background-color: #d4edda;
            border-color: #c3e6cb;
        }

        [data-theme="dark"] .alert-success {
            color: #b7eb8f;
            background-color: #1a3a2a;
            border-color: #2d5a3d;
        }

        .alert-danger {
            color: #721c24;
            background-color: #f8d7da;
            border-color: #f5c6cb;
        }

        [data-theme="dark"] .alert-danger {
            color: #f5a3a3;
            background-color: #3a1a1a;
            border-color: #5a2d2d;
        }

        .alert-warning {
            color: #856404;
            background-color: #fff3cd;
            border-color: #ffeeba;
        }

        [data-theme="dark"] .alert-warning {
            color: #f5d98a;
            background-color: #3a2a1a;
            border-color: #5a4a2d;
        }

        .alert-info {
            color: #0c5460;
            background-color: #d1ecf1;
            border-color: #bee5eb;
        }

        [data-theme="dark"] .alert-info {
            color: #8ad4e8;
            background-color: #1a2a3a;
            border-color: #2d4a5a;
        }

        .alert-dismissible {
            position: relative;
            padding-right: 40px;
        }

        .alert-dismissible .btn-close {
            position: absolute;
            top: 50%;
            right: 10px;
            transform: translateY(-50%);
            background: none;
            border: none;
            font-size: 20px;
            cursor: pointer;
            color: inherit;
            opacity: 0.7;
        }

        .alert-dismissible .btn-close:hover {
            opacity: 1;
        }

        /* Button Styles */
        .btn {
            display: inline-block;
            font-weight: 600;
            text-align: center;
            white-space: nowrap;
            vertical-align: middle;
            user-select: none;
            border: 1px solid transparent;
            padding: 0.5rem 1rem;
            font-size: 14px;
            line-height: 1.5;
            border-radius: 4px;
            transition: all 0.15s ease;
            text-decoration: none;
            cursor: pointer;
        }

        .btn-primary {
            color: #fff;
            background-color: #4e73df;
            border-color: #4e73df;
        }

        .btn-primary:hover {
            background-color: #2e59d9;
            border-color: #2e59d9;
        }

        .btn-success {
            color: #fff;
            background-color: #1cc88a;
            border-color: #1cc88a;
        }

        .btn-success:hover {
            background-color: #17a673;
            border-color: #17a673;
        }

        .btn-danger {
            color: #fff;
            background-color: #e74a3b;
            border-color: #e74a3b;
        }

        .btn-danger:hover {
            background-color: #be2617;
            border-color: #be2617;
        }

        .btn-warning {
            color: #fff;
            background-color: #f6c23e;
            border-color: #f6c23e;
        }

        .btn-warning:hover {
            background-color: #dda20a;
            border-color: #dda20a;
        }

        .btn-secondary {
            color: #fff;
            background-color: #858796;
            border-color: #858796;
        }

        .btn-secondary:hover {
            background-color: #717384;
            border-color: #717384;
        }

        .btn-outline-primary {
            color: #4e73df;
            border-color: #4e73df;
            background: transparent;
        }

        .btn-outline-primary:hover {
            background-color: #4e73df;
            color: #fff;
        }

        .btn-outline-secondary {
            color: var(--text-secondary);
            border-color: var(--border-color);
            background: transparent;
        }

        .btn-outline-secondary:hover {
            background: var(--bg-hover);
            color: var(--text-primary);
        }

        /* Form Controls */
        .form-control, .form-select {
            background: var(--bg-input);
            color: var(--text-primary);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 10px 14px;
            font-size: 14px;
            width: 100%;
            transition: border-color 0.15s ease;
        }

        .form-control:focus, .form-select:focus {
            outline: none;
            border-color: var(--primary-gold);
            box-shadow: 0 0 0 3px rgba(245,166,35,0.1);
        }

        .form-label {
            display: block;
            font-weight: 600;
            font-size: 13px;
            color: var(--text-primary);
            margin-bottom: 6px;
        }

        .form-check-input {
            width: 18px;
            height: 18px;
            margin-right: 8px;
            accent-color: var(--primary-gold);
        }

        .form-check-label {
            color: var(--text-primary);
        }

        /* Table Styles */
        .table {
            width: 100%;
            color: var(--text-primary);
            border-collapse: collapse;
        }

        .table th, .table td {
            padding: 12px;
            border-bottom: 1px solid var(--border-color);
            text-align: left;
        }

        .table th {
            font-weight: 600;
            color: var(--text-secondary);
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .table-hover tbody tr:hover {
            background: var(--bg-hover);
        }

        /* Badge Styles */
        .badge {
            display: inline-block;
            padding: 4px 10px;
            font-size: 11px;
            font-weight: 600;
            border-radius: 4px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .badge-success { background: #1cc88a; color: #fff; }
        .badge-warning { background: #f6c23e; color: #fff; }
        .badge-danger { background: #e74a3b; color: #fff; }
        .badge-info { background: #36b9cc; color: #fff; }
        .badge-primary { background: #4e73df; color: #fff; }
        .badge-secondary { background: #858796; color: #fff; }

        /* Success Page Styles */
        .success-container {
            max-width: 700px;
            margin: 40px auto;
            text-align: center;
        }

        .success-icon {
            font-size: 80px;
            color: #1cc88a;
            margin-bottom: 20px;
            animation: bounceIn 0.6s ease;
        }

        .success-card {
            background: var(--bg-card);
            border-radius: 12px;
            padding: 50px 40px;
            box-shadow: 0 10px 40px var(--shadow-color);
            border: 1px solid var(--border-color);
            transition: background 0.3s ease, border-color 0.3s ease;
        }

        .success-card h2 {
            color: var(--text-primary);
            margin-bottom: 10px;
            font-weight: 700;
        }

        .success-card .subtitle {
            color: var(--text-secondary);
            font-size: 16px;
            margin-bottom: 20px;
        }

        .application-details {
            background: var(--bg-hover);
            border-radius: 8px;
            padding: 20px;
            margin: 20px 0;
            text-align: left;
            border-left: 4px solid #1cc88a;
        }

        .application-details p {
            margin: 8px 0;
            color: var(--text-primary);
        }

        .application-details .label {
            font-weight: 600;
            color: var(--text-secondary);
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: block;
        }

        .application-details .value {
            font-size: 16px;
            font-weight: 500;
        }

        .countdown-container {
            margin: 30px 0 20px;
        }

        .countdown-circle {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: var(--bg-hover);
            border: 4px solid var(--primary-gold);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto;
            font-size: 28px;
            font-weight: 700;
            color: var(--primary-gold);
            position: relative;
        }

        .countdown-circle .label {
            font-size: 10px;
            font-weight: 400;
            color: var(--text-secondary);
            display: block;
            position: absolute;
            bottom: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .progress-bar-container {
            width: 100%;
            max-width: 400px;
            margin: 20px auto;
            height: 6px;
            background: var(--bg-hover);
            border-radius: 3px;
            overflow: hidden;
        }

        .progress-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--primary-gold), #1cc88a);
            border-radius: 3px;
            width: 100%;
            animation: progressShrink 10s linear forwards;
        }

        .btn-view-applications {
            display: inline-block;
            padding: 12px 30px;
            background: var(--primary-gold);
            color: var(--primary-dark);
            border: none;
            border-radius: 6px;
            font-weight: 700;
            font-size: 15px;
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
            margin-top: 10px;
        }

        .btn-view-applications:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(245, 166, 35, 0.3);
            color: var(--primary-dark);
        }

        .btn-view-applications i {
            margin-right: 8px;
        }

        .confetti-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 9999;
            overflow: hidden;
        }

        .confetti {
            position: absolute;
            width: 10px;
            height: 10px;
            opacity: 0;
            animation: confettiFall 3s ease-in forwards;
        }

        @@keyframes bounceIn {
            0% { transform: scale(0); opacity: 0; }
            50% { transform: scale(1.2); }
            70% { transform: scale(0.9); }
            100% { transform: scale(1); opacity: 1; }
        }

        @@keyframes progressShrink {
            0% { width: 100%; }
            100% { width: 0%; }
        }

        @@keyframes confettiFall {
            0% { transform: translateY(-20px) rotate(0deg); opacity: 1; }
            100% { transform: translateY(100vh) rotate(720deg); opacity: 0; }
        }

        .pulse {
            animation: pulse 2s ease-in-out infinite;
        }

        @@keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }

        /* Dark mode adjustments for success page */
        [data-theme="dark"] .btn-view-applications {
            color: #fff;
        }

        [data-theme="dark"] .btn-view-applications:hover {
            color: #fff;
        }

        [data-theme="dark"] .application-details {
            background: var(--bg-card);
            border-color: var(--border-color);
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
            }

            .sidebar.open {
                transform: translateX(0);
            }

            .main-content {
                margin-left: 0;
            }

            .header-left .toggle-sidebar {
                display: block;
            }

            .header {
                padding: 0 16px;
            }

            .page-content {
                padding: 16px;
            }

            .header-right .logout-btn span {
                display: none;
            }

            .success-card {
                padding: 30px 20px;
            }

            .success-icon {
                font-size: 60px;
            }

            .countdown-circle {
                width: 60px;
                height: 60px;
                font-size: 22px;
            }
        }

        /* Scrollbar */
        .sidebar-menu::-webkit-scrollbar {
            width: 4px;
        }

        .sidebar-menu::-webkit-scrollbar-track {
            background: transparent;
        }

        .sidebar-menu::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.15);
            border-radius: 4px;
        }

        .sidebar-menu::-webkit-scrollbar-thumb:hover {
            background: rgba(255,255,255,0.25);
        }

        /* Utility */
        .text-gold { color: var(--primary-gold); }
        .bg-gold { background: var(--primary-gold); }
        .text-muted { color: var(--text-secondary); }
        .text-center { text-align: center; }
        .text-start { text-align: left; }
        .text-end { text-align: right; }
        .mb-0 { margin-bottom: 0; }
        .mb-1 { margin-bottom: 4px; }
        .mb-2 { margin-bottom: 8px; }
        .mb-3 { margin-bottom: 12px; }
        .mb-4 { margin-bottom: 20px; }
        .mt-3 { margin-top: 12px; }
        .mt-4 { margin-top: 20px; }
        .me-2 { margin-right: 8px; }
        .me-3 { margin-right: 12px; }
        .ms-2 { margin-left: 8px; }
        .d-flex { display: flex; }
        .d-grid { display: grid; }
        .gap-2 { gap: 8px; }
        .gap-3 { gap: 12px; }
        .align-items-center { align-items: center; }
        .justify-content-between { justify-content: space-between; }
        .justify-content-center { justify-content: center; }
        .flex-column { flex-direction: column; }
        .flex-wrap { flex-wrap: wrap; }
        .w-100 { width: 100%; }
        .h-100 { height: 100%; }
        .border-0 { border: 0; }
        .shadow-sm { box-shadow: 0 2px 8px var(--shadow-color); }
        .shadow { box-shadow: 0 4px 16px var(--shadow-color); }
        .rounded { border-radius: 6px; }
        .bg-white { background: var(--bg-card); }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon">M</div>
            <div class="brand-text">Muhle<span>Ops</span></div>
        </div>

        <nav class="sidebar-menu">
            <div class="menu-label">Main</div>

            @if (User.IsInRole("Admin"))
            {
                <!-- Admin Menu -->
                <a href="@Url.Action("Dashboard", "Home")" class="nav-item">
                    <i class="fas fa-th-large"></i>
                    <span>Dashboard</span>
                </a>

                <div class="menu-label">Recruitment</div>
                <a href="@Url.Action("Index", "JobPost")" class="nav-item">
                    <i class="fas fa-bullhorn"></i>
                    <span>Job Posts</span>
                </a>
                <a href="#" class="nav-item" onclick="alert('Applications feature coming soon!')">
                    <i class="fas fa-users"></i>
                    <span>Applications</span>
                </a>
                <a href="#" class="nav-item" onclick="alert('Hire Staff feature coming soon!')">
                    <i class="fas fa-user-check"></i>
                    <span>Hire Staff</span>
                </a>

                <div class="menu-label">Clients</div>
                <a href="#" class="nav-item" onclick="alert('Register Client feature coming soon!')">
                    <i class="fas fa-building"></i>
                    <span>Register Client</span>
                </a>
                <a href="#" class="nav-item" onclick="alert('Contracts feature coming soon!')">
                    <i class="fas fa-file-contract"></i>
