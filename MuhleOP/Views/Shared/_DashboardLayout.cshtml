﻿
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - MuhleOps</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        :root {
            --sidebar-width: 250px;
            --header-height: 60px;
            --primary-dark: #16202C;
            --primary-gold: #F5A623;
            /* Light Mode Colors */
            --bg-body: #f4f6f9;
            --bg-card: #ffffff;
            --bg-header: #ffffff;
            --text-primary: #1a202c;
            --text-secondary: #6b7280;
            --border-color: #e9ecef;
            --shadow-color: rgba(0,0,0,0.08);
            --bg-input: #ffffff;
            --bg-hover: #f3f4f6;
            --bg-sidebar: #16202C;
            --text-sidebar: rgba(255,255,255,0.7);
            --text-sidebar-hover: #ffffff;
            --bg-sidebar-hover: rgba(255,255,255,0.06);
            --bg-sidebar-active: rgba(245,166,35,0.12);
        }

        [data-theme="dark"] {
            --bg-body: #0f1419;
            --bg-card: #1a202c;
            --bg-header: #1a202c;
            --text-primary: #e2e8f0;
            --text-secondary: #a0aec0;
            --border-color: #2d3748;
            --shadow-color: rgba(0,0,0,0.3);
            --bg-input: #2d3748;
            --bg-hover: #2d3748;
            --bg-sidebar: #0f1419;
            --text-sidebar: rgba(255,255,255,0.6);
            --text-sidebar-hover: #ffffff;
            --bg-sidebar-hover: rgba(255,255,255,0.05);
            --bg-sidebar-active: rgba(245,166,35,0.08);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        a:focus-visible,
        button:focus-visible,
        input:focus-visible,
        select:focus-visible,
        textarea:focus-visible,
        .nav-item:focus-visible {
            outline: 2px solid var(--primary-gold);
            outline-offset: 2px;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: var(--bg-body);
            color: var(--text-primary);
            overflow-x: hidden;
            transition: background 0.3s ease, color 0.3s ease;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* Sidebar */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: var(--sidebar-width);
            height: 100vh;
            background: var(--bg-sidebar);
            color: #fff;
            z-index: 1000;
            transition: transform 0.3s ease, background 0.3s ease;
            display: flex;
            flex-direction: column;
        }

        .sidebar-brand {
            padding: 20px 24px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .sidebar-brand .brand-icon {
                width: 36px;
                height: 36px;
                background: var(--primary-gold);
                border-radius: 6px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 900;
                font-size: 18px;
                color: var(--primary-dark);
            }

            .sidebar-brand .brand-text {
                font-weight: 800;
                font-size: 18px;
                letter-spacing: 0.5px;
            }

                .sidebar-brand .brand-text span {
                    color: var(--primary-gold);
                }

        .sidebar-menu {
            flex: 1;
            overflow-y: auto;
            padding: 16px 0;
        }

            .sidebar-menu .menu-label {
                font-size: 10px;
                text-transform: uppercase;
                letter-spacing: 1.5px;
                color: rgba(255,255,255,0.35);
                padding: 12px 24px 6px;
                font-weight: 600;
            }

            .sidebar-menu .nav-item {
                display: flex;
                align-items: center;
                gap: 14px;
                padding: 10px 24px;
                color: var(--text-sidebar);
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
                transition: all 0.15s ease;
                border-left: 3px solid transparent;
                cursor: pointer;
            }

                .sidebar-menu .nav-item:hover {
                    background: var(--bg-sidebar-hover);
                    color: var(--text-sidebar-hover);
                    border-left-color: var(--primary-gold);
                }

                .sidebar-menu .nav-item.active {
                    background: var(--bg-sidebar-active);
                    color: #fff;
                    border-left-color: var(--primary-gold);
                }

                .sidebar-menu .nav-item i {
                    width: 20px;
                    text-align: center;
                    font-size: 16px;
                    color: rgba(255,255,255,0.5);
                }

                .sidebar-menu .nav-item:hover i,
                .sidebar-menu .nav-item.active i {
                    color: var(--primary-gold);
                }

                .sidebar-menu .nav-item.disabled {
                    cursor: default;
                    opacity: 0.45;
                }

                    .sidebar-menu .nav-item.disabled:hover {
                        background: transparent;
                        color: var(--text-sidebar);
                        border-left-color: transparent;
                    }

                        .sidebar-menu .nav-item.disabled:hover i {
                            color: rgba(255,255,255,0.5);
                        }

                .sidebar-menu .nav-item .soon-pill {
                    margin-left: auto;
                    font-size: 9px;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                    padding: 2px 6px;
                    border-radius: 10px;
                    background: rgba(255,255,255,0.08);
                    color: rgba(255,255,255,0.5);
                    flex-shrink: 0;
                }

        .sidebar-footer {
            padding: 16px 24px;
            border-top: 1px solid rgba(255,255,255,0.08);
        }

            .sidebar-footer .user-info {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .sidebar-footer .user-avatar {
                width: 36px;
                height: 36px;
                border-radius: 50%;
                background: var(--primary-gold);
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                font-size: 14px;
                color: var(--primary-dark);
            }

            .sidebar-footer .user-name {
                font-size: 13px;
                font-weight: 600;
                color: rgba(255,255,255,0.9);
            }

            .sidebar-footer .user-email {
                font-size: 11px;
                color: rgba(255,255,255,0.5);
            }

            .sidebar-footer .role-pill {
                display: inline-block;
                margin-top: 2px;
                padding: 2px 8px;
                font-size: 10px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                border-radius: 10px;
            }

            .sidebar-footer .role-pill-gold {
                background: rgba(245,166,35,0.18);
                color: var(--primary-gold);
            }

            .sidebar-footer .role-pill-primary {
                background: rgba(78,115,223,0.2);
                color: #8ba4ec;
            }

            .sidebar-footer .role-pill-success {
                background: rgba(28,200,138,0.2);
                color: #5edcae;
            }

            .sidebar-footer .role-pill-info {
                background: rgba(54,185,204,0.2);
                color: #7bdcea;
            }

            .sidebar-footer .role-pill-warning {
                background: rgba(246,194,62,0.2);
                color: #f6c23e;
            }

            .sidebar-footer .role-pill-secondary {
                background: rgba(255,255,255,0.1);
                color: rgba(255,255,255,0.65);
            }

        /* Main Content */
        .main-content {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            transition: margin-left 0.3s ease;
        }

        /* Header */
        .header {
            height: var(--header-height);
            background: var(--bg-header);
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
            position: sticky;
            top: 0;
            z-index: 999;
            transition: background 0.3s ease, border-color 0.3s ease;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

            .header-left .toggle-sidebar {
                background: none;
                border: none;
                font-size: 20px;
                color: var(--text-secondary);
                cursor: pointer;
                display: none;
                padding: 4px;
            }

            .header-left .page-title {
                font-size: 16px;
                font-weight: 600;
                color: var(--text-primary);
            }

        .header-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

            .header-right .theme-toggle {
                background: none;
                border: none;
                font-size: 18px;
                color: var(--text-secondary);
                cursor: pointer;
                padding: 6px 10px;
                border-radius: 6px;
                transition: background 0.15s ease;
            }

                .header-right .theme-toggle:hover {
                    background: var(--bg-hover);
                }

        /* Notification Styles */
        .notification-dropdown {
            position: relative;
        }

        .notification-btn {
            position: relative;
            background: none;
            border: none;
            font-size: 18px;
            color: var(--text-secondary);
            cursor: pointer;
            padding: 4px;
            transition: color 0.15s ease;
        }

            .notification-btn:hover {
                color: var(--text-primary);
            }

            .notification-btn .badge-dot {
                position: absolute;
                top: 0;
                right: 0;
                width: 8px;
                height: 8px;
                background: #e74c3c;
                border-radius: 50%;
                border: 2px solid var(--bg-header);
                animation: pulse-dot 2s infinite;
            }

        .badge-count {
            position: absolute;
            top: -6px;
            right: -6px;
            background: #e74c3c;
            color: #fff;
            border-radius: 50%;
            padding: 2px 6px;
            font-size: 10px;
            font-weight: 700;
            min-width: 18px;
            text-align: center;
            border: 2px solid var(--bg-header);
            display: none;
        }

        @@keyframes pulse-dot {
            0% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.3);
            }

            100% {
                transform: scale(1);
            }
        }

        .notification-panel {
            position: absolute;
            right: 0;
            top: calc(100% + 10px);
            width: 400px;
            max-height: 500px;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            box-shadow: 0 10px 40px var(--shadow-color);
            display: none;
            overflow: hidden;
            z-index: 1001;
        }

            .notification-panel.active {
                display: block;
            }

        .notification-header {
            padding: 14px 18px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: var(--bg-card);
        }

            .notification-header span {
                font-weight: 700;
                font-size: 14px;
                color: var(--text-primary);
            }

            .notification-header .unread-count {
                background: var(--primary-gold);
                color: #fff;
                border-radius: 50%;
                padding: 1px 8px;
                font-size: 11px;
                margin-left: 6px;
            }

        .mark-all-read {
            background: none;
            border: none;
            color: var(--primary-gold);
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: color 0.15s ease;
        }

            .mark-all-read:hover {
                color: #d4a00e;
            }

        .notification-list {
            max-height: 400px;
            overflow-y: auto;
        }

        .notification-item {
            padding: 14px 18px;
            border-bottom: 1px solid var(--border-color);
            cursor: pointer;
            transition: background 0.15s ease;
            display: flex;
            align-items: flex-start;
            gap: 12px;
        }

            .notification-item:hover {
                background: var(--bg-hover);
            }

            .notification-item.unread {
                background: var(--bg-hover);
                border-left: 3px solid var(--primary-gold);
            }

            .notification-item .icon {
                width: 36px;
                height: 36px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                font-size: 14px;
                color: #fff;
            }

                .notification-item .icon.application {
                    background: #4e73df;
                }

                .notification-item .icon.interview {
                    background: #36b9cc;
                }

                .notification-item .icon.status {
                    background: #1cc88a;
                }

                .notification-item .icon.system {
                    background: #858796;
                }

                .notification-item .icon.quiz {
                    background: #9b59b6;
                }

                .notification-item .icon.maintenance {
                    background: #f6c23e;
                }

                .notification-item .icon.finance {
                    background: #1cc88a;
                }

            .notification-item .content {
                flex: 1;
                min-width: 0;
            }

                .notification-item .content .title {
                    font-weight: 600;
                    font-size: 13px;
                    color: var(--text-primary);
                    margin-bottom: 2px;
                }

                .notification-item .content .message {
                    font-size: 12px;
                    color: var(--text-secondary);
                    line-height: 1.4;
                    display: -webkit-box;
                    -webkit-line-clamp: 2;
                    -webkit-box-orient: vertical;
                    overflow: hidden;
                }

                .notification-item .content .time {
                    font-size: 11px;
                    color: var(--text-secondary);
                    margin-top: 4px;
                }

        .notification-empty {
            padding: 30px 20px;
            text-align: center;
            color: var(--text-secondary);
        }

            .notification-empty i {
                font-size: 36px;
                margin-bottom: 10px;
                opacity: 0.5;
            }

            .notification-empty p {
                margin: 0;
                font-size: 14px;
            }

        .notification-list::-webkit-scrollbar {
            width: 4px;
        }

        .notification-list::-webkit-scrollbar-track {
            background: transparent;
        }

        .notification-list::-webkit-scrollbar-thumb {
            background: var(--border-color);
            border-radius: 4px;
        }

            .notification-list::-webkit-scrollbar-thumb:hover {
                background: var(--text-secondary);
            }

        .header-right .logout-btn {
            background: none;
            border: none;
            color: var(--text-secondary);
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            padding: 8px 12px;
            border-radius: 6px;
            transition: all 0.15s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .header-right .logout-btn:hover {
                background: var(--bg-hover);
                color: var(--text-primary);
            }

        /* Page Content */
        .page-content {
            padding: 24px 30px 40px;
        }

        /* Card Styles */
        .card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            transition: background 0.3s ease, border-color 0.3s ease;
        }

        .card-header {
            background: var(--bg-card);
            border-bottom: 1px solid var(--border-color);
            padding: 16px 20px;
        }

        .card-body {
            padding: 20px;
        }

        /* Alert Styles */
        .alert {
            padding: 12px 20px;
            border-radius: 6px;
            margin-bottom: 20px;
            border: 1px solid transparent;
        }

        .alert-success {
            color: #155724;
            background-color: #d4edda;
            border-color: #c3e6cb;
        }

        [data-theme="dark"] .alert-success {
            color: #b7eb8f;
            background-color: #1a3a2a;
            border-color: #2d5a3d;
        }

        .alert-danger {
            color: #721c24;
            background-color: #f8d7da;
            border-color: #f5c6cb;
        }

        [data-theme="dark"] .alert-danger {
            color: #f5a3a3;
            background-color: #3a1a1a;
            border-color: #5a2d2d;
        }

        .alert-warning {
            color: #856404;
            background-color: #fff3cd;
            border-color: #ffeeba;
        }

        [data-theme="dark"] .alert-warning {
            color: #f5d98a;
            background-color: #3a2a1a;
            border-color: #5a4a2d;
        }

        .alert-info {
            color: #0c5460;
            background-color: #d1ecf1;
            border-color: #bee5eb;
        }

        [data-theme="dark"] .alert-info {
            color: #8ad4e8;
            background-color: #1a2a3a;
            border-color: #2d4a5a;
        }

        .alert-dismissible {
            position: relative;
            padding-right: 40px;
        }

            .alert-dismissible .btn-close {
                position: absolute;
                top: 50%;
                right: 10px;
                transform: translateY(-50%);
                background: none;
                border: none;
                font-size: 20px;
                cursor: pointer;
                color: inherit;
                opacity: 0.7;
            }

                .alert-dismissible .btn-close:hover {
                    opacity: 1;
                }

        /* Button Styles */
        .btn {
            display: inline-block;
            font-weight: 600;
            text-align: center;
            white-space: nowrap;
            vertical-align: middle;
            user-select: none;
            border: 1px solid transparent;
            padding: 0.5rem 1rem;
            font-size: 14px;
            line-height: 1.5;
            border-radius: 4px;
            transition: all 0.15s ease;
            text-decoration: none;
            cursor: pointer;
        }

        .btn-primary {
            color: #fff;
            background-color: #4e73df;
            border-color: #4e73df;
        }

            .btn-primary:hover {
                background-color: #2e59d9;
                border-color: #2e59d9;
            }

        .btn-success {
            color: #fff;
            background-color: #1cc88a;
            border-color: #1cc88a;
        }

            .btn-success:hover {
                background-color: #17a673;
                border-color: #17a673;
            }

        .btn-danger {
            color: #fff;
            background-color: #e74a3b;
            border-color: #e74a3b;
        }

            .btn-danger:hover {
                background-color: #be2617;
                border-color: #be2617;
            }

        .btn-warning {
            color: #fff;
            background-color: #f6c23e;
            border-color: #f6c23e;
        }

            .btn-warning:hover {
                background-color: #dda20a;
                border-color: #dda20a;
            }

        .btn-secondary {
            color: #fff;
            background-color: #858796;
            border-color: #858796;
        }

            .btn-secondary:hover {
                background-color: #717384;
                border-color: #717384;
            }

        .btn-info {
            color: #fff;
            background-color: #36b9cc;
            border-color: #36b9cc;
        }

            .btn-info:hover {
                background-color: #258391;
                border-color: #258391;
            }

        .btn-outline-primary {
            color: #4e73df;
            border-color: #4e73df;
            background: transparent;
        }

            .btn-outline-primary:hover {
                background-color: #4e73df;
                color: #fff;
            }

        .btn-outline-secondary {
            color: var(--text-secondary);
            border-color: var(--border-color);
            background: transparent;
        }

            .btn-outline-secondary:hover {
                background: var(--bg-hover);
                color: var(--text-primary);
            }

        .btn-outline-success {
            color: #1cc88a;
            border-color: #1cc88a;
            background: transparent;
        }

            .btn-outline-success:hover {
                background-color: #1cc88a;
                color: #fff;
            }

        .btn-outline-warning {
            color: #f6c23e;
            border-color: #f6c23e;
            background: transparent;
        }

            .btn-outline-warning:hover {
                background-color: #f6c23e;
                color: #fff;
            }

        .btn-sm {
            padding: 0.25rem 0.5rem;
            font-size: 12px;
        }

        /* Badge */
        .badge {
            display: inline-block;
            padding: 0.25em 0.6em;
            font-size: 75%;
            font-weight: 700;
            line-height: 1;
            text-align: center;
            white-space: nowrap;
            vertical-align: baseline;
            border-radius: 0.25rem;
            color: #fff;
        }

        .bg-success {
            background-color: #1cc88a !important;
        }

        .bg-primary {
            background-color: #4e73df !important;
        }

        .bg-secondary {
            background-color: #858796 !important;
        }

        .bg-danger {
            background-color: #e74a3b !important;
        }

        .bg-warning {
            background-color: #f6c23e !important;
        }

        .bg-info {
            background-color: #36b9cc !important;
        }

        /* Table */
        .table {
            width: 100%;
            margin-bottom: 0;
            color: var(--text-primary);
            border-collapse: collapse;
        }

            .table th,
            .table td {
                padding: 0.75rem;
                vertical-align: middle;
                border-top: 1px solid var(--border-color);
            }

            .table thead th {
                vertical-align: bottom;
                border-bottom: 2px solid var(--border-color);
                font-weight: 600;
                font-size: 13px;
                color: var(--text-secondary);
            }

        .table-hover tbody tr:hover {
            background-color: var(--bg-hover);
        }

        .form-control {
            display: block;
            width: 100%;
            padding: 0.5rem 0.75rem;
            font-size: 14px;
            line-height: 1.5;
            color: var(--text-primary);
            background-color: var(--bg-input);
            border: 1px solid var(--border-color);
            border-radius: 4px;
            transition: border-color 0.15s ease;
        }

            .form-control:focus {
                border-color: var(--primary-gold);
                outline: 0;
                box-shadow: 0 0 0 0.2rem rgba(245,166,35,0.25);
            }

        .form-label {
            display: block;
            margin-bottom: 0.35rem;
            font-weight: 600;
            font-size: 13px;
            color: var(--text-secondary);
        }

        /* Mobile */
        @@media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .main-content {
                margin-left: 0;
            }

            .header-left .toggle-sidebar {
                display: block;
            }

            .page-content {
                padding: 16px;
            }

            .notification-panel {
                width: 320px;
                right: -40px;
            }
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon">M</div>
            <div class="brand-text">Muhle<span>Ops</span></div>
        </div>

        <nav class="sidebar-menu">
            @if (User.IsInRole("Admin"))
            {
                <!-- ===================== ADMIN ===================== -->
