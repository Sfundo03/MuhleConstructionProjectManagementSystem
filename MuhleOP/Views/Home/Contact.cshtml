﻿@{
    ViewBag.Title = "Contact";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Contact Us</h2>
        <p class="text-muted">
            <i class="fas fa-envelope me-2"></i>
            Get in touch with the MuhleOps team
        </p>
    </div>
    <a href="@Url.Action("Dashboard")" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back to Dashboard
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h4 class="mb-3">Get in Touch</h4>
                <p class="text-muted">
                    Have questions, feedback, or need support? Reach out to us using any of the methods below.
                </p>
                <hr />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="bg-hover p-3 rounded">
                            <i class="fas fa-phone text-gold fa-2x mb-2"></i>
                            <h6>Phone</h6>
                            <p class="mb-0"><strong>+27844253392</strong></p>
                            <small class="text-muted">Mon-Fri, 8:00 - 17:00</small>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="bg-hover p-3 rounded">
                            <i class="fas fa-envelope text-gold fa-2x mb-2"></i>
                            <h6>Email</h6>
                            <p class="mb-0"><strong>zmbalo@muhle.co.za</strong></p>
                            <small class="text-muted">Response within 24 hours</small>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="bg-hover p-3 rounded">
                            <i class="fas fa-building text-gold fa-2x mb-2"></i>
                            <h6>Office Address</h6>
                            <p class="mb-0">Muhle Building</p>
                            <small class="text-muted">Cape Town, South Africa</small>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="bg-hover p-3 rounded">
                            <i class="fas fa-clock text-gold fa-2x mb-2"></i>
                            <h6>Business Hours</h6>
                            <p class="mb-0"><strong>Mon-Fri:</strong> 8:00 - 17:00</p>
                            <p class="mb-0"><strong>Sat:</strong> 9:00 - 13:00</p>
                            <small class="text-muted">Closed on Sundays</small>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info mt-3">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>System Support:</strong> For technical issues, contact your system administrator.
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="card-title"><i class="fas fa-info-circle me-2"></i>Quick Links</h6>
                <div class="d-grid gap-2">
                    <a href="@Url.Action("About")" class="btn btn-outline-primary">
                        <i class="fas fa-info-circle"></i> About MuhleOps
                    </a>
                    <a href="@Url.Action("Dashboard")" class="btn btn-outline-secondary">
                        <i class="fas fa-home"></i> Dashboard
                    </a>
                    <a href="@Url.Action("Index", "JobPost")" class="btn btn-outline-info">
                        <i class="fas fa-bullhorn"></i> Job Posts
                    </a>
                    <a href="@Url.Action("Index", "Project")" class="btn btn-outline-success">
                        <i class="fas fa-project-diagram"></i> Projects
                    </a>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mt-4">
            <div class="card-body">
                <h6 class="card-title"><i class="fas fa-shield-alt me-2"></i>Support Hours</h6>
                <div class="d-flex flex-column gap-2">
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Monday - Friday</span>
                        <span>8:00 - 17:00</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Saturday</span>
                        <span>9:00 - 13:00</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Sunday</span>
                        <span class="badge bg-secondary">Closed</span>
                    </div>
                </div>
                <hr />
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Response Time</span>
                    <span class="badge bg-success">&lt; 24 hours</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .text-gold {
        color: var(--primary-gold, #F5A623);
    }

    .bg-hover {
        background: var(--bg-hover, #f8f9fa);
        transition: background 0.3s ease;
    }

        .bg-hover:hover {
            background: var(--border-color, #e9ecef);
        }

    [data-theme="dark"] .bg-hover {
        background: var(--bg-hover, #2d3748);
    }

        [data-theme="dark"] .bg-hover:hover {
            background: var(--border-color, #2d3748);
        }

    .badge.bg-success {
        color: #fff;
    }

    .badge.bg-secondary {
        color: #fff;
    }
</style>
