﻿@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="dashboard-content">
    <!-- Welcome Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center justify-content-between flex-wrap">
                    <div>
                        <h4 class="mb-1">Welcome back, @User.Identity.Name!</h4>
                        <p class="text-muted mb-0">
                            <i class="fas fa-calendar-alt me-2"></i>
                            @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
                        </p>
                    </div>
                    <div class="d-flex gap-2 mt-2 mt-sm-0">
                        <span class="badge bg-primary p-2">Admin Access</span>
                        <span class="badge bg-success p-2">
                            <i class="fas fa-circle me-1" style="font-size:8px;"></i> Online
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Cards - Only visible to Admin -->
    @if (User.IsInRole("Admin"))
    {
        <div class="row">
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-2">Active Projects</h6>
                                <h3 class="mb-0">12</h3>
                            </div>
                            <div class="icon-circle bg-primary text-white">
                                <i class="fas fa-project-diagram"></i>
                            </div>
                        </div>
                        <div class="mt-3">
                            <small class="text-success"><i class="fas fa-arrow-up"></i> 3 new this month</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-2">Total Staff</h6>
                                <h3 class="mb-0">48</h3>
                            </div>
                            <div class="icon-circle bg-success text-white">
                                <i class="fas fa-users"></i>
                            </div>
                        </div>
                        <div class="mt-3">
                            <small class="text-info"><i class="fas fa-user-plus"></i> 2 new hires</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-2">Equipment Active</h6>
                                <h3 class="mb-0">36</h3>
                            </div>
                            <div class="icon-circle bg-warning text-white">
                                <i class="fas fa-tools"></i>
                            </div>
                        </div>
                        <div class="mt-3">
                            <small class="text-warning"><i class="fas fa-exclamation-triangle"></i> 4 due for maintenance</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-2">Revenue</h6>
                                <h3 class="mb-0">R2.4M</h3>
                            </div>
                            <div class="icon-circle bg-info text-white">
                                <i class="fas fa-currency-rand"></i>
                            </div>
                        </div>
                        <div class="mt-3">
                            <small class="text-success"><i class="fas fa-arrow-up"></i> 12.5% increase</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row">
        <!-- Recent Activity - Visible to Admin only -->
        @if (User.IsInRole("Admin"))
        {
            <div class="col-lg-8 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent border-0">
                        <h6 class="mb-0">Recent Activity</h6>
                    </div>
                    <div class="card-body">
                        <div class="activity-feed">
                            <div class="activity-item d-flex align-items-start mb-3">
                                <div class="activity-badge bg-success text-white me-3">P</div>
                                <div>
                                    <p class="mb-0"><strong>Project Update:</strong> Riverside Mall phase 2 completed</p>
                                    <small class="text-muted">2 hours ago</small>
                                </div>
                            </div>
                            <div class="activity-item d-flex align-items-start mb-3">
                                <div class="activity-badge bg-warning text-dark me-3">E</div>
                                <div>
                                    <p class="mb-0"><strong>Equipment Alert:</strong> Excavator #047 needs maintenance</p>
                                    <small class="text-muted">4 hours ago</small>
                                </div>
                            </div>
                            <div class="activity-item d-flex align-items-start mb-3">
                                <div class="activity-badge bg-info text-white me-3">S</div>
                                <div>
                                    <p class="mb-0"><strong>Staff Update:</strong> 3 new employees onboarded</p>
                                    <small class="text-muted">Yesterday</small>
                                </div>
                            </div>
                            <div class="activity-item d-flex align-items-start">
                                <div class="activity-badge bg-primary text-white me-3">C</div>
                                <div>
                                    <p class="mb-0"><strong>Client Update:</strong> New contract signed with Vusani Developments</p>
                                    <small class="text-muted">2 days ago</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (User.IsInRole("Candidate"))
        {
            <!-- Candidate Recent Applications -->
            <div class="col-lg-8 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent border-0">
                        <h6 class="mb-0">My Recent Applications</h6>
                    </div>
                    <div class="card-body">
                        <div class="activity-feed">
                            <div class="activity-item d-flex align-items-start mb-3">
                                <div class="activity-badge bg-warning text-dark me-3">P</div>
                                <div>
                                    <p class="mb-0"><strong>Senior Construction Manager</strong> - Application Pending</p>
                                    <small class="text-muted">Submitted 2 days ago</small>
                                </div>
                            </div>
                            <div class="activity-item d-flex align-items-start mb-3">
                                <div class="activity-badge bg-success text-white me-3">S</div>
                                <div>
                                    <p class="mb-0"><strong>Site Supervisor</strong> - Shortlisted</p>
                                    <small class="text-muted">Submitted 1 week ago</small>
                                </div>
                            </div>
                            <div class="activity-item d-flex align-items-start">
                                <div class="activity-badge bg-danger text-white me-3">R</div>
                                <div>
                                    <p class="mb-0"><strong>Project Coordinator</strong> - Application Closed</p>
                                    <small class="text-muted">Submitted 2 weeks ago</small>
                                </div>
                            </div>
                        </div>
                        <div class="text-center mt-3">
                            <a href="@Url.Action("Dashboard", "Candidate")" class="btn btn-outline-primary btn-sm">
                                View All Applications
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Quick Actions - Role Based -->
        <div class="@(User.IsInRole("Admin") ? "col-lg-4" : "col-lg-4") mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0">
                    <h6 class="mb-0">Quick Actions</h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        @if (User.IsInRole("Admin"))
                        {
                            <a href="@Url.Action("Create", "JobPost")" class="btn btn-outline-primary text-start">
                                <i class="fas fa-plus-circle me-2"></i>New Job Post
                            </a>
                            <button class="btn btn-outline-success text-start" onclick="alert('Coming soon!')">
                                <i class="fas fa-user-plus me-2"></i>Hire Staff
                            </button>
                            <button class="btn btn-outline-warning text-start" onclick="alert('Coming soon!')">
                                <i class="fas fa-file-contract me-2"></i>Create Contract
                            </button>
                            <button class="btn btn-outline-info text-start" onclick="alert('Coming soon!')">
                                <i class="fas fa-upload me-2"></i>Record Timesheet
                            </button>
                            <button class="btn btn-outline-secondary text-start" onclick="alert('Coming soon!')">
                                <i class="fas fa-chart-line me-2"></i>Generate Report
                            </button>
                        }
                        else if (User.IsInRole("Candidate"))
                        {
                            <a href="@Url.Action("BrowseJobs", "Candidate")" class="btn btn-outline-primary text-start">
                                <i class="fas fa-search me-2"></i>Browse Jobs
                            </a>
                            <a href="@Url.Action("Dashboard", "Candidate")" class="btn btn-outline-success text-start">
                                <i class="fas fa-file-alt me-2"></i>My Applications
                            </a>
                            <a href="@Url.Action("Dashboard", "Candidate")" class="btn btn-outline-info text-start">
                                <i class="fas fa-user me-2"></i>Update Profile
                            </a>
                            <a href="@Url.Action("Dashboard", "Candidate")" class="btn btn-outline-warning text-start">
                                <i class="fas fa-file-upload me-2"></i>Upload Documents
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-outline-primary text-start" onclick="alert('Coming soon!')">
                                <i class="fas fa-tasks me-2"></i>My Tasks
                            </button>
                            <button class="btn btn-outline-success text-start" onclick="alert('Coming soon!')">
                                <i class="fas fa-clock me-2"></i>Timesheet
                            </button>
                            <button class="btn btn-outline-info text-start" onclick="alert('Coming soon!')">
                                <i class="fas fa-project-diagram me-2"></i>My Projects
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Additional Section for Admin -->
    @if (User.IsInRole("Admin"))
    {
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent border-0">
                        <h6 class="mb-0">Quick Stats</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3 col-6 mb-3 mb-md-0">
                                <div class="text-center">
                                    <h5>24</h5>
                                    <small class="text-muted">Total Applications</small>
                                </div>
                            </div>
                            <div class="col-md-3 col-6 mb-3 mb-md-0">
                                <div class="text-center">
                                    <h5>8</h5>
                                    <small class="text-muted">Pending Review</small>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="text-center">
                                    <h5>4</h5>
                                    <small class="text-muted">Shortlisted</small>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="text-center">
                                    <h5>12</h5>
                                    <small class="text-muted">Hired</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- System Status -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <div>
                            <small class="text-muted">
                                <i class="fas fa-check-circle text-success me-1"></i> System Status: Operational
                            </small>
                        </div>
                        <div>
                            <small class="text-muted">
                                <i class="fas fa-clock me-1"></i> Last updated: @DateTime.Now.ToString("HH:mm")
                            </small>
                        </div>
                        <div>
                            <small class="text-muted">
                                <i class="fas fa-user me-1"></i> Role: @(User.IsInRole("Admin") ? "Administrator" : User.IsInRole("Candidate") ? "Candidate" : "User")
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .icon-circle {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .bg-primary {
        background-color: #4e73df;
    }

    .bg-success {
        background-color: #1cc88a;
    }

    .bg-warning {
        background-color: #f6c23e;
    }

    .bg-info {
        background-color: #36b9cc;
    }

    .bg-danger {
        background-color: #e74a3b;
    }

    .activity-badge {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 14px;
        flex-shrink: 0;
    }

    .activity-item {
        padding-bottom: 12px;
        border-bottom: 1px solid var(--border-color, #f0f0f0);
    }

        .activity-item:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

    .btn-outline-primary {
        color: #4e73df;
        border-color: #4e73df;
    }

        .btn-outline-primary:hover {
            background-color: #4e73df;
            color: #fff;
        }

    .btn-outline-success {
        color: #1cc88a;
        border-color: #1cc88a;
    }

        .btn-outline-success:hover {
            background-color: #1cc88a;
            color: #fff;
        }

    .btn-outline-warning {
        color: #f6c23e;
        border-color: #f6c23e;
    }

        .btn-outline-warning:hover {
            background-color: #f6c23e;
            color: #fff;
        }

    .btn-outline-info {
        color: #36b9cc;
        border-color: #36b9cc;
    }

        .btn-outline-info:hover {
            background-color: #36b9cc;
            color: #fff;
        }

    .btn-outline-secondary {
        color: var(--text-secondary, #858796);
        border-color: var(--border-color, #e9ecef);
    }

        .btn-outline-secondary:hover {
            background: var(--bg-hover, #f3f4f6);
            color: var(--text-primary, #1a202c);
        }

    /* Dark mode support */
    [data-theme="dark"] .activity-item {
        border-bottom-color: var(--border-color, #2d3748);
    }

    [data-theme="dark"] .card {
        background: var(--bg-card, #1a202c);
    }

    [data-theme="dark"] .card-header {
        background: var(--bg-card, #1a202c);
        border-bottom-color: var(--border-color, #2d3748);
    }

    [data-theme="dark"] .text-muted {
        color: var(--text-secondary, #a0aec0) !important;
    }

    [data-theme="dark"] .btn-outline-secondary {
        color: var(--text-secondary, #a0aec0);
        border-color: var(--border-color, #2d3748);
    }

        [data-theme="dark"] .btn-outline-secondary:hover {
            background: var(--bg-hover, #2d3748);
            color: var(--text-primary, #e2e8f0);
        }

    [data-theme="dark"] .badge.bg-light {
        background: var(--bg-hover, #2d3748) !important;
        color: var(--text-primary, #e2e8f0) !important;
    }
</style>