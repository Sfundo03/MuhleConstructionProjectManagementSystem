﻿@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var userRole = ViewBag.UserRole ?? "User";
}

<div class="dashboard-content">
    <!-- Welcome Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center justify-content-between flex-wrap">
                    <div>
                        <h4 class="mb-1">Welcome back, @User.Identity.Name!</h4>
                        <p class="text-muted mb-0">
                            <i class="fas fa-calendar-alt me-2"></i>
                            @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
                        </p>
                        <p class="text-muted mb-0 mt-1">
                            <i class="fas fa-user-tag me-2"></i>
                            Role: <strong>@userRole</strong>
                        </p>
                    </div>
                    <div class="d-flex gap-2 mt-2 mt-sm-0">
                        <span class="badge bg-success p-2">
                            <i class="fas fa-circle me-1" style="font-size:8px;"></i> System Online
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================ -->
    <!-- ADMIN DASHBOARD -->
    <!-- ============================================ -->
    @if (User.IsInRole("Admin"))
    {
        <!-- Stats Cards -->
        <div class="row">
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-2">Active Projects</h6>
                                <h3 class="mb-0">@ViewBag.ActiveProjects</h3>
                            </div>
                            <div class="icon-circle bg-primary text-white">
                                <i class="fas fa-project-diagram"></i>
                            </div>
                        </div>
                        <div class="mt-3">
                            <small class="text-success"><i class="fas fa-check-circle"></i> @ViewBag.CompletedProjects completed</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-2">Total Staff</h6>
                                <h3 class="mb-0">@ViewBag.TotalStaff</h3>
                            </div>
                            <div class="icon-circle bg-success text-white">
                                <i class="fas fa-users"></i>
                            </div>
                        </div>
                        <div class="mt-3">
                            <small class="text-info"><i class="fas fa-user-plus"></i> Active staff</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-2">Total Clients</h6>
                                <h3 class="mb-0">@ViewBag.TotalClients</h3>
                            </div>
                            <div class="icon-circle bg-info text-white">
                                <i class="fas fa-building"></i>
                            </div>
                        </div>
                        <div class="mt-3">
                            <small class="text-muted"><i class="fas fa-file-contract"></i> Registered clients</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-2">Job Applications</h6>
                                <h3 class="mb-0">@ViewBag.TotalApplications</h3>
                            </div>
                            <div class="icon-circle bg-warning text-white">
                                <i class="fas fa-file-alt"></i>
                            </div>
                        </div>
                        <div class="mt-3">
                            <small class="text-danger"><i class="fas fa-clock"></i> @ViewBag.PendingApplications pending</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Action Buttons - Use Cases 1-11 -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent border-0">
                        <h6 class="mb-0"><i class="fas fa-bolt text-gold me-2"></i>Quick Actions - Use Cases 1-11</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-2">
                            <!-- UC1: Create Vacancy -->
                            <div class="col-md-3 col-6">
                                <a href="@Url.Action("Create", "JobPost")" class="btn btn-outline-primary w-100 text-start">
                                    <i class="fas fa-plus-circle me-2"></i>UC1: Create Vacancy
                                </a>
                            </div>
                            <!-- UC2: Browse & Apply Jobs -->
                            <div class="col-md-3 col-6">
                                <a href="@Url.Action("BrowseJobs", "Candidate")" class="btn btn-outline-success w-100 text-start">
                                    <i class="fas fa-search me-2"></i>UC2: Browse/Apply Jobs
                                </a>
                            </div>
                            <!-- UC3: Review & Shortlist -->
                            <div class="col-md-3 col-6">
                                <a href="@Url.Action("AllApplications", "JobPost")" class="btn btn-outline-warning w-100 text-start">
                                    <i class="fas fa-star me-2"></i>UC3: Review & Shortlist
                                </a>
                            </div>
                            <!-- UC4: Schedule Interview -->
                            <div class="col-md-3 col-6">
                                <a href="@Url.Action("AllApplications", "JobPost")" class="btn btn-outline-info w-100 text-start">
                                    <i class="fas fa-calendar-plus me-2"></i>UC4: Schedule Interview
                                </a>
                            </div>
                            <!-- UC5: Hire Staff -->
                            <div class="col-md-3 col-6">
                                <a href="@Url.Action("Hire", "Staff")" class="btn btn-outline-success w-100 text-start">
                                    <i class="fas fa-user-plus me-2"></i>UC5: Hire Staff
                                </a>
                            </div>
                            <!-- UC6: Register Client -->
                            <div class="col-md-3 col-6">
                                <a href="@Url.Action("Register", "Client")" class="btn btn-outline-primary w-100 text-start">
                                    <i class="fas fa-building me-2"></i>UC6: Register Client
                                </a>
                            </div>
                            <!-- UC7: Create Contract -->
                            <div class="col-md-3 col-6">
                                <a href="@Url.Action("Index", "Client")" class="btn btn-outline-warning w-100 text-start">
                                    <i class="fas fa-file-contract me-2"></i>UC7: Create Contract
                                </a>
                            </div>
                            <!-- UC8: Sign Contract -->
                            <div class="col-md-3 col-6">
                                <a href="@Url.Action("Index", "Client")" class="btn btn-outline-info w-100 text-start">
                                    <i class="fas fa-signature me-2"></i>UC8: Sign Contract
                                </a>
                            </div>
                            <!-- UC9: Initiate Project -->
                            <div class="col-md-3 col-6">
                                <a href="@Url.Action("Initiate", "Project")" class="btn btn-outline-primary w-100 text-start">
                                    <i class="fas fa-rocket me-2"></i>UC9: Initiate Project
                                </a>
                            </div>
                            <!-- UC10: Assign Staff -->
                            <div class="col-md-3 col-6">
                                <a href="@Url.Action("Index", "Project")" class="btn btn-outline-success w-100 text-start">
                                    <i class="fas fa-user-friends me-2"></i>UC10: Assign Staff
                                </a>
                            </div>
                            <!-- UC11: Assign Equipment -->
                            <div class="col-md-3 col-6">
                                <a href="@Url.Action("Index", "Project")" class="btn btn-outline-warning w-100 text-start">
                                    <i class="fas fa-tools me-2"></i>UC11: Assign Equipment
                                </a>
                            </div>
                            <!-- View All Projects -->
                            <div class="col-md-3 col-6">
                                <a href="@Url.Action("Index", "Project")" class="btn btn-outline-secondary w-100 text-start">
                                    <i class="fas fa-folder-open me-2"></i>All Projects
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="row">
            <div class="col-lg-8 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent border-0">
                        <h6 class="mb-0"><i class="fas fa-clock me-2"></i>Recent Applications</h6>
                    </div>
                    <div class="card-body">
                        @if (ViewBag.RecentApplications != null && ((IEnumerable<MuhleOP.Models.JobApplication>)ViewBag.RecentApplications).Any())
                        {
                            foreach (var app in (IEnumerable<MuhleOP.Models.JobApplication>)ViewBag.RecentApplications)
                            {
                                <div class="activity-item d-flex align-items-start mb-3">
                                    <div class="activity-badge bg-primary text-white me-3">
                                        <i class="fas fa-file-alt"></i>
                                    </div>
                                    <div>
                                        <p class="mb-0">
                                            <strong>@(app.JobPost?.JobTitle ?? "Unknown Position")</strong>
                                            - @(app.Candidate?.FullName ?? "Unknown Candidate")
                                        </p>
                                        <small class="text-muted">
                                            <span class="badge bg-@(app.Status == "Pending" ? "warning" : app.Status == "Shortlisted" ? "success" : app.Status == "Hired" ? "info" : "secondary")">
                                                @app.Status
                                            </span>
                                            - @app.ApplicationDate.ToString("dd MMM yyyy HH:mm")
                                        </small>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="fas fa-inbox fa-2x text-muted mb-2"></i>
                                <p class="text-muted">No recent applications</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-4 mb-4">
                <!-- Quick Stats -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent border-0">
                        <h6 class="mb-0"><i class="fas fa-chart-simple me-2"></i>Quick Stats</h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-6 mb-3">
                                <div class="text-center p-2 bg-hover rounded">
                                    <h5>@ViewBag.TotalJobPosts</h5>
                                    <small class="text-muted">Job Posts</small>
                                </div>
                            </div>
                            <div class="col-6 mb-3">
                                <div class="text-center p-2 bg-hover rounded">
                                    <h5>@ViewBag.TotalCandidates</h5>
                                    <small class="text-muted">Candidates</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="text-center p-2 bg-hover rounded">
                                    <h5>@ViewBag.ShortlistedCount</h5>
                                    <small class="text-muted">Shortlisted</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="text-center p-2 bg-hover rounded">
                                    <h5>@ViewBag.HiredCount</h5>
                                    <small class="text-muted">Hired</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Projects -->
                <div class="card border-0 shadow-sm mt-4">
                    <div class="card-header bg-transparent border-0">
                        <h6 class="mb-0"><i class="fas fa-project-diagram me-2"></i>Recent Projects</h6>
                    </div>
                    <div class="card-body">
                        @if (ViewBag.RecentProjects != null && ((IEnumerable<MuhleOP.Models.Project>)ViewBag.RecentProjects).Any())
                        {
                            foreach (var project in (IEnumerable<MuhleOP.Models.Project>)ViewBag.RecentProjects)
                            {
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="small">@project.ProjectName</span>
                                    <span class="badge bg-@(project.Status == "In Progress" ? "success" : project.Status == "Initiated" ? "info" : project.Status == "Completed" ? "primary" : "secondary")">
                                        @project.Status
                                    </span>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted text-center">No projects</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ============================================ -->
    <!-- CANDIDATE DASHBOARD -->
    <!-- ============================================ -->
    else if (User.IsInRole("Candidate"))
    {
    <!-- Stats Cards -->
    <div class="row">
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">Applications</h6>
                            <h3 class="mb-0">@ViewBag.TotalApplications</h3>
                        </div>
                        <div class="icon-circle bg-primary text-white">
                            <i class="fas fa-file-alt"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">Pending</h6>
                            <h3 class="mb-0">@ViewBag.PendingApplications</h3>
                        </div>
                        <div class="icon-circle bg-warning text-white">
                            <i class="fas fa-clock"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">Shortlisted</h6>
                            <h3 class="mb-0">@ViewBag.ShortlistedApplications</h3>
                        </div>
                        <div class="icon-circle bg-success text-white">
                            <i class="fas fa-star"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">Interviews</h6>
                            <h3 class="mb-0">@ViewBag.InterviewScheduledCount</h3>
                        </div>
                        <div class="icon-circle bg-info text-white">
                            <i class="fas fa-calendar-check"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Action Buttons - Use Case 2 -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0">
                    <h6 class="mb-0"><i class="fas fa-bolt text-gold me-2"></i>Quick Actions</h6>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-md-3 col-6">
                            <a href="@Url.Action("BrowseJobs", "Candidate")" class="btn btn-outline-primary w-100 text-start">
                                <i class="fas fa-search me-2"></i>Browse Jobs (UC2)
                            </a>
                        </div>
                        <div class="col-md-3 col-6">
                            <a href="@Url.Action("AllApplications", "Candidate")" class="btn btn-outline-success w-100 text-start">
                                <i class="fas fa-file-alt me-2"></i>My Applications
                            </a>
                        </div>
                        <div class="col-md-3 col-6">
                            <a href="@Url.Action("ApplicationStatus", "Candidate", new { id = 0 })" class="btn btn-outline-info w-100 text-start">
                                <i class="fas fa-chart-line me-2"></i>Application Status
                            </a>
                        </div>
                        <div class="col-md-3 col-6">
                            <a href="@Url.Action("Dashboard", "Home")" class="btn btn-outline-secondary w-100 text-start">
                                <i class="fas fa-user me-2"></i>My Profile
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Applications -->
    <div class="row">
        <div class="col-lg-8 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0">
                    <h6 class="mb-0"><i class="fas fa-clock me-2"></i>My Recent Applications</h6>
                </div>
                <div class="card-body">
                    @if (ViewBag.RecentApplications != null && ((IEnumerable<MuhleOP.Models.JobApplication>)ViewBag.RecentApplications).Any())
                    {
                        foreach (var app in (IEnumerable<MuhleOP.Models.JobApplication>)ViewBag.RecentApplications)
                        {
                            <div class="activity-item d-flex align-items-start mb-3">
                                <div class="activity-badge bg-@(app.Status == "Pending" ? "warning" : app.Status == "Shortlisted" ? "success" : app.Status == "Hired" ? "info" : "secondary") text-white me-3">
                                    <i class="fas fa-file-alt"></i>
                                </div>
                                <div>
                                    <p class="mb-0">
                                        <strong>@(app.JobPost?.JobTitle ?? "Unknown Position")</strong>
                                    </p>
                                    <small class="text-muted">
                                        <span class="badge bg-@(app.Status == "Pending" ? "warning" : app.Status == "Shortlisted" ? "success" : app.Status == "Hired" ? "info" : "secondary")">
                                            @app.Status
                                        </span>
                                        - @app.ApplicationDate.ToString("dd MMM yyyy")
                                        @if (app.InterviewScheduled && app.InterviewDateTime.HasValue)
                                        {
                                            <span class="ms-2"><i class="fas fa-calendar-alt"></i> @app.InterviewDateTime.Value.ToString("dd MMM HH:mm")</span>
                                        }
                                    </small>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-inbox fa-2x text-muted mb-2"></i>
                            <p class="text-muted">You haven't applied for any jobs yet.</p>
                            <a href="@Url.Action("BrowseJobs", "Candidate")" class="btn btn-primary btn-sm">Browse Jobs</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <!-- Available Jobs -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0">
                    <h6 class="mb-0"><i class="fas fa-briefcase me-2"></i>Available Jobs</h6>
                </div>
                <div class="card-body">
                    @if (ViewBag.AvailableJobs != null && ((IEnumerable<MuhleOP.Models.JobPost>)ViewBag.AvailableJobs).Any())
                    {
                        foreach (var job in (IEnumerable<MuhleOP.Models.JobPost>)ViewBag.AvailableJobs)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="small">@job.JobTitle</span>
                                <a href="@Url.Action("Apply", "Candidate", new { id = job.Id })" class="btn btn-sm btn-success">Apply</a>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted text-center">No jobs available</p>
                    }
                </div>
            </div>

            <!-- Status Legend -->
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-header bg-transparent border-0">
                    <h6 class="mb-0"><i class="fas fa-info-circle me-2"></i>Status Legend</h6>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-column gap-1">
                        <div><span class="badge bg-warning me-1">Pending</span> <small>Awaiting review</small></div>
                        <div><span class="badge bg-success me-1">Shortlisted</span> <small>Selected for interview</small></div>
                        <div><span class="badge bg-info me-1">Interview</span> <small>Interview scheduled</small></div>
                        <div><span class="badge bg-success me-1">Hired</span> <small>Position offered</small></div>
                        <div><span class="badge bg-danger me-1">Rejected</span> <small>Not selected</small></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    }

    <!-- ============================================ -->
    <!-- PROJECT MANAGER DASHBOARD -->
    <!-- ============================================ -->
    else if (User.IsInRole("Project Manager"))
    {
    <div class="row">
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">My Projects</h6>
                            <h3 class="mb-0">@(ViewBag.MyProjects != null ? ((IEnumerable<MuhleOP.Models.Project>)ViewBag.MyProjects).Count() : 0)</h3>
                        </div>
                        <div class="icon-circle bg-primary text-white">
                            <i class="fas fa-project-diagram"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">My Tasks</h6>
                            <h3 class="mb-0">@(ViewBag.MyTasks != null ? ((IEnumerable<MuhleOP.Models.DailyTask>)ViewBag.MyTasks).Count() : 0)</h3>
                        </div>
                        <div class="icon-circle bg-warning text-white">
                            <i class="fas fa-tasks"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions - Use Cases 7, 9, 10, 11 -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0">
                    <h6 class="mb-0"><i class="fas fa-bolt text-gold me-2"></i>Quick Actions</h6>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-md-3 col-6">
                            <a href="@Url.Action("Initiate", "Project")" class="btn btn-outline-primary w-100 text-start">
                                <i class="fas fa-rocket me-2"></i>Initiate Project (UC9)
                            </a>
                        </div>
                        <div class="col-md-3 col-6">
                            <a href="@Url.Action("Index", "Project")" class="btn btn-outline-success w-100 text-start">
                                <i class="fas fa-folder-open me-2"></i>My Projects
                            </a>
                        </div>
                        <div class="col-md-3 col-6">
                            <a href="@Url.Action("Index", "Client")" class="btn btn-outline-warning w-100 text-start">
                                <i class="fas fa-file-contract me-2"></i>Create Contract (UC7)
                            </a>
                        </div>
                        <div class="col-md-3 col-6">
                            <a href="@Url.Action("Index", "Project")" class="btn btn-outline-info w-100 text-start">
                                <i class="fas fa-user-friends me-2"></i>Assign Staff (UC10)
                            </a>
                        </div>
                        <div class="col-md-3 col-6">
                            <a href="@Url.Action("Index", "Project")" class="btn btn-outline-warning w-100 text-start">
                                <i class="fas fa-tools me-2"></i>Assign Equipment (UC11)
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- My Projects List -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0">
                    <h6 class="mb-0"><i class="fas fa-list me-2"></i>My Projects</h6>
                </div>
                <div class="card-body">
                    @if (ViewBag.MyProjects != null && ((IEnumerable<MuhleOP.Models.Project>)ViewBag.MyProjects).Any())
                    {
                        foreach (var project in (IEnumerable<MuhleOP.Models.Project>)ViewBag.MyProjects)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-2 p-2 border-bottom">
                                <div>
                                    <strong>@project.ProjectName</strong>
                                    <br />
                                    <small class="text-muted">@project.ProjectCode - @project.ProjectLocation</small>
                                </div>
                                <div>
                                    <span class="badge bg-@(project.Status == "In Progress" ? "success" : project.Status == "Initiated" ? "info" : project.Status == "Completed" ? "primary" : "secondary")">
                                        @project.Status
                                    </span>
                                    <a href="@Url.Action("Details", "Project", new { id = project.Id })" class="btn btn-sm btn-outline-primary ms-2">View</a>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted text-center">No projects assigned</p>
                    }
                </div>
            </div>
        </div>
    </div>
