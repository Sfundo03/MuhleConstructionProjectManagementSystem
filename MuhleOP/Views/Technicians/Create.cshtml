
@model MuhleOP.ViewModels.EquipmentTechnicianFormViewModel
@{
    ViewBag.Title = Model.Id == 0 ? "Add Technician" : "Edit Technician";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4" style="max-width: 600px;">
    <h2 class="mb-4">@(Model.Id == 0 ? "Add Technician" : "Edit Technician")</h2>

    <div class="alert alert-info">
        <i class="fas fa-info-circle me-1"></i> Technicians do not log into the system; their email address is used to automatically dispatch assignment notices when scheduled.
    </div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Full Name <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                </div>
                <div class="mb-3">
                    <label class="form-label">Email Address <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", required = "required", placeholder = "technician@workshop.com" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                </div>
                <div class="mb-3">
                    <label class="form-label">Phone Number</label>
                    @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
                </div>
                <div class="mb-3">
                    <label class="form-label">Specialization</label>
                    @Html.TextBoxFor(m => m.Specialization, new { @class = "form-control", placeholder = "e.g. Hydraulics, Electrical, General Mechanics" })
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Save Technician</button>
        <a href="@Url.Action("Index", "Technicians")" class="btn btn-outline-secondary">Cancel</a>
    }
</div>