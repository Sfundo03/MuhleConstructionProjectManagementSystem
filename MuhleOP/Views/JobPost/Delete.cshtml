﻿@model MuhleOP.ViewModels.JobPostViewModel
@{
    ViewBag.Title = "Delete Job Post";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Delete Job Post</h2>
        <p class="text-muted">
            <i class="fas fa-trash me-2"></i>
            Permanently remove this job post
        </p>
    </div>
    <a href="@Url.Action("Index")" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back to List
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>Warning!</strong> Are you sure you want to delete this job post? This action cannot be undone.
        </div>

        <div class="row">
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Job Title</dt>
                    <dd class="col-sm-8"><strong>@Model.JobTitle</strong></dd>

                    <dt class="col-sm-4">Department</dt>
                    <dd class="col-sm-8">@Model.Department</dd>

                    <dt class="col-sm-4">Location</dt>
                    <dd class="col-sm-8">@Model.Location</dd>

                    <dt class="col-sm-4">Job Type</dt>
                    <dd class="col-sm-8">@Model.JobType</dd>

                    <dt class="col-sm-4">Experience Level</dt>
                    <dd class="col-sm-8">@Model.ExperienceLevel</dd>
                </dl>
            </div>
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Closing Date</dt>
                    <dd class="col-sm-8">@Model.ClosingDate.ToString("dd MMM yyyy")</dd>

                    <dt class="col-sm-4">Number of Openings</dt>
                    <dd class="col-sm-8">@Model.NumberOfOpenings</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsPublished)
                        {
                            <span class="badge bg-success">Published</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Draft</span>
                        }
                        @if (Model.IsClosed)
                        {
                            <span class="badge bg-danger">Closed</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Date Posted</dt>
                    <dd class="col-sm-8">@Model.DatePosted.ToString("dd MMM yyyy HH:mm")</dd>
                </dl>
            </div>
        </div>

        <div class="alert alert-info mt-3">
            <i class="fas fa-info-circle me-2"></i>
            <strong>Note:</strong> This will permanently remove the job post and all associated data. This action cannot be undone.
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> Confirm Delete
                </button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="fas fa-times"></i> Cancel
                </a>
            </div>
        }
    </div>
</div>

<style>
    .badge {
        font-size: 11px;
        padding: 5px 10px;
    }

        .badge.bg-warning {
            color: #fff;
        }

        .badge.bg-info {
            color: #fff;
        }

        .badge.bg-success {
            color: #fff;
        }

        .badge.bg-danger {
            color: #fff;
        }

        .badge.bg-secondary {
            color: #fff;
        }

        .badge.bg-primary {
            color: #fff;
        }
</style>