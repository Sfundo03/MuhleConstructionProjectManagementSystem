
@model MuhleOP.ViewModels.JobPostViewModel
@{
    ViewBag.Title = "Job Post Details";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Job Post Details</h2>
    <div>
        <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-primary">
            <i class="fas fa-edit"></i> Edit
        </a>
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <h3>@Model.JobTitle</h3>

                <div class="d-flex flex-wrap gap-3 mb-3">
                    <span class="badge bg-primary">@Model.JobType</span>
                    <span class="badge bg-info">@Model.ExperienceLevel</span>
                    @if (Model.IsPublished)
                    {
                        <span class="badge bg-success">Published</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Draft</span>
                    }
                </div>

                <dl class="row">
                    <dt class="col-sm-3">Department</dt>
                    <dd class="col-sm-9">@Model.Department</dd>

                    <dt class="col-sm-3">Location</dt>
                    <dd class="col-sm-9">@Model.Location</dd>

                    <dt class="col-sm-3">Salary Range</dt>
                    <dd class="col-sm-9">@Model.SalaryRange</dd>

                    <dt class="col-sm-3">Number of Openings</dt>
                    <dd class="col-sm-9">@Model.NumberOfOpenings</dd>

                    <dt class="col-sm-3">Applications Received</dt>
                    <dd class="col-sm-9"><span class="badge bg-info">@Model.ApplicationCount</span></dd>

                    <dt class="col-sm-3">Closing Date</dt>
                    <dd class="col-sm-9">@Model.ClosingDate.ToString("yyyy-MM-dd")</dd>

                    <dt class="col-sm-3">Date Posted</dt>
                    <dd class="col-sm-9">@Model.DatePosted.ToString("yyyy-MM-dd HH:mm")</dd>

                    <dt class="col-sm-3">Posted By</dt>
                    <dd class="col-sm-9">@Model.PostedBy</dd>
                </dl>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0">
                <h5 class="mb-0">Job Description</h5>
            </div>
            <div class="card-body">
                <p style="white-space: pre-wrap;">@Model.JobDescription</p>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0">
                <h5 class="mb-0">Requirements</h5>
            </div>
            <div class="card-body">
                <p style="white-space: pre-wrap;">@Model.Requirements</p>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Quick Actions</h5>
                <div class="d-grid gap-2">
                    <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-outline-primary">
                        <i class="fas fa-edit"></i> Edit Job Post
                    </a>
                    <a href="@Url.Action("Delete", new { id = Model.Id })" class="btn btn-outline-danger">
                        <i class="fas fa-trash"></i> Delete Job Post
                    </a>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                        <i class="fas fa-list"></i> View All Posts
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>