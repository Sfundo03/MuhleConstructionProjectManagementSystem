﻿@model MuhleOP.ViewModels.ScheduleInterviewViewModel
@{
    ViewBag.Title = "Schedule Interview";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Schedule Interview</h2>
        <p class="text-muted">
            <i class="fas fa-calendar-plus me-2"></i>
            Schedule an interview with a shortlisted candidate
        </p>
    </div>
    <a href="javascript:history.back()" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>Scheduling Interview for:</strong> @Model.CandidateFullName - @Model.JobTitle
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.ApplicationId)
                    @Html.HiddenFor(m => m.CandidateId)

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                @Html.LabelFor(m => m.InterviewDateTime, new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(m => m.InterviewDateTime, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                                @Html.ValidationMessageFor(m => m.InterviewDateTime, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                @Html.LabelFor(m => m.InterviewType, new { @class = "form-label fw-bold" })
                                @Html.DropDownListFor(m => m.InterviewType,
                                    new SelectList(new[] { "In-person", "Phone", "Video" }),
                                    "-- Select Type --",
                                    new { @class = "form-select" })
                                @Html.ValidationMessageFor(m => m.InterviewType, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.InterviewLocation, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.InterviewLocation, new { @class = "form-control", placeholder = "e.g. Muhle Building, Office 101" })
                        @Html.ValidationMessageFor(m => m.InterviewLocation, "", new { @class = "text-danger" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.InterviewNotes, new { @class = "form-label fw-bold" })
                        @Html.TextAreaFor(m => m.InterviewNotes, new { @class = "form-control", rows = "5", placeholder = "Add any notes for the interview..." })
                        @Html.ValidationMessageFor(m => m.InterviewNotes, "", new { @class = "text-danger" })
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-calendar-check"></i> Schedule Interview
                        </button>
                        <a href="javascript:history.back()" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Cancel
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <h6 class="card-title"><i class="fas fa-lightbulb text-gold me-2"></i>Interview Tips</h6>
                <ul class="list-unstyled small">
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Prepare relevant questions
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Review the candidate's CV before the interview
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Take notes during the interview
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Allow time for candidate questions
                    </li>
                    <li>
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Follow up after the interview
                    </li>
                </ul>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="card-title"><i class="fas fa-user me-2"></i>Candidate Summary</h6>
                <dl class="row small">
                    <dt class="col-5">Name:</dt>
                    <dd class="col-7">@Model.CandidateFullName</dd>
                    <dt class="col-5">Position:</dt>
                    <dd class="col-7">@Model.JobTitle</dd>
                    <dt class="col-5">Application ID:</dt>
                    <dd class="col-7">#@Model.ApplicationId</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<style>
    .text-gold {
        color: var(--primary-gold, #F5A623);
    }

    .form-control, .form-select {
        font-size: 14px;
        padding: 10px 14px;
    }
</style>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}