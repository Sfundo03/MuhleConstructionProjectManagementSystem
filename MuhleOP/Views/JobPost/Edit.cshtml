@model MuhleOP.ViewModels.JobPostViewModel
@{
    ViewBag.Title = "Edit Job Post";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Edit Job Post</h2>
    <a href="@Url.Action("Index")" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back to List
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            @Html.HiddenFor(m => m.DatePosted)
            @Html.HiddenFor(m => m.PostedBy)
            @Html.HiddenFor(m => m.IsClosed)

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.JobTitle, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.JobTitle, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.JobTitle, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Department, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.Department, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Department, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.JobType, new { @class = "form-label fw-bold" })
                        @Html.DropDownListFor(m => m.JobType,
                            new SelectList(new[] { "Full-time", "Part-time", "Contract", "Temporary", "Internship" }),
                            "-- Select Job Type --",
                            new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.JobType, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.ExperienceLevel, new { @class = "form-label fw-bold" })
                        @Html.DropDownListFor(m => m.ExperienceLevel,
                            new SelectList(new[] { "Entry", "Junior", "Mid", "Senior", "Lead", "Executive" }),
                            "-- Select Experience Level --",
                            new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.ExperienceLevel, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Location, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.Location, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Location, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.SalaryRange, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.SalaryRange, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.SalaryRange, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.NumberOfOpenings, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.NumberOfOpenings, new { @class = "form-control", type = "number", min = "1" })
                        @Html.ValidationMessageFor(m => m.NumberOfOpenings, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.ClosingDate, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.ClosingDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(m => m.ClosingDate, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.JobDescription, new { @class = "form-label fw-bold" })
                @Html.TextAreaFor(m => m.JobDescription, new { @class = "form-control", rows = "5" })
                @Html.ValidationMessageFor(m => m.JobDescription, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Requirements, new { @class = "form-label fw-bold" })
                @Html.TextAreaFor(m => m.Requirements, new { @class = "form-control", rows = "5" })
                @Html.ValidationMessageFor(m => m.Requirements, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3 form-check">
                @Html.CheckBoxFor(m => m.IsPublished, new { @class = "form-check-input" })
                @Html.LabelFor(m => m.IsPublished, new { @class = "form-check-label" })
                <small class="text-muted d-block">Publish or unpublish this job post.</small>
            </div>

            @if (Model.IsClosed)
            {
                <div class="alert alert-warning">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>Note:</strong> This job post is currently closed. Candidates cannot apply until it is reopened.
                </div>
            }

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Update Job Post
                </button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="fas fa-times"></i> Cancel
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}