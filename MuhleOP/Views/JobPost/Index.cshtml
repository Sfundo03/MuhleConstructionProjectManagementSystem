@model IEnumerable<MuhleOP.ViewModels.JobPostViewModel>
@{
    ViewBag.Title = "Job Posts";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Job Posts</h2>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="fas fa-plus-circle"></i> Create New Job Post
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Job Title</th>
                        <th>Department</th>
                        <th>Location</th>
                        <th>Closing Date</th>
                        <th>Applications</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="@(item.IsClosed ? "table-secondary" : "")">
                            <td>
                                <strong>@item.JobTitle</strong>
                                <br />
                                <small class="text-muted">@item.JobType</small>
                            </td>
                            <td>@item.Department</td>
                            <td>@item.Location</td>
                            <td>@item.ClosingDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <span class="badge bg-info">@item.ApplicationCount</span>
                            </td>
                            <td>
                                @if (item.IsClosed)
                                {
                                    <span class="badge bg-secondary">Closed</span>
                                }
                                else if (item.IsPublished)
                                {
                                    <span class="badge bg-success">Published</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Draft</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-outline-info" title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-outline-primary" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-outline-danger" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                    @if (item.IsClosed)
                                    {
                                        <button onclick="toggleJobPost(@item.Id, '@item.JobTitle')"
                                                class="btn btn-outline-success"
                                                title="Reopen Job Post">
                                            <i class="fas fa-folder-open"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button onclick="toggleJobPost(@item.Id, '@item.JobTitle')"
                                                class="btn btn-outline-secondary"
                                                title="Close Job Post">
                                            <i class="fas fa-folder"></i>
                                        </button>
                                    }
                                    @if (item.ApplicationCount > 0)
                                    {
                                        <a href="@Url.Action("ReviewApplications", new { id = item.Id })" class="btn btn-outline-success" title="Review Applications">
                                            <i class="fas fa-users"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-file-alt fa-3x text-muted mb-3"></i>
                <h4>No Job Posts Found</h4>
                <p class="text-muted">Create your first job post to start recruiting.</p>
                <a href="@Url.Action("Create")" class="btn btn-primary">
                    <i class="fas fa-plus-circle"></i> Create Job Post
                </a>
            </div>
        }
    </div>
</div>

<style>
    .table-secondary {
        background-color: var(--bg-hover) !important;
        opacity: 0.7;
    }

    [data-theme="dark"] .table-secondary {
        background-color: rgba(45, 55, 72, 0.5) !important;
    }

    .btn-group {
        display: flex;
        flex-wrap: wrap;
        gap: 2px;
    }

        .btn-group .btn {
            margin: 1px;
        }
</style>

@section Scripts {
    <script>
        function toggleJobPost(id, title) {
            console.log('Toggle Job Post called - ID:', id, 'Title:', title);

            // Determine action based on current status
            const row = document.querySelector(`button[onclick*="toggleJobPost(${id}"]`)?.closest('tr');
            const statusBadge = row?.querySelector('.badge');
            const isClosed = statusBadge?.textContent.trim() === 'Closed';
            const action = isClosed ? 'reopen' : 'close';

            if (!confirm(`Are you sure you want to ${action} the job post "${title}"?`)) {
                console.log('User cancelled the action');
                return;
            }

            console.log('Sending request to close/reopen job post...');

            // Show loading state
            const button = document.querySelector(`button[onclick*="toggleJobPost(${id}"]`);
            if (button) {
                button.disabled = true;
                button.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            }

            fetch('/JobPost/CloseJobPost', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ id: id })
            })
                .then(response => {
                    console.log('Response status:', response.status);
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    console.log('Response data:', data);
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Error: ' + data.message);
                        // Reset button
                        if (button) {
                            button.disabled = false;
                            const isClosed = data.isClosed !== undefined ? data.isClosed : false;
                            button.innerHTML = '<i class="fas fa-' + (isClosed ? 'folder-open' : 'folder') + '"></i>';
                        }
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred. Please try again.\nError: ' + error.message);
                    // Reset button
                    if (button) {
                        button.disabled = false;
                        const isClosed = statusBadge?.textContent.trim() === 'Closed';
                        button.innerHTML = '<i class="fas fa-' + (isClosed ? 'folder-open' : 'folder') + '"></i>';
                    }
                });
        }
    </script>
}