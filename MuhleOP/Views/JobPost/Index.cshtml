﻿@model IEnumerable<MuhleOP.ViewModels.JobPostViewModel>
@{
    ViewBag.Title = "Job Posts";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Job Posts</h2>
        <p class="text-muted">
            <i class="fas fa-bullhorn me-2"></i>
            Manage all job vacancies and recruitment activities
        </p>
    </div>
    <div>
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="fas fa-plus-circle"></i> Create New Job Post
        </a>
        <a href="@Url.Action("AllApplications", "JobPost")" class="btn btn-outline-info ms-2">
            <i class="fas fa-users"></i> All Applications
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">&times;</button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">&times;</button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover" id="jobPostsTable">
                <thead>
                    <tr>
                        <th>Job Title</th>
                        <th>Department</th>
                        <th>Location</th>
                        <th>Closing Date</th>
                        <th>Applications</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="@(item.IsClosed ? "table-secondary" : "")">
                                <td>
                                    <strong>@item.JobTitle</strong>
                                    <br />
                                    <small class="text-muted">@item.JobType</small>
                                    @if (item.IsAutoClosed)
                                    {
                                        <br />
                                        <span class="badge bg-info">Auto-Closed</span>
                                    }
                                </td>
                                <td>@item.Department</td>
                                <td>@item.Location</td>
                                <td>@item.ClosingDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <span class="badge bg-primary">@item.ApplicationCount</span>
                                    @if (item.AcceptedCount > 0)
                                    {
                                        <br />
                                        <small class="text-muted">Accepted: @item.AcceptedCount</small>
                                    }
                                </td>
                                <td>
                                    @if (item.IsClosed)
                                    {
                                        <span class="badge bg-secondary">Closed</span>
                                    }
                                    else if (item.IsPublished)
                                    {
                                        <span class="badge bg-success">Published</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Draft</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-outline-info" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-outline-primary" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-outline-danger" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                        @if (item.IsClosed)
                                        {
                                            <button onclick="toggleJobPost(@item.Id, '@item.JobTitle')"
                                                    class="btn btn-outline-success"
                                                    title="Reopen Job Post">
                                                <i class="fas fa-folder-open"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button onclick="toggleJobPost(@item.Id, '@item.JobTitle')"
                                                    class="btn btn-outline-secondary"
                                                    title="Close Job Post">
                                                <i class="fas fa-folder"></i>
                                            </button>
                                        }
                                        @if (item.ApplicationCount > 0)
                                        {
                                            <a href="@Url.Action("ReviewApplications", new { id = item.Id })" class="btn btn-outline-success" title="Review Applications">
                                                <i class="fas fa-users"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <i class="fas fa-file-alt fa-3x text-muted mb-3" style="opacity:0.3;"></i>
                                <h4>No Job Posts Found</h4>
                                <p class="text-muted">Create your first job post to start recruiting.</p>
                                <a href="@Url.Action("Create")" class="btn btn-primary">
                                    <i class="fas fa-plus-circle"></i> Create Job Post
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .table-secondary {
        background-color: var(--bg-hover) !important;
        opacity: 0.7;
    }

    [data-theme="dark"] .table-secondary {
        background-color: rgba(45, 55, 72, 0.5) !important;
    }

    .btn-group {
        display: flex;
        flex-wrap: wrap;
        gap: 2px;
    }

        .btn-group .btn {
            margin: 1px;
        }

    .badge {
        font-size: 11px;
        padding: 5px 10px;
    }

        .badge.bg-warning {
            color: #fff;
        }

        .badge.bg-info {
            color: #fff;
        }

        .badge.bg-success {
            color: #fff;
        }

        .badge.bg-secondary {
            color: #fff;
        }

        .badge.bg-primary {
            color: #fff;
        }

    .btn-outline-info {
        color: #36b9cc;
        border-color: #36b9cc;
    }

        .btn-outline-info:hover {
            background-color: #36b9cc;
            color: #fff;
        }

    .btn-outline-primary {
        color: #4e73df;
        border-color: #4e73df;
    }

        .btn-outline-primary:hover {
            background-color: #4e73df;
            color: #fff;
        }

    .btn-outline-danger {
        color: #e74a3b;
        border-color: #e74a3b;
    }

        .btn-outline-danger:hover {
            background-color: #e74a3b;
            color: #fff;
        }

    .btn-outline-success {
        color: #1cc88a;
        border-color: #1cc88a;
    }

        .btn-outline-success:hover {
            background-color: #1cc88a;
            color: #fff;
        }

    .btn-outline-secondary {
        color: #858796;
        border-color: #858796;
    }

        .btn-outline-secondary:hover {
            background-color: #858796;
            color: #fff;
        }
</style>

@section Scripts {
    <script>
        function toggleJobPost(id, title) {
            const row = document.querySelector(`button[onclick*="toggleJobPost(${id}"]`)?.closest('tr');
            const statusBadge = row?.querySelector('.badge');
            const isClosed = statusBadge?.textContent.trim() === 'Closed';
            const action = isClosed ? 'reopen' : 'close';

            if (!confirm(`Are you sure you want to ${action} the job post "${title}"?`)) {
                return;
            }

            const button = document.querySelector(`button[onclick*="toggleJobPost(${id}"]`);
            if (button) {
                button.disabled = true;
                button.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            }

            fetch('/JobPost/CloseJobPost', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ id: id })
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Error: ' + data.message);
                        if (button) {
                            button.disabled = false;
                            button.innerHTML = '<i class="fas fa-' + (isClosed ? 'folder-open' : 'folder') + '"></i>';
                        }
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred. Please try again.');
                    if (button) {
                        button.disabled = false;
                        button.innerHTML = '<i class="fas fa-' + (isClosed ? 'folder-open' : 'folder') + '"></i>';
                    }
                });
        }
    </script>
}