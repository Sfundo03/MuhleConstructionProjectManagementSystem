﻿@model MuhleOP.ViewModels.JobPostViewModel
@{
    ViewBag.Title = "Create Job Post";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Create Job Post</h2>
        <p class="text-muted">
            <i class="fas fa-plus-circle me-2"></i>
            Create a new job vacancy for candidates to apply
        </p>
    </div>
    <a href="@Url.Action("Index")" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back to List
    </a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>
        <strong>Please correct the following errors:</strong>
        <ul class="mb-0 mt-1">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">&times;</button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.SystemRoleId, new { @class = "form-label fw-bold" })
                        @Html.DropDownListFor(m => m.SystemRoleId, Model.AvailableRoles, new { @class = "form-select", id = "SystemRoleId" })
                        @Html.ValidationMessageFor(m => m.SystemRoleId, "", new { @class = "text-danger" })
                        <small class="text-muted d-block mt-1">Select the system role for this position. The job title will be auto-generated.</small>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.JobTitle, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.JobTitle, new { @class = "form-control", @readonly = "readonly", id = "JobTitle", placeholder = "Auto-generated from selected role" })
                        @Html.ValidationMessageFor(m => m.JobTitle, "", new { @class = "text-danger" })
                        <small class="text-muted d-block mt-1">Job title is auto-generated based on the selected role</small>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Department, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.Department, new { @class = "form-control", placeholder = "e.g. Construction" })
                        @Html.ValidationMessageFor(m => m.Department, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.JobType, new { @class = "form-label fw-bold" })
                        @Html.DropDownListFor(m => m.JobType,
                            new SelectList(new[] { "Full-time", "Part-time", "Contract", "Temporary", "Internship" }),
                            "-- Select Job Type --",
                            new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.JobType, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.ExperienceLevel, new { @class = "form-label fw-bold" })
                        @Html.DropDownListFor(m => m.ExperienceLevel,
                            new SelectList(new[] { "Entry", "Junior", "Mid", "Senior", "Lead", "Executive" }),
                            "-- Select Experience Level --",
                            new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.ExperienceLevel, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Location, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.Location, new { @class = "form-control", placeholder = "e.g. Cape Town, South Africa" })
                        @Html.ValidationMessageFor(m => m.Location, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.SalaryRange, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.SalaryRange, new { @class = "form-control", placeholder = "e.g. R45,000 - R55,000" })
                        @Html.ValidationMessageFor(m => m.SalaryRange, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.NumberOfOpenings, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.NumberOfOpenings, new { @class = "form-control", type = "number", min = "1", value = "1" })
                        @Html.ValidationMessageFor(m => m.NumberOfOpenings, "", new { @class = "text-danger" })
                        <small class="text-muted d-block mt-1">Number of positions available for this role</small>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.ClosingDate, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.ClosingDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(m => m.ClosingDate, "", new { @class = "text-danger" })
                        <small class="text-muted d-block mt-1">Applications will close on this date</small>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.JobDescription, new { @class = "form-label fw-bold" })
                @Html.TextAreaFor(m => m.JobDescription, new { @class = "form-control", rows = "5", placeholder = "Describe the role, responsibilities, and day-to-day activities..." })
                @Html.ValidationMessageFor(m => m.JobDescription, "", new { @class = "text-danger" })
                <small class="text-muted d-block mt-1">Provide a detailed description of the position</small>
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Requirements, new { @class = "form-label fw-bold" })
                @Html.TextAreaFor(m => m.Requirements, new { @class = "form-control", rows = "5", placeholder = "List the qualifications, skills, experience, and certifications required..." })
                @Html.ValidationMessageFor(m => m.Requirements, "", new { @class = "text-danger" })
                <small class="text-muted d-block mt-1">Include education, experience, skills, and any other requirements</small>
            </div>

            <div class="mb-3 form-check">
                @Html.CheckBoxFor(m => m.IsPublished, new { @class = "form-check-input", id = "IsPublished" })
                @Html.LabelFor(m => m.IsPublished, new { @class = "form-check-label", @for = "IsPublished" })
                <small class="text-muted d-block mt-1">Publish immediately so candidates can apply, or save as draft for later</small>
            </div>

            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Create Job Post
                </button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="fas fa-times"></i> Cancel
                </a>
            </div>
        }
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0">
                <h6 class="mb-0"><i class="fas fa-lightbulb text-gold me-2"></i>Tips for Creating a Great Job Post</h6>
            </div>
            <div class="card-body">
                <ul class="list-unstyled small">
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Select the appropriate system role - this determines the job title
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        List required qualifications and experience
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Include salary range to attract qualified candidates
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Set a realistic closing date
                    </li>
                    <li>
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Highlight what makes your company great
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<style>
    .text-gold {
        color: var(--primary-gold, #F5A623);
    }

    .form-control, .form-select {
        font-size: 14px;
        padding: 10px 14px;
    }

    .form-check-label {
        font-weight: 600;
        font-size: 14px;
    }

    .form-control[readonly] {
        background-color: #f8f9fa;
        cursor: not-allowed;
    }

    [data-theme="dark"] .form-control[readonly] {
        background-color: #2d3748;
    }
</style>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function() {
            // Auto-generate job title when role is selected
            $('#SystemRoleId').change(function() {
                var roleId = $(this).val();
                if (roleId) {
                    var roleName = $(this).find('option:selected').text();
                    // Remove the "-- Select a System Role --" option text
                    if (roleName && roleName !== '-- Select a System Role --') {
                        $('#JobTitle').val(roleName + ' Position');
                    } else {
                        $('#JobTitle').val('');
                    }
                } else {
                    $('#JobTitle').val('');
                }
            });

            // If role is pre-selected (for edit mode), set job title
            var selectedRole = $('#SystemRoleId').val();
            if (selectedRole) {
                var roleName = $('#SystemRoleId').find('option:selected').text();
                if (roleName && roleName !== '-- Select a System Role --') {
                    $('#JobTitle').val(roleName + ' Position');
                }
            }
        });
    </script>
}