﻿@model List<MuhleOP.ViewModels.ApplicationReviewViewModel>
@{
    ViewBag.Title = "All Applications";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var totalApplications = ViewBag.TotalApplications ?? 0;
    var shortlistedCount = ViewBag.ShortlistedCount ?? 0;
    var interviewScheduledCount = ViewBag.InterviewScheduledCount ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>All Applications</h2>
        <p class="text-muted">
            <i class="fas fa-users me-2"></i>
            View all candidate applications across all job posts
        </p>
    </div>
    <div>
        <a href="@Url.Action("Index", "JobPost")" class="btn btn-secondary me-2">
            <i class="fas fa-arrow-left"></i> Back to Job Posts
        </a>
        <a href="@Url.Action("AllApplications", "JobPost")" class="btn btn-primary">
            <i class="fas fa-sync"></i> Refresh
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">&times;</button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">&times;</button>
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <!-- Summary Stats -->
        <div class="row mb-3">
            <div class="col-md-8">
                <h6 class="text-muted"><i class="fas fa-chart-simple me-2"></i>Application Summary</h6>
                <div class="d-flex gap-4 flex-wrap">
                    <div>
                        <span class="badge bg-primary" style="font-size:16px;padding:8px 16px;">@totalApplications</span>
                        <small class="text-muted d-block mt-1">Total Applications</small>
                    </div>
                    <div>
                        <span class="badge bg-success" style="font-size:16px;padding:8px 16px;">@shortlistedCount</span>
                        <small class="text-muted d-block mt-1">Shortlisted</small>
                    </div>
                    <div>
                        <span class="badge bg-info" style="font-size:16px;padding:8px 16px;">@interviewScheduledCount</span>
                        <small class="text-muted d-block mt-1">Interviews Scheduled</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Applications Table -->
        <div class="table-responsive">
            <table class="table table-hover" id="applicationsTable">
                <thead>
                    <tr>
                        <th>Job Title</th>
                        <th>Candidate</th>
                        <th>Date Applied</th>
                        <th>Score</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var app in Model)
                        {
                            <tr class="@(app.IsShortlisted ? "table-success" : "") @(app.InterviewScheduled ? "table-info" : "") @(app.IsHired ? "table-hired" : "")">
                                <td>
                                    <span class="badge bg-secondary" style="font-size:13px;padding:6px 12px;">@app.JobTitle</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="me-2">
                                            @if (!string.IsNullOrEmpty(app.ProfilePicturePath))
                                            {
                                                <img src="@Url.Content(app.ProfilePicturePath)" alt="Profile" class="rounded-circle" style="width:35px;height:35px;object-fit:cover;" />
                                            }
                                            else
                                            {
                                                <div class="rounded-circle bg-gold d-flex align-items-center justify-content-center" style="width:35px;height:35px;color:#fff;font-size:14px;font-weight:700;">
                                                    @(app.CandidateFullName?.Substring(0, 1).ToUpper() ?? "U")
                                                </div>
                                            }
                                        </div>
                                        <div>
                                            <strong>@app.CandidateFullName</strong>
                                            <br />
                                            <small class="text-muted">@app.CandidateEmail</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@app.ApplicationDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (app.RankingScore > 0)
                                    {
                                        <div class="d-flex align-items-center">
                                            <span class="fw-bold me-2">@app.RankingScore</span>
                                            <div class="progress" style="width:50px;height:5px;">
                                                <div class="progress-bar bg-@(app.RankingScore >= 70 ? "success" : app.RankingScore >= 50 ? "warning" : "danger")"
                                                     style="width:@(app.RankingScore)%;">
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td>
                                    @if (app.IsHired)
                                    {
                                        <span class="badge bg-success">Hired</span>
                                    }
                                    else if (app.InterviewResult == "Passed")
                                    {
                                        <span class="badge bg-success">Passed</span>
                                    }
                                    else if (app.InterviewResult == "Failed")
                                    {
                                        <span class="badge bg-danger">Failed</span>
                                    }
                                    else if (app.InterviewScheduled)
                                    {
                                        <span class="badge bg-info">Interview Scheduled</span>
                                        <br />
                                        <small class="text-muted">@(app.InterviewDateTime?.ToString("dd MMM HH:mm") ?? "N/A")</small>
                                    }
                                    else if (app.IsShortlisted)
                                    {
                                        <span class="badge bg-success">Shortlisted</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@(app.Status ?? "Pending")</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a href="@Url.Action("ReviewApplications", "JobPost", new { id = app.JobPostId })" class="btn btn-outline-info" title="View Job Applications">
                                            <i class="fas fa-briefcase"></i>
                                        </a>
                                        <a href="@Url.Action("CandidateDetails", "JobPost", new { id = app.CandidateId })" class="btn btn-outline-secondary" title="View Candidate">
                                            <i class="fas fa-user"></i>
                                        </a>
                                        @if (app.IsShortlisted && !app.InterviewScheduled && !app.IsHired)
                                        {
                                            <a href="@Url.Action("ScheduleInterview", "JobPost", new { id = app.ApplicationId })" class="btn btn-outline-primary" title="Schedule Interview">
                                                <i class="fas fa-calendar-plus"></i>
                                            </a>
                                        }
                                        @if (app.InterviewScheduled && app.InterviewResult == "Pending" && !app.IsHired)
                                        {
                                            <a href="@Url.Action("AssessInterview", "JobPost", new { id = app.ApplicationId })" class="btn btn-outline-warning" title="Assess Interview">
                                                <i class="fas fa-clipboard-check"></i>
                                            </a>
                                        }
                                        @if (app.InterviewResult == "Passed" && !app.IsHired)
                                        {
                                            <a href="@Url.Action("HireCandidate", "JobPost", new { id = app.ApplicationId })" class="btn btn-outline-success" title="Hire Candidate">
                                                <i class="fas fa-user-plus"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <i class="fas fa-inbox fa-3x text-muted mb-3" style="opacity:0.3;"></i>
                                <h5>No Applications Yet</h5>
                                <p class="text-muted">No candidates have applied for any positions yet.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .table-success {
        background-color: var(--bg-success, rgba(28, 200, 138, 0.1)) !important;
    }

    .table-info {
        background-color: var(--bg-info, rgba(54, 185, 204, 0.1)) !important;
    }

    .table-hired {
        background-color: rgba(28, 200, 138, 0.2) !important;
    }

    [data-theme="dark"] .table-success {
        background-color: rgba(28, 200, 138, 0.2) !important;
    }

    [data-theme="dark"] .table-info {
        background-color: rgba(54, 185, 204, 0.2) !important;
    }

    [data-theme="dark"] .table-hired {
        background-color: rgba(28, 200, 138, 0.3) !important;
    }

    .bg-gold {
        background-color: var(--primary-gold, #F5A623);
    }

    .badge {
        font-size: 11px;
        padding: 5px 10px;
    }

        .badge.bg-warning {
            color: #fff;
        }

        .badge.bg-info {
            color: #fff;
        }

        .badge.bg-success {
            color: #fff;
        }

        .badge.bg-danger {
            color: #fff;
        }

        .badge.bg-primary {
            color: #fff;
        }

        .badge.bg-secondary {
            color: #fff;
        }

    .progress {
        background-color: var(--bg-hover);
    }

    .btn-outline-info {
        color: #36b9cc;
        border-color: #36b9cc;
    }

        .btn-outline-info:hover {
            background-color: #36b9cc;
            color: #fff;
        }

    .btn-outline-primary {
        color: #4e73df;
        border-color: #4e73df;
    }

        .btn-outline-primary:hover {
            background-color: #4e73df;
            color: #fff;
        }

    .btn-outline-warning {
        color: #f6c23e;
        border-color: #f6c23e;
    }

        .btn-outline-warning:hover {
            background-color: #f6c23e;
            color: #fff;
        }

    .btn-outline-success {
        color: #1cc88a;
        border-color: #1cc88a;
    }

        .btn-outline-success:hover {
            background-color: #1cc88a;
            color: #fff;
        }

    .btn-outline-secondary {
        color: #858796;
        border-color: #858796;
    }

        .btn-outline-secondary:hover {
            background-color: #858796;
            color: #fff;
        }

    .btn-group .btn {
        margin: 1px;
    }
</style>