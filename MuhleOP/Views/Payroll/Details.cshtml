
@model MuhleOP.ViewModels.PayrollDetailsViewModel
@{
    ViewBag.Title = "Payroll Details";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h1 class="h3 mb-1">
                <i class="fa-solid fa-file-invoice-dollar me-2"></i>
                @Model.StaffName — @Model.PeriodLabel
            </h1>
            <p class="text-muted mb-0">
                @Model.EmployeeId · @Model.StaffRole
                <span class="badge bg-@Model.StatusBadgeColor ms-2">@Model.Status</span>
            </p>
        </div>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> Back
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white fw-semibold">Earnings &amp; Deductions</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6 col-md-4">
                            <div class="text-muted small">Regular Hours</div>
                            <div class="fs-5">@Model.RegularHours.ToString("N2")</div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="text-muted small">Overtime Hours</div>
                            <div class="fs-5">@Model.OvertimeHours.ToString("N2")</div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="text-muted small">Hourly Rate</div>
                            <div class="fs-5">R @Model.HourlyRate.ToString("N2")</div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="text-muted small">Overtime Rate (1.5×)</div>
                            <div class="fs-5">R @Model.OvertimeRate.ToString("N2")</div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="text-muted small">Regular Pay</div>
                            <div class="fs-5">R @Model.RegularPay.ToString("N2")</div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="text-muted small">Overtime Pay</div>
                            <div class="fs-5">R @Model.OvertimePay.ToString("N2")</div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="text-muted small">Bonus</div>
                            <div class="fs-5">R @Model.Bonus.ToString("N2")</div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="text-muted small">Gross Pay</div>
                            <div class="fs-5 fw-semibold">R @Model.GrossPay.ToString("N2")</div>
                        </div>
                    </div>

                    <hr />

                    <div class="row g-3">
                        <div class="col-6 col-md-4">
                            <div class="text-muted small">UIF (1% capped R177.12)</div>
                            <div class="fs-5 text-danger">− R @Model.Deductions.ToString("N2")</div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="text-muted small">PAYE Tax (18%)</div>
                            <div class="fs-5 text-danger">− R @Model.Tax.ToString("N2")</div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="text-muted small">Net Pay</div>
                            <div class="fs-4 fw-bold text-success">R @Model.NetPay.ToString("N2")</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-semibold">Period &amp; Payment</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="text-muted small">Pay Period</div>
                            <div>@Model.PayPeriodStart.ToString("dd MMM yyyy") – @Model.PayPeriodEnd.ToString("dd MMM yyyy")</div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted small">Bank Account</div>
                            <div>@(string.IsNullOrEmpty(Model.BankAccount) ? "—" : Model.BankAccount)</div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted small">Payment Method</div>
                            <div>@(Model.PaymentMethod ?? "—")</div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted small">Payment Date</div>
                            <div>@(Model.PaymentDate.HasValue ? Model.PaymentDate.Value.ToString("dd MMM yyyy") : "—")</div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.Notes))
                        {
                            <div class="col-12">
                                <div class="text-muted small">Notes</div>
                                <div>@Model.Notes</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white fw-semibold">Actions</div>
                <div class="card-body d-grid gap-2">
                    @if (Model.CanCalculate)
                    {
                        using (Html.BeginForm("Calculate", "Payroll", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-info w-100">
                                <i class="fa-solid fa-calculator me-1"></i>
                                @(Model.Status == "Calculated" ? "Recalculate" : "Calculate")
                            </button>
                        }
                    }

                    @if (Model.CanApprove)
                    {
                        using (Html.BeginForm("Approve", "Payroll", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-primary w-100"
                                    onclick="return confirm('Approve this payroll for payment processing?');">
                                <i class="fa-solid fa-check me-1"></i> Approve
                            </button>
                        }
                    }

                    @if (Model.CanProcess)
                    {
                        <a href="@Url.Action("Process", new { id = Model.Id })" class="btn btn-warning w-100">
                            <i class="fa-solid fa-credit-card me-1"></i> Process Payment
                        </a>
                    }

                    @if (Model.CanMarkPaid)
                    {
                        using (Html.BeginForm("MarkPaid", "Payroll", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-success w-100"
                                    onclick="return confirm('Mark this payroll as Paid and notify the staff member?');">
                                <i class="fa-solid fa-circle-check me-1"></i> Mark as Paid
                            </button>
                        }
                    }

                    @if (!Model.CanCalculate && !Model.CanApprove && !Model.CanProcess && !Model.CanMarkPaid)
                    {
                        <p class="text-muted small mb-0">No further actions available for this status.</p>
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-semibold">Audit Trail</div>
                <div class="card-body small">
                    <dl class="row mb-0">
                        <dt class="col-5 text-muted">Calculated by</dt>
                        <dd class="col-7">@(Model.CalculatedBy ?? "—")</dd>

                        <dt class="col-5 text-muted">Approved by</dt>
                        <dd class="col-7">
                            @(Model.ApprovedBy ?? "—")
                            @if (Model.ApprovalDate.HasValue)
                            {
                                <span class="text-muted">(@Model.ApprovalDate.Value.ToString("dd MMM yyyy HH:mm"))</span>
                            }
                        </dd>

                        <dt class="col-5 text-muted">Processed by</dt>
                        <dd class="col-7">
                            @(Model.ProcessedBy ?? "—")
                            @if (Model.ProcessedDate.HasValue)
                            {
                                <span class="text-muted">(@Model.ProcessedDate.Value.ToString("dd MMM yyyy HH:mm"))</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>