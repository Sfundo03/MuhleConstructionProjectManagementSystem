@model MuhleOP.ViewModels.PayrollDetailsViewModel
@{
    ViewBag.Title = "Payroll Details";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h1 class="h3 mb-1">
                <i class="fa-solid fa-file-invoice-dollar me-2"></i>
                @Model.StaffName — @Model.PeriodLabel
                @if (Model.IsPeriodLocked)
                {
                    <span class="badge bg-danger ms-2"><i class="fa-solid fa-lock me-1"></i> Period Locked</span>
                }
            </h1>
            <p class="text-muted mb-0">
                @Model.EmployeeId · @Model.StaffRole
                <span class="badge bg-@Model.StatusBadgeColor ms-2">@Model.Status</span>
            </p>
        </div>
        <div class="d-flex gap-2">
            @if (!string.IsNullOrEmpty(Model.PayslipPdfPath))
            {
                <a href="@Url.Action("DownloadPayslip", new { id = Model.Id })" class="btn btn-outline-success">
                    <i class="fa-solid fa-file-pdf me-1"></i> Download Payslip
                </a>
            }
            else if (Model.Status == "Calculated" || Model.Status == "Approved" || Model.Status == "Processed" || Model.Status == "Paid")
            {
                using (Html.BeginForm("GeneratePayslip", "Payroll", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-outline-success">
                        <i class="fa-solid fa-file-pdf me-1"></i> Generate Payslip PDF
                    </button>
                }
            }
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i> Back
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Anomalies != null && Model.Anomalies.Any())
    {
        <div class="card border-0 shadow-sm mb-4 border-start border-4 @(Model.HasBlocker ? "border-danger" : "border-warning")">
            <div class="card-header bg-white fw-semibold">
                <i class="fa-solid fa-triangle-exclamation me-1 @(Model.HasBlocker ? "text-danger" : "text-warning")"></i>
                Payroll Anomalies &amp; Validation
            </div>
            <div class="card-body">
                <ul class="mb-0 ps-3">
                    @foreach (var anom in Model.Anomalies)
                    {
                        <li class="mb-1">
                            <span class="badge @(anom.Severity == "Blocker" ? "bg-danger" : anom.Severity == "Warning" ? "bg-warning text-dark" : "bg-info") me-2">@anom.Severity</span>
                            <strong>[@anom.Code]</strong> @anom.Message
                            @if (!string.IsNullOrEmpty(anom.RelatedRecord))
                            {
                                <span class="text-muted small">(@anom.RelatedRecord)</span>
                            }
                        </li>
                    }
                </ul>
            </div>
        </div>
    }

    <!-- Roster vs Attendance -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white fw-semibold">
            <i class="fa-solid fa-calendar-check me-1"></i> Roster vs Attendance
        </div>
        <div class="card-body">
            <div class="row g-3 text-center">
                <div class="col"><div class="text-muted small">Rostered</div><div class="fs-5">@Model.RosteredHours.ToString("N2") h</div></div>
                <div class="col"><div class="text-muted small">Actual</div><div class="fs-5">@((Model.RegularHours + Model.OvertimeHours + Model.SundayHours + Model.HolidayHours).ToString("N2")) h</div></div>
                <div class="col"><div class="text-muted small">Regular</div><div class="fs-5">@Model.RegularHours.ToString("N2") h</div></div>
                <div class="col"><div class="text-muted small">Overtime</div><div class="fs-5">@Model.OvertimeHours.ToString("N2") h</div></div>
                <div class="col"><div class="text-muted small">Sunday</div><div class="fs-5">@Model.SundayHours.ToString("N2") h</div></div>
                <div class="col"><div class="text-muted small">Holiday</div><div class="fs-5">@Model.HolidayHours.ToString("N2") h</div></div>
                <div class="col"><div class="text-muted small">Unworked</div><div class="fs-5 text-warning">@Model.UnworkedRosteredHours.ToString("N2") h</div></div>
            </div>
        </div>
    </div>

    <!-- YTD -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white fw-semibold">Year-to-Date (@Model.TaxYear)</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-6 col-md-3"><div class="text-muted small">Gross</div><div>R @Model.YtdGross.ToString("N2")</div></div>
                <div class="col-6 col-md-3"><div class="text-muted small">PAYE</div><div>R @Model.YtdPaye.ToString("N2")</div></div>
                <div class="col-6 col-md-3"><div class="text-muted small">UIF</div><div>R @Model.YtdUif.ToString("N2")</div></div>
                <div class="col-6 col-md-3"><div class="text-muted small">Net</div><div>R @Model.YtdNet.ToString("N2")</div></div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white fw-semibold">Earnings &amp; Deductions (ZAR)</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6 col-md-4">
                            <div class="text-muted small">Regular Hours</div>
                            <div class="fs-5">@Model.RegularHours.ToString("N2")</div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="text-muted small">Overtime Hours</div>
                            <div class="fs-5">@Model.OvertimeHours.ToString("N2")</div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="text-muted small">Hourly Rate</div>
                            <div class="fs-5">R @Model.HourlyRate.ToString("N2")</div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="text-muted small">Overtime Rate (1.5×)</div>
                            <div class="fs-5">R @Model.OvertimeRate.ToString("N2")</div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="text-muted small">Regular Pay (3601)</div>
                            <div class="fs-5">R @Model.RegularPay.ToString("N2")</div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="text-muted small">Overtime Pay (3605)</div>
                            <div class="fs-5">R @Model.OvertimePay.ToString("N2")</div>
                        </div>
                        @if (Model.SundayHours > 0)
                        {
                            <div class="col-6 col-md-4">
                                <div class="text-muted small">Sunday Pay (3607)</div>
                                <div class="fs-5">R @Model.SundayPay.ToString("N2")</div>
                            </div>
                        }
                        @if (Model.HolidayHours > 0)
                        {
                            <div class="col-6 col-md-4">
                                <div class="text-muted small">Holiday Pay (3607)</div>
                                <div class="fs-5">R @Model.HolidayPay.ToString("N2")</div>
                            </div>
                        }
                        <div class="col-6 col-md-4">
                            <div class="text-muted small">Bonus</div>
                            <div class="fs-5">R @Model.Bonus.ToString("N2")</div>
                        </div>
                        @if (Model.OtherAdditions > 0)
                        {
                            <div class="col-6 col-md-4">
                                <div class="text-muted small">Other Additions</div>
                                <div class="fs-5">R @Model.OtherAdditions.ToString("N2")</div>
                            </div>
                        }
                        <div class="col-6 col-md-4">
                            <div class="text-muted small">Gross Pay</div>
                            <div class="fs-5 fw-semibold">R @Model.GrossPay.ToString("N2")</div>
                        </div>
                    </div>

                    <hr />

                    <div class="row g-3">
                        <div class="col-6 col-md-4">
                            <div class="text-muted small">UIF Employee (4003)</div>
                            <div class="fs-5 text-danger">− R @Model.UifEmployee.ToString("N2")</div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="text-muted small">PAYE (4001)</div>
                            <div class="fs-5 text-danger">− R @Model.Tax.ToString("N2")</div>
                        </div>
                        @if (Model.MedicalAidContribution > 0)
                        {
                            <div class="col-6 col-md-4">
                                <div class="text-muted small">Medical Aid (4006)</div>
                                <div class="fs-5 text-danger">− R @Model.MedicalAidContribution.ToString("N2")</div>
                            </div>
                        }
                        @if (Model.PensionContribution > 0)
                        {
                            <div class="col-6 col-md-4">
                                <div class="text-muted small">Pension (4007)</div>
                                <div class="fs-5 text-danger">− R @Model.PensionContribution.ToString("N2")</div>
                            </div>
                        }
                        @if (Model.OtherDeductions > 0)
                        {
                            <div class="col-6 col-md-4">
                                <div class="text-muted small">Other Deductions</div>
                                <div class="fs-5 text-danger">− R @Model.OtherDeductions.ToString("N2")</div>
                            </div>
                        }
                        @if (Model.AdvanceRecovery > 0)
                        {
                            <div class="col-6 col-md-4">
                                <div class="text-muted small">Advance Recovery</div>
                                <div class="fs-5 text-danger">− R @Model.AdvanceRecovery.ToString("N2")</div>
                            </div>
                        }
                        <div class="col-12">
                            <div class="text-muted small">Net Pay</div>
                            <div class="fs-4 fw-bold text-success">R @Model.NetPay.ToString("N2")</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Employer contributions -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white fw-semibold">Employer Contributions (not deducted from salary)</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="text-muted small">UIF Employer</div>
                            <div>R @Model.UifEmployer.ToString("N2")</div>
                        </div>
                        <div class="col-6">
                            <div class="text-muted small">SDL (4005)</div>
                            <div>R @Model.Sdl.ToString("N2")</div>
                        </div>
                    </div>
                </div>
            </div>

            @if (User.IsInRole("Finance Officer") && (Model.Status == "Draft" || Model.Status == "Calculated"))
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white fw-semibold">Edit Deductions &amp; Additions</div>
                    <div class="card-body">
                        @using (Html.BeginForm("UpdateDeductions", "Payroll", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label small">Medical Aid (R)</label>
                                    <input type="number" step="0.01" name="medicalAid" class="form-control form-control-sm" value="@Model.MedicalAidContribution" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small">Pension (R)</label>
                                    <input type="number" step="0.01" name="pension" class="form-control form-control-sm" value="@Model.PensionContribution" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small">Advance Recovery (R)</label>
                                    <input type="number" step="0.01" name="advance" class="form-control form-control-sm" value="@Model.AdvanceRecovery" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small">Other Deductions (R)</label>
                                    <input type="number" step="0.01" name="otherDed" class="form-control form-control-sm" value="@Model.OtherDeductions" />
                                    <input type="text" name="deductionNotes" class="form-control form-control-sm mt-1" placeholder="Deduction notes" value="@Model.DeductionNotes" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small">Other Additions (R)</label>
                                    <input type="number" step="0.01" name="otherAdd" class="form-control form-control-sm" value="@Model.OtherAdditions" />
                                    <input type="text" name="additionNotes" class="form-control form-control-sm mt-1" placeholder="Addition notes" value="@Model.AdditionNotes" />
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="btn btn-sm btn-primary">
                                        <i class="fa-solid fa-save me-1"></i> Save &amp; Recalculate
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-semibold">Period &amp; Payment</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="text-muted small">Pay Period</div>
                            <div>@Model.PayPeriodStart.ToString("dd MMM yyyy") – @Model.PayPeriodEnd.ToString("dd MMM yyyy")</div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted small">Bank Account</div>
                            <div>@(string.IsNullOrEmpty(Model.BankAccount) ? "—" : Model.BankAccount)</div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted small">Payment Method</div>
                            <div>@(Model.PaymentMethod ?? "—")</div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted small">Payment Date</div>
                            <div>@(Model.PaymentDate.HasValue ? Model.PaymentDate.Value.ToString("dd MMM yyyy") : "—")</div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.Notes))
                        {
                            <div class="col-12">
                                <div class="text-muted small">Notes</div>
                                <div>@Model.Notes</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white fw-semibold">Actions</div>
                <div class="card-body d-grid gap-2">
                    @if (Model.CanCalculate)
                    {
                        using (Html.BeginForm("Calculate", "Payroll", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-info w-100" @(Model.HasBlocker ? "disabled" : "")>
                                <i class="fa-solid fa-calculator me-1"></i>
                                @(Model.Status == "Calculated" ? "Recalculate" : "Calculate")
                            </button>
                        }
                        if (Model.HasBlocker)
                        {
                            <div class="text-danger small text-center">Cannot calculate due to validation blockers.</div>
                        }
                    }

                    @if (Model.CanApprove)
                    {
                        using (Html.BeginForm("Approve", "Payroll", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-primary w-100"
                                    onclick="return confirm('Approve this payroll for payment processing?');">
                                <i class="fa-solid fa-check me-1"></i> Approve
                            </button>
                        }
                    }

                    @if (Model.CanProcess)
                    {
                        <a href="@Url.Action("Process", new { id = Model.Id })" class="btn btn-warning w-100">
                            <i class="fa-solid fa-credit-card me-1"></i> Process Payment
                        </a>
                    }

                    @if (Model.CanMarkPaid)
                    {
                        using (Html.BeginForm("MarkPaid", "Payroll", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-success w-100"
                                    onclick="return confirm('Mark this payroll as Paid and notify the staff member?');">
                                <i class="fa-solid fa-circle-check me-1"></i> Mark as Paid
                            </button>
                        }
                    }

                    @if (!Model.CanCalculate && !Model.CanApprove && !Model.CanProcess && !Model.CanMarkPaid)
                    {
                        <p class="text-muted small mb-0">No further actions available for this status.</p>
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-semibold">Audit Trail</div>
                <div class="card-body small">
                    <dl class="row mb-0">
                        <dt class="col-5 text-muted">Calculated by</dt>
                        <dd class="col-7">@(Model.CalculatedBy ?? "—")</dd>
                        <dt class="col-5 text-muted">Approved by</dt>
                        <dd class="col-7">
                            @(Model.ApprovedBy ?? "—")
                            @if (Model.ApprovalDate.HasValue)
                            {
                                <span class="text-muted">(@Model.ApprovalDate.Value.ToString("dd MMM yyyy HH:mm"))</span>
                            }
                        </dd>
                        <dt class="col-5 text-muted">Processed by</dt>
                        <dd class="col-7">
                            @(Model.ProcessedBy ?? "—")
                            @if (Model.ProcessedDate.HasValue)
                            {
                                <span class="text-muted">(@Model.ProcessedDate.Value.ToString("dd MMM yyyy HH:mm"))</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>