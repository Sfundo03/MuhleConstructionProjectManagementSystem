@model MuhleOP.ViewModels.CreateDutyRosterViewModel
@{
    var isRevise = Model is MuhleOP.ViewModels.ReviseRosterViewModel;
    ViewBag.Title = isRevise ? "Revise Duty Roster" : "Create Duty Roster";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">@ViewBag.Title</h2>
        <p class="text-muted mb-0">
            @(isRevise
                ? "Adjust the period, crew and defaults — shifts will be regenerated for the new version."
                : "Select project, period and crew. Shifts are generated automatically for each day.")
        </p>
    </div>
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">Back</a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}

@* Server-side validation summary *@
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul class="mb-0">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                if (!string.IsNullOrWhiteSpace(err.ErrorMessage))
                {
                    <li>@err.ErrorMessage</li>
                }
            }
        </ul>
    </div>
}

@using (Html.BeginForm(isRevise ? "Revise" : "Create", "DutyRoster", FormMethod.Post, new { id = "rosterForm" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.SubmitAction, new { id = "SubmitActionField" })
    if (isRevise)
    {
        var rev = (MuhleOP.ViewModels.ReviseRosterViewModel)Model;
        <input type="hidden" name="ParentRosterId" value="@rev.ParentRosterId" />
        <input type="hidden" name="Version" value="@rev.Version" />
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent fw-semibold">1. Project &amp; period</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label">@Html.DisplayNameFor(m => m.ProjectId)</label>
                    @Html.DropDownListFor(m => m.ProjectId, Model.Projects, "-- Select Project --", new { @class = "form-select", id = "ProjectId" })
                    @Html.ValidationMessageFor(m => m.ProjectId, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Html.DisplayNameFor(m => m.PeriodStart)</label>
                    @Html.TextBoxFor(m => m.PeriodStart, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", id = "PeriodStart" })
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Html.DisplayNameFor(m => m.PeriodEnd)</label>
                    @Html.TextBoxFor(m => m.PeriodEnd, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", id = "PeriodEnd" })
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.WeekdaysOnly, new { @class = "form-check-input", id = "WeekdaysOnly" })
                        <label class="form-check-label" for="WeekdaysOnly">@Html.DisplayNameFor(m => m.WeekdaysOnly)</label>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label">@Html.DisplayNameFor(m => m.Notes)</label>
                    @Html.TextAreaFor(m => m.Notes, new { @class = "form-control", rows = 2 })
                </div>
            </div>
            <div id="periodConflictAlert" class="alert alert-warning mt-3 mb-0 d-none"></div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent fw-semibold">2. Default shift settings (applied to every generated day)</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-2">
                    <label class="form-label">@Html.DisplayNameFor(m => m.DefaultStartTime)</label>
                    @Html.TextBoxFor(m => m.DefaultStartTime, new { @class = "form-control", type = "time", id = "DefaultStartTime" })
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Html.DisplayNameFor(m => m.DefaultEndTime)</label>
                    @Html.TextBoxFor(m => m.DefaultEndTime, new { @class = "form-control", type = "time", id = "DefaultEndTime" })
                </div>
                <div class="col-md-4">
                    <label class="form-label">@Html.DisplayNameFor(m => m.DefaultShiftRole)</label>
                    @Html.DropDownListFor(m => m.DefaultShiftRole, new SelectList(new[] {
                        "General Labour", "Crane Operator", "Forklift Operator", "Electrician",
                        "Scaffolding Erector", "Site Supervisor", "Labourer"
                    }, Model.DefaultShiftRole), new { @class = "form-select" })
                </div>
                <div class="col-md-4">
                    <label class="form-label">@Html.DisplayNameFor(m => m.DefaultSiteLocation)</label>
                    @Html.TextBoxFor(m => m.DefaultSiteLocation, new { @class = "form-control", placeholder = "e.g. Gate 2" })
                </div>
            </div>
            <p class="form-text mb-0 mt-2">
                One shift is created for each day in the period (respecting weekdays-only). All selected crew are assigned to every shift.
            </p>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
            <span class="fw-semibold">3. Select crew members (assigned to this project only)</span>
            <div>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="selectAllCrew">Select all</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="clearAllCrew">Clear</button>
            </div>
        </div>
        <div class="card-body">
            <div id="crewLoading" class="text-muted d-none"><i class="fas fa-spinner fa-spin me-1"></i> Loading crew…</div>
            <div id="crewEmpty" class="text-muted @(Model.AvailableStaff != null && Model.AvailableStaff.Any() ? "d-none" : "")">
                Select a project to load assigned crew members.
            </div>
            <div id="crewList" class="row g-2">
                @if (Model.AvailableStaff != null)
                {
                    foreach (var c in Model.AvailableStaff)
                    {
                        <div class="col-md-4 col-lg-3">
                            <div class="form-check border rounded p-2 h-100">
                                <input class="form-check-input crew-cb" type="checkbox" name="SelectedStaffIds" value="@c.StaffId"
                                       id="crew_@c.StaffId" @(c.IsSelected ? "checked" : "") />
                                <label class="form-check-label" for="crew_@c.StaffId">
                                    <span class="fw-semibold d-block">@c.FullName</span>
                                    <span class="small text-secondary">@c.Role@(string.IsNullOrEmpty(c.EmployeeId) ? "" : " · " + c.EmployeeId)</span>
                                </label>
                            </div>
                        </div>
                    }
                }
            </div>
            @Html.ValidationMessageFor(m => m.SelectedStaffIds, "", new { @class = "text-danger d-block mt-2" })
            <div class="mt-2 small text-secondary">
                Selected: <strong id="crewSelectedCount">0</strong>
                &middot; Estimated shifts: <strong id="estimatedShifts">0</strong>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mb-4">
        <button type="submit" id="btnSaveDraft" class="btn btn-secondary">
            <i class="fas fa-save me-1"></i> Save as Draft
        </button>
        <button type="submit" id="btnPublish" class="btn btn-primary">
            <i class="fas fa-paper-plane me-1"></i> Publish
        </button>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        function countWeekdays(startStr, endStr, weekdaysOnly) {
            if (!startStr || !endStr) return 0;
            var start = new Date(startStr + 'T00:00:00');
            var end = new Date(endStr + 'T00:00:00');
            if (end < start) return 0;
            var n = 0;
            for (var d = new Date(start); d <= end; d.setDate(d.getDate() + 1)) {
                var day = d.getDay(); // 0 Sun .. 6 Sat
                if (weekdaysOnly && (day === 0 || day === 6)) continue;
                n++;
            }
            return n;
        }

        function updateCounts() {
            var selected = $('.crew-cb:checked').length;
            $('#crewSelectedCount').text(selected);
            var days = countWeekdays($('#PeriodStart').val(), $('#PeriodEnd').val(), $('#WeekdaysOnly').is(':checked'));
            $('#estimatedShifts').text(days);
        }

        function loadCrew(projectId) {
            var $list = $('#crewList');
            var $empty = $('#crewEmpty');
            var $loading = $('#crewLoading');

            if (!projectId) {
                $list.empty();
                $empty.removeClass('d-none').text('Select a project to load assigned crew members.');
                updateCounts();
                return;
            }

            $loading.removeClass('d-none');
            $empty.addClass('d-none');
            $list.empty();

            $.get('@Url.Action("GetAssignedCrew")', { projectId: projectId })
                .done(function (data) {
                    $loading.addClass('d-none');
                    if (!data || !data.length) {
                        $empty.removeClass('d-none').text('No active Crew Members are assigned to this project.');
                        updateCounts();
                        return;
                    }
                    $empty.addClass('d-none');
                    data.forEach(function (c) {
                        var id = 'crew_' + c.StaffId;
                        var html = '<div class="col-md-4 col-lg-3">' +
                            '<div class="form-check border rounded p-2 h-100">' +
                            '<input class="form-check-input crew-cb" type="checkbox" name="SelectedStaffIds" value="' + c.StaffId + '" id="' + id + '" />' +
                            '<label class="form-check-label" for="' + id + '">' +
                            '<span class="fw-semibold d-block">' + $('<div>').text(c.FullName).html() + '</span>' +
                            '<span class="small text-secondary">' + $('<div>').text(c.Role + (c.EmployeeId ? ' · ' + c.EmployeeId : '')).html() + '</span>' +
                            '</label></div></div>';
                        $list.append(html);
                    });
                    updateCounts();
                })
                .fail(function () {
                    $loading.addClass('d-none');
                    $empty.removeClass('d-none').text('Failed to load crew.');
                });
        }

        $('#ProjectId').on('change', function () {
            loadCrew($(this).val());
        });

        $('#PeriodStart, #PeriodEnd, #WeekdaysOnly').on('change', updateCounts);
        $(document).on('change', '.crew-cb', updateCounts);

        $('#selectAllCrew').on('click', function () {
            $('.crew-cb').prop('checked', true);
            updateCounts();
        });
        $('#clearAllCrew').on('click', function () {
            $('.crew-cb').prop('checked', false);
            updateCounts();
        });

        $('#btnSaveDraft').on('click', function () { $('#SubmitActionField').val('SaveDraft'); });
        $('#btnPublish').on('click', function () { $('#SubmitActionField').val('Publish'); });

        // Initial
        updateCounts();
        var initialProject = $('#ProjectId').val();
        if (initialProject && $('#crewList .crew-cb').length === 0) {
            loadCrew(initialProject);
        }
    </script>
}