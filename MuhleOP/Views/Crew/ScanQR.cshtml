@* Views/Crew/ScanQR.cshtml *@
@model MuhleOP.ViewModels.ScanQrRequestViewModel
@{
    ViewBag.Title = "Scan Crew QR Code";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    .scan-page {
        max-width: 560px;
        margin: 0 auto;
        padding: 0 8px 40px;
        text-align: center;
    }

    .scan-title {
        font-size: 1.4rem;
        font-weight: 800;
        margin-bottom: 8px;
        color: var(--text-primary);
    }

    .scan-status {
        font-size: 0.95rem;
        font-weight: 600;
        padding: 8px 14px;
        border-radius: 6px;
        margin-bottom: 14px;
        background: var(--bg-hover);
        color: var(--text-secondary);
    }

        .scan-status.error {
            background: #f8d7da;
            color: #721c24;
        }

    [data-theme="dark"] .scan-status.error {
        background: #3a1a1a;
        color: #f5a3a3;
    }

    .scan-status.ready {
        background: rgba(28, 200, 138, 0.15);
        color: #1cc88a;
    }

    #reader {
        width: 100%;
        max-width: 500px;
        margin: 0 auto;
        border-radius: 10px;
        overflow: hidden;
        background: #000;
        min-height: 280px;
    }

        #reader video {
            width: 100% !important;
            border-radius: 10px;
        }

    .scan-hint {
        font-size: 0.85rem;
        color: var(--text-secondary);
        margin-top: 12px;
    }

    .scan-overlay {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: rgba(0,0,0,0.75);
    }

        .scan-overlay.success .overlay-card {
            background: #d4edda;
            border: 3px solid #1cc88a;
            color: #155724;
        }

    [data-theme="dark"] .scan-overlay.success .overlay-card {
        background: #1a3a2a;
        color: #b7eb8f;
        border-color: #1cc88a;
    }

    .scan-overlay.error .overlay-card {
        background: #f8d7da;
        border: 3px solid #e74a3b;
        color: #721c24;
    }

    [data-theme="dark"] .scan-overlay.error .overlay-card {
        background: #3a1a1a;
        color: #f5a3a3;
        border-color: #e74a3b;
    }

    .overlay-card {
        width: 100%;
        max-width: 420px;
        border-radius: 14px;
        padding: 36px 24px;
        text-align: center;
        box-shadow: 0 12px 40px rgba(0,0,0,0.35);
    }

        .overlay-card .big-icon {
            font-size: 3.5rem;
            line-height: 1;
            margin-bottom: 12px;
        }

        .overlay-card h2 {
            font-size: 1.5rem;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .overlay-card p {
            font-size: 1.15rem;
            font-weight: 600;
            margin-bottom: 20px;
            line-height: 1.4;
        }

        .overlay-card .btn {
            font-size: 1.05rem;
            padding: 12px 28px;
            min-width: 160px;
        }
</style>

<div class="scan-page">
    <h1 class="scan-title"><i class="fas fa-qrcode"></i> Scan Crew QR Code</h1>
    <div id="scanStatus" class="scan-status ready">Ready to scan</div>
    <div id="reader"></div>
    <p class="scan-hint">Point the camera at the crew member's QR code. Works on phone or desktop webcam.</p>
</div>

@* Anti-forgery token for AJAX POST *@
<form id="antiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<div id="resultOverlay" class="scan-overlay" style="display:none;" role="dialog" aria-modal="true">
    <div class="overlay-card">
        <div class="big-icon" id="overlayIcon"></div>
        <h2 id="overlayTitle"></h2>
        <p id="overlayMessage"></p>
        <button type="button" class="btn btn-success" id="overlayBtn">Scan Next</button>
    </div>
</div>

@section scripts {
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
    <script>
        (function () {
            'use strict';

            var html5QrCode = null;
            var scanning = false;
            var lastScanAt = 0;

            function getAntiForgeryToken() {
                var input = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]');
                return input ? input.value : '';
            }

            function setStatus(text, isError) {
                var el = document.getElementById('scanStatus');
                el.textContent = text;
                el.className = 'scan-status' + (isError ? ' error' : ' ready');
            }

            function showOverlay(success, title, message) {
                var overlay = document.getElementById('resultOverlay');
                overlay.className = 'scan-overlay ' + (success ? 'success' : 'error');
                document.getElementById('overlayIcon').textContent = success ? '✓' : '✕';
                document.getElementById('overlayTitle').textContent = title;
                document.getElementById('overlayMessage').textContent = message;
                document.getElementById('overlayBtn').textContent = success ? 'Scan Next' : 'Try Again';
                document.getElementById('overlayBtn').className = success ? 'btn btn-success' : 'btn btn-danger';
                overlay.style.display = 'flex';

                if (success && navigator.vibrate) {
                    try { navigator.vibrate(200); } catch (e) { /* ignore */ }
                }
            }

            function hideOverlay() {
                document.getElementById('resultOverlay').style.display = 'none';
            }

            function stopScanner() {
                if (html5QrCode && scanning) {
                    html5QrCode.stop().then(function () {
                        scanning = false;
                    }).catch(function () {
                        scanning = false;
                    });
                }
            }

            function startScanner() {
                if (scanning) return;
                setStatus('Scanning…', false);

                html5QrCode = new Html5Qrcode('reader');
                var config = {
                    fps: 10,
                    qrbox: { width: 250, height: 250 },
                    aspectRatio: 1.0
                };

                html5QrCode.start(
                    { facingMode: 'environment' },
                    config,
                    onScanSuccess,
                    function () { /* ignore frame errors */ }
                ).then(function () {
                    scanning = true;
                    setStatus('Ready to scan', false);
                }).catch(function (err) {
                    console.error('Camera start failed', err);
                    setStatus('Camera access denied or unavailable. Allow camera permissions and reload.', true);
                });
            }

            function onScanSuccess(decodedText) {
                var now = Date.now();
                if (now - lastScanAt < 2500) return;
                lastScanAt = now;

                stopScanner();
                setStatus('Processing…', false);

                var token = getAntiForgeryToken();
                var body = new URLSearchParams();
                body.append('Payload', decodedText);
                body.append('__RequestVerificationToken', token);

                fetch('/Crew/ScanQR', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: body.toString(),
                    credentials: 'same-origin'
                })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (data && data.success) {
                            showOverlay(true, data.action === 'ClockIn' ? 'Clocked In' : 'Clocked Out', data.message || '');
                        } else {
                            showOverlay(false, 'Scan Failed', (data && data.message) ? data.message : 'Unknown error.');
                        }
                    })
                    .catch(function (err) {
                        console.error(err);
                        showOverlay(false, 'Scan Failed', 'Network or server error. Please try again.');
                    });
            }

            document.addEventListener('DOMContentLoaded', function () {
                document.getElementById('overlayBtn').addEventListener('click', function () {
                    hideOverlay();
                    startScanner();
                });
                document.getElementById('resultOverlay').addEventListener('click', function (e) {
                    if (e.target === this) {
                        hideOverlay();
                        startScanner();
                    }
                });
                startScanner();
            });
        })();
    </script>
}