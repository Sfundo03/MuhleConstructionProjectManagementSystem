@* Views/Crew/ClockInOut.cshtml *@
@model MuhleOP.ViewModels.ClockInOutViewModel
@{
    ViewBag.Title = Model.Action == "ClockIn" ? "Clock In" : "Clock Out";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    .clock-card {
        max-width: 480px;
        margin: 0 auto;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        padding: 28px 24px 32px;
        text-align: center;
    }

    [data-theme="dark"] .clock-card {
        background: var(--bg-card);
        box-shadow: 0 4px 24px rgba(0,0,0,0.3);
    }

    .clock-mode {
        font-size: 1.5rem;
        font-weight: 800;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
        color: var(--text-primary);
    }

        .clock-mode.in {
            color: #1cc88a;
        }

        .clock-mode.out {
            color: #e74a3b;
        }

    #qrImg {
        width: 100%;
        max-width: 360px;
        height: auto;
        background: #fff;
        border-radius: 8px;
        margin: 16px auto;
        display: block;
        border: 4px solid #f0f0f0;
    }

    .clock-meta {
        font-size: 0.95rem;
        color: var(--text-secondary);
        margin-top: 12px;
        line-height: 1.6;
    }

        .clock-meta strong {
            color: var(--text-primary);
        }

    .live-time {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 8px 0;
        font-variant-numeric: tabular-nums;
    }

    .countdown {
        font-size: 0.85rem;
        color: var(--text-secondary);
        margin-bottom: 16px;
    }

    .location-note {
        font-size: 0.8rem;
        color: #f6c23e;
        margin-top: 6px;
    }

    .success-card {
        max-width: 480px;
        margin: 40px auto;
        background: #d4edda;
        border: 2px solid #1cc88a;
        border-radius: 12px;
        padding: 40px 28px;
        text-align: center;
    }

    [data-theme="dark"] .success-card {
        background: #1a3a2a;
        border-color: #1cc88a;
    }

    .success-card .big-check {
        font-size: 4rem;
        color: #1cc88a;
        line-height: 1;
        margin-bottom: 12px;
    }

    .success-card h2 {
        font-size: 1.5rem;
        font-weight: 800;
        color: #155724;
        margin-bottom: 8px;
    }

    [data-theme="dark"] .success-card h2 {
        color: #b7eb8f;
    }

    .success-card p {
        font-size: 1.1rem;
        color: #155724;
    }

    [data-theme="dark"] .success-card p {
        color: #b7eb8f;
    }
</style>

<div id="clockContainer">
    <div class="clock-card">
        <div class="clock-mode @(Model.Action == "ClockIn" ? "in" : "out")">
            @(Model.Action == "ClockIn" ? "CLOCK IN" : "CLOCK OUT")
        </div>
        <p class="mb-1" style="color:var(--text-secondary);font-size:0.9rem;">
            Show this QR code to Admin / Site Manager
        </p>

        <img id="qrImg" alt="Clock QR Code" width="360" height="360" />

        <div id="locationNote" class="location-note" style="display:none;">
            <i class="fas fa-map-marker-alt"></i> Location unavailable
        </div>

        <div class="live-time" id="liveTime">--:--:--</div>
        <div class="countdown" id="countdown">QR expires in 5:00</div>

        <div class="clock-meta">
            <strong>@Model.StaffName</strong><br />
            Project: @Model.ProjectName<br />
            @if (Model.Action == "ClockOut" && Model.ClockInTime.HasValue)
            {
                <text>Clocked in at: @Model.ClockInTime.Value.ToString(@"hh\:mm")</text><br />
            }
            Week so far: @Model.WeeklyHoursSummary
        </div>

        <button type="button" class="btn btn-outline-secondary mt-3" id="btnRefresh" onclick="window.location.reload();">
            <i class="fas fa-sync-alt"></i> Refresh QR
        </button>
    </div>
</div>

<div id="successContainer" style="display:none;">
    <div class="success-card">
        <div class="big-check">✓</div>
        <h2 id="successTitle"></h2>
        <p id="successMessage"></p>
        <a href="@Url.Action("Dashboard", "Home")" class="btn btn-success mt-3">
            <i class="fas fa-home"></i> Back to Dashboard
        </a>
    </div>
</div>

@section scripts {
    <script>
(function () {
    'use strict';

    var staffId = @Model.StaffId;
    var staffName = @Html.Raw(Json.Encode(Model.StaffName));
    var action = @Html.Raw(Json.Encode(Model.Action));
    var token = @Html.Raw(Json.Encode(Model.Token));
    var timesheetEntryId = @(Model.TimesheetEntryId.HasValue ? Model.TimesheetEntryId.Value.ToString() : "null");
    var expiresAt = Date.now() + 5 * 60 * 1000;
    var pollTimer = null;
    var countdownTimer = null;
    var geo = { lat: null, lng: null, accuracy: null };

    function pad(n) { return n < 10 ? '0' + n : '' + n; }

    function updateLiveTime() {
        var d = new Date();
        document.getElementById('liveTime').textContent =
            pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
    }

    function updateCountdown() {
        var remaining = Math.max(0, Math.floor((expiresAt - Date.now()) / 1000));
        var m = Math.floor(remaining / 60);
        var s = remaining % 60;
        document.getElementById('countdown').textContent = 'QR expires in ' + m + ':' + pad(s);
        if (remaining <= 0) {
            document.getElementById('countdown').textContent = 'QR expired — please refresh';
            document.getElementById('countdown').style.color = '#e74a3b';
        }
    }

    function buildPayload() {
        return {
            action: action,
            staffId: staffId,
            staffName: staffName,
            lat: geo.lat,
            lng: geo.lng,
            accuracy: geo.accuracy,
            timestamp: new Date().toISOString(),
            token: token,
            timesheetEntryId: timesheetEntryId
        };
    }

    function renderQr() {
        var json = JSON.stringify(buildPayload());
        var encoded = encodeURIComponent(json);
        document.getElementById('qrImg').src =
            'https://api.qrserver.com/v1/create-qr-code/?size=400x400&data=' + encoded;
    }

    function requestGeo() {
        if (!navigator.geolocation) {
            document.getElementById('locationNote').style.display = 'block';
            renderQr();
            return;
        }
        navigator.geolocation.getCurrentPosition(
            function (pos) {
                geo.lat = pos.coords.latitude;
                geo.lng = pos.coords.longitude;
                geo.accuracy = pos.coords.accuracy;
                renderQr();
            },
            function () {
                document.getElementById('locationNote').style.display = 'block';
                renderQr();
            },
            { enableHighAccuracy: true, timeout: 8000, maximumAge: 30000 }
        );
    }

    function pollStatus() {
        fetch('/Crew/ClockInOutStatus?token=' + encodeURIComponent(token), {
            method: 'GET',
            headers: { 'Accept': 'application/json' },
            credentials: 'same-origin'
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (data && data.scanned === true) {
                clearInterval(pollTimer);
                clearInterval(countdownTimer);
                document.getElementById('clockContainer').style.display = 'none';
                document.getElementById('successContainer').style.display = 'block';
                document.getElementById('successTitle').textContent =
                    data.action === 'ClockIn' ? 'Clocked In' : 'Clocked Out';
                document.getElementById('successMessage').textContent = data.message || '';
            }
        })
        .catch(function (err) {
            console.error('Poll error', err);
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        updateLiveTime();
        setInterval(updateLiveTime, 1000);
        updateCountdown();
        countdownTimer = setInterval(updateCountdown, 1000);
        requestGeo();
        pollTimer = setInterval(pollStatus, 3000);
    });
})();
    </script>
}