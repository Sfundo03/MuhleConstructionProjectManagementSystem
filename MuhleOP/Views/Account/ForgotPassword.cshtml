﻿@model MuhleOP.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - MuhleOps</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        :root {
            --charcoal: #14181D;
            --slate-panel: #1B222B;
            --amber: #FDB813;
            --amber-deep: #D99A00;
            --concrete: #F1EFEA;
            --concrete-line: #DBD8CF;
            --ink: #14181D;
            --steel-gray: #69727C;
            --danger: #C0392B;
            --success: #27AE60;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            font-family: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: var(--charcoal);
        }

        .forgot-hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
            background: linear-gradient(135deg, var(--charcoal) 0%, var(--slate-panel) 100%);
            position: relative;
            overflow: hidden;
        }

            .forgot-hero::before {
                content: "";
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(253,184,19,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(253,184,19,0.03) 1px, transparent 1px);
                background-size: 48px 48px;
                pointer-events: none;
            }

            .forgot-hero::after {
                content: "";
                position: absolute;
                left: 0;
                bottom: 0;
                width: 60%;
                height: 60%;
                background: radial-gradient(ellipse at bottom left, rgba(253,184,19,0.08) 0%, rgba(253,184,19,0) 70%);
                pointer-events: none;
            }

        .forgot-card {
            max-width: 480px;
            width: 100%;
            background: var(--concrete);
            border-radius: 2px;
            box-shadow: 0 30px 70px rgba(0,0,0,0.5);
            padding: 50px 48px 40px;
            position: relative;
            z-index: 2;
        }

            .forgot-card::before {
                content: "";
                position: absolute;
                top: -11px;
                left: -11px;
                width: 22px;
                height: 22px;
                border-top: 2px solid var(--amber);
                border-left: 2px solid var(--amber);
            }

            .forgot-card::after {
                content: "";
                position: absolute;
                bottom: -11px;
                right: -11px;
                width: 22px;
                height: 22px;
                border-bottom: 2px solid var(--amber);
                border-right: 2px solid var(--amber);
            }

        .forgot-header {
            text-align: center;
            margin-bottom: 32px;
        }

            .forgot-header .brand {
                font-family: 'Barlow Condensed', sans-serif;
                font-weight: 900;
                font-size: 28px;
                letter-spacing: 0.5px;
                color: var(--charcoal);
                text-transform: uppercase;
            }

                .forgot-header .brand span {
                    color: var(--amber);
                }

            .forgot-header h1 {
                font-family: 'Barlow Condensed', sans-serif;
                font-size: 28px;
                font-weight: 800;
                text-transform: uppercase;
                color: var(--ink);
                margin-top: 8px;
                letter-spacing: 0.3px;
            }

            .forgot-header .subtitle {
                color: var(--steel-gray);
                font-size: 14px;
                font-family: 'IBM Plex Mono', monospace;
                margin-top: 4px;
            }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group label {
                display: block;
                font-size: 10.5px;
                font-weight: 600;
                letter-spacing: 1.3px;
                text-transform: uppercase;
                color: var(--ink);
                margin-bottom: 6px;
                font-family: 'IBM Plex Mono', monospace;
            }

        .input-wrap {
            display: flex;
            align-items: center;
            gap: 10px;
            border: 1px solid var(--concrete-line);
            border-radius: 2px;
            padding: 12px 14px;
            background: #ffffff;
            transition: border-color 0.15s ease;
        }

            .input-wrap:focus-within {
                border-color: var(--amber);
            }

            .input-wrap svg {
                flex-shrink: 0;
                color: var(--steel-gray);
            }

            .input-wrap input {
                border: none;
                outline: none;
                flex: 1;
                font-size: 14px;
                font-family: 'IBM Plex Sans', sans-serif;
                color: var(--ink);
                background: transparent;
            }

                .input-wrap input::placeholder {
                    color: #A9A49A;
                }

        .btn-reset {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 15px;
            background: var(--charcoal);
            color: var(--amber);
            border: none;
            border-radius: 2px;
            font-size: 12.5px;
            font-weight: 700;
            letter-spacing: 1.8px;
            text-transform: uppercase;
            cursor: pointer;
            font-family: 'IBM Plex Mono', monospace;
            transition: background 0.15s ease, color 0.15s ease;
            margin-top: 8px;
        }

            .btn-reset:hover {
                background: #05070a;
                color: #ffffff;
            }

        .login-link {
            text-align: center;
            margin-top: 18px;
            color: var(--steel-gray);
            font-size: 13px;
            font-family: 'IBM Plex Mono', monospace;
        }

            .login-link a {
                color: var(--amber);
                text-decoration: none;
                font-weight: 600;
                transition: color 0.15s ease;
            }

                .login-link a:hover {
                    color: var(--amber-deep);
                    text-decoration: underline;
                }

        .alert-success {
            background: rgba(39, 174, 96, 0.1);
            color: var(--success);
            padding: 12px 16px;
            border-radius: 2px;
            margin-bottom: 20px;
            border-left: 3px solid var(--success);
            font-size: 13px;
            font-family: 'IBM Plex Mono', monospace;
        }

        .alert-danger {
            background: rgba(192, 57, 43, 0.1);
            color: var(--danger);
            padding: 12px 16px;
            border-radius: 2px;
            margin-bottom: 20px;
            border-left: 3px solid var(--danger);
            font-size: 13px;
            font-family: 'IBM Plex Mono', monospace;
        }

        .text-danger {
            color: var(--danger);
            font-size: 12px;
            margin-top: 4px;
            display: block;
            font-family: 'IBM Plex Mono', monospace;
        }

        .site-bar {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            z-index: 3;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 26px 40px 0 40px;
        }

        .site-mark {
            display: flex;
            align-items: baseline;
            gap: 8px;
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 800;
            font-size: 20px;
            letter-spacing: 0.5px;
            color: #ffffff;
            text-transform: uppercase;
        }

            .site-mark span {
                color: var(--amber);
            }

        .site-status {
            display: flex;
            align-items: center;
            gap: 8px;
            font-family: 'IBM Plex Mono', monospace;
            font-size: 11px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.65);
        }

            .site-status .dot {
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: #3FCB6C;
                box-shadow: 0 0 0 0 rgba(63,203,108,0.6);
                animation: pulse 2.2s infinite;
            }

        @@keyframes pulse {
            0% {
                box-shadow: 0 0 0 0 rgba(63,203,108,0.55);
            }

            70% {
                box-shadow: 0 0 0 8px rgba(63,203,108,0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(63,203,108,0);
            }
        }

        @@media (max-width: 768px) {
            .forgot-card {
                padding: 30px 20px;
                margin-top: 60px;
            }

                .forgot-card::before,
                .forgot-card::after {
                    display: none;
                }

            .site-bar {
                padding: 18px 20px 0 20px;
            }

            .site-mark {
                font-size: 16px;
            }

            .forgot-header h1 {
                font-size: 22px;
            }
        }
    </style>
</head>
<body>
    <div class="forgot-hero">
        <div class="site-bar">
            <div class="site-mark">MUHLE<span>OPS</span></div>
            <div class="site-status"><span class="dot"></span> Secure Portal</div>
        </div>

        <div class="forgot-card">
            <div class="forgot-header">
                <div class="brand">Muhle<span>Ops</span></div>
                <h1>Reset Password</h1>
                <p class="subtitle">// ENTER YOUR EMAIL TO RESET YOUR PASSWORD</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert-success">
                    <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert-danger">
                    <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
                </div>
            }

            @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { role = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="form-group">
                    @Html.LabelFor(m => m.Email)
                    <div class="input-wrap">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                        @Html.TextBoxFor(m => m.Email, new { placeholder = "Enter your email address" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                    <small class="text-muted" style="display:block;font-size:11px;color:var(--steel-gray);margin-top:4px;font-family:'IBM Plex Mono',monospace;">
                        We'll send you a link to reset your password
                    </small>
                </div>

                <button type="submit" class="btn-reset">
                    <i class="fas fa-paper-plane"></i>
                    Send Reset Link
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                    </svg>
                </button>
            }

            <div class="login-link">
                Remember your password? <a href="@Url.Action("Login", "Account")">Login here</a>
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
</body>
</html>
