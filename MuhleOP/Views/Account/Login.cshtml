@using MuhleOP.Models
@model LoginViewModel
@{
    ViewBag.Title = "Log in";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - MuhleOps</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --charcoal: #14181D;
            --slate-panel: #1B222B;
            --steel-line: #3A4756;
            --amber: #FDB813;
            --amber-deep: #D99A00;
            --concrete: #F1EFEA;
            --concrete-line: #DBD8CF;
            --ink: #14181D;
            --steel-gray: #69727C;
            --danger: #C0392B;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            font-family: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }

        /* ============ HERO / SITE BACKDROP ============ */

        .login-hero {
            position: relative;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background-image: linear-gradient(100deg, rgba(10,9,8,0.82) 0%, rgba(10,9,8,0.55) 45%, rgba(10,9,8,0.35) 100%), url('@Url.Content("~/Content/images/login-hero.jpg")');
            background-size: cover;
            background-position: center;
        }

        /* subtle blueprint grid laid over the photo, never touching the image rule above */
        .login-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(253,184,19,0.06) 1px, transparent 1px),
                linear-gradient(90deg, rgba(253,184,19,0.06) 1px, transparent 1px);
            background-size: 48px 48px;
            pointer-events: none;
            z-index: 1;
        }

        .login-hero::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: 0;
            width: 55%;
            height: 55%;
            background: radial-gradient(ellipse at bottom left, rgba(253,184,19,0.16) 0%, rgba(253,184,19,0) 70%);
            pointer-events: none;
            z-index: 1;
        }

        /* ============ TOP STATUS BAR ============ */

        .site-bar {
            position: relative;
            z-index: 3;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 26px 90px 0 90px;
        }

        .site-mark {
            display: flex;
            align-items: baseline;
            gap: 8px;
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 800;
            font-size: 22px;
            letter-spacing: 0.5px;
            color: #ffffff;
            text-transform: uppercase;
        }

        .site-mark span {
            color: var(--amber);
        }

        .site-status {
            display: flex;
            align-items: center;
            gap: 8px;
            font-family: 'IBM Plex Mono', monospace;
            font-size: 11px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.65);
        }

        .site-status .dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #3FCB6C;
            box-shadow: 0 0 0 0 rgba(63,203,108,0.6);
            animation: pulse 2.2s infinite;
        }

        @@keyframes pulse {
            0% { box-shadow: 0 0 0 0 rgba(63,203,108,0.55); }
            70% { box-shadow: 0 0 0 8px rgba(63,203,108,0); }
            100% { box-shadow: 0 0 0 0 rgba(63,203,108,0); }
        }

        /* ============ MAIN SPLIT ============ */

        .hero-main {
            position: relative;
            z-index: 2;
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 70px;
            padding: 40px 90px 60px 90px;
        }

        .hero-content {
            max-width: 600px;
            margin-right: auto;
        }

        .hero-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-family: 'IBM Plex Mono', monospace;
            font-size: 12px;
            font-weight: 500;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--amber);
            border: 1px solid rgba(253,184,19,0.5);
            padding: 7px 14px;
            margin-bottom: 30px;
        }

        .hero-eyebrow::before {
            content: "";
            width: 6px;
            height: 6px;
            background: var(--amber);
        }

        .hero-heading {
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 900;
            font-size: 58px;
            line-height: 1.02;
            color: #ffffff;
            margin: 0 0 24px 0;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .hero-heading .accent {
            color: var(--amber);
        }

        .hero-desc {
            color: rgba(255,255,255,0.75);
            font-size: 15px;
            line-height: 1.75;
            max-width: 460px;
            margin: 0 0 48px 0;
        }

        /* blueprint-style callout stats: numbers pinned to a dashed leader line */
        .hero-specs {
            display: flex;
            gap: 0;
            max-width: 500px;
            border-top: 1px dashed rgba(255,255,255,0.3);
        }

        .hero-spec {
            flex: 1;
            padding: 20px 22px 0 0;
            border-right: 1px dashed rgba(255,255,255,0.3);
            position: relative;
        }

        .hero-spec:last-child {
            border-right: none;
        }

        .hero-spec::before {
            content: "";
            position: absolute;
            top: -1px;
            left: 0;
            width: 14px;
            height: 1px;
            background: var(--amber);
        }

        .hero-spec .num {
            display: block;
            font-family: 'IBM Plex Mono', monospace;
            font-weight: 600;
            font-size: 30px;
            color: var(--amber);
            line-height: 1;
            margin-bottom: 8px;
        }

        .hero-spec .label {
            display: block;
            font-size: 10.5px;
            font-weight: 500;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.6);
            font-family: 'IBM Plex Mono', monospace;
        }

        /* ============ LOGIN PANEL ============ */

        .login-panel-wrap {
            position: relative;
            flex-shrink: 0;
            width: 440px;
        }

        /* technical-drawing registration marks framing the panel */
        .login-panel-wrap::before,
        .login-panel-wrap::after,
        .login-card .corner-tl,
        .login-card .corner-br {
            content: "";
        }

        .crop {
            position: absolute;
            width: 22px;
            height: 22px;
            z-index: 3;
            pointer-events: none;
        }

        .crop-tl { top: -11px; left: -11px; border-top: 2px solid var(--amber); border-left: 2px solid var(--amber); }
        .crop-br { bottom: -11px; right: -11px; border-bottom: 2px solid var(--amber); border-right: 2px solid var(--amber); }

        .login-card {
            position: relative;
            z-index: 2;
            background: var(--concrete);
            border-radius: 2px;
            box-shadow: 0 30px 70px rgba(0,0,0,0.45);
            padding: 46px 42px 34px 42px;
        }

        .card-kicker {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 22px;
        }

        .card-kicker .tag {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 10.5px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--steel-gray);
        }

        .card-kicker .tag strong {
            color: var(--ink);
        }

        .login-card h1 {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: 30px;
            font-weight: 800;
            letter-spacing: 0.3px;
            text-transform: uppercase;
            color: var(--ink);
            margin: 0 0 6px 0;
        }

        .login-card .subtitle {
            font-size: 13px;
            color: var(--steel-gray);
            margin: 0 0 24px 0;
            font-family: 'IBM Plex Mono', monospace;
        }

        .field-group {
            margin-bottom: 18px;
        }

        .field-group label {
            display: block;
            font-size: 10.5px;
            font-weight: 600;
            letter-spacing: 1.3px;
            text-transform: uppercase;
            color: var(--ink);
            margin-bottom: 8px;
            font-family: 'IBM Plex Mono', monospace;
        }

        .input-wrap {
            display: flex;
            align-items: center;
            gap: 10px;
            border: 1px solid var(--concrete-line);
            border-radius: 2px;
            padding: 12px 14px;
            background: #ffffff;
            transition: border-color .15s ease;
        }

        .input-wrap:focus-within {
            border-color: var(--amber);
        }

        .input-wrap svg {
            flex-shrink: 0;
            color: var(--steel-gray);
        }

        .input-wrap input {
            border: none;
            outline: none;
            flex: 1;
            font-size: 14px;
            font-family: 'IBM Plex Sans', sans-serif;
            color: var(--ink);
            background: transparent;
        }

        .input-wrap input::placeholder {
            color: #A9A49A;
        }

        .btn-enter {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: var(--charcoal);
            color: var(--amber);
            border: none;
            border-radius: 2px;
            padding: 15px;
            font-size: 12.5px;
            font-weight: 700;
            letter-spacing: 1.8px;
            text-transform: uppercase;
            cursor: pointer;
            margin-top: 8px;
            font-family: 'IBM Plex Mono', monospace;
            transition: background .15s ease, color .15s ease;
        }

        .btn-enter:hover {
            background: #05070a;
            color: #ffffff;
        }

        .btn-secondary {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: transparent;
            color: var(--ink);
            border: 1px solid var(--concrete-line);
            border-radius: 2px;
            padding: 13px;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            cursor: pointer;
            margin-top: 10px;
            font-family: 'IBM Plex Mono', monospace;
            text-decoration: none;
            transition: border-color .15s ease, color .15s ease, background .15s ease;
        }

        .btn-secondary:hover {
            border-color: var(--amber-deep);
            color: var(--amber-deep);
            background: #ffffff;
        }

        .card-divider {
            border: none;
            border-top: 1px dashed var(--concrete-line);
            margin: 26px 0 18px 0;
        }

        .card-footer {
            font-size: 12.5px;
            color: var(--steel-gray);
            margin: 0;
        }

        .card-footer strong {
            color: var(--ink);
            font-weight: 700;
        }

        .validation-summary-errors {
            color: var(--danger);
            font-size: 13px;
            margin-bottom: 16px;
        }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 18px;
        }

        .field-validation-error {
            display: block;
            color: var(--danger);
            font-size: 12px;
            margin-top: 6px;
        }

        .text-danger {
            color: var(--danger);
        }

        @@media (max-width: 900px) {
            .site-bar {
                padding: 22px 24px 0 24px;
            }

            .hero-main {
                justify-content: center;
                padding: 32px 24px 40px 24px;
                flex-direction: column;
                gap: 36px;
            }

            .hero-content {
                text-align: center;
                margin-right: 0;
            }

            .hero-heading {
                font-size: 36px;
            }

            .hero-specs {
                justify-content: center;
                margin: 0 auto;
                text-align: left;
            }

            .login-panel-wrap {
                width: 100%;
                max-width: 440px;
            }
        }
    </style>
</head>
<body>
    <div class="login-hero">
        <div class="site-bar">
            <div class="site-mark">MUHLE<span>OPS</span></div>
            <div class="site-status"><span class="dot"></span> Site Systems Online</div>
        </div>

        <div class="hero-main">
            <div class="hero-content">
                <span class="hero-eyebrow">SYS&#8209;01 // Construction Operations Platform</span>
                <h1 class="hero-heading">
                    Every Site.<br />
                    Every Crew.<br />
                    <span class="accent">Every Rand<br />On The Books.</span>
                </h1>
                <p class="hero-desc">
                    MuhleOps replaces scattered spreadsheets with one control room for projects, people, plant and payments — from first job post to final handover.
                </p>
                <div class="hero-specs">
                    <div class="hero-spec">
                        <span class="num">10</span>
                        <span class="label">Business Processes</span>
                    </div>
                    <div class="hero-spec">
                        <span class="num">21</span>
                        <span class="label">Use Cases</span>
                    </div>
                    <div class="hero-spec">
                        <span class="num">08</span>
                        <span class="label">User Roles</span>
                    </div>
                </div>
            </div>

            <div class="login-panel-wrap">
                <span class="crop crop-tl"></span>
                <span class="crop crop-br"></span>
                <div class="login-card">
                    <div class="card-kicker">
                        <span class="tag">ACCESS <strong>// TERMINAL</strong></span>
                    </div>
                    <h1>Account Access</h1>
                    <p class="subtitle">Enter your credentials to continue.</p>

                    @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="field-group">
                            @Html.Label("", "Username", new { @for = "Email" })
                            <div class="input-wrap">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                                @Html.TextBoxFor(m => m.Email, new { @class = "", placeholder = "Enter your email" })
                            </div>
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-validation-error" })
                        </div>

                        <div class="field-group">
                            @Html.Label("", "Password", new { @for = "Password" })
                            <div class="input-wrap">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                                @Html.PasswordFor(m => m.Password, new { @class = "", placeholder = "••••••••" })
                            </div>
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
                        </div>

                        @Html.CheckBoxFor(m => m.RememberMe, new { style = "display:none;", @checked = "checked" })

                        <button type="submit" class="btn-enter">
                            Login
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
                        </button>

                        <a href="@Url.Action("ForgotPassword", "Account")" class="btn-secondary">Reset Password</a>
                        <a href="@Url.Action("Register", "Candidate")" class="btn-secondary">No Account? Register</a>
                    }

                    <hr class="card-divider" />
                    <p class="card-footer">
                        Lost your credentials? Contact your system administrator on <strong>064 8317 102</strong>.
                    </p>
                </div>
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/jqueryval")
</body>
</html>