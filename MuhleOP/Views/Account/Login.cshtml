﻿@using MuhleOP.Models
@model LoginViewModel
@{
    ViewBag.Title = "Log in";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - MuhleOps</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@800;900&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }

        .login-hero {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding: 0 90px;
            overflow: hidden;
            background-image: linear-gradient(100deg, rgba(10,9,8,0.82) 0%, rgba(10,9,8,0.55) 45%, rgba(10,9,8,0.35) 100%), url('@Url.Content("~/Content/images/login-hero.jpg")');
            background-size: cover;
            background-position: center;
        }

        .login-hero::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: 0;
            width: 55%;
            height: 60%;
            background: radial-gradient(ellipse at bottom left, rgba(245,166,35,0.28) 0%, rgba(245,166,35,0) 70%);
            pointer-events: none;
        }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 620px;
            padding-bottom: 40px;
        }

        .hero-badge {
            display: inline-block;
            border: 1px solid #F2A93B;
            color: #F2A93B;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 8px 16px;
            margin-bottom: 28px;
        }

        .hero-heading {
            font-family: 'Poppins', sans-serif;
            font-weight: 900;
            font-size: 50px;
            line-height: 1.08;
            color: #ffffff;
            margin: 0 0 22px 0;
            text-transform: uppercase;
        }

        .hero-heading .accent {
            color: #F5A623;
        }

        .hero-desc {
            color: rgba(255,255,255,0.78);
            font-size: 15px;
            line-height: 1.7;
            max-width: 480px;
            margin: 0 0 46px 0;
        }

        .hero-stats {
            display: flex;
            gap: 56px;
            border-top: 1px solid rgba(255,255,255,0.18);
            padding-top: 26px;
            max-width: 480px;
        }

        .hero-stat .num {
            display: block;
            font-family: 'Poppins', sans-serif;
            font-weight: 800;
            font-size: 32px;
            color: #F5A623;
            line-height: 1;
            margin-bottom: 6px;
        }

        .hero-stat .label {
            display: block;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.7);
        }

        .login-card {
            position: relative;
            z-index: 2;
            width: 460px;
            flex-shrink: 0;
            background: #ffffff;
            border-radius: 6px;
            box-shadow: 0 30px 70px rgba(0,0,0,0.4);
            padding: 44px 40px 36px 40px;
        }

        .login-card h1 {
            font-size: 21px;
            font-weight: 800;
            letter-spacing: 0.3px;
            color: #10151c;
            margin: 0 0 6px 0;
        }

        .login-card .subtitle {
            font-size: 13.5px;
            color: #6b7280;
            margin: 0 0 26px 0;
        }

        .register-links {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-top: 12px;
        }

        .register-links a {
            color: #4e73df;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            transition: color 0.15s ease;
        }

        .register-links a:hover {
            color: #2e59d9;
            text-decoration: underline;
        }

        .register-links .candidate-link {
            color: #1cc88a;
        }

        .register-links .candidate-link:hover {
            color: #17a673;
        }

        .field-group {
            margin-bottom: 20px;
        }

        .field-group label {
            display: block;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #374151;
            margin-bottom: 8px;
        }

        .input-wrap {
            display: flex;
            align-items: center;
            gap: 10px;
            border: 1px solid #E2E5EA;
            border-radius: 6px;
            padding: 11px 14px;
            background: #fff;
            transition: border-color .15s ease;
        }

        .input-wrap:focus-within {
            border-color: #F5A623;
        }

        .input-wrap svg {
            flex-shrink: 0;
            color: #9AA1AC;
        }

        .input-wrap input {
            border: none;
            outline: none;
            flex: 1;
            font-size: 14px;
            font-family: 'Inter', sans-serif;
            color: #10151c;
            background: transparent;
        }

        .input-wrap input::placeholder {
            color: #A6ACB6;
        }

        .btn-enter {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: #16202C;
            color: #ffffff;
            border: none;
            border-radius: 4px;
            padding: 15px;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            cursor: pointer;
            margin-top: 6px;
            font-family: 'Inter', sans-serif;
            transition: background .15s ease;
        }

        .btn-enter:hover {
            background: #0e1620;
        }

        .card-divider {
            border: none;
            border-top: 1px solid #ECEEF1;
            margin: 24px 0 18px 0;
        }

        .card-footer {
            font-size: 13px;
            color: #6b7280;
            margin: 0;
        }

        .card-footer strong {
            color: #10151c;
            font-weight: 700;
        }

        .validation-summary-errors {
            color: #d0392c;
            font-size: 13px;
            margin-bottom: 16px;
        }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 18px;
        }

        .field-validation-error {
            display: block;
            color: #d0392c;
            font-size: 12px;
            margin-top: 6px;
        }

        .text-danger {
            color: #d0392c;
        }

        .default-creds {
            background: #f8f9fa;
            padding: 12px 16px;
            border-radius: 6px;
            margin-bottom: 20px;
            border-left: 4px solid #F5A623;
            font-size: 12px;
        }

        .default-creds strong {
            color: #16202C;
        }

        @@media (max-width: 900px) {
            .login-hero {
                justify-content: center;
                padding: 24px;
                flex-direction: column;
                gap: 32px;
            }

            .hero-content {
                text-align: center;
                padding-bottom: 0;
            }

            .hero-heading {
                font-size: 34px;
            }

            .hero-stats {
                justify-content: center;
                margin: 0 auto;
            }

            .login-card {
                width: 100%;
                max-width: 460px;
            }
        }
    </style>
</head>
<body>
    <div class="login-hero">
        <div class="hero-content">
            <span class="hero-badge">Construction Operations Platform</span>
            <h1 class="hero-heading">
                Every Site,<br />
                Every Crew,<br />
                <span class="accent">Every Rand<br />Accounted For.</span>
            </h1>
            <p class="hero-desc">
                MuhleOps replaces scattered spreadsheets with one control room for projects, people, plant and payments — from first job post to final handover.
            </p>
            <div class="hero-stats">
                <div class="hero-stat">
                    <span class="num">10</span>
                    <span class="label">Business Processes</span>
                </div>
                <div class="hero-stat">
                    <span class="num">21</span>
                    <span class="label">Use Cases</span>
                </div>
                <div class="hero-stat">
                    <span class="num">8</span>
                    <span class="label">User Roles</span>
                </div>
            </div>
        </div>

        <div class="login-card">
            <h1>Sign In</h1>
            <p class="subtitle">Use the credentials issued to you by the Admin.</p>

            <div class="default-creds">
                <strong>Default Admin:</strong> admin@gmail.com / Admin123!
            </div>

            @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { role = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="field-group">
                    @Html.Label("", "Username", new { @for = "Email" })
                    <div class="input-wrap">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                        @Html.TextBoxFor(m => m.Email, new { @class = "", placeholder = "admin@gmail.com" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-validation-error" })
                </div>

                <div class="field-group">
                    @Html.Label("", "Password", new { @for = "Password" })
                    <div class="input-wrap">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                        @Html.PasswordFor(m => m.Password, new { @class = "", placeholder = "••••••••" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
                </div>

                @Html.CheckBoxFor(m => m.RememberMe, new { style = "display:none;", @checked = "checked" })

                <button type="submit" class="btn-enter">
                    Enter Dashboard
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
                </button>
            }

            <div class="register-links">
                <a href="@Url.Action("Register", "Account")">Register as a new user</a>
                <a href="@Url.Action("Register", "Candidate")" class="candidate-link">Register as a Candidate</a>
            </div>

            <hr class="card-divider" />
            <p class="card-footer">
                Lost your credentials? Contact your system administrator on <strong>064 8317 102</strong>.
            </p>
        </div>
    </div>

    @Scripts.Render("~/bundles/jqueryval")
</body>
</html>