﻿@{
    ViewBag.Title = "Account Locked";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - MuhleOps</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        :root {
            --charcoal: #14181D;
            --slate-panel: #1B222B;
            --amber: #FDB813;
            --concrete: #F1EFEA;
            --steel-gray: #69727C;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            font-family: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: var(--charcoal);
        }

        .lockout-hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
            background: linear-gradient(135deg, var(--charcoal) 0%, var(--slate-panel) 100%);
            position: relative;
            overflow: hidden;
        }

            .lockout-hero::before {
                content: "";
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(253,184,19,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(253,184,19,0.03) 1px, transparent 1px);
                background-size: 48px 48px;
                pointer-events: none;
            }

        .lockout-card {
            max-width: 480px;
            width: 100%;
            background: var(--concrete);
            border-radius: 2px;
            box-shadow: 0 30px 70px rgba(0,0,0,0.5);
            padding: 50px 48px 40px;
            position: relative;
            z-index: 2;
            text-align: center;
        }

            .lockout-card::before {
                content: "";
                position: absolute;
                top: -11px;
                left: -11px;
                width: 22px;
                height: 22px;
                border-top: 2px solid var(--amber);
                border-left: 2px solid var(--amber);
            }

            .lockout-card::after {
                content: "";
                position: absolute;
                bottom: -11px;
                right: -11px;
                width: 22px;
                height: 22px;
                border-bottom: 2px solid var(--amber);
                border-right: 2px solid var(--amber);
            }

        .lockout-icon {
            font-size: 64px;
            color: #e74a3b;
            margin-bottom: 20px;
        }

        .lockout-card h1 {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: 32px;
            font-weight: 800;
            text-transform: uppercase;
            color: var(--charcoal);
            margin-bottom: 10px;
        }

        .lockout-card .subtitle {
            color: var(--steel-gray);
            font-size: 14px;
            font-family: 'IBM Plex Mono', monospace;
            margin-bottom: 20px;
        }

        .lockout-card p {
            color: var(--steel-gray);
            font-size: 14px;
            line-height: 1.8;
            margin-bottom: 30px;
        }

        .btn-primary {
            display: inline-block;
            padding: 14px 40px;
            background: var(--charcoal);
            color: var(--amber);
            border: none;
            border-radius: 2px;
            font-size: 12.5px;
            font-weight: 700;
            letter-spacing: 1.8px;
            text-transform: uppercase;
            cursor: pointer;
            font-family: 'IBM Plex Mono', monospace;
            text-decoration: none;
            transition: background 0.15s ease, color 0.15s ease;
        }

            .btn-primary:hover {
                background: #05070a;
                color: #ffffff;
            }

        .site-bar {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            z-index: 3;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 26px 40px 0 40px;
        }

        .site-mark {
            display: flex;
            align-items: baseline;
            gap: 8px;
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 800;
            font-size: 20px;
            letter-spacing: 0.5px;
            color: #ffffff;
            text-transform: uppercase;
        }

            .site-mark span {
                color: var(--amber);
            }

        @@media (max-width: 768px) {
            .lockout-card {
                padding: 30px 20px;
                margin-top: 60px;
            }

                .lockout-card::before,
                .lockout-card::after {
                    display: none;
                }

            .site-bar {
                padding: 18px 20px 0 20px;
            }

            .site-mark {
                font-size: 16px;
            }

            .lockout-card h1 {
                font-size: 24px;
            }
        }
    </style>
</head>
<body>
    <div class="lockout-hero">
        <div class="site-bar">
            <div class="site-mark">MUHLE<span>OPS</span></div>
        </div>

        <div class="lockout-card">
            <div class="lockout-icon">
                <i class="fas fa-lock"></i>
            </div>
            <h1>Account Locked</h1>
            <p class="subtitle">// ACCESS RESTRICTED</p>
            <p>
                Your account has been temporarily locked due to multiple failed login attempts.
                Please try again later or contact your system administrator for assistance.
            </p>
            <a href="@Url.Action("Login", "Account")" class="btn-primary">
                <i class="fas fa-arrow-left"></i> Back to Login
            </a>
        </div>
    </div>
</body>
</html>