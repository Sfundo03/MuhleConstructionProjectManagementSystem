﻿@model MuhleOP.ViewModels.StaffViewModel
@{
    ViewBag.Title = "Edit Staff";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Edit Staff</h2>
        <p class="text-muted">
            <i class="fas fa-edit me-2"></i>
            Update staff member details
        </p>
    </div>
    <a href="@Url.Action("Index")" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back to Staff
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            @Html.HiddenFor(m => m.EmployeeId)
            @Html.HiddenFor(m => m.HireDate)

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.FirstName, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.LastName, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.LastName, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Email, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.PhoneNumber, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Role, new { @class = "form-label fw-bold" })
                        @Html.DropDownListFor(m => m.Role,
                            new SelectList(new[] { "Crew Member", "Project Manager", "Finance Officer", "Site Manager", "Procurement Officer" }),
                            "-- Select Role --",
                            new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.Role, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Department, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.Department, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Department, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.IsActive, new { @class = "form-label fw-bold" })
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", id = "IsActive" })
                            @Html.LabelFor(m => m.IsActive, new { @class = "form-check-label", @for = "IsActive" })
                        </div>
                        @Html.ValidationMessageFor(m => m.IsActive, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Employee ID</label>
                        <p class="form-control-static"><code>@Model.EmployeeId</code></p>
                    </div>
                </div>
            </div>

            <div class="alert alert-info mt-3">
                <i class="fas fa-info-circle me-2"></i>
                <strong>Note:</strong> Changes to the staff member's role may affect their system permissions.
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Update Staff
                </button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="fas fa-times"></i> Cancel
                </a>
            </div>
        }
    </div>
</div>

<style>
    .form-control, .form-select {
        font-size: 14px;
        padding: 10px 14px;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary-gold, #F5A623);
            box-shadow: 0 0 0 3px rgba(245, 166, 35, 0.1);
        }

    .form-control-static {
        padding: 10px 0;
        margin: 0;
        font-size: 14px;
    }

    code {
        background: var(--bg-hover);
        padding: 2px 6px;
        border-radius: 3px;
        font-size: 13px;
    }

    [data-theme="dark"] code {
        background: var(--bg-hover, #2d3748);
    }
</style>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}