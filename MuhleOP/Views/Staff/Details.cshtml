
@model MuhleOP.ViewModels.StaffViewModel
@{
    ViewBag.Title = "Staff Details";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Staff Details</h2>
    <div>
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Staff
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <div class="mb-3">
                    <div class="rounded-circle bg-gold d-flex align-items-center justify-content-center mx-auto" style="width:120px;height:120px;font-size:48px;color:#fff;font-weight:700;">
                        @Model.FullName.Substring(0, 1).ToUpper()
                    </div>
                </div>
                <h4>@Model.FullName</h4>
                <p class="text-muted">@Model.Role</p>
                <p class="text-muted"><i class="fas fa-envelope me-2"></i>@Model.Email</p>
                <p class="text-muted"><i class="fas fa-phone me-2"></i>@Model.PhoneNumber</p>
                <hr />
                <div class="text-start">
                    <h6 class="mb-3">Employment Details</h6>
                    <dl class="row">
                        <dt class="col-6">Employee ID</dt>
                        <dd class="col-6"><code>@Model.EmployeeId</code></dd>
                        <dt class="col-6">Department</dt>
                        <dd class="col-6">@Model.Department</dd>
                        <dt class="col-6">Hire Date</dt>
                        <dd class="col-6">@Model.HireDate.ToString("yyyy-MM-dd")</dd>
                        <dt class="col-6">Status</dt>
                        <dd class="col-6">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0">
                <h6 class="mb-0">Information</h6>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="text-muted small">Full Name</label>
                        <p class="fw-bold">@Model.FullName</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Email</label>
                        <p class="fw-bold">@Model.Email</p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="text-muted small">Role</label>
                        <p class="fw-bold">
                            <span class="badge bg-@GetRoleColor(Model.Role)">@Model.Role</span>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Phone Number</label>
                        <p class="fw-bold">@Model.PhoneNumber</p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="text-muted small">Employee ID</label>
                        <p class="fw-bold"><code>@Model.EmployeeId</code></p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Department</label>
                        <p class="fw-bold">@Model.Department</p>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <label class="text-muted small">Hire Date</label>
                        <p class="fw-bold">@Model.HireDate.ToString("yyyy-MM-dd")</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small">Status</label>
                        <p class="fw-bold">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gold {
        background-color: var(--primary-gold);
    }

    .badge {
        font-size: 11px;
        padding: 5px 10px;
    }

        .badge.bg-warning {
            color: #fff;
        }

        .badge.bg-info {
            color: #fff;
        }
</style>

@functions {
    public string GetRoleColor(string role)
    {
        switch (role)
        {
            case "Crew Member": return "primary";
            case "Project Manager": return "success";
            case "Finance Officer": return "warning";
            case "Site Manager": return "info";
            default: return "secondary";
        }
    }
}