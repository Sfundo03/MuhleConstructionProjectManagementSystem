﻿@model MuhleOP.ViewModels.CreateStaffViewModel
@{
    ViewBag.Title = "Hire Staff";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var candidateId = ViewBag.CandidateId;
    var applicationId = ViewBag.ApplicationId;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Hire Staff</h2>
        <p class="text-muted">
            <i class="fas fa-user-plus me-2"></i>
            @if (candidateId != null)
            {
                <text>Hire a candidate as a staff member</text>
            }
            else
            {
                <text>Create a new staff member account</text>
            }
        </p>
    </div>
    <a href="@Url.Action("Index")" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back to Staff
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        @if (candidateId != null)
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                <strong>Hiring from Candidate:</strong> This will create a staff account for the selected candidate. Login credentials will be sent to their email.
            </div>
        }

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            if (applicationId != null)
            {
                <input type="hidden" name="ApplicationId" value="@applicationId" />
            }

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.FirstName, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", placeholder = "e.g. John" })
                        @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.LastName, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", placeholder = "e.g. Doe" })
                        @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Email, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "john.doe@company.com" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.PhoneNumber, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "+27 82 123 4567" })
                        @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Role, new { @class = "form-label fw-bold" })
                        @Html.DropDownListFor(m => m.Role,
                            new SelectList(new[] { "Crew Member", "Project Manager", "Finance Officer", "Site Manager", "Procurement Officer" }),
                            "-- Select Role --",
                            new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.Role, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Department, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.Department, new { @class = "form-control", placeholder = "e.g. Construction" })
                        @Html.ValidationMessageFor(m => m.Department, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="alert alert-warning mt-3">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong>Note:</strong> A random password will be generated and sent to the staff member's email. They will be prompted to change it on first login.
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-user-plus"></i> Hire Staff
                </button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="fas fa-times"></i> Cancel
                </a>
            </div>
        }
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0">
                <h6 class="mb-0"><i class="fas fa-lightbulb text-gold me-2"></i>Staff Hiring Tips</h6>
            </div>
            <div class="card-body">
                <ul class="list-unstyled small">
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Verify the candidate's qualifications
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Ensure the email address is correct
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Assign the appropriate role
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Specify the correct department
                    </li>
                    <li>
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Login credentials will be sent via email
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<style>
    .text-gold {
        color: var(--primary-gold, #F5A623);
    }

    .form-control, .form-select {
        font-size: 14px;
        padding: 10px 14px;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary-gold, #F5A623);
            box-shadow: 0 0 0 3px rgba(245, 166, 35, 0.1);
        }
</style>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}