﻿@model MuhleOP.ViewModels.CreateStaffViewModel
@{
    ViewBag.Title = "Hire Candidate";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var candidateId = ViewBag.CandidateId;
    var applicationId = ViewBag.ApplicationId;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Hire Candidate</h2>
        <p class="text-muted">
            <i class="fas fa-user-check me-2"></i>
            Convert a successful candidate to a staff member
        </p>
    </div>
    <a href="@Url.Action("Index", "JobPost")" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back to Applications
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="alert alert-success">
            <i class="fas fa-star me-2"></i>
            <strong>Congratulations!</strong> This candidate has passed the interview and is ready to be hired.
        </div>

        @using (Html.BeginForm("Hire", "Staff", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="ApplicationId" value="@applicationId" />

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.FirstName, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", placeholder = "e.g. John" })
                        @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.LastName, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", placeholder = "e.g. Doe" })
                        @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Email, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "john.doe@company.com" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.PhoneNumber, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "+27 82 123 4567" })
                        @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Role, new { @class = "form-label fw-bold" })
                        @Html.DropDownListFor(m => m.Role,
                            new SelectList(new[] { "Crew Member", "Project Manager", "Finance Officer", "Site Manager", "Procurement Officer" }),
                            "-- Select Role --",
                            new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.Role, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Department, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.Department, new { @class = "form-control", placeholder = "e.g. Construction" })
                        @Html.ValidationMessageFor(m => m.Department, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="alert alert-info mt-3">
                <i class="fas fa-info-circle me-2"></i>
                <strong>Note:</strong> This will create a staff account for the candidate. Login credentials will be generated and sent to their email.
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-user-plus"></i> Hire Candidate
                </button>
                <a href="@Url.Action("ReviewApplications", "JobPost", new { id = ViewBag.JobPostId })" class="btn btn-secondary">
                    <i class="fas fa-times"></i> Cancel
                </a>
            </div>
        }
    </div>
</div>

<style>
    .form-control, .form-select {
        font-size: 14px;
        padding: 10px 14px;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary-gold, #F5A623);
            box-shadow: 0 0 0 3px rgba(245, 166, 35, 0.1);
        }
</style>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}