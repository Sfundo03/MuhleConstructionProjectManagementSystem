
@{
    ViewBag.Title = "External Workshop Notice";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4" style="max-width: 600px;">
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="fa-solid fa-industry fa-3x text-warning mb-3"></i>
            <h3 class="mb-3">External Workshop Notice</h3>
            <p class="text-muted mb-4">
                No internal technicians are currently available for repair ticket <strong>#RT-@ViewBag.RepairId</strong> (@ViewBag.EquipmentName). You may proceed to record the workshop slot but assign a technician later, or contact an external workshop service partner.
            </p>
            <a href="@Url.Action("RepairDetails", new { id = ViewBag.RepairId })" class="btn btn-primary">Back to Repair Details</a>
        </div>
    </div>
</div>