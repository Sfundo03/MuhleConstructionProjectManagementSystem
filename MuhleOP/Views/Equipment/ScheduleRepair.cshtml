@model MuhleOP.ViewModels.ScheduleRepairViewModel
@{
    ViewBag.Title = "Schedule Repair";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4" style="max-width: 680px;">
    <h2 class="mb-4">Schedule Repair — @Model.EquipmentName</h2>

    <div class="alert alert-info">
        Current status: <strong>@Model.CurrentStatus</strong>. Ticket #@Model.RepairId.
    </div>

    @if (ViewBag.WarrantyActive == true)
    {
        <div class="alert alert-warning">
            <i class="fa-solid fa-shield-halved me-1"></i> <strong>Warranty Notice:</strong> This equipment appears to be within its 24-month warranty window (purchased @ViewBag.PurchaseDateFormatted). Consider requesting a supplier repair instead of an internal one.
        </div>
    }

    @if (ViewBag.NoTechniciansAvailable == true)
    {
        <div class="alert alert-danger">
            <i class="fa-solid fa-user-slash me-1"></i> <strong>No Internal Technicians Available.</strong> You may proceed to record the workshop slot but assign a technician later, or <a href="@Url.Action("ExternalWorkshopNotice", new { id = Model.RepairId })" class="alert-link">consult external workshop notice</a>.
        </div>
    }

    @using (Html.BeginForm("ScheduleRepair", "Equipment", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.RepairId)
        @Html.HiddenFor(m => m.EquipmentName)
        @Html.HiddenFor(m => m.CurrentStatus)
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Technician <span class="text-danger">*</span></label>
                    @Html.DropDownListFor(m => m.TechnicianId, Model.AvailableTechnicians, "Select technician...", new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.TechnicianId, "", new { @class = "text-danger small" })
                </div>
                <div class="mb-3">
                    <label class="form-label">Technician Name (Fallback / Custom) <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.TechnicianName, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessageFor(m => m.TechnicianName, "", new { @class = "text-danger small" })
                </div>
                <div class="mb-3">
                    <label class="form-label">Repair Category <span class="text-danger">*</span></label>
                    @Html.DropDownListFor(m => m.RepairCategory, Model.CategoryOptions, "Select category...", new { @class = "form-select", required = "required" })
                    @Html.ValidationMessageFor(m => m.RepairCategory, "", new { @class = "text-danger small" })
                </div>
                <div class="mb-3">
                    <label class="form-label">Priority <span class="text-danger">*</span></label>
                    @Html.DropDownListFor(m => m.Priority, Model.PriorityOptions, new { @class = "form-select", required = "required" })
                    @Html.ValidationMessageFor(m => m.Priority, "", new { @class = "text-danger small" })
                </div>
                <div class="mb-3">
                    <label class="form-label">Diagnosis Notes</label>
                    @Html.TextAreaFor(m => m.DiagnosisNotes, new { @class = "form-control", rows = 3 })
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Estimated Parts Cost (R)</label>
                        @Html.TextBoxFor(m => m.EstimatedPartsCost, new { @class = "form-control", type = "number", step = "0.01" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Estimated Labour Cost (R)</label>
                        @Html.TextBoxFor(m => m.EstimatedLabourCost, new { @class = "form-control", type = "number", step = "0.01" })
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Workshop Slot Start <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.WorkshopSlotStart, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", required = "required" })
                        @Html.ValidationMessageFor(m => m.WorkshopSlotStart, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Workshop Slot End <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.WorkshopSlotEnd, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", required = "required" })
                        @Html.ValidationMessageFor(m => m.WorkshopSlotEnd, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <!-- Parts from Inventory Section -->
                <div class="card border mb-3">
                    <div class="card-header bg-light fw-semibold">Parts from Inventory</div>
                    <div class="card-body">
                        <div id="schedulePartsContainer">
                            @if (Model.PartsToUse != null && Model.PartsToUse.Count > 0)
                            {
                                for (int i = 0; i < Model.PartsToUse.Count; i++)
                                {
                                    <div class="row g-2 mb-2 schedule-part-row">
                                        <div class="col-7">
                                            @Html.DropDownList(string.Format("PartsToUse[{0}].EquipmentPartId", i), new SelectList(Model.AvailableParts, "Value", "Text", Model.PartsToUse[i].EquipmentPartId), "Select part...", new { @class = "form-select form-select-sm" })
                                        </div>
                                        <div class="col-3">
                                            @Html.TextBox(string.Format("PartsToUse[{0}].QuantityUsed", i), Model.PartsToUse[i].QuantityUsed, new { @class = "form-control form-control-sm", type = "number", min = "1", placeholder = "Qty" })
                                        </div>
                                        <div class="col-2">
                                            <button type="button" class="btn btn-outline-danger btn-sm w-100 remove-schedule-part">Remove</button>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                        <button type="button" id="addSchedulePartBtn" class="btn btn-outline-secondary btn-sm mt-1">+ Add Part Row</button>

                        <!-- Add New Part on the Fly Collapsible -->
                        <div class="mt-4 pt-3 border-top">
                            <a data-bs-toggle="collapse" href="#newPartCollapse" role="button" aria-expanded="false" aria-controls="newPartCollapse" class="text-decoration-none fw-semibold">
                                <i class="fa-solid fa-plus-circle me-1"></i> Or create a new part on the fly...
                            </a>
                            <div class="collapse mt-2" id="newPartCollapse">
                                <div class="p-3 bg-light rounded border">
                                    <div class="row g-2">
                                        <div class="col-md-5">
                                            <label class="form-label small">New Part Name</label>
                                            @Html.TextBoxFor(m => m.NewPartName, new { @class = "form-control form-control-sm" })
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small">Part Code</label>
                                            @Html.TextBoxFor(m => m.NewPartCode, new { @class = "form-control form-control-sm", placeholder = "Auto if blank" })
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small">Unit</label>
                                            @Html.TextBoxFor(m => m.NewPartUnit, new { @class = "form-control form-control-sm", placeholder = "each" })
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small">Qty Needed</label>
                                            @Html.TextBoxFor(m => m.NewPartQuantityNeeded, new { @class = "form-control form-control-sm", type = "number", min = "1" })
                                        </div>
                                    </div>
                                    <small class="text-muted d-block mt-1">Creating a new part will automatically flag this repair for procurement (to be ordered).</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Additional parts (free text — for anything not in inventory)</label>
                    @Html.TextAreaFor(m => m.RequiredParts, new { @class = "form-control", rows = 2 })
                </div>
                <div class="mb-3">
                    <label class="form-label">Parts Notes</label>
                    @Html.TextAreaFor(m => m.PartsNotes, new { @class = "form-control", rows = 2 })
                </div>
                <div class="mb-3">
                    <label class="form-label">Check-In Notes</label>
                    @Html.TextAreaFor(m => m.CheckInNotes, new { @class = "form-control", rows = 3 })
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Schedule Repair</button>
        <a href="@Url.Action("RepairDetails", new { id = Model.RepairId })" class="btn btn-outline-secondary">Cancel</a>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var availablePartsOptions = @Html.Raw(Json.Encode(Model.AvailableParts));
            $('#addSchedulePartBtn').on('click', function () {
                var index = $('#schedulePartsContainer .schedule-part-row').length;
                var dropdownOptions = '<option value="">Select part...</option>';
                for (var i = 0; i < availablePartsOptions.length; i++) {
                    dropdownOptions += '<option value="' + availablePartsOptions[i].Value + '">' + availablePartsOptions[i].Text + '</option>';
                }

                var rowHtml = '<div class="row g-2 mb-2 schedule-part-row">' +
                    '<div class="col-7"><select name="PartsToUse[' + index + '].EquipmentPartId" class="form-select form-select-sm">' + dropdownOptions + '</select></div>' +
                    '<div class="col-3"><input type="number" name="PartsToUse[' + index + '].QuantityUsed" class="form-control form-control-sm" min="1" value="1" placeholder="Qty" /></div>' +
                    '<div class="col-2"><button type="button" class="btn btn-outline-danger btn-sm w-100 remove-schedule-part">Remove</button></div>' +
                    '</div>';
                $('#schedulePartsContainer').append(rowHtml);
            });

            $(document).on('click', '.remove-schedule-part', function () {
                $(this).closest('.schedule-part-row').remove();
                $('#schedulePartsContainer .schedule-part-row').each(function (idx, el) {
                    $(el).find('select').attr('name', 'PartsToUse[' + idx + '].EquipmentPartId');
                    $(el).find('input').attr('name', 'PartsToUse[' + idx + '].QuantityUsed');
                });
            });
        })();
    </script>
}