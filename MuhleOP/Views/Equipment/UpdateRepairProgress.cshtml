@model MuhleOP.ViewModels.UpdateRepairProgressViewModel
@{
    ViewBag.Title = "Update Repair Progress";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4" style="max-width: 720px;">
    <h2 class="mb-2">Update Progress — @Model.EquipmentName</h2>
    <p class="text-muted mb-4"><i class="fas fa-shoe-prints me-1"></i>Current Step: <strong>@Model.CurrentStepTitle</strong></p>

    <!-- Step Progress Tracker Bar -->
    <div class="row g-2 mb-4 text-center">
        <div class="col-4">
            <div class="p-2 rounded border @(Model.CurrentStepNumber == 1 ? "bg-primary text-white fw-bold shadow-sm" : "bg-light text-muted")">
                1. Schedule &amp; Tech
            </div>
        </div>
        <div class="col-4">
            <div class="p-2 rounded border @(Model.CurrentStepNumber == 2 ? "bg-primary text-white fw-bold shadow-sm" : "bg-light text-muted")">
                2. Parts Management
            </div>
        </div>
        <div class="col-4">
            <div class="p-2 rounded border @(Model.CurrentStepNumber == 3 ? "bg-primary text-white fw-bold shadow-sm" : "bg-light text-muted")">
                3. Cost &amp; Verification
            </div>
        </div>
    </div>

    @using (Html.BeginForm("UpdateRepairProgress", "Equipment", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.RepairId)
        @Html.HiddenFor(m => m.EquipmentName)
        @Html.HiddenFor(m => m.OriginalStatus)
        @Html.HiddenFor(m => m.RowVersion)
        @Html.HiddenFor(m => m.CurrentStepNumber)
        @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <!-- Step 1: Technician Assignment & Schedule / Warranty Notices -->
                @if (Model.CurrentStepNumber == 1)
                {
                    if (ViewBag.WarrantyActive == true)
                    {
                        <div class="alert alert-warning">
                            <i class="fa-solid fa-shield-halved me-1"></i> <strong>Warranty Notice:</strong> This equipment appears to be within its 24-month warranty window (purchased @ViewBag.PurchaseDateFormatted). Consider requesting a supplier repair instead of an internal one.
                        </div>
                    }

                    if (Model.NoTechniciansAvailable)
                    {
                        <div class="alert alert-danger">
                            <i class="fa-solid fa-user-slash me-1"></i> <strong>No Internal Technicians Available.</strong> You may proceed to record the workshop slot or <a href="@Url.Action("ExternalWorkshopNotice", new { id = Model.RepairId })" class="alert-link">consult external workshop notice</a>.
                        </div>
                    }

                    <div class="card border mb-3 bg-light">
                        <div class="card-header bg-white fw-semibold"><i class="fas fa-user-gear me-1"></i> Step 1: Technician &amp; Schedule</div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label">Assign Technician</label>
                                @Html.DropDownListFor(m => m.TechnicianId, Model.AvailableTechnicians, "Select technician...", new { @class = "form-select", id = "technicianSelect" })
                                @Html.ValidationMessageFor(m => m.TechnicianId, "", new { @class = "text-danger small" })
                            </div>
                            <div class="form-check mb-3">
                                @Html.CheckBoxFor(m => m.EscalateToExternalWorkshop, new { @class = "form-check-input", id = "escalateCheckbox" })
                                <label class="form-check-label fw-semibold text-dark" for="escalateCheckbox">Escalate to External Workshop (no internal technician available)</label>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Repair Category <span class="text-danger">*</span></label>
                                @Html.DropDownListFor(m => m.RepairCategory, Model.CategoryOptions, "Select category...", new { @class = "form-select", required = "required" })
                                @Html.ValidationMessageFor(m => m.RepairCategory, "", new { @class = "text-danger small" })
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Priority <span class="text-danger">*</span></label>
                                @Html.DropDownListFor(m => m.Priority, Model.PriorityOptions, "Select priority...", new { @class = "form-select", required = "required" })
                                @Html.ValidationMessageFor(m => m.Priority, "", new { @class = "text-danger small" })
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Diagnosis Notes</label>
                                @Html.TextAreaFor(m => m.DiagnosisNotes, new { @class = "form-control", rows = 3 })
                            </div>
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Estimated Parts Cost (R)</label>
                                    @Html.TextBoxFor(m => m.EstimatedPartsCost, new { @class = "form-control", type = "number", step = "0.01" })
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Estimated Labour Cost (R)</label>
                                    @Html.TextBoxFor(m => m.EstimatedLabourCost, new { @class = "form-control", type = "number", step = "0.01" })
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Estimated Finish Date (Revised Completion)</label>
                                @Html.TextBoxFor(m => m.RevisedCompletionDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Photo Evidence (optional)</label>
                                <input type="file" name="PhotoEvidence" class="form-control" accept="image/*" />
                            </div>
                        </div>
                    </div>
                }

                <!-- Step 2: Parts Management -->
                @if (Model.CurrentStepNumber == 2)
                {
                    <div class="card border mb-3 bg-light">
                        <div class="card-header bg-white fw-semibold"><i class="fas fa-boxes-stacked me-1"></i> Step 2: Parts Management</div>
                        <div class="card-body">
                            <div class="form-check mb-3">
                                @Html.CheckBoxFor(m => m.NoPartsNeeded, new { @class = "form-check-input", id = "noPartsNeededCheck" })
                                <label class="form-check-label fw-semibold text-dark" for="noPartsNeededCheck">No parts needed (Skip parts selection)</label>
                            </div>
                            <div id="partsSelectionSection">
                                <div id="partsContainer">
                                    @if (Model.PartsUsed != null && Model.PartsUsed.Any())
                                    {
                                        for (int i = 0; i < Model.PartsUsed.Count; i++)
                                        {
                                            <div class="row g-2 mb-2 part-row">
                                                <div class="col-7">
                                                    @Html.DropDownList(string.Format("PartsUsed[{0}].EquipmentPartId", i), new SelectList(Model.AvailableParts, "Value", "Text", Model.PartsUsed[i].EquipmentPartId), "Select part...", new { @class = "form-select form-select-sm" })
                                                </div>
                                                <div class="col-3">
                                                    @Html.TextBox(string.Format("PartsUsed[{0}].QuantityUsed", i), Model.PartsUsed[i].QuantityUsed, new { @class = "form-control form-control-sm", type = "number", min = "1", placeholder = "Qty" })
                                                </div>
                                                <div class="col-2">
                                                    <button type="button" class="btn btn-outline-danger btn-sm w-100 remove-part-row">Remove</button>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                                <button type="button" id="addPartRowBtn" class="btn btn-outline-secondary btn-sm mt-1">+ Add Part from Inventory</button>
                                <small class="text-muted d-block mt-2">Note: If selected parts exceed current stock levels, the system will automatically notify the Project Manager.</small>

                                <!-- Add New Part Section -->
                                <div class="card border mt-4 p-3 bg-white">
                                    <h6 class="fw-semibold mb-2"><i class="fas fa-plus-circle me-1"></i> Add New Part (not in inventory)</h6>
                                    <p class="small text-muted mb-2">If a required part is missing from inventory, enter details below. It will be added with zero stock and flagged for procurement.</p>
                                    <div class="row g-2">
                                        <div class="col-md-4">
                                            @Html.TextBoxFor(m => m.NewPartName, new { @class = "form-control form-control-sm", placeholder = "Part Name" })
                                        </div>
                                        <div class="col-md-3">
                                            @Html.TextBoxFor(m => m.NewPartCode, new { @class = "form-control form-control-sm", placeholder = "Part Code (Optional)" })
                                        </div>
                                        <div class="col-md-2">
                                            @Html.TextBoxFor(m => m.NewPartUnit, new { @class = "form-control form-control-sm", placeholder = "Unit (e.g. ea)" })
                                        </div>
                                        <div class="col-md-3">
                                            @Html.TextBoxFor(m => m.NewPartQuantityNeeded, new { @class = "form-control form-control-sm", type = "number", min = "1", placeholder = "Qty Needed" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Step 3: Cost Input & Ready for Verification -->
                @if (Model.CurrentStepNumber == 3)
                {
                    <div class="card border mb-3 bg-light">
                        <div class="card-header bg-white fw-semibold"><i class="fas fa-calculator me-1"></i> Step 3: Cost Input</div>
                        <div class="card-body">
                            <div class="row g-3 mb-3">
                                <div class="col-md-4">
                                    <label class="form-label">Parts Cost (R)</label>
                                    @Html.TextBoxFor(m => m.PartsCost, new { @class = "form-control", type = "number", step = "0.01", id = "partsCost" })
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Labour Cost (R)</label>
                                    @Html.TextBoxFor(m => m.LabourCost, new { @class = "form-control", type = "number", step = "0.01", id = "labourCost" })
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">Total Cost (R)</label>
                                    @Html.TextBoxFor(m => m.TotalCost, new { @class = "form-control fw-bold bg-white", type = "number", step = "0.01", id = "totalCost", @readonly = "readonly" })
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Repair Notes -->
                <div class="mb-3">
                    <label class="form-label">Repair Notes / Progress Details</label>
                    @Html.TextAreaFor(m => m.RepairNotes, new { @class = "form-control", rows = 3, placeholder = "Enter notes for this step..." })
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary btn-lg w-100 mb-2">Save Step Progress &amp; Continue</button>
        <a href="@Url.Action("RepairDetails", new { id = Model.RepairId })" class="btn btn-outline-secondary w-100">Cancel</a>
    }
</div>

@section Scripts {
    <script>
        (function () {
            // Auto calculate total cost
            var p = document.getElementById('partsCost');
            var l = document.getElementById('labourCost');
            var t = document.getElementById('totalCost');
            function sum() {
                var a = parseFloat(p ? p.value : 0) || 0;
                var b = parseFloat(l ? l.value : 0) || 0;
                if (t) {
                    t.value = (a + b).toFixed(2);
                }
            }
            if (p && l && t) {
                p.addEventListener('input', sum);
                l.addEventListener('input', sum);
                sum();
            }

            // Toggle parts section based on checkbox
            var noPartsCheck = document.getElementById('noPartsNeededCheck');
            var partsSection = document.getElementById('partsSelectionSection');
            function toggleParts() {
                if (noPartsCheck && partsSection) {
                    partsSection.style.display = noPartsCheck.checked ? 'none' : 'block';
                }
            }
            if (noPartsCheck) {
                noPartsCheck.addEventListener('change', toggleParts);
                toggleParts();
            }

            // External Workshop Escalation Toggle
            var escalateCheck = document.getElementById('escalateCheckbox');
            var techSelect = document.getElementById('technicianSelect');
            function toggleEscalate() {
                if (escalateCheck && techSelect) {
                    if (escalateCheck.checked) {
                        techSelect.value = '';
                        techSelect.disabled = true;
                    } else {
                        techSelect.disabled = false;
                    }
                }
            }
            if (escalateCheck) {
                escalateCheck.addEventListener('change', toggleEscalate);
                toggleEscalate();
            }

            // Dynamic Parts Row Management
            var availablePartsOptions = @Html.Raw(Json.Encode(Model.AvailableParts));
            $('#addPartRowBtn').on('click', function () {
                var index = $('#partsContainer .part-row').length;
                var dropdownOptions = '<option value="">Select part...</option>';
                for (var i = 0; i < availablePartsOptions.length; i++) {
                    dropdownOptions += '<option value="' + availablePartsOptions[i].Value + '">' + availablePartsOptions[i].Text + '</option>';
                }

                var rowHtml = '<div class="row g-2 mb-2 part-row">' +
                    '<div class="col-7"><select name="PartsUsed[' + index + '].EquipmentPartId" class="form-select form-select-sm">' + dropdownOptions + '</select></div>' +
                    '<div class="col-3"><input type="number" name="PartsUsed[' + index + '].QuantityUsed" class="form-control form-control-sm" min="1" value="1" placeholder="Qty" /></div>' +
                    '<div class="col-2"><button type="button" class="btn btn-outline-danger btn-sm w-100 remove-part-row">Remove</button></div>' +
                    '</div>';
                $('#partsContainer').append(rowHtml);
            });

            $(document).on('click', '.remove-part-row', function () {
                $(this).closest('.part-row').remove();
                $('#partsContainer .part-row').each(function (idx, el) {
                    $(el).find('select').attr('name', 'PartsUsed[' + idx + '].EquipmentPartId');
                    $(el).find('input').attr('name', 'PartsUsed[' + idx + '].QuantityUsed');
                });
            });
        })();
    </script>
}