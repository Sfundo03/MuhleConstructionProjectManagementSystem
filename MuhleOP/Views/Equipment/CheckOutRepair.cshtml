@model MuhleOP.ViewModels.CheckOutRepairViewModel
@{
    ViewBag.Title = "Check-Out Repair";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4" style="max-width: 640px;">
    <h2 class="mb-4">Check-Out Fixed Equipment</h2>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h5>@Model.EquipmentName <span class="text-muted">(@Model.EquipmentCode)</span></h5>
            <p class="mb-1"><strong>Technician:</strong> @(Model.TechnicianName ?? "—")</p>
            <p class="mb-0 small text-muted">@Model.RepairSummary</p>
        </div>
    </div>

    @if (Model.ReallocationSuggestions != null && Model.ReallocationSuggestions.Any())
    {
        <div class="card border-0 shadow-sm mb-4 bg-light">
            <div class="card-header bg-white fw-semibold">Projects Recently Using This Equipment Category</div>
            <div class="card-body">
                <p class="small text-muted mb-2">Consider re-allocating this equipment to one of these projects:</p>
                <ul class="mb-0 ps-3">
                    @foreach (var proj in Model.ReallocationSuggestions)
                    {
                        <li><strong>@proj.ProjectName</strong> (@proj.ProjectCode) — Last assigned on @proj.AssignedDate.ToString("dd MMM yyyy")</li>
                    }
                </ul>
            </div>
        </div>
    }

    @using (Html.BeginForm("CheckOutRepair", "Equipment", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.RepairId)
        @Html.HiddenFor(m => m.EquipmentName)
        @Html.HiddenFor(m => m.EquipmentCode)
        @Html.HiddenFor(m => m.TechnicianName)
        @Html.HiddenFor(m => m.RepairSummary)
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white fw-semibold">Verification Checklist &amp; Sign-Off</div>
            <div class="card-body">
                <div class="form-check mb-2">
                    @Html.CheckBoxFor(m => m.CheckoutChecklist.LoadTestPassed, new { @class = "form-check-input", id = "LoadTestPassed" })
                    <label class="form-check-label" for="LoadTestPassed">Load Test Passed</label>
                </div>
                <div class="mb-3 ps-4">
                    <label class="form-label small text-muted">Load Test Result (kg)</label>
                    @Html.TextBoxFor(m => m.CheckoutChecklist.LoadTestResultKg, new { @class = "form-control form-control-sm", type = "number", step = "0.01", style = "max-width: 200px;" })
                </div>
                <div class="form-check mb-2">
                    @Html.CheckBoxFor(m => m.CheckoutChecklist.SafetyCheckPassed, new { @class = "form-check-input", id = "SafetyCheckPassed" })
                    <label class="form-check-label" for="SafetyCheckPassed">Safety Check Passed</label>
                </div>
                <div class="form-check mb-2">
                    @Html.CheckBoxFor(m => m.CheckoutChecklist.CalibrationVerified, new { @class = "form-check-input", id = "CalibrationVerified" })
                    <label class="form-check-label" for="CalibrationVerified">Calibration Verified</label>
                </div>
                <div class="form-check mb-3">
                    @Html.CheckBoxFor(m => m.CheckoutChecklist.VisualInspectionPassed, new { @class = "form-check-input", id = "VisualInspectionPassed" })
                    <label class="form-check-label" for="VisualInspectionPassed">Visual Inspection Passed</label>
                </div>
                <div class="mb-3">
                    <label class="form-label">Checklist Notes</label>
                    @Html.TextAreaFor(m => m.CheckoutChecklist.Notes, new { @class = "form-control", rows = 2 })
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Technician Sign-Off Name <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.CheckoutChecklist.TechnicianSignOffName, new { @class = "form-control", required = "required" })
                        @Html.ValidationMessageFor(m => m.CheckoutChecklist.TechnicianSignOffName, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Admin Sign-Off Name <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.CheckoutChecklist.AdminSignOffName, new { @class = "form-control", required = "required" })
                        @Html.ValidationMessageFor(m => m.CheckoutChecklist.AdminSignOffName, "", new { @class = "text-danger small" })
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Final Condition <span class="text-danger">*</span></label>
                    @Html.DropDownListFor(m => m.FinalCondition, Model.ConditionOptions, new { @class = "form-select", required = "required" })
                </div>
                <div class="mb-3">
                    <label class="form-label">Final Verification Notes</label>
                    @Html.TextAreaFor(m => m.FinalVerificationNotes, new { @class = "form-control", rows = 3 })
                </div>
                <div class="form-check mb-3">
                    @Html.CheckBoxFor(m => m.FinalVerified, new { @class = "form-check-input", id = "FinalVerified" })
                    <label class="form-check-label" for="FinalVerified">
                        I confirm the equipment passed the final safety/load test
                    </label>
                    @Html.ValidationMessageFor(m => m.FinalVerified, "", new { @class = "text-danger small d-block" })
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-success w-100 mb-2">
            <i class="fa-solid fa-check-double me-1"></i> Check-Out &amp; Return to Service
        </button>
        <a href="@Url.Action("RepairDetails", new { id = Model.RepairId })" class="btn btn-outline-secondary w-100">Cancel</a>
    }
</div>