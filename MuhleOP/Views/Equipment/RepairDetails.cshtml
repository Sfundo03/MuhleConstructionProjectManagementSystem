
@model MuhleOP.ViewModels.EquipmentRepairDetailsViewModel
@{
    ViewBag.Title = "Repair " + Model.Id;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="mb-0">Repair #RT-@Model.Id</h2>
            <div class="text-muted">@Model.EquipmentName · @Model.EquipmentCode</div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @if (Model.Status == "Reported")
            {
                <a href="@Url.Action("ScheduleRepair", new { id = Model.Id })" class="btn btn-primary">Schedule Repair</a>
            }
            @if (Model.Status == "In Repair" || Model.Status == "Awaiting Parts" || Model.Status == "Ready for Verification")
            {
                <a href="@Url.Action("UpdateRepairProgress", new { id = Model.Id })" class="btn btn-outline-primary">Update Progress</a>
            }
            @if (Model.Status == "Ready for Verification")
            {
                <a href="@Url.Action("CheckOutRepair", new { id = Model.Id })" class="btn btn-success">Check-Out Fixed Equipment</a>
            }
            <a href="@Url.Action("RepairQueue")" class="btn btn-outline-secondary">Back to Queue</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-semibold">Repair Details</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8"><span class="badge bg-@Model.StatusBadgeColor">@Model.Status</span></dd>
                        <dt class="col-sm-4">Reported By</dt>
                        <dd class="col-sm-8">@(Model.ReportedBy ?? "—")</dd>
                        <dt class="col-sm-4">Reported Date</dt>
                        <dd class="col-sm-8">@Model.CreatedDate.ToString("dd MMM yyyy HH:mm")</dd>
                        <dt class="col-sm-4">Repair Date</dt>
                        <dd class="col-sm-8">@Model.RepairDate.ToString("dd MMM yyyy")</dd>
                        <dt class="col-sm-4">Technician</dt>
                        <dd class="col-sm-8">@(Model.TechnicianName ?? "—")</dd>
                        <dt class="col-sm-4">Parts Cost</dt>
                        <dd class="col-sm-8">R@Model.PartsCost.ToString("N2")</dd>
                        <dt class="col-sm-4">Labour Cost</dt>
                        <dd class="col-sm-8">R@Model.LabourCost.ToString("N2")</dd>
                        <dt class="col-sm-4">Total Cost</dt>
                        <dd class="col-sm-8"><strong>R@Model.TotalCost.ToString("N2")</strong></dd>
                        <dt class="col-sm-4">Verified By</dt>
                        <dd class="col-sm-8">@(Model.VerifiedBy ?? "—")</dd>
                        <dt class="col-sm-4">Verification Date</dt>
                        <dd class="col-sm-8">@(Model.VerificationDate.HasValue ? Model.VerificationDate.Value.ToString("dd MMM yyyy HH:mm") : "—")</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-semibold">Equipment</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@Model.EquipmentName</dd>
                        <dt class="col-sm-4">Code</dt>
                        <dd class="col-sm-8">@Model.EquipmentCode</dd>
                        <dt class="col-sm-4">Category</dt>
                        <dd class="col-sm-8">@(Model.EquipmentCategory ?? "—")</dd>
                        <dt class="col-sm-4">Current Status</dt>
                        <dd class="col-sm-8">@(Model.EquipmentStatus ?? "—")</dd>
                        <dt class="col-sm-4">Condition</dt>
                        <dd class="col-sm-8">@(Model.EquipmentCondition ?? "—")</dd>
                        <dt class="col-sm-4">Project</dt>
                        <dd class="col-sm-8">@(Model.AssignedProjectName ?? "—")</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-semibold">Issue Description</div>
                <div class="card-body">
                    <p class="mb-0">@(Model.IssueDescription ?? "—")</p>
                </div>
            </div>
        </div>
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-semibold">Parts Replaced</div>
                <div class="card-body">
                    <p class="mb-0">@(Model.PartsReplaced ?? "—")</p>
                </div>
            </div>
        </div>
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-semibold">Repair Notes / Audit Trail</div>
                <div class="card-body">
                    <pre class="mb-0" style="white-space: pre-wrap; font-family: inherit;">@(Model.RepairNotes ?? "—")</pre>
                </div>
            </div>
        </div>
    </div>
</div>