@model MuhleOP.ViewModels.EquipmentRepairDetailsViewModel
@{
    ViewBag.Title = $"Repair Details — RT-{Model.Id}";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4" style="max-width: 900px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Repair Details — Ticket #RT-@Model.Id</h2>
            <p class="text-muted mb-0">Equipment: <strong>@Model.EquipmentName</strong> (@Model.EquipmentCode)</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            @if (Model.RequiresProcurement)
            {
                <span class="badge bg-warning text-dark">Requires Procurement</span>
            }
            <span class="badge bg-@Model.StatusBadgeColor fs-6">@Model.Status</span>
            @if (Model.IsQuarantined)
            {
                <span class="badge bg-dark fs-6">Quarantined</span>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-light fw-semibold">Repair Information</div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li><strong>Reported Date:</strong> @Model.CreatedDate.ToString("dd MMM yyyy HH:mm")</li>
                        <li><strong>Reported By:</strong> @Model.ReportedBy</li>
                        <li><strong>Project:</strong> @(Model.AssignedProjectName ?? "N/A")</li>
                        <li><strong>Category:</strong> @(Model.RepairCategory ?? "N/A")</li>
                        <li><strong>Severity:</strong> <span class="badge bg-@Model.SeverityBadgeColor">@(Model.Severity ?? "N/A")</span></li>
                        <li><strong>Priority:</strong> <span class="badge bg-@Model.PriorityBadgeColor">@(Model.Priority ?? "N/A")</span></li>
                        <li><strong>Technician:</strong> @(string.IsNullOrEmpty(Model.TechnicianName) ? "Unassigned" : Model.TechnicianName)</li>
                        @if (!string.IsNullOrEmpty(Model.ProcurementRequestReference))
                        {
                            <li><strong>Procurement reference:</strong> @Model.ProcurementRequestReference</li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-light fw-semibold">Costs & Timeline</div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li><strong>Parts Cost:</strong> R@Model.PartsCost.ToString("N2")</li>
                        <li><strong>Labour Cost:</strong> R@Model.LabourCost.ToString("N2")</li>
                        <li><strong>Total Cost:</strong> R@Model.TotalCost.ToString("N2")</li>
                        <li><strong>Actual Hours:</strong> @(Model.ActualHours.HasValue ? Model.ActualHours.Value.ToString("0.##") + " hrs" : "N/A")</li>
                        <li><strong>Revised Completion:</strong> @(Model.RevisedCompletionDate.HasValue ? Model.RevisedCompletionDate.Value.ToString("dd MMM yyyy") : "N/A")</li>
                        @if (Model.IsEscalated)
                        {
                            <li class="text-danger fw-bold mt-2"><i class="fa-solid fa-triangle-exclamation me-1"></i> Ticket Escalated</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mt-4">
        <div class="card-header bg-light fw-semibold">Issue Description & Diagnosis</div>
        <div class="card-body">
            <p><strong>Issue:</strong> @Model.IssueDescription</p>
            @if (!string.IsNullOrEmpty(Model.DiagnosisNotes))
            {
                <p class="mb-0"><strong>Diagnosis Notes:</strong> @Model.DiagnosisNotes</p>
            }
        </div>
    </div>

    @if (Model.PhotoEvidencePaths != null && Model.PhotoEvidencePaths.Any())
    {
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-header bg-light fw-semibold">Photo Evidence</div>
            <div class="card-body">
                <div class="row g-2">
                    @foreach (var p in Model.PhotoEvidencePaths)
                    {
                        <div class="col-md-3">
                            <a href="@p" target="_blank"><img src="@p" class="img-fluid rounded border" alt="Evidence" /></a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="d-flex gap-2 mt-4">
        @if (Model.Status != "Verified" && Model.Status != "Cancelled")
        {
            <a href="@Url.Action("UpdateRepairProgress", new { id = Model.Id })" class="btn btn-primary"><i class="fa-solid fa-pen-to-square me-1"></i> Update Progress</a>
        }
        @if (Model.Status == "Ready for Verification")
        {
            <a href="@Url.Action("CheckOutRepair", new { id = Model.Id })" class="btn btn-success"><i class="fa-solid fa-check-circle me-1"></i> Check Out / Verify</a>
        }
        <a href="@Url.Action("RepairQueue")" class="btn btn-outline-secondary">Back to Queue</a>
    </div>
</div>