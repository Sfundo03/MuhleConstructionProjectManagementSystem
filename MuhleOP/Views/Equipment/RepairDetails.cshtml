@model MuhleOP.ViewModels.EquipmentRepairDetailsViewModel
@{
    ViewBag.Title = "Repair " + Model.Id;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="mb-0">
                Repair #RT-@Model.Id
                @if (Model.IsEscalated)
                {
                    <span class="badge bg-danger ms-2">ESCALATED</span>
                }
                @if (Model.IsDelayFlagged)
                {
                    <span class="badge bg-warning text-dark ms-1">DELAYED</span>
                }
            </h2>
            <div class="text-muted">@Model.EquipmentName · @Model.EquipmentCode</div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @if (Model.Status == "Reported")
            {
                <a href="@Url.Action("ScheduleRepair", new { id = Model.Id })" class="btn btn-primary">Schedule Repair</a>
            }
            @if (Model.Status == "In Repair" || Model.Status == "Awaiting Parts" || Model.Status == "Awaiting Approval" || Model.Status == "Ready for Verification")
            {
                <a href="@Url.Action("UpdateRepairProgress", new { id = Model.Id })" class="btn btn-outline-primary">Update Progress</a>
            }
            @if (Model.Status == "Ready for Verification")
            {
                <a href="@Url.Action("CheckOutRepair", new { id = Model.Id })" class="btn btn-success">Check-Out Fixed Equipment</a>
            }
            <a href="@Url.Action("RepairQueue")" class="btn btn-outline-secondary">Back to Queue</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-semibold">Repair Details</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8"><span class="badge bg-@Model.StatusBadgeColor">@Model.Status</span></dd>
                        <dt class="col-sm-4">Reported By</dt>
                        <dd class="col-sm-8">@(Model.ReportedBy ?? "—")</dd>
                        <dt class="col-sm-4">Reported Date</dt>
                        <dd class="col-sm-8">@Model.CreatedDate.ToString("dd MMM yyyy HH:mm")</dd>
                        <dt class="col-sm-4">Repair Date</dt>
                        <dd class="col-sm-8">@Model.RepairDate.ToString("dd MMM yyyy")</dd>
                        <dt class="col-sm-4">Technician</dt>
                        <dd class="col-sm-8">@(Model.TechnicianName ?? "—")</dd>
                        <dt class="col-sm-4">Actual Hours</dt>
                        <dd class="col-sm-8">@(Model.ActualHours.HasValue ? Model.ActualHours.Value.ToString("0.##") + " hrs" : "—")</dd>
                        <dt class="col-sm-4">Revised Completion</dt>
                        <dd class="col-sm-8">@(Model.RevisedCompletionDate.HasValue ? Model.RevisedCompletionDate.Value.ToString("dd MMM yyyy") : "—")</dd>
                        <dt class="col-sm-4">Procurement Ref</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.ProcurementRequestReference) ? "—" : Model.ProcurementRequestReference)</dd>
                        <dt class="col-sm-4">Parts Cost</dt>
                        <dd class="col-sm-8">R@Model.PartsCost.ToString("N2")</dd>
                        <dt class="col-sm-4">Labour Cost</dt>
                        <dd class="col-sm-8">R@Model.LabourCost.ToString("N2")</dd>
                        <dt class="col-sm-4">Total Cost</dt>
                        <dd class="col-sm-8"><strong>R@Model.TotalCost.ToString("N2")</strong></dd>
                        <dt class="col-sm-4">Verified By</dt>
                        <dd class="col-sm-8">@(Model.VerifiedBy ?? "—")</dd>
                        <dt class="col-sm-4">Verification Date</dt>
                        <dd class="col-sm-8">@(Model.VerificationDate.HasValue ? Model.VerificationDate.Value.ToString("dd MMM yyyy HH:mm") : "—")</dd>
                        @if (!string.IsNullOrEmpty(Model.CancellationReason))
                        {
                            <dt class="col-sm-4 text-danger">Cancellation Reason</dt>
                            <dd class="col-sm-8 text-danger">@Model.CancellationReason</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-semibold">Equipment</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@Model.EquipmentName</dd>
                        <dt class="col-sm-4">Code</dt>
                        <dd class="col-sm-8">@Model.EquipmentCode</dd>
                        <dt class="col-sm-4">Category</dt>
                        <dd class="col-sm-8">@(Model.EquipmentCategory ?? "—")</dd>
                        <dt class="col-sm-4">Current Status</dt>
                        <dd class="col-sm-8">@(Model.EquipmentStatus ?? "—")</dd>
                        <dt class="col-sm-4">Condition</dt>
                        <dd class="col-sm-8">@(Model.EquipmentCondition ?? "—")</dd>
                        <dt class="col-sm-4">Project</dt>
                        <dd class="col-sm-8">@(Model.AssignedProjectName ?? "—")</dd>
                    </dl>

                    @if (!string.IsNullOrEmpty(Model.PhotoEvidencePath))
                    {
                        <div class="mt-3">
                            <label class="form-label fw-semibold">Photo Evidence</label>
                            <div>
                                <img src="@Model.PhotoEvidencePath" alt="Photo Evidence" class="img-fluid rounded shadow-sm" style="max-height: 200px;" />
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-semibold">Issue Description</div>
                <div class="card-body">
                    <p class="mb-0">@(Model.IssueDescription ?? "—")</p>
                </div>
            </div>
        </div>
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-semibold">Parts Replaced (Summary)</div>
                <div class="card-body">
                    <p class="mb-0">@(Model.PartsReplaced ?? "—")</p>
                </div>
            </div>
        </div>

        <!-- Parts Used Inventory Table -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-semibold">Parts Used (Inventory Tracking)</div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Part Name</th>
                                <th>Part Code</th>
                                <th>Quantity</th>
                                <th>Unit Cost</th>
                                <th>Total</th>
                                <th>Recorded By</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.PartUsages == null || !Model.PartUsages.Any())
                            {
                                <tr><td colspan="7" class="text-center text-muted py-3">No inventory parts recorded for this repair.</td></tr>
                            }
                            else
                            {
                                foreach (var pu in Model.PartUsages)
                                {
                                    <tr>
                                        <td><strong>@pu.PartName</strong></td>
                                        <td>@(pu.PartCode ?? "—")</td>
                                        <td>@pu.QuantityUsed</td>
                                        <td>R@pu.UnitCostAtUse.ToString("N2")</td>
                                        <td><strong>R@pu.TotalCost.ToString("N2")</strong></td>
                                        <td>@(pu.RecordedBy ?? "—")</td>
                                        <td>@pu.UsedDate.ToString("dd MMM yyyy HH:mm")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Immutable Progress History / Audit Trail -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-semibold">Progress History & Audit Trail</div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Timestamp</th>
                                <th>Status</th>
                                <th>Change Type</th>
                                <th>Notes / Details</th>
                                <th>Revised Date</th>
                                <th>Hours</th>
                                <th>Changed By</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ProgressLogs == null || !Model.ProgressLogs.Any())
                            {
                                <tr><td colspan="7" class="text-center text-muted py-3">No progress logs recorded.</td></tr>
                            }
                            else
                            {
                                foreach (var log in Model.ProgressLogs)
                                {
                                    <tr>
                                        <td>@log.ChangedAt.ToString("dd MMM yyyy HH:mm")</td>
                                        <td><span class="badge bg-secondary">@log.Status</span></td>
                                        <td>
                                            <span class="badge bg-info">@log.ChangeType</span>
                                            @if (log.IsDelayFlagged)
                                            {
                                                <span class="badge bg-warning text-dark">Delayed</span>
                                            }
                                        </td>
                                        <td>
                                            @(log.Notes ?? "—")
                                            @if (!string.IsNullOrEmpty(log.PartsUsedSummary))
                                            {
                                                <div class="small text-muted">Parts: @log.PartsUsedSummary</div>
                                            }
                                        </td>
                                        <td>@(log.RevisedCompletionDate.HasValue ? log.RevisedCompletionDate.Value.ToString("dd MMM yyyy") : "—")</td>
                                        <td>@(log.ActualHours.HasValue ? log.ActualHours.Value.ToString("0.##") + "h" : "—")</td>
                                        <td>@(log.ChangedBy ?? "—")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-semibold">Legacy Repair Notes / Audit Trail</div>
                <div class="card-body">
                    <pre class="mb-0" style="white-space: pre-wrap; font-family: inherit;">@(Model.RepairNotes ?? "—")</pre>
                </div>
            </div>
        </div>
    </div>
</div>