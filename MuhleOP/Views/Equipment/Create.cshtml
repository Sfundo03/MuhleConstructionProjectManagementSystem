
@model MuhleOP.ViewModels.CreateEquipmentViewModel
@{
    ViewBag.Title = "Register Equipment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4" style="max-width: 800px;">
    <h2 class="mb-4"><i class="fa-solid fa-plus me-2"></i>Register New Equipment</h2>

    @using (Html.BeginForm("Create", "Equipment", FormMethod.Post, new { @class = "needs-validation" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">@Html.DisplayNameFor(m => m.EquipmentName) <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.EquipmentName, new { @class = "form-control", required = "required" })
                        @Html.ValidationMessageFor(m => m.EquipmentName, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Equipment Code</label>
                        <input type="text" class="form-control" value="Auto-generated on save" disabled />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Html.DisplayNameFor(m => m.SerialNumber) <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.SerialNumber, new { @class = "form-control", required = "required" })
                        @Html.ValidationMessageFor(m => m.SerialNumber, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Html.DisplayNameFor(m => m.Category) <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.Category, Model.Categories, "Select category...", new { @class = "form-select", required = "required" })
                        @Html.ValidationMessageFor(m => m.Category, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Html.DisplayNameFor(m => m.SubCategory)</label>
                        @Html.TextBoxFor(m => m.SubCategory, new { @class = "form-control" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Html.DisplayNameFor(m => m.Make)</label>
                        @Html.TextBoxFor(m => m.Make, new { @class = "form-control" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Html.DisplayNameFor(m => m.Model)</label>
                        @Html.TextBoxFor(m => m.Model, new { @class = "form-control" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Html.DisplayNameFor(m => m.Year)</label>
                        @Html.TextBoxFor(m => m.Year, new { @class = "form-control", type = "number", min = "1900", max = "2100" })
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Html.DisplayNameFor(m => m.Condition)</label>
                        @Html.DropDownListFor(m => m.Condition, Model.Conditions, new { @class = "form-select" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Html.DisplayNameFor(m => m.PurchaseDate)</label>
                        @Html.TextBoxFor(m => m.PurchaseDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Html.DisplayNameFor(m => m.PurchaseCost)</label>
                        @Html.TextBoxFor(m => m.PurchaseCost, new { @class = "form-control", type = "number", step = "0.01" })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Html.DisplayNameFor(m => m.CurrentValue)</label>
                        @Html.TextBoxFor(m => m.CurrentValue, new { @class = "form-control", type = "number", step = "0.01" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Html.DisplayNameFor(m => m.Location)</label>
                        @Html.TextBoxFor(m => m.Location, new { @class = "form-control", placeholder = "e.g. Main Yard, Site A Store" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Html.DisplayNameFor(m => m.Status)</label>
                        @Html.DropDownListFor(m => m.Status, Model.Statuses, new { @class = "form-select" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Html.DisplayNameFor(m => m.MaintenanceFrequencyDays)</label>
                        @Html.DropDownListFor(m => m.MaintenanceFrequencyDays, Model.MaintenanceFrequencies, new { @class = "form-select", id = "freqSelect" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Next Maintenance Date (preview)</label>
                        <input type="text" id="nextMaintPreview" class="form-control" readonly value="—" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">@Html.DisplayNameFor(m => m.Notes)</label>
                        @Html.TextAreaFor(m => m.Notes, new { @class = "form-control", rows = 3 })
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save me-1"></i> Register Equipment</button>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancel</a>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var select = document.getElementById('freqSelect');
            var preview = document.getElementById('nextMaintPreview');
            function updatePreview() {
                var days = parseInt(select.value, 10);
                if (!days || isNaN(days)) {
                    preview.value = '—';
                    return;
                }
                var d = new Date();
                d.setDate(d.getDate() + days);
                preview.value = d.toISOString().slice(0, 10);
            }
            select.addEventListener('change', updatePreview);
            updatePreview();
        })();
    </script>
}