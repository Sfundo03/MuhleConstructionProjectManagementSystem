
@model MuhleOP.ViewModels.RequestVariationViewModel
@{
    ViewBag.Title = "Request Variation";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Request Project Variation</h4>
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">Back</a>
</div>

@using (Html.BeginForm("RequestVariation", "Quality", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.SiteInspectionId)

    <div class="card">
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.RelatedInspectionSummary))
            {
                <div class="alert alert-info">
                    <i class="fas fa-link me-1"></i> Linked to inspection: <strong>@Model.RelatedInspectionSummary</strong>
                </div>
            }
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">@Html.DisplayNameFor(m => m.ProjectId)</label>
                    @Html.DropDownListFor(m => m.ProjectId, Model.Projects, "-- Select Project --", new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.ProjectId, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6">
                    <label class="form-label">@Html.DisplayNameFor(m => m.VariationType)</label>
                    @Html.DropDownListFor(m => m.VariationType, Model.VariationTypes, "-- Type --", new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.VariationType, "", new { @class = "text-danger" })
                </div>
                <div class="col-12">
                    <label class="form-label">@Html.DisplayNameFor(m => m.Description)</label>
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 3 })
                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                </div>
                <div class="col-12">
                    <label class="form-label">@Html.DisplayNameFor(m => m.Reason)</label>
                    @Html.TextAreaFor(m => m.Reason, new { @class = "form-control", rows = 2 })
                    @Html.ValidationMessageFor(m => m.Reason, "", new { @class = "text-danger" })
                </div>
                <div class="col-12">
                    <label class="form-label">@Html.DisplayNameFor(m => m.ImpactOnScope)</label>
                    @Html.TextAreaFor(m => m.ImpactOnScope, new { @class = "form-control", rows = 2 })
                </div>
                <div class="col-md-4">
                    <label class="form-label">@Html.DisplayNameFor(m => m.ImpactOnCost)</label>
                    @Html.TextBoxFor(m => m.ImpactOnCost, new { @class = "form-control", type = "number", step = "0.01" })
                </div>
                <div class="col-md-4">
                    <label class="form-label">@Html.DisplayNameFor(m => m.ImpactOnTimelineDays)</label>
                    @Html.TextBoxFor(m => m.ImpactOnTimelineDays, new { @class = "form-control", type = "number" })
                </div>
                <div class="col-md-4">
                    <label class="form-label">@Html.DisplayNameFor(m => m.SupportingDocuments)</label>
                    <input type="file" name="SupportingDocuments" class="form-control" />
                </div>
            </div>
        </div>
        <div class="card-footer text-end">
            <button type="submit" class="btn btn-warning">
                <i class="fas fa-paper-plane me-1"></i> Submit Variation Request
            </button>
        </div>
    </div>
}