
@model MuhleOP.ViewModels.InspectionDetailsViewModel
@{
    ViewBag.Title = "Inspection Details";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Inspection #@Model.Id</h4>
    <div>
        <a href="@Url.Action("InspectionQueue")" class="btn btn-outline-secondary btn-sm">Queue</a>
        @if (Model.CanRequestVariation)
        {
            <a href="@Url.Action("RequestVariation", new { inspectionId = Model.Id })" class="btn btn-warning btn-sm">
                <i class="fas fa-exchange-alt me-1"></i> Request Variation
            </a>
        }
        @if (Model.CanReview)
        {
            using (Html.BeginForm("MarkInspectionReviewed", "Quality", FormMethod.Post, new { style = "display:inline;" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-success btn-sm">
                    <i class="fas fa-check me-1"></i> Mark as Reviewed
                </button>
            }
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible">@TempData["ErrorMessage"]</div>
}

<div class="row g-3">
    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-header fw-semibold">Inspection Information</div>
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-sm-4 text-secondary">Project</div>
                    <div class="col-sm-8">@Model.ProjectName (@Model.ProjectCode)</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4 text-secondary">Type</div>
                    <div class="col-sm-8">@Model.InspectionType</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4 text-secondary">Area</div>
                    <div class="col-sm-8">@(Model.InspectionArea ?? "—")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4 text-secondary">Date</div>
                    <div class="col-sm-8">@Model.InspectionDate.ToString("dd MMM yyyy")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4 text-secondary">Performed By</div>
                    <div class="col-sm-8">@Model.PerformedByName</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-4 text-secondary">Status</div>
                    <div class="col-sm-8">
                        <span class="badge bg-@Model.StatusBadgeColor">@Model.Status</span>
                        @if (Model.IsPassed)
                        {
                            <span class="badge bg-success ms-1">Passed</span>
                        }
                        else
                        {
                            <span class="badge bg-danger ms-1">Not Passed</span>
                        }
                    </div>
                </div>
                @if (Model.Score.HasValue)
                {
                    <div class="row mb-2">
                        <div class="col-sm-4 text-secondary">Score</div>
                        <div class="col-sm-8">@Model.Score / 100</div>
                    </div>
                }
                <div class="row mb-2">
                    <div class="col-sm-4 text-secondary">Findings</div>
                    <div class="col-sm-8">@Model.Findings</div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Recommendations))
                {
                    <div class="row mb-2">
                        <div class="col-sm-4 text-secondary">Recommendations</div>
                        <div class="col-sm-8">@Model.Recommendations</div>
                    </div>
                }
                @if (Model.ActionRequired)
                {
                    <div class="row mb-2">
                        <div class="col-sm-4 text-secondary">Action Items</div>
                        <div class="col-sm-8">
                            <span class="badge bg-danger">Action Required</span>
                            <div class="mt-1">@Model.ActionItems</div>
                            @if (Model.DueDate.HasValue)
                            {
                                <div class="small text-secondary">Due: @Model.DueDate.Value.ToString("dd MMM yyyy")</div>
                            }
                        </div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.ReviewedBy))
                {
                    <div class="row mb-2">
                        <div class="col-sm-4 text-secondary">Reviewed By</div>
                        <div class="col-sm-8">@Model.ReviewedBy on @(Model.ReviewDate?.ToString("dd MMM yyyy HH:mm"))</div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header fw-semibold">Attachments</div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.PhotosPath))
                {
                    <a href="@Model.PhotosPath" target="_blank" class="d-block mb-2">
                        <i class="fas fa-image me-1"></i> Photos
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(Model.ReportPath))
                {
                    <a href="@Model.ReportPath" target="_blank" class="d-block">
                        <i class="fas fa-file-alt me-1"></i> Report
                    </a>
                }
                @if (string.IsNullOrWhiteSpace(Model.PhotosPath) && string.IsNullOrWhiteSpace(Model.ReportPath))
                {
                    <span class="text-secondary">No attachments</span>
                }
            </div>
        </div>
        @if (Model.RelatedVariations != null && Model.RelatedVariations.Any())
        {
            <div class="card">
                <div class="card-header fw-semibold">Related Variations</div>
                <ul class="list-group list-group-flush">
                    @foreach (var v in Model.RelatedVariations)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <a href="@Url.Action("VariationDetails", new { id = v.Id })">@v.VariationNumber</a>
                            <span class="badge bg-@v.StatusBadgeColor">@v.Status</span>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>