@model MuhleOP.ViewModels.InspectionDetailsViewModel
@{
    ViewBag.Title = "Inspection Details #" + Model.Id;
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0">Inspection #@Model.Id – @Model.InspectionType</h4>
        <span class="text-secondary">Project: @Model.ProjectName (@Model.ProjectCode)</span>
    </div>
    <div>
        <a href="@Url.Action("InspectionQueue")" class="btn btn-outline-secondary btn-sm me-2">Back to Queue</a>
        @if (Model.CanReview)
        {
            using (Html.BeginForm("MarkInspectionReviewed", "Quality", new { id = Model.Id }, FormMethod.Post, new { style = "display:inline;" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success btn-sm">
                    <i class="fas fa-check-circle me-1"></i> Mark as Reviewed
                </button>
            }
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible">@TempData["ErrorMessage"]</div>
}

@if (Model.HasCriticalNonConformance)
{
    <div class="alert alert-danger shadow-sm mb-4">
        <i class="fas fa-triangle-exclamation fa-lg me-2"></i>
        <strong>CRITICAL SAFETY ISSUE RECORDED:</strong> This inspection recorded a critical safety issue. The affected task is halted pending resolution.
    </div>
}

<div class="row g-4">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header fw-semibold">Inspection Information</div>
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-sm-3 text-secondary">Inspection Area</div>
                    <div class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.InspectionArea) ? "N/A" : Model.InspectionArea)</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-3 text-secondary">Inspection Date</div>
                    <div class="col-sm-9">@Model.InspectionDate.ToString("dd MMM yyyy")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-3 text-secondary">Performed By</div>
                    <div class="col-sm-9">@Model.PerformedByName</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-3 text-secondary">Status</div>
                    <div class="col-sm-9"><span class="badge bg-@Model.StatusBadgeColor">@Model.Status</span></div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-3 text-secondary">Score</div>
                    <div class="col-sm-9">@(Model.Score.HasValue ? Model.Score.Value + "/100" : "N/A")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-sm-3 text-secondary">Findings</div>
                    <div class="col-sm-9" style="white-space: pre-wrap;">@Model.Findings</div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Recommendations))
                {
                    <div class="row mb-2">
                        <div class="col-sm-3 text-secondary">Recommendations</div>
                        <div class="col-sm-9" style="white-space: pre-wrap;">@Model.Recommendations</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.MeasurementNotes))
                {
                    <div class="row mb-2">
                        <div class="col-sm-3 text-secondary">Measurement Notes</div>
                        <div class="col-sm-9"><code>@Model.MeasurementNotes</code></div>
                    </div>
                }
            </div>
        </div>

        <!-- Checklist Results -->
        <div class="card mb-4">
            <div class="card-header fw-semibold">Checklist Results</div>
            <div class="card-body p-0">
                @if (Model.ItemResults != null && Model.ItemResults.Any())
                {
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Category</th>
                                <th>Result</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var res in Model.ItemResults)
                            {
                                var badgeCol = res.Result == "Pass" ? "success" : (res.Result == "Fail" ? "danger" : (res.Result == "Partial" ? "warning" : "secondary"));
                                <tr>
                                    <td>@res.ItemLabel</td>
                                    <td><span class="badge bg-secondary">@res.Category</span></td>
                                    <td><span class="badge bg-@badgeCol">@res.Result</span></td>
                                    <td>@(string.IsNullOrWhiteSpace(res.Notes) ? "—" : res.Notes)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="p-3 text-muted">No checklist item results recorded for this inspection.</div>
                }
            </div>
        </div>

        <!-- Non-Conformances Register -->
        <div class="card mb-4">
            <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                <span>Non-Conformances Register</span>
                @if (Model.CanRequestVariation)
                {
                    <a href="@Url.Action("RequestVariation", new { inspectionId = Model.Id })" class="btn btn-warning btn-sm">
                        <i class="fas fa-exchange-alt me-1"></i> Request Variation
                    </a>
                }
            </div>
            <div class="card-body p-0">
                @if (Model.NonConformances != null && Model.NonConformances.Any())
                {
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Ref #</th>
                                <th>Description</th>
                                <th>Severity</th>
                                <th>Responsible</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var nc in Model.NonConformances)
                            {
                                var sevBadge = nc.Severity == "Critical" ? "danger" : (nc.Severity == "Major" ? "warning" : "secondary");
                                <tr>
                                    <td class="fw-bold">@nc.ReferenceNumber</td>
                                    <td>@nc.Description</td>
                                    <td><span class="badge bg-@sevBadge">@nc.Severity</span></td>
                                    <td>@nc.ResponsibleParty</td>
                                    <td><span class="badge bg-info">@nc.Status</span></td>
                                    <td>
                                        <a href="@Url.Action("RequestVariationFromNonConformance", new { nonConformanceId = nc.Id })" class="btn btn-outline-primary btn-sm" title="Request Variation from Non-Conformance">
                                            <i class="fas fa-plus me-1"></i> Variation
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="p-3 text-muted">No non-conformances registered.</div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card mb-4">
            <div class="card-header fw-semibold">Review & Verification</div>
            <div class="card-body">
                <div class="mb-3">
                    <span class="text-secondary d-block small">Action Required</span>
                    <span class="fw-bold @(Model.ActionRequired ? "text-danger" : "text-success")">
                        @(Model.ActionRequired ? "Yes" : "No")
                    </span>
                </div>
                @if (Model.ActionRequired)
                {
                    <div class="mb-3">
                        <span class="text-secondary d-block small">Action Items</span>
                        <p class="mb-0">@Model.ActionItems</p>
                    </div>
                    <div class="mb-3">
                        <span class="text-secondary d-block small">Due Date</span>
                        <span class="fw-bold">@(Model.DueDate.HasValue ? Model.DueDate.Value.ToString("dd MMM yyyy") : "N/A")</span>
                    </div>
                }
                <div class="mb-3">
                    <span class="text-secondary d-block small">Reviewed By</span>
                    <span class="fw-bold">@(string.IsNullOrWhiteSpace(Model.ReviewedBy) ? "Pending Review" : Model.ReviewedBy)</span>
                </div>
                @if (Model.ReviewDate.HasValue)
                {
                    <div class="mb-3">
                        <span class="text-secondary d-block small">Review Date</span>
                        <span class="fw-bold">@Model.ReviewDate.Value.ToString("dd MMM yyyy HH:mm")</span>
                    </div>
                }
            </div>
        </div>

        <!-- Digital Sign-Off Card -->
        <div class="card mb-4">
            <div class="card-header fw-semibold">Sign-Off & Authentication</div>
            <div class="card-body">
                <div class="mb-2">
                    <span class="text-secondary d-block small">Signed Off By</span>
                    <span class="fw-bold">@(string.IsNullOrWhiteSpace(Model.SignedOffBy) ? "N/A" : Model.SignedOffBy)</span>
                </div>
                <div class="mb-3">
                    <span class="text-secondary d-block small">Signed Off Date</span>
                    <span class="fw-bold">@(Model.SignedOffDate.HasValue ? Model.SignedOffDate.Value.ToString("dd MMM yyyy HH:mm") : "N/A")</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.SignatureDataPath))
                {
                    <div class="mb-2">
                        <span class="text-secondary d-block small mb-1">Digital Signature</span>
                        <div class="border p-2 bg-light rounded text-center">
                            <img src="@Model.SignatureDataPath" alt="Site Manager Signature" style="max-height:80px; max-width:100%;" />
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header fw-semibold">Attached Files</div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.PhotosPath))
                {
                    <div class="mb-3">
                        <span class="text-secondary d-block small mb-1">Inspection Photos</span>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var pPath in Model.PhotosPath.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries))
                            {
                                <a href="@pPath" target="_blank" class="border rounded p-1 bg-light">
                                    <img src="@pPath" alt="Photo" style="width:60px; height:60px; object-fit:cover;" />
                                </a>
                            }
                        </div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.ReportPath))
                {
                    <div>
                        <span class="text-secondary d-block small mb-1">Report Document</span>
                        <a href="@Model.ReportPath" target="_blank" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-file-pdf me-1"></i> Download Report
                        </a>
                    </div>
                }
                @if (string.IsNullOrWhiteSpace(Model.PhotosPath) && string.IsNullOrWhiteSpace(Model.ReportPath))
                {
                    <p class="text-muted mb-0 small">No files attached.</p>
                }
            </div>
        </div>
    </div>
</div>