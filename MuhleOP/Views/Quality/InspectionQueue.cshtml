@model MuhleOP.ViewModels.InspectionQueueViewModel
@{
    ViewBag.Title = "Inspection Queue";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Inspection Queue</h4>
    @if (User.IsInRole("Admin") || User.IsInRole("Site Manager"))
    {
        <a href="@Url.Action("ConductInspection")" class="btn btn-primary btn-sm">
            <i class="fas fa-plus me-1"></i> New Inspection
        </a>
    }
</div>

<form method="get" class="card mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small">Project</label>
                @Html.DropDownList("projectId", Model.Projects, "All Projects", new { @class = "form-select form-select-sm", name = "projectId" })
            </div>
            <div class="col-md-2">
                <label class="form-label small">Status</label>
                @Html.DropDownList("status", Model.Statuses, new { @class = "form-select form-select-sm" })
            </div>
            <div class="col-md-2">
                <label class="form-label small">From</label>
                <input type="date" name="from" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">To</label>
                <input type="date" name="to" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-primary btn-sm w-100">Filter</button>
            </div>
        </div>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Project</th>
                    <th>Type</th>
                    <th>Performed By</th>
                    <th>Score</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items == null || !Model.Items.Any())
                {
                    <tr><td colspan="7" class="text-center text-secondary py-4">No inspections found.</td></tr>
                }
                else
                {
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.InspectionDate.ToString("dd MMM yyyy")</td>
                            <td>@item.ProjectName</td>
                            <td>@item.InspectionType</td>
                            <td>@item.PerformedByName</td>
                            <td>@(item.Score.HasValue ? item.Score.ToString() : "—")</td>
                            <td>
                                <span class="badge bg-@item.StatusBadgeColor">@item.Status</span>
                                @if (item.ActionRequired)
                                {
                                    <span class="badge bg-danger ms-1">Action</span>
                                }
                                @if (item.HasCriticalNonConformance)
                                {
                                    <span class="badge bg-danger ms-1" title="Critical Non-Conformance Detected — Task Halted">Critical NC</span>
                                }
                            </td>
                            <td class="text-end">
                                <a href="@Url.Action("InspectionDetails", new { id = item.Id })" class="btn btn-sm btn-outline-primary">View</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>