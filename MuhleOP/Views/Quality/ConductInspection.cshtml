@model MuhleOP.ViewModels.CreateInspectionViewModel
@{
    ViewBag.Title = "Conduct Inspection";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Conduct Inspection & Checklist</h4>
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">Back</a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible">@TempData["ErrorMessage"]</div>
}

@using (Html.BeginForm("ConductInspection", "Quality", FormMethod.Post, new { enctype = "multipart/form-data", id = "inspectionForm" }))
{
    @Html.AntiForgeryToken()
    <div class="card mb-4">
        <div class="card-header fw-semibold">General Information</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">@Html.DisplayNameFor(m => m.ProjectId)</label>
                    @Html.DropDownListFor(m => m.ProjectId, Model.Projects, "-- Select Project --", new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.ProjectId, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Html.DisplayNameFor(m => m.InspectionType)</label>
                    @Html.DropDownListFor(m => m.InspectionType, Model.InspectionTypes, "-- Type --", new { @class = "form-select", id = "InspectionTypeDropdown" })
                    @Html.ValidationMessageFor(m => m.InspectionType, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Html.DisplayNameFor(m => m.InspectionDate)</label>
                    @Html.TextBoxFor(m => m.InspectionDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                </div>
                <div class="col-md-6">
                    <label class="form-label">@Html.DisplayNameFor(m => m.InspectionArea)</label>
                    @Html.TextBoxFor(m => m.InspectionArea, new { @class = "form-control" })
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Html.DisplayNameFor(m => m.Score)</label>
                    @Html.TextBoxFor(m => m.Score, new { @class = "form-control", type = "number", min = "0", max = "100" })
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.ActionRequired, new { @class = "form-check-input" })
                        <label class="form-check-label" for="ActionRequired">Action Required</label>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label">@Html.DisplayNameFor(m => m.Findings)</label>
                    @Html.TextAreaFor(m => m.Findings, new { @class = "form-control", rows = 4 })
                    @Html.ValidationMessageFor(m => m.Findings, "", new { @class = "text-danger" })
                </div>
                <div class="col-12">
                    <label class="form-label">@Html.DisplayNameFor(m => m.Recommendations)</label>
                    @Html.TextAreaFor(m => m.Recommendations, new { @class = "form-control", rows = 3 })
                </div>
                <div class="col-md-8">
                    <label class="form-label">@Html.DisplayNameFor(m => m.ActionItems)</label>
                    @Html.TextAreaFor(m => m.ActionItems, new { @class = "form-control", rows = 2 })
                </div>
                <div class="col-md-4">
                    <label class="form-label">@Html.DisplayNameFor(m => m.DueDate)</label>
                    @Html.TextBoxFor(m => m.DueDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                </div>
                <div class="col-12">
                    <label class="form-label">@Html.DisplayNameFor(m => m.MeasurementNotes)</label>
                    @Html.TextAreaFor(m => m.MeasurementNotes, new { @class = "form-control", rows = 2, placeholder = "e.g., slab thickness 152mm, tolerance ±3mm" })
                </div>
                <div class="col-md-6">
                    <label class="form-label">@Html.DisplayNameFor(m => m.Photos)</label>
                    <input type="file" name="Photos" class="form-control" accept="image/*" multiple />
                    <div class="form-text">You can select multiple photo files.</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">@Html.DisplayNameFor(m => m.Report)</label>
                    <input type="file" name="Report" class="form-control" accept=".pdf,.doc,.docx" />
                </div>
            </div>
        </div>
    </div>

    <!-- Template Checklist Section -->
    <div class="card mb-4">
        <div class="card-header fw-semibold">Checklist Items</div>
        <div class="card-body">
            <div id="checklistValidationAlert" class="alert alert-warning d-none mb-3"></div>
            <div id="checklistContainer">
                <p class="text-muted">Select an inspection type to load pre-defined checklist items.</p>
            </div>
        </div>
    </div>

    <!-- Non-Conformance Dynamic Sub-Form Section -->
    <div class="card mb-4" id="nonConformanceCard" style="display:none;">
        <div class="card-header fw-semibold text-danger d-flex justify-content-between align-items-center">
            <span>Non-Conformance Register (Triggered by Fail/Partial or Added Manually)</span>
            <button type="button" class="btn btn-sm btn-outline-danger" id="addManualNcBtn">
                <i class="fas fa-plus me-1"></i> Add Non-Conformance
            </button>
        </div>
        <div class="card-body">
            <p class="text-muted small">Items marked Fail/Partial automatically generate non-conformance entries. You may also add additional manual entries below:</p>
            <div id="ncRowsContainer">
                <!-- Dynamic NC rows will be injected here -->
            </div>
        </div>
    </div>

    <!-- Digital Signature Pad Section -->
    <div class="card mb-4">
        <div class="card-header fw-semibold">Site Manager Digital Sign-off</div>
        <div class="card-body">
            <p class="text-muted small">Please sign inside the box below to finalise and authenticate this inspection record.</p>
            <div class="border rounded p-2 bg-light d-inline-block">
                <canvas id="signatureCanvas" width="400" height="150" style="background:#fff; border:1px solid #ced4da; cursor:crosshair;"></canvas>
            </div>
            <div>
                <button type="button" class="btn btn-outline-secondary btn-sm mt-2" id="clearSignature">Clear Signature</button>
            </div>
            @Html.HiddenFor(m => m.SignatureData, new { id = "SignatureData" })
            @Html.ValidationMessageFor(m => m.SignatureData, "", new { @class = "text-danger d-block mt-1" })
        </div>
        <div class="card-footer text-end">
            <button type="submit" class="btn btn-primary" id="submitBtn">
                <i class="fas fa-save me-1"></i> Save & Submit Inspection
            </button>
        </div>
    </div>
}

@section scripts {
    <script>
        var templateItemsData = @Html.Raw(Json.Encode(Model.TemplateItems));

        function renderChecklist(inspectionType) {
            var container = $('#checklistContainer');
            container.empty();
            $('#checklistValidationAlert').addClass('d-none').text('');

            var filtered = templateItemsData.filter(function (item) {
                return item.InspectionType === inspectionType;
            });

            if (filtered.length === 0) {
                container.html('<p class="text-muted">No template checklist items available for this type.</p>');
                $('#nonConformanceCard').slideUp();
                $('#ncRowsContainer').empty();
                return;
            }

            var html = '<div class="table-responsive"><table class="table table-bordered align-middle"><thead><tr><th>Item</th><th>Category</th><th style="width:220px;">Result</th><th>Notes</th></tr></thead><tbody>';

            filtered.forEach(function (item, index) {
                html += '<tr data-item-id="' + item.Id + '" data-item-label="' + escapeHtml(item.ItemLabel) + '">' +
                    '<td>' + escapeHtml(item.ItemLabel) +
                    '<input type="hidden" name="ItemResultsInput[' + index + '].TemplateItemId" value="' + item.Id + '" />' +
                    '<input type="hidden" name="ItemResultsInput[' + index + '].ItemLabel" value="' + escapeHtml(item.ItemLabel) + '" />' +
                    '</td>' +
                    '<td><span class="badge bg-secondary">' + escapeHtml(item.Category || 'General') + '</span></td>' +
                    '<td>' +
                    '<div class="btn-group btn-group-sm w-100" role="group">' +
                    '<input type="radio" class="btn-check result-radio" name="ItemResultsInput[' + index + '].Result" id="res_pass_' + index + '" value="Pass" autocomplete="off">' +
                    '<label class="btn btn-outline-success" for="res_pass_' + index + '">Pass</label>' +
                    '<input type="radio" class="btn-check result-radio" name="ItemResultsInput[' + index + '].Result" id="res_fail_' + index + '" value="Fail" autocomplete="off">' +
                    '<label class="btn btn-outline-danger" for="res_fail_' + index + '">Fail</label>' +
                    '<input type="radio" class="btn-check result-radio" name="ItemResultsInput[' + index + '].Result" id="res_part_' + index + '" value="Partial" autocomplete="off">' +
                    '<label class="btn btn-outline-warning" for="res_part_' + index + '">Partial</label>' +
                    '<input type="radio" class="btn-check result-radio" name="ItemResultsInput[' + index + '].Result" id="res_na_' + index + '" value="N/A" autocomplete="off">' +
                    '<label class="btn btn-outline-secondary" for="res_na_' + index + '">N/A</label>' +
                    '</div>' +
                    '</td>' +
                    '<td><input type="text" name="ItemResultsInput[' + index + '].Notes" class="form-control form-control-sm" placeholder="Optional notes..." /></td>' +
                    '</tr>';
            });

            html += '</tbody></table></div>';
            container.html(html);
            bindResultListeners();
            reindexNonConformances();
        }

        function escapeHtml(text) {
            return $('<div>').text(text).html();
        }

        // BEFORE: Hardcoded single NC row with static index [0] and limited toggle behavior.
        // AFTER: Dynamic generation and removal of NC rows per failed/partial item, supporting manual additions and sequential reindexing.
        function bindResultListeners() {
            $('.result-radio').on('change', function () {
                var row = $(this).closest('tr');
                var itemId = row.data('item-id');
                var itemLabel = row.data('item-label');
                var val = $(this).val();

                // Remove previous auto-generated NC row for this item if present
                $('#ncRowsContainer .nc-row[data-source-item-id="' + itemId + '"]').remove();

                // If Fail or Partial, auto-generate an associated NC row pre-filled with item label
                if (val === 'Fail' || val === 'Partial') {
                    addNcRow({
                        description: itemLabel,
                        severity: val === 'Fail' ? 'Major' : 'Minor',
                        sourceItemId: itemId,
                        isAuto: true
                    });
                }

                updateNonConformanceCardVisibility();
                reindexNonConformances();
            });
        }

        function addNcRow(data) {
            data = data || { description: '', severity: 'Minor', sourceItemId: '', isAuto: false };
            var container = $('#ncRowsContainer');

            var rowHtml = '<div class="row g-3 nc-row mb-3 pb-3 border-bottom" ' + (data.sourceItemId ? 'data-source-item-id="' + data.sourceItemId + '"' : '') + '>' +
                '<input type="hidden" class="nc-is-auto" value="' + (data.isAuto ? 'true' : 'false') + '" />' +
                '<div class="col-md-5">' +
                '<label class="form-label">Description</label>' +
                '<input type="text" name="Description" class="form-control nc-desc" value="' + escapeHtml(data.description) + '" placeholder="Describe the non-conformance" ' + (data.isAuto ? 'readonly' : '') + ' />' +
                '</div>' +
                '<div class="col-md-3">' +
                '<label class="form-label">Severity</label>' +
                '<select name="Severity" class="form-select nc-sev">' +
                '<option value="Minor" ' + (data.severity === 'Minor' ? 'selected' : '') + '>Minor</option>' +
                '<option value="Major" ' + (data.severity === 'Major' ? 'selected' : '') + '>Major</option>' +
                '<option value="Critical" class="text-danger fw-bold" ' + (data.severity === 'Critical' ? 'selected' : '') + '>Critical (Halts Task)</option>' +
                '</select>' +
                '</div>' +
                '<div class="col-md-2">' +
                '<label class="form-label">Responsible Party</label>' +
                '<input type="text" name="ResponsibleParty" class="form-control" value="Site Contractor" />' +
                '</div>' +
                '<div class="col-md-1">' +
                '<label class="form-label">Due Date</label>' +
                '<input type="date" name="DueDate" class="form-control" />' +
                '</div>' +
                '<div class="col-md-1 d-flex align-items-end">' +
                (data.isAuto ? '' : '<button type="button" class="btn btn-outline-danger btn-sm remove-nc-btn w-100"><i class="fas fa-trash"></i></button>') +
                '</div>' +
                '</div>';

            container.append(rowHtml);
            updateNonConformanceCardVisibility();
            reindexNonConformances();
        }

        // Renumbers all NC rows sequentially (NonConformancesInput[0], NonConformancesInput[1], ...) to ensure zero gaps for MVC model binding
        function reindexNonConformances() {
            $('#ncRowsContainer .nc-row').each(function (index, element) {
                $(element).find('.nc-desc').attr('name', 'NonConformancesInput[' + index + '].Description');
                $(element).find('.nc-sev').attr('name', 'NonConformancesInput[' + index + '].Severity');
                $(element).find('input[type="text"]').not('.nc-desc').attr('name', 'NonConformancesInput[' + index + '].ResponsibleParty');
                $(element).find('input[type="date"]').attr('name', 'NonConformancesInput[' + index + '].DueDate');
            });
        }

        function updateNonConformanceCardVisibility() {
            var count = $('#ncRowsContainer .nc-row').length;
            if (count > 0) {
                $('#nonConformanceCard').slideDown();
            } else {
                $('#nonConformanceCard').slideUp();
            }
        }

        $(document).ready(function () {
            var initialType = $('#InspectionTypeDropdown').val();
            if (initialType) {
                renderChecklist(initialType);
            }

            $('#InspectionTypeDropdown').on('change', function () {
                renderChecklist($(this).val());
                $('#ncRowsContainer').empty();
            });

            $('#addManualNcBtn').on('click', function () {
                addNcRow({ description: '', severity: 'Minor', sourceItemId: '', isAuto: false });
            });

            $(document).on('click', '.remove-nc-btn', function () {
                $(this).closest('.nc-row').remove();
                updateNonConformanceCardVisibility();
                reindexNonConformances();
            });

            var canvas = document.getElementById('signatureCanvas');
            if (canvas) {
                var ctx = canvas.getContext('2d');
                var drawing = false;

                function getPos(e) {
                    var rect = canvas.getBoundingClientRect();
                    var clientX = e.clientX || (e.touches && e.touches[0].clientX);
                    var clientY = e.clientY || (e.touches && e.touches[0].clientY);
                    return {
                        x: clientX - rect.left,
                        y: clientY - rect.top
                    };
                }

                canvas.addEventListener('mousedown', function (e) {
                    drawing = true;
                    ctx.beginPath();
                    var pos = getPos(e);
                    ctx.moveTo(pos.x, pos.y);
                });

                canvas.addEventListener('mousemove', function (e) {
                    if (!drawing) return;
                    var pos = getPos(e);
                    ctx.lineTo(pos.x, pos.y);
                    ctx.stroke();
                });

                canvas.addEventListener('mouseup', function () { drawing = false; });
                canvas.addEventListener('mouseleave', function () { drawing = false; });

                canvas.addEventListener('touchstart', function (e) {
                    drawing = true;
                    ctx.beginPath();
                    var pos = getPos(e);
                    ctx.moveTo(pos.x, pos.y);
                    e.preventDefault();
                });

                canvas.addEventListener('touchmove', function (e) {
                    if (!drawing) return;
                    var pos = getPos(e);
                    ctx.lineTo(pos.x, pos.y);
                    ctx.stroke();
                    e.preventDefault();
                });

                canvas.addEventListener('touchend', function () { drawing = false; });

                $('#clearSignature').on('click', function () {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    $('#SignatureData').val('');
                });

                // FIX 3: Pre-submit validation for unmarked checklist items, running BEFORE signature conversion
                $('#inspectionForm').on('submit', function (e) {
                    // Reset previous validation highlights and summary alerts
                    $('#checklistContainer tr').removeClass('table-danger border border-danger');
                    $('#checklistValidationAlert').addClass('d-none').text('');

                    var unmarkedRows = [];
                    $('#checklistContainer tbody tr').each(function () {
                        var checkedRadio = $(this).find('.result-radio:checked');
                        if (checkedRadio.length === 0) {
                            unmarkedRows.push($(this));
                        }
                    });

                    if (unmarkedRows.length > 0) {
                        // Highlight offending rows in red
                        unmarkedRows.forEach(function ($tr) {
                            $tr.addClass('table-danger border border-danger');
                        });

                        // Show summary alert at top of checklist container
                        $('#checklistValidationAlert').removeClass('d-none').html('<strong>Validation Warning:</strong> ' + unmarkedRows.length + ' checklist item(s) have no result selected. Offending rows are highlighted in red below.');

                        // Escape hatch confirmation prompt
                        var confirmSubmit = confirm('You have ' + unmarkedRows.length + ' unmarked checklist item(s). Do you want to submit anyway? (Click OK to submit with unmarked items, or Cancel to review).');
                        if (!confirmSubmit) {
                            e.preventDefault(); // Block submission
                            $('html, body').animate({
                                scrollTop: $('#checklistContainer').offset().top - 100
                            }, 300);
                            return false;
                        }
                    }

                    // Signature-to-base64 script execution (runs after validation passes or user confirms)
                    var blank = document.createElement('canvas');
                    blank.width = canvas.width;
                    blank.height = canvas.height;
                    if (canvas.toDataURL() !== blank.toDataURL()) {
                        $('#SignatureData').val(canvas.toDataURL('image/png'));
                    }
                });
            }
        });
    </script>
}