@model MuhleOP.ViewModels.QuizViewModel
@{
    ViewBag.Title = "Take Quiz";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var attemptId = ViewBag.AttemptId ?? 0;
    var timeLimitMinutes = ViewBag.TimeLimitMinutes ?? 15;
    var questionCount = ViewBag.QuestionCount ?? 10;
    var passingScore = ViewBag.PassingScore ?? 60;
    var elapsedSeconds = ViewBag.ElapsedSeconds ?? 0;
    var remainingSeconds = (timeLimitMinutes * 60) - elapsedSeconds;
}

<style>
    .quiz-container {
        max-width: 900px;
        margin: 0 auto;
    }

    .question-card {
        border-left: 4px solid var(--primary-gold, #F5A623);
        transition: all 0.3s ease;
    }

        .question-card:hover {
            transform: translateX(5px);
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

    .question-number {
        background: var(--primary-gold, #F5A623);
        color: #fff;
        border-radius: 50%;
        width: 30px;
        height: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 14px;
    }

    .option-label {
        display: block;
        padding: 12px 16px;
        border: 2px solid #e9ecef;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
        margin-bottom: 8px;
    }

        .option-label:hover {
            background: rgba(245, 166, 35, 0.05);
            border-color: var(--primary-gold, #F5A623);
        }

        .option-label input[type="radio"] {
            margin-right: 12px;
            accent-color: var(--primary-gold, #F5A623);
        }

        .option-label.selected {
            border-color: var(--primary-gold, #F5A623);
            background: rgba(245, 166, 35, 0.1);
        }

    .timer-container {
        position: sticky;
        top: 0;
        z-index: 100;
        background: #fff;
        padding: 12px 0;
        border-bottom: 2px solid #e9ecef;
        margin-bottom: 20px;
    }

    [data-theme="dark"] .timer-container {
        background: #1a202c;
        border-bottom-color: #2d3748;
    }

    .timer {
        font-size: 2rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }

        .timer.warning {
            color: #e74a3b;
            animation: pulse 1s infinite;
        }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.5;
        }
    }

    .progress-container {
        background: #e9ecef;
        border-radius: 10px;
        height: 8px;
        overflow: hidden;
    }

    [data-theme="dark"] .progress-container {
        background: #2d3748;
    }

    .progress-bar {
        height: 100%;
        background: var(--primary-gold, #F5A623);
        border-radius: 10px;
        transition: width 0.3s ease;
    }

        .progress-bar.success {
            background: #1cc88a;
        }

    .question-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        max-height: 200px;
        overflow-y: auto;
        padding: 8px 4px;
    }

    .question-nav-btn {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 2px solid #e9ecef;
        background: #fff;
        font-weight: 600;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    [data-theme="dark"] .question-nav-btn {
        background: #1a202c;
        border-color: #2d3748;
        color: #fff;
    }

    .question-nav-btn:hover {
        border-color: var(--primary-gold, #F5A623);
    }

    .question-nav-btn.answered {
        background: var(--primary-gold, #F5A623);
        border-color: var(--primary-gold, #F5A623);
        color: #fff;
    }

    .question-nav-btn.active {
        border-color: #4e73df;
        box-shadow: 0 0 0 3px rgba(78, 115, 223, 0.3);
    }

    .question-nav-btn.passed {
        background: #1cc88a;
        border-color: #1cc88a;
        color: #fff;
    }

    .question-nav-btn.failed {
        background: #e74a3b;
        border-color: #e74a3b;
        color: #fff;
    }

    .quiz-header {
        border-bottom: 2px solid #e9ecef;
        padding-bottom: 16px;
        margin-bottom: 24px;
    }

    [data-theme="dark"] .quiz-header {
        border-bottom-color: #2d3748;
    }

    .quiz-error {
        background: #f8d7da;
        color: #721c24;
        padding: 15px 20px;
        border-radius: 6px;
        border: 1px solid #f5c6cb;
        margin-bottom: 20px;
    }

    [data-theme="dark"] .quiz-error {
        background: #3a1a1a;
        color: #f5a3a3;
        border-color: #5a2d2d;
    }
</style>

<div class="quiz-container">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="quiz-error">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="quiz-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h3>@Model.Title</h3>
                <p class="text-muted">@Model.Description</p>
            </div>
            <div class="text-end">
                <div class="timer" id="timerDisplay">
                    <i class="fas fa-clock me-2"></i>
                    <span id="timerMinutes">@timeLimitMinutes</span>:<span id="timerSeconds">00</span>
                </div>
                <small class="text-muted">
                    Questions: @Model.NumberOfQuestions | Passing Score: @passingScore%
                </small>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-3 order-lg-2">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h6 class="card-title">
                        <i class="fas fa-list me-2"></i>Questions
                        <span class="badge bg-primary float-end" id="answeredCount">0/@Model.NumberOfQuestions</span>
                    </h6>
                    <div class="question-nav" id="questionNav">
                        @for (int i = 0; i < Model.Questions.Count; i++)
                        {
                            <button type="button" class="question-nav-btn" data-index="@i" data-question-id="@Model.Questions[i].Id">
                                @(i + 1)
                            </button>
                        }
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between small text-muted">
                        <span><span class="badge bg-warning" style="width:14px;height:14px;display:inline-block;padding:0;margin-right:4px;">&nbsp;</span> Answered</span>
                        <span><span class="badge bg-secondary" style="width:14px;height:14px;display:inline-block;padding:0;margin-right:4px;">&nbsp;</span> Not Answered</span>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="card-title"><i class="fas fa-info-circle me-2"></i>Instructions</h6>
                    <ul class="small list-unstyled">
                        <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>Select one answer per question</li>
                        <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>You have @timeLimitMinutes minutes to complete</li>
                        <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>Passing score: @passingScore%</li>
                        <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>You can navigate between questions</li>
                        <li><i class="fas fa-check-circle text-success me-2"></i>Submit only when you're ready</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-9 order-lg-1">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div id="questionsContainer">
                        @for (int i = 0; i < Model.Questions.Count; i++)
                        {
                            var question = Model.Questions[i];
                            <div class="question-container @(i == 0 ? "" : "d-none")" data-question-index="@i" data-question-id="@question.Id">
                                <div class="d-flex align-items-center mb-3">
                                    <span class="question-number me-2">@(i + 1)</span>
                                    <h5 class="mb-0">Question @(i + 1) of @Model.NumberOfQuestions</h5>
                                </div>
                                <div class="question-card p-3 mb-3 bg-hover rounded">
                                    <p class="fw-bold mb-3">@question.Question</p>
                                    <div class="options-container">
                                        @foreach (var option in question.Options)
                                        {
                                            <label class="option-label">
                                                <input type="radio" name="question_@question.Id" value="@option" />
                                                @option
                                            </label>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <button type="button" class="btn btn-secondary" id="prevBtn" disabled>
                            <i class="fas fa-arrow-left"></i> Previous
                        </button>
                        <div>
                            <button type="button" class="btn btn-primary" id="nextBtn">
                                Next <i class="fas fa-arrow-right"></i>
                            </button>
                            <button type="button" class="btn btn-success ms-2" id="submitBtn">
                                <i class="fas fa-check"></i> Submit Quiz
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<form id="quizForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="attemptId" value="@attemptId" />
    <input type="hidden" name="answers" id="answersInput" />
</form>

@section Scripts {
    <script>
        $(document).ready(function() {
            const questions = @Html.Raw(Json.Encode(Model.Questions));
            const totalQuestions = questions.length;
            const timeLimitMinutes = @timeLimitMinutes;
            const passingScore = @passingScore;
            const attemptId = @attemptId;
            const elapsedSeconds = @elapsedSeconds;

            let currentIndex = 0;
            let answers = {};
            let timerInterval = null;
            let remainingSeconds = (timeLimitMinutes * 60) - elapsedSeconds;

            // Initialize answered state from any pre-selected answers
            @if (Model.Questions.Any(q => !string.IsNullOrEmpty(q.SelectedAnswer)))
            {
                foreach (var q in Model.Questions.Where(q => !string.IsNullOrEmpty(q.SelectedAnswer)))
                {
                    @:answers[@q.Id] = '@q.SelectedAnswer';
                }
            }

            function updateTimer() {
                if (remainingSeconds <= 0) {
                    clearInterval(timerInterval);
                    $('#timerDisplay').addClass('warning');
                    $('#timerMinutes').text('00');
                    $('#timerSeconds').text('00');
                    alert('Time is up! Your quiz will be submitted automatically.');
                    submitQuiz();
                    return;
                }

                remainingSeconds--;
                const minutes = Math.floor(remainingSeconds / 60);
                const seconds = remainingSeconds % 60;
                $('#timerMinutes').text(String(minutes).padStart(2, '0'));
                $('#timerSeconds').text(String(seconds).padStart(2, '0'));

                if (remainingSeconds < 60) {
                    $('#timerDisplay').addClass('warning');
                }
            }

            function startTimer() {
                if (elapsedSeconds > 0) {
                    // Resume timer
                    timerInterval = setInterval(updateTimer, 1000);
                    updateTimer(); // Update immediately
                } else {
                    timerInterval = setInterval(updateTimer, 1000);
                }
            }

            function showQuestion(index) {
                $('.question-container').addClass('d-none');
                $(`.question-container[data-question-index="${index}"]`).removeClass('d-none');

                // Update navigation buttons
                $('.question-nav-btn').removeClass('active');
                $(`.question-nav-btn[data-index="${index}"]`).addClass('active');

                // Update prev/next buttons
                $('#prevBtn').prop('disabled', index === 0);
                $('#nextBtn').prop('disabled', index === totalQuestions - 1);

                // Scroll to top of question
                $('.question-container').first().parent().scrollTop(0);
            }

            function updateAnsweredCount() {
                const answered = Object.keys(answers).length;
                $('#answeredCount').text(`${answered}/${totalQuestions}`);

                // Update navigation buttons
                $('.question-nav-btn').each(function() {
                    const questionId = $(this).data('question-id');
                    if (answers[questionId]) {
                        $(this).addClass('answered');
                    } else {
                        $(this).removeClass('answered');
                    }
                });
            }

            let saveProgressTimeout = null;

            function saveAnswer(questionId, answer) {
                answers[questionId] = answer;
                updateAnsweredCount();
                scheduleSaveProgress();
            }

            // Persist answers to the server (debounced) so that a refresh, closed tab, or
            // resumed session doesn't lose anything the candidate has already answered.
            function scheduleSaveProgress() {
                if (saveProgressTimeout) {
                    clearTimeout(saveProgressTimeout);
                }
                saveProgressTimeout = setTimeout(saveProgressNow, 800);
            }

            function saveProgressNow() {
                $.ajax({
                    url: '@Url.Action("SaveQuizProgress", "Candidate")',
                    type: 'POST',
                    data: {
                        __RequestVerificationToken: $('#quizForm input[name="__RequestVerificationToken"]').val(),
                        attemptId: attemptId,
                        answers: JSON.stringify(answers)
                    }
                    // Best-effort: if this fails (e.g. brief network hiccup), the next answer
                    // change will simply try again. The final Submit still sends the complete
                    // answer set regardless.
                });
            }

            function getAnswer(questionId) {
                return answers[questionId] || null;
            }

            function submitQuiz() {
                if (Object.keys(answers).length < totalQuestions) {
                    if (!confirm(`You have answered ${Object.keys(answers).length} out of ${totalQuestions} questions. Are you sure you want to submit?`)) {
                        return;
                    }
                }

                // Build the answers object as a JSON string
                var answersJson = JSON.stringify(answers);

                $('#submitBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i> Submitting...');

                $.ajax({
                    url: '@Url.Action("SubmitQuiz", "Candidate")',
                    type: 'POST',
                    data: {
                        __RequestVerificationToken: $('#quizForm input[name="__RequestVerificationToken"]').val(),
                        attemptId: attemptId,
                        answers: answersJson
                    },
                    success: function(response) {
                        if (response.success) {
                            window.location.href = '@Url.Action("QuizResult", "Candidate")/' + response.attemptId;
                        } else {
                            alert('Error: ' + response.message);
                            $('#submitBtn').prop('disabled', false).html('<i class="fas fa-check"></i> Submit Quiz');
                        }
                    },
                    error: function(xhr, status, error) {
                        alert('An error occurred while submitting the quiz. Please try again.\nError: ' + error);
                        $('#submitBtn').prop('disabled', false).html('<i class="fas fa-check"></i> Submit Quiz');
                    }
                });
            }

            // Event handlers
            $(document).on('change', '.option-label input[type="radio"]', function() {
                const questionContainer = $(this).closest('.question-container');
                const questionId = questionContainer.data('question-id');
                const answer = $(this).val();

                // Remove selected class from all options in this question
                questionContainer.find('.option-label').removeClass('selected');
                // Add selected class to this option
                $(this).closest('.option-label').addClass('selected');

                saveAnswer(questionId, answer);
            });

            $('.question-nav-btn').on('click', function() {
                const index = $(this).data('index');
                showQuestion(index);
            });

            $('#prevBtn').on('click', function() {
                if (currentIndex > 0) {
                    currentIndex--;
                    showQuestion(currentIndex);
                }
            });

            $('#nextBtn').on('click', function() {
                if (currentIndex < totalQuestions - 1) {
                    currentIndex++;
                    showQuestion(currentIndex);
                }
            });

            $('#submitBtn').on('click', submitQuiz);

            // Restore selected answers
            $('.question-container').each(function() {
                const questionId = $(this).data('question-id');
                const answer = getAnswer(questionId);
                if (answer) {
                    $(this).find(`.option-label input[value="${answer}"]`).prop('checked', true);
                    $(this).find(`.option-label input[value="${answer}"]`).closest('.option-label').addClass('selected');
                }
            });

            // Keyboard navigation
            $(document).on('keydown', function(e) {
                if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
                    e.preventDefault();
                    if (currentIndex < totalQuestions - 1) {
                        currentIndex++;
                        showQuestion(currentIndex);
                    }
                } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
                    e.preventDefault();
                    if (currentIndex > 0) {
                        currentIndex--;
                        showQuestion(currentIndex);
                    }
                }
            });

            // Initialize
            showQuestion(0);
            updateAnsweredCount();
            startTimer();

            // Safety-net autosave every 20 seconds in case a debounced save was missed
            setInterval(function() {
                if (Object.keys(answers).length > 0) {
                    saveProgressNow();
                }
            }, 20000);

            // Warn before leaving page, and make a best-effort save of whatever has been
            // answered so far (navigator.sendBeacon delivers even as the page unloads).
            window.addEventListener('beforeunload', function(e) {
                if (Object.keys(answers).length > 0 && navigator.sendBeacon) {
                    var token = $('#quizForm input[name="__RequestVerificationToken"]').val();
                    var formData = new FormData();
                    formData.append('__RequestVerificationToken', token);
                    formData.append('attemptId', attemptId);
                    formData.append('answers', JSON.stringify(answers));
                    navigator.sendBeacon('@Url.Action("SaveQuizProgress", "Candidate")', formData);
                }

                if (Object.keys(answers).length < totalQuestions) {
                    e.preventDefault();
                    e.returnValue = 'You have not completed all questions. Are you sure you want to leave?';
                    return e.returnValue;
                }
            });
        });
    </script>
}