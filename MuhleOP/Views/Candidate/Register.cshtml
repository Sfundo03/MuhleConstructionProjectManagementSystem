﻿@model MuhleOP.ViewModels.CandidateRegisterViewModel
@{
    ViewBag.Title = "Candidate Registration";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - MuhleOps</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        :root {
            --charcoal: #14181D;
            --slate-panel: #1B222B;
            --steel-line: #3A4756;
            --amber: #FDB813;
            --amber-deep: #D99A00;
            --concrete: #F1EFEA;
            --concrete-line: #DBD8CF;
            --ink: #14181D;
            --steel-gray: #69727C;
            --danger: #C0392B;
            --success: #27AE60;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            font-family: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: var(--charcoal);
        }

        .register-hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
            background: linear-gradient(135deg, var(--charcoal) 0%, var(--slate-panel) 100%);
            position: relative;
            overflow: hidden;
        }

            .register-hero::before {
                content: "";
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(253,184,19,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(253,184,19,0.03) 1px, transparent 1px);
                background-size: 48px 48px;
                pointer-events: none;
            }

            .register-hero::after {
                content: "";
                position: absolute;
                left: 0;
                bottom: 0;
                width: 60%;
                height: 60%;
                background: radial-gradient(ellipse at bottom left, rgba(253,184,19,0.08) 0%, rgba(253,184,19,0) 70%);
                pointer-events: none;
            }

        .register-card {
            max-width: 900px;
            width: 100%;
            background: var(--concrete);
            border-radius: 2px;
            box-shadow: 0 30px 70px rgba(0,0,0,0.5);
            padding: 50px 48px 40px;
            position: relative;
            z-index: 2;
        }

            /* Registration marks */
            .register-card::before {
                content: "";
                position: absolute;
                top: -11px;
                left: -11px;
                width: 22px;
                height: 22px;
                border-top: 2px solid var(--amber);
                border-left: 2px solid var(--amber);
            }

            .register-card::after {
                content: "";
                position: absolute;
                bottom: -11px;
                right: -11px;
                width: 22px;
                height: 22px;
                border-bottom: 2px solid var(--amber);
                border-right: 2px solid var(--amber);
            }

        .register-header {
            text-align: center;
            margin-bottom: 32px;
        }

            .register-header .brand {
                font-family: 'Barlow Condensed', sans-serif;
                font-weight: 900;
                font-size: 28px;
                letter-spacing: 0.5px;
                color: var(--charcoal);
                text-transform: uppercase;
            }

                .register-header .brand span {
                    color: var(--amber);
                }

            .register-header h1 {
                font-family: 'Barlow Condensed', sans-serif;
                font-size: 32px;
                font-weight: 800;
                text-transform: uppercase;
                color: var(--ink);
                margin-top: 8px;
                letter-spacing: 0.3px;
            }

            .register-header .subtitle {
                color: var(--steel-gray);
                font-size: 14px;
                font-family: 'IBM Plex Mono', monospace;
                margin-top: 4px;
            }

        .form-group {
            margin-bottom: 18px;
        }

            .form-group label {
                display: block;
                font-size: 10.5px;
                font-weight: 600;
                letter-spacing: 1.3px;
                text-transform: uppercase;
                color: var(--ink);
                margin-bottom: 6px;
                font-family: 'IBM Plex Mono', monospace;
            }

            .form-group .form-control {
                width: 100%;
                padding: 10px 14px;
                border: 1px solid var(--concrete-line);
                border-radius: 2px;
                font-size: 14px;
                font-family: 'IBM Plex Sans', sans-serif;
                color: var(--ink);
                background: #ffffff;
                transition: border-color 0.15s ease;
            }

                .form-group .form-control:focus {
                    outline: none;
                    border-color: var(--amber);
                    box-shadow: 0 0 0 3px rgba(253,184,19,0.1);
                }

            .form-group .form-control-file {
                padding: 8px 0;
                font-size: 13px;
                font-family: 'IBM Plex Sans', sans-serif;
                color: var(--ink);
                background: transparent;
                border: none;
                width: 100%;
            }

                .form-group .form-control-file::-webkit-file-upload-button {
                    background: var(--charcoal);
                    color: var(--amber);
                    border: none;
                    padding: 8px 16px;
                    border-radius: 2px;
                    font-size: 11px;
                    font-weight: 600;
                    font-family: 'IBM Plex Mono', monospace;
                    cursor: pointer;
                    text-transform: uppercase;
                    letter-spacing: 1px;
                }

                    .form-group .form-control-file::-webkit-file-upload-button:hover {
                        background: #05070a;
                        color: #ffffff;
                    }

            .form-group .text-danger {
                color: var(--danger);
                font-size: 12px;
                margin-top: 4px;
                display: block;
                font-family: 'IBM Plex Mono', monospace;
            }

            .form-group .text-muted {
                display: block;
                font-size: 11px;
                color: var(--steel-gray);
                margin-top: 4px;
                font-family: 'IBM Plex Mono', monospace;
            }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .form-row-3 {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 20px;
        }

        .required-star {
            color: var(--danger);
            margin-left: 2px;
        }

        .btn-register {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 15px;
            background: var(--charcoal);
            color: var(--amber);
            border: none;
            border-radius: 2px;
            font-size: 12.5px;
            font-weight: 700;
            letter-spacing: 1.8px;
            text-transform: uppercase;
            cursor: pointer;
            font-family: 'IBM Plex Mono', monospace;
            transition: background 0.15s ease, color 0.15s ease;
            margin-top: 8px;
        }

            .btn-register:hover {
                background: #05070a;
                color: #ffffff;
            }

        .login-link {
            text-align: center;
            margin-top: 18px;
            color: var(--steel-gray);
            font-size: 13px;
            font-family: 'IBM Plex Mono', monospace;
        }

            .login-link a {
                color: var(--amber);
                text-decoration: none;
                font-weight: 600;
                transition: color 0.15s ease;
            }

                .login-link a:hover {
                    color: var(--amber-deep);
                    text-decoration: underline;
                }

        .validation-summary {
            background: rgba(192, 57, 43, 0.1);
            color: var(--danger);
            padding: 12px 16px;
            border-radius: 2px;
            margin-bottom: 20px;
            border-left: 3px solid var(--danger);
            font-size: 13px;
            font-family: 'IBM Plex Mono', monospace;
        }

            .validation-summary ul {
                margin: 0;
                padding-left: 20px;
            }

        .site-bar {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            z-index: 3;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 26px 40px 0 40px;
        }

        .site-mark {
            display: flex;
            align-items: baseline;
            gap: 8px;
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 800;
            font-size: 20px;
            letter-spacing: 0.5px;
            color: #ffffff;
            text-transform: uppercase;
        }

            .site-mark span {
                color: var(--amber);
            }

        .site-status {
            display: flex;
            align-items: center;
            gap: 8px;
            font-family: 'IBM Plex Mono', monospace;
            font-size: 11px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.65);
        }

            .site-status .dot {
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: #3FCB6C;
                box-shadow: 0 0 0 0 rgba(63,203,108,0.6);
                animation: pulse 2.2s infinite;
            }

        @@keyframes pulse {
            0% {
                box-shadow: 0 0 0 0 rgba(63,203,108,0.55);
            }

            70% {
                box-shadow: 0 0 0 8px rgba(63,203,108,0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(63,203,108,0);
            }
        }

        /* Dark mode support */
        .dark-theme {
            --concrete: #1B222B;
            --concrete-line: #3A4756;
            --ink: #F1EFEA;
            --steel-gray: #A9A49A;
        }

        @@media (max-width: 768px) {
            .register-card {
                padding: 30px 20px;
                margin-top: 60px;
            }

                .register-card::before,
                .register-card::after {
                    display: none;
                }

            .form-row {
                grid-template-columns: 1fr;
                gap: 0;
            }

            .form-row-3 {
                grid-template-columns: 1fr;
                gap: 0;
            }

            .site-bar {
                padding: 18px 20px 0 20px;
            }

            .site-mark {
                font-size: 16px;
            }

            .register-header h1 {
                font-size: 24px;
            }
        }
    </style>
</head>
<body>
    <div class="register-hero">
        <!-- Top Status Bar -->
        <div class="site-bar">
            <div class="site-mark">MUHLE<span>OPS</span></div>
            <div class="site-status"><span class="dot"></span> Secure Registration</div>
        </div>

        <div class="register-card">
            <div class="register-header">
                <div class="brand">Muhle<span>Ops</span></div>
                <h1>Candidate Registration</h1>
                <p class="subtitle">// CREATE YOUR ACCOUNT TO APPLY FOR CONSTRUCTION JOBS</p>
            </div>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.SelectMany(v => v.Errors).Any())
            {
                <div class="validation-summary">
                    @Html.ValidationSummary(false, "Please fix the following errors:")
                </div>
            }

            @using (Html.BeginForm("Register", "Candidate", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()

                <div class="form-row">
                    <div class="form-group">
                        @Html.LabelFor(m => m.FirstName)
                        @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", placeholder = "John" })
                        @Html.ValidationMessageFor(m => m.FirstName)
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.LastName)
                        @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", placeholder = "Doe" })
                        @Html.ValidationMessageFor(m => m.LastName)
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Email)
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "john.doe@email.com" })
                        @Html.ValidationMessageFor(m => m.Email)
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.PhoneNumber)
                        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "+27 82 123 4567" })
                        @Html.ValidationMessageFor(m => m.PhoneNumber)
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Password)
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Minimum 6 characters" })
                        @Html.ValidationMessageFor(m => m.Password)
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.ConfirmPassword)
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Confirm your password" })
                        @Html.ValidationMessageFor(m => m.ConfirmPassword)
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        @Html.LabelFor(m => m.DateOfBirth)
                        @Html.TextBoxFor(m => m.DateOfBirth, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(m => m.DateOfBirth)
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.Gender)
                        @Html.DropDownListFor(m => m.Gender,
                            new SelectList(new[] { "Male", "Female", "Other" }),
                            "-- Select Gender --",
                            new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Gender)
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Nationality)
                        @Html.TextBoxFor(m => m.Nationality, new { @class = "form-control", placeholder = "South African" })
                        @Html.ValidationMessageFor(m => m.Nationality)
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.CurrentAddress)
                        @Html.TextAreaFor(m => m.CurrentAddress, new { @class = "form-control", rows = "2", placeholder = "123 Main St, Cape Town" })
                        @Html.ValidationMessageFor(m => m.CurrentAddress)
                    </div>
                </div>

                <div class="form-row-3">
                    <div class="form-group">
                        @Html.LabelFor(m => m.IdDocument)
                        <span class="required-star">*</span>
                        <input type="file" name="IdDocument" class="form-control-file" accept=".pdf,.doc,.docx,.jpg,.png" required />
                        @Html.ValidationMessageFor(m => m.IdDocument)
                        <span class="text-muted">PDF, DOC, JPG, PNG (Max 5MB)</span>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.Qualifications)
                        <span class="required-star">*</span>
                        <input type="file" name="Qualifications" class="form-control-file" accept=".pdf,.doc,.docx" required />
                        @Html.ValidationMessageFor(m => m.Qualifications)
                        <span class="text-muted">PDF, DOC (Max 5MB)</span>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.Cv)
                        <span class="required-star">*</span>
                        <input type="file" name="Cv" class="form-control-file" accept=".pdf,.doc,.docx" required />
                        @Html.ValidationMessageFor(m => m.Cv)
                        <span class="text-muted">PDF, DOC (Max 5MB)</span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        @Html.LabelFor(m => m.License)
                        <input type="file" name="License" class="form-control-file" accept=".pdf,.doc,.docx,.jpg,.png" />
                        @Html.ValidationMessageFor(m => m.License)
                        <span class="text-muted">Optional: Driver's License (PDF, DOC, JPG, PNG)</span>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.ProfilePicture)
                        <input type="file" name="ProfilePicture" class="form-control-file" accept=".jpg,.png" />
                        @Html.ValidationMessageFor(m => m.ProfilePicture)
                        <span class="text-muted">Optional: Profile Picture (JPG, PNG)</span>
                    </div>
                </div>

                <button type="submit" class="btn-register">
                    <i class="fas fa-user-plus"></i>
                    Register as Candidate
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                    </svg>
                </button>
            }

            <div class="login-link">
                Already have an account? <a href="@Url.Action("Login", "Account")">Login here</a>
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
</body>
</html>