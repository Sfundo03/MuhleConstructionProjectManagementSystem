@model MuhleOP.ViewModels.CandidateRegisterViewModel
@{
    ViewBag.Title = "Candidate Registration";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - MuhleOps</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: 'Inter', sans-serif;
            background: #f4f6f9;
            min-height: 100vh;
        }
        .register-hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
            background: linear-gradient(135deg, #16202C 0%, #1a2634 100%);
        }
        .register-card {
            max-width: 900px;
            width: 100%;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            padding: 40px;
        }
        .register-header {
            text-align: center;
            margin-bottom: 30px;
        }
        .register-header h1 {
            color: #16202C;
            font-size: 28px;
            font-weight: 800;
        }
        .register-header .subtitle {
            color: #6b7280;
            font-size: 14px;
        }
        .register-header .brand {
            color: #F5A623;
            font-weight: 900;
            font-size: 24px;
        }
        .form-group {
            margin-bottom: 20px;
        }
        .form-group label {
            display: block;
            font-weight: 600;
            font-size: 13px;
            color: #374151;
            margin-bottom: 6px;
        }
        .form-group .form-control {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            font-size: 14px;
            transition: border-color 0.15s ease;
            font-family: 'Inter', sans-serif;
        }
        .form-group .form-control:focus {
            outline: none;
            border-color: #F5A623;
            box-shadow: 0 0 0 3px rgba(245,166,35,0.1);
        }
        .form-group .form-control-file {
            padding: 8px 0;
        }
        .form-group .text-danger {
            color: #dc3545;
            font-size: 12px;
            margin-top: 4px;
            display: block;
        }
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }
        .form-row-3 {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 20px;
        }
        .btn-register {
            width: 100%;
            padding: 14px;
            background: #16202C;
            color: #fff;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: background 0.15s ease;
            font-family: 'Inter', sans-serif;
        }
        .btn-register:hover {
            background: #0e1620;
        }
        .btn-register i {
            margin-right: 8px;
        }
        .login-link {
            text-align: center;
            margin-top: 16px;
            color: #6b7280;
            font-size: 14px;
        }
        .login-link a {
            color: #F5A623;
            text-decoration: none;
            font-weight: 600;
        }
        .login-link a:hover {
            text-decoration: underline;
        }
        .validation-summary {
            background: #f8d7da;
            color: #721c24;
            padding: 12px 16px;
            border-radius: 6px;
            margin-bottom: 20px;
            border: 1px solid #f5c6cb;
        }
        .validation-summary ul {
            margin: 0;
            padding-left: 20px;
        }
        .required-star {
            color: #dc3545;
            margin-left: 2px;
        }
        @@media (max-width: 768px) {
            .register-card {
                padding: 24px;
            }
            .form-row {
                grid-template-columns: 1fr;
            }
            .form-row-3 {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="register-hero">
        <div class="register-card">
            <div class="register-header">
                <div class="brand">Muhle<span style="color:#16202C;">Ops</span></div>
                <h1>Candidate Registration</h1>
                <p class="subtitle">Create your account to apply for construction jobs</p>
            </div>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.SelectMany(v => v.Errors).Any())
            {
                <div class="validation-summary">
                    @Html.ValidationSummary(false, "Please fix the following errors:")
                </div>
            }

            @using (Html.BeginForm("Register", "Candidate", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()

                <div class="form-row">
                    <div class="form-group">
                        @Html.LabelFor(m => m.FirstName)
                        @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", placeholder = "John" })
                        @Html.ValidationMessageFor(m => m.FirstName)
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.LastName)
                        @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", placeholder = "Doe" })
                        @Html.ValidationMessageFor(m => m.LastName)
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Email)
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "john.doe@email.com" })
                        @Html.ValidationMessageFor(m => m.Email)
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.PhoneNumber)
                        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "+27 82 123 4567" })
                        @Html.ValidationMessageFor(m => m.PhoneNumber)
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Password)
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Minimum 6 characters" })
                        @Html.ValidationMessageFor(m => m.Password)
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.ConfirmPassword)
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Confirm your password" })
                        @Html.ValidationMessageFor(m => m.ConfirmPassword)
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        @Html.LabelFor(m => m.DateOfBirth)
                        @Html.TextBoxFor(m => m.DateOfBirth, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(m => m.DateOfBirth)
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.Gender)
                        @Html.DropDownListFor(m => m.Gender,
                            new SelectList(new[] { "Male", "Female", "Other" }),
                            "-- Select Gender --",
                            new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Gender)
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Nationality)
                        @Html.TextBoxFor(m => m.Nationality, new { @class = "form-control", placeholder = "South African" })
                        @Html.ValidationMessageFor(m => m.Nationality)
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.CurrentAddress)
                        @Html.TextAreaFor(m => m.CurrentAddress, new { @class = "form-control", rows = "2", placeholder = "123 Main St, Cape Town" })
                        @Html.ValidationMessageFor(m => m.CurrentAddress)
                    </div>
                </div>

                <div class="form-row-3">
                    <div class="form-group">
                        @Html.LabelFor(m => m.IdDocument)
                        <span class="required-star">*</span>
                        <input type="file" name="IdDocument" class="form-control-file" accept=".pdf,.doc,.docx,.jpg,.png" required />
                        @Html.ValidationMessageFor(m => m.IdDocument)
                        <small class="text-muted" style="display:block;font-size:11px;">PDF, DOC, JPG, PNG (Max 5MB)</small>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.Qualifications)
                        <span class="required-star">*</span>
                        <input type="file" name="Qualifications" class="form-control-file" accept=".pdf,.doc,.docx" required />
                        @Html.ValidationMessageFor(m => m.Qualifications)
                        <small class="text-muted" style="display:block;font-size:11px;">PDF, DOC (Max 5MB)</small>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.Cv)
                        <span class="required-star">*</span>
                        <input type="file" name="Cv" class="form-control-file" accept=".pdf,.doc,.docx" required />
                        @Html.ValidationMessageFor(m => m.Cv)
                        <small class="text-muted" style="display:block;font-size:11px;">PDF, DOC (Max 5MB)</small>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        @Html.LabelFor(m => m.License)
                        <input type="file" name="License" class="form-control-file" accept=".pdf,.doc,.docx,.jpg,.png" />
                        @Html.ValidationMessageFor(m => m.License)
                        <small class="text-muted" style="display:block;font-size:11px;">Optional: Driver's License (PDF, DOC, JPG, PNG)</small>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.ProfilePicture)
                        <input type="file" name="ProfilePicture" class="form-control-file" accept=".jpg,.png" />
                        @Html.ValidationMessageFor(m => m.ProfilePicture)
                        <small class="text-muted" style="display:block;font-size:11px;">Optional: Profile Picture (JPG, PNG)</small>
                    </div>
                </div>

                <button type="submit" class="btn-register">
                    <i class="fas fa-user-plus"></i> Register as Candidate
                </button>
            }

            <div class="login-link">
                Already have an account? <a href="@Url.Action("Login", "Account")">Login here</a>
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
</body>
</html>