﻿@model MuhleOP.ViewModels.ApplyJobViewModel
@{
    ViewBag.Title = "Job Details";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Job Details</h2>
        <p class="text-muted">
            <i class="fas fa-info-circle me-2"></i>
            Review the position details and requirements
        </p>
    </div>
    <div>
        @if (Model.HasApplied)
        {
            <span class="badge bg-success me-2" style="font-size:16px;padding:10px 20px;">
                <i class="fas fa-check-circle me-2"></i> Already Applied
            </span>
        }
        else
        {
            <a href="@Url.Action("Apply", new { id = Model.JobPostId })" class="btn btn-success me-2">
                <i class="fas fa-paper-plane"></i> Apply Now
            </a>
        }
        <a href="@Url.Action("BrowseJobs")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Jobs
        </a>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">&times;</button>
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <!-- Job Title -->
                <h3 class="mb-2">@Model.JobTitle</h3>

                <!-- Job Badges -->
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @if (!string.IsNullOrEmpty(Model.JobType))
                    {
                        <span class="badge bg-primary">
                            <i class="fas fa-briefcase me-1"></i> @Model.JobType
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(Model.Location))
                    {
                        <span class="badge bg-info">
                            <i class="fas fa-map-marker-alt me-1"></i> @Model.Location
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(Model.SalaryRange))
                    {
                        <span class="badge bg-success">
                            <i class="fas fa-money-bill-wave me-1"></i> @Model.SalaryRange
                        </span>
                    }
                    @if (Model.ClosingDate.HasValue)
                    {
                        <span class="badge bg-warning">
                            <i class="fas fa-calendar-alt me-1"></i> Closes: @Model.ClosingDate.Value.ToString("dd MMM yyyy")
                        </span>
                    }
                </div>

                <!-- Job Description -->
                <div class="mb-4">
                    <h5 class="border-bottom pb-2">
                        <i class="fas fa-file-alt text-gold me-2"></i>Job Description
                    </h5>
                    <div class="job-description">
                        @if (!string.IsNullOrEmpty(Model.JobDescription))
                        {
                            <p style="white-space: pre-wrap; line-height: 1.8;">@Model.JobDescription</p>
                        }
                        else
                        {
                            <p class="text-muted">No description provided.</p>
                        }
                    </div>
                </div>

                <!-- Requirements -->
                <div>
                    <h5 class="border-bottom pb-2">
                        <i class="fas fa-list-check text-gold me-2"></i>Requirements
                    </h5>
                    <div class="requirements">
                        @if (!string.IsNullOrEmpty(Model.Requirements))
                        {
                            <p style="white-space: pre-wrap; line-height: 1.8;">@Model.Requirements</p>
                        }
                        else
                        {
                            <p class="text-muted">No requirements listed.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="fas fa-bolt text-gold me-2"></i>Quick Actions
                </h5>
                <div class="d-grid gap-2">
                    @if (Model.HasApplied)
                    {
                        <button class="btn btn-success" disabled>
                            <i class="fas fa-check-circle me-2"></i> Already Applied
                        </button>
                        <div class="alert alert-info mt-2">
                            <i class="fas fa-info-circle me-2"></i>
                            You have already applied for this position. Please wait for feedback or check your email for updates.
                        </div>
                        <a href="@Url.Action("AllApplications", "Candidate")" class="btn btn-outline-info">
                            <i class="fas fa-chart-line me-2"></i> Check Application Status
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Apply", new { id = Model.JobPostId })" class="btn btn-success">
                            <i class="fas fa-paper-plane me-2"></i> Apply Now
                        </a>
                    }
                    <a href="@Url.Action("BrowseJobs")" class="btn btn-outline-secondary">
                        <i class="fas fa-list me-2"></i> Browse More Jobs
                    </a>
                    <a href="@Url.Action("Dashboard", "Home")" class="btn btn-outline-primary">
                        <i class="fas fa-home me-2"></i> Dashboard
                    </a>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="card-title">
                    <i class="fas fa-info-circle me-2"></i>Application Tips
                </h6>
                <ul class="list-unstyled small">
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Read the requirements carefully
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Tailor your cover letter to the role
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Ensure your CV is up to date
                    </li>
                    <li>
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Submit before the closing date
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<style>
    .text-gold {
        color: var(--primary-gold, #F5A623);
    }

    .border-bottom {
        border-bottom: 2px solid var(--border-color, #e9ecef) !important;
        padding-bottom: 8px;
    }

    .badge {
        font-size: 11px;
        padding: 5px 10px;
    }

        .badge.bg-warning {
            color: #fff;
        }

        .badge.bg-info {
            color: #fff;
        }

        .badge.bg-primary {
            color: #fff;
        }

        .badge.bg-success {
            color: #fff;
        }

    .job-description, .requirements {
        max-height: 400px;
        overflow-y: auto;
        padding-right: 10px;
    }

        .job-description::-webkit-scrollbar,
        .requirements::-webkit-scrollbar {
            width: 6px;
        }

        .job-description::-webkit-scrollbar-track,
        .requirements::-webkit-scrollbar-track {
            background: var(--bg-hover, #f1f1f1);
            border-radius: 3px;
        }

        .job-description::-webkit-scrollbar-thumb,
        .requirements::-webkit-scrollbar-thumb {
            background: var(--primary-gold, #F5A623);
            border-radius: 3px;
        }

    [data-theme="dark"] .job-description::-webkit-scrollbar-track,
    [data-theme="dark"] .requirements::-webkit-scrollbar-track {
        background: var(--bg-hover, #2d3748);
    }

    .btn-success {
        background-color: #1cc88a;
        border-color: #1cc88a;
    }

        .btn-success:hover {
            background-color: #17a673;
            border-color: #17a673;
        }

    .btn-outline-secondary {
        color: #858796;
        border-color: #858796;
    }

        .btn-outline-secondary:hover {
            background-color: #858796;
            color: #fff;
        }

    .btn-outline-primary {
        color: #4e73df;
        border-color: #4e73df;
    }

        .btn-outline-primary:hover {
            background-color: #4e73df;
            color: #fff;
        }

    .btn-outline-info {
        color: #36b9cc;
        border-color: #36b9cc;
    }

        .btn-outline-info:hover {
            background-color: #36b9cc;
            color: #fff;
        }
</style>