@model MuhleOP.ViewModels.ApplicationStatusViewModel
@{
    ViewBag.Title = "Application Status";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Application Status</h2>
        <p class="text-muted">Track the progress of your application for @Model.JobTitle</p>
    </div>
    <div>
        <a href="@Url.Action("AllApplications", "Candidate")" class="btn btn-secondary me-2">
            <i class="fas fa-arrow-left"></i> Back to Applications
        </a>
        <a href="@Url.Action("BrowseJobs", "Candidate")" class="btn btn-primary">
            <i class="fas fa-search"></i> Browse Jobs
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <!-- Application Details -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h4>@Model.JobTitle</h4>
                        <p class="text-muted">
                            <i class="fas fa-calendar-alt me-2"></i>
                            Applied on: @Model.ApplicationDate.ToString("dd MMMM yyyy HH:mm")
                        </p>
                    </div>
                    <div>
                        @if (Model.InterviewScheduled)
                        {
                            <span class="badge bg-info" style="font-size:16px;padding:8px 16px;">
                                <i class="fas fa-calendar-check me-2"></i> Interview Scheduled
                            </span>
                        }
                        else if (Model.IsShortlisted)
                        {
                            <span class="badge bg-success" style="font-size:16px;padding:8px 16px;">
                                <i class="fas fa-star me-2"></i> Shortlisted
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning" style="font-size:16px;padding:8px 16px;">
                                <i class="fas fa-clock me-2"></i> @Model.Status
                            </span>
                        }
                    </div>
                </div>

                @if (Model.InterviewScheduled && Model.InterviewDateTime.HasValue)
                {
                    <div class="alert alert-info mt-3">
                        <i class="fas fa-calendar-check me-2"></i>
                        <strong>Interview Scheduled:</strong>
                        @Model.InterviewDateTime.Value.ToString("dd MMMM yyyy HH:mm")
                        @if (!string.IsNullOrEmpty(Model.InterviewNotes))
                        {
                            <br />
                            <small class="text-muted">Notes: @Model.InterviewNotes</small>
                        }
                    </div>
                }

                <!-- Ranking Info -->
                @if (Model.RankingScore > 0)
                {
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <div class="bg-light p-3 rounded">
                                <small class="text-muted">Ranking Score</small>
                                <h3 class="mb-0">@Model.RankingScore</h3>
                                <div class="progress mt-2" style="height:6px;">
                                    <div class="progress-bar bg-@(Model.RankingScore >= 70 ? "success" : Model.RankingScore >= 50 ? "warning" : "danger")"
                                         style="width:@(Model.RankingScore)%"
                                         role="progressbar">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="bg-light p-3 rounded">
                                <small class="text-muted">Skills Match</small>
                                <h3 class="mb-0">@Model.SkillsMatchPercentage%</h3>
                                <div class="progress mt-2" style="height:6px;">
                                    <div class="progress-bar bg-primary"
                                         style="width:@(Model.SkillsMatchPercentage)%"
                                         role="progressbar">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Cover Letter -->
                @if (!string.IsNullOrEmpty(Model.CoverLetter))
                {
                    <div class="mt-3">
                        <h6>Cover Letter</h6>
                        <div class="bg-light p-3 rounded" style="white-space:pre-wrap;max-height:200px;overflow-y:auto;">
                            @Model.CoverLetter
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Status Timeline -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                <h6 class="mb-0">Application Timeline</h6>
                <span class="badge bg-secondary">@(Model.StatusHistory?.Count ?? 0) updates</span>
            </div>
            <div class="card-body">
                @if (Model.StatusHistory != null && Model.StatusHistory.Any())
                {
                    <div class="timeline">
                        @foreach (var item in Model.StatusHistory)
                        {
                            <div class="timeline-item">
                                <div class="timeline-badge bg-@GetStatusBadgeColor(item.Status)">
                                    <i class="fas fa-@GetStatusIcon(item.Status)"></i>
                                </div>
                                <div class="timeline-content">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="mb-1">@item.Status</h6>
                                            <p class="text-muted small mb-1">@item.Notes</p>
                                            <small class="text-muted">
                                                <i class="fas fa-user me-1"></i> @item.ChangedBy
                                            </small>
                                        </div>
                                        <small class="text-muted">@item.ChangeDate.ToString("dd MMM yyyy HH:mm")</small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="fas fa-clock fa-3x text-muted mb-3"></i>
                        <p class="text-muted">No status updates yet. Your application is being reviewed.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <!-- Quick Actions -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <h6 class="card-title">Quick Actions</h6>
                <div class="d-grid gap-2">
                    <a href="@Url.Action("BrowseJobs", "Candidate")" class="btn btn-outline-primary">
                        <i class="fas fa-search me-2"></i> Browse More Jobs
                    </a>
                    <a href="@Url.Action("AllApplications", "Candidate")" class="btn btn-outline-secondary">
                        <i class="fas fa-list me-2"></i> View All Applications
                    </a>
                    <a href="@Url.Action("Dashboard", "Home")" class="btn btn-outline-secondary">
                        <i class="fas fa-home me-2"></i> Dashboard
                    </a>
                </div>
            </div>
        </div>

        <!-- Application Summary -->
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="card-title">Application Summary</h6>
                <dl class="row small">
                    <dt class="col-6">Application ID:</dt>
                    <dd class="col-6">#@Model.ApplicationId</dd>
                    <dt class="col-6">Position:</dt>
                    <dd class="col-6">@Model.JobTitle</dd>
                    <dt class="col-6">Applied:</dt>
                    <dd class="col-6">@Model.ApplicationDate.ToString("dd MMM yyyy")</dd>
                    <dt class="col-6">Status:</dt>
                    <dd class="col-6">
                        @if (Model.InterviewScheduled)
                        {
                            <span class="badge bg-info">Interview</span>
                        }
                        else if (Model.IsShortlisted)
                        {
                            <span class="badge bg-success">Shortlisted</span>
                        }
                        else
                        {
                            <span class="badge bg-warning">@Model.Status</span>
                        }
                    </dd>
                    @if (Model.InterviewScheduled && Model.InterviewDateTime.HasValue)
                    {
                        <dt class="col-6">Interview:</dt>
                        <dd class="col-6">@Model.InterviewDateTime.Value.ToString("dd MMM HH:mm")</dd>
                    }
                    @if (Model.RankingScore > 0)
                    {
                        <dt class="col-6">Ranking:</dt>
                        <dd class="col-6">@Model.RankingScore</dd>
                    }
                    @if (Model.SkillsMatchPercentage > 0)
                    {
                        <dt class="col-6">Skills Match:</dt>
                        <dd class="col-6">@Model.SkillsMatchPercentage%</dd>
                    }
                </dl>
            </div>
        </div>

        <!-- Status Legend -->
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-body">
                <h6 class="card-title">Status Legend</h6>
                <div class="d-flex flex-column gap-2">
                    <div class="d-flex align-items-center">
                        <span class="badge bg-warning me-2" style="width:20px;height:20px;border-radius:50%;padding:0;"></span>
                        <span class="small">Pending - Application submitted, awaiting review</span>
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="badge bg-success me-2" style="width:20px;height:20px;border-radius:50%;padding:0;"></span>
                        <span class="small">Shortlisted - Candidate selected for interview</span>
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="badge bg-info me-2" style="width:20px;height:20px;border-radius:50%;padding:0;"></span>
                        <span class="small">Interview Scheduled - Interview date set</span>
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="badge bg-primary me-2" style="width:20px;height:20px;border-radius:50%;padding:0;"></span>
                        <span class="small">Interviewed - Interview completed</span>
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="badge bg-danger me-2" style="width:20px;height:20px;border-radius:50%;padding:0;"></span>
                        <span class="small">Rejected - Application unsuccessful</span>
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="badge bg-success me-2" style="width:20px;height:20px;border-radius:50%;padding:0;"></span>
                        <span class="small">Hired - Candidate offered position</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .timeline {
        position: relative;
        padding-left: 30px;
    }

        .timeline::before {
            content: '';
            position: absolute;
            left: 10px;
            top: 0;
            bottom: 0;
            width: 2px;
            background: var(--border-color);
        }

    .timeline-item {
        position: relative;
        margin-bottom: 25px;
        padding-left: 20px;
    }

        .timeline-item:last-child {
            margin-bottom: 0;
        }

    .timeline-badge {
        position: absolute;
        left: -24px;
        top: 0;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 14px;
    }

    .timeline-content {
        padding-left: 10px;
    }

    .bg-warning {
        background-color: #f6c23e;
    }

    .bg-info {
        background-color: #36b9cc;
    }

    .bg-success {
        background-color: #1cc88a;
    }

    .bg-danger {
        background-color: #e74a3b;
    }

    .bg-primary {
        background-color: #4e73df;
    }

    .bg-secondary {
        background-color: #858796;
    }

    [data-theme="dark"] .bg-light {
        background: var(--bg-hover) !important;
    }

    [data-theme="dark"] .timeline::before {
        background: var(--border-color);
    }

    .badge {
        font-size: 11px;
        padding: 5px 10px;
    }

        .badge.bg-warning {
            color: #fff;
        }

        .badge.bg-info {
            color: #fff;
        }

        .badge.bg-success {
            color: #fff;
        }

        .badge.bg-danger {
            color: #fff;
        }

        .badge.bg-primary {
            color: #fff;
        }

        .badge.bg-secondary {
            color: #fff;
        }
</style>

@functions {
    public string GetStatusBadgeColor(string status)
    {
        switch (status)
        {
            case "Pending": return "warning";
            case "Shortlisted": return "info";
            case "Interviewed": return "primary";
            case "Hired": return "success";
            case "Rejected": return "danger";
            default: return "secondary";
        }
    }

    public string GetStatusIcon(string status)
    {
        switch (status)
        {
            case "Pending": return "clock";
            case "Shortlisted": return "star";
            case "Interviewed": return "calendar-check";
            case "Hired": return "check-circle";
            case "Rejected": return "times-circle";
            default: return "circle";
        }
    }
}