﻿@model MuhleOP.ViewModels.QuizResultViewModel
@{
    ViewBag.Title = "Quiz Result";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                @if (Model.Passed)
                {
                    <div class="mb-4">
                        <div class="display-1 text-success">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <h2 class="text-success">Congratulations!</h2>
                        <p class="lead">You passed the quiz!</p>
                    </div>
                }
                else
                {
                    <div class="mb-4">
                        <div class="display-1 text-danger">
                            <i class="fas fa-times-circle"></i>
                        </div>
                        <h2 class="text-danger">Not Passed</h2>
                        <p class="lead">You did not reach the passing score.</p>
                    </div>
                }

                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="bg-hover p-3 rounded">
                            <small class="text-muted">Score</small>
                            <h3 class="mb-0">@Model.Score%</h3>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="bg-hover p-3 rounded">
                            <small class="text-muted">Correct Answers</small>
                            <h3 class="mb-0">@Model.CorrectAnswers / @Model.TotalQuestions</h3>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="bg-hover p-3 rounded">
                            <small class="text-muted">Passing Score</small>
                            <h3 class="mb-0">@Model.PassingScore%</h3>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="bg-hover p-3 rounded">
                            <small class="text-muted">Time Taken</small>
                            <h3 class="mb-0">@(Model.TimeTakenSeconds / 60)m @(Model.TimeTakenSeconds % 60)s</h3>
                        </div>
                    </div>
                </div>

                @if (Model.Passed)
                {
                    <div class="alert alert-success">
                        <i class="fas fa-star me-2"></i>
                        <strong>Great job!</strong> You have successfully passed the quiz for the <strong>@Model.JobTitle</strong> position.
                        Your application status has been updated. The hiring team will review your results.
                    </div>
                }
                else
                {
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Unfortunately,</strong> you did not pass the quiz for the <strong>@Model.JobTitle</strong> position.
                        The passing score is <strong>@Model.PassingScore%</strong>. You scored <strong>@Model.Score%</strong>.
                    </div>
                }

                <div class="mt-4">
                    <a href="@Url.Action("AllApplications")" class="btn btn-primary">
                        <i class="fas fa-list me-2"></i> View All Applications
                    </a>
                    <a href="@Url.Action("Dashboard", "Home")" class="btn btn-secondary">
                        <i class="fas fa-home me-2"></i> Dashboard
                    </a>
                </div>
            </div>
        </div>

        <!-- Review Answers -->
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-header bg-transparent border-0">
                <h6 class="mb-0"><i class="fas fa-list-check me-2"></i>Review Answers</h6>
            </div>
            <div class="card-body">
                @foreach (var question in Model.Questions)
                {
                    <div class="question-review mb-4 p-3 rounded @(question.IsCorrect ? "bg-success bg-opacity-10" : "bg-danger bg-opacity-10")">
                        <div class="d-flex align-items-start">
                            <span class="badge @(question.IsCorrect ? "bg-success" : "bg-danger") me-2">@(question.IsCorrect ? "✓" : "✗")</span>
                            <div>
                                <p class="fw-bold mb-2">@question.Question</p>
                                <div class="small">
                                    <div>
                                        <strong>Your Answer:</strong>
                                        <span class="@(question.IsCorrect ? "text-success" : "text-danger")">
                                            @(question.SelectedAnswer ?? "Not answered")
                                        </span>
                                    </div>
                                    @if (!question.IsCorrect)
                                    {
                                        <div>
                                            <strong>Correct Answer:</strong>
                                            <span class="text-success">@question.CorrectAnswer</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .bg-hover {
        background: var(--bg-hover, #f8f9fa);
    }

    [data-theme="dark"] .bg-hover {
        background: var(--bg-hover, #2d3748);
    }

    .bg-success.bg-opacity-10 {
        background-color: rgba(28, 200, 138, 0.1) !important;
    }

    .bg-danger.bg-opacity-10 {
        background-color: rgba(231, 74, 59, 0.1) !important;
    }
</style>