﻿@model MuhleOP.ViewModels.QuizResultViewModel
@{
    ViewBag.Title = "Quiz Result";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <div class="mb-4">
                    <div class="display-1 text-success">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <h2>Thank You!</h2>
                    <p class="lead mb-0">
                        Thank you for completing the quiz for the <strong>@Model.JobTitle</strong> position.
                    </p>
                    <p class="text-muted">
                        We will be in touch regarding the final decision.
                    </p>
                </div>

                <div class="mt-4">
                    <a href="@Url.Action("AllApplications")" class="btn btn-primary">
                        <i class="fas fa-list me-2"></i> View All Applications
                    </a>
                    <a href="@Url.Action("Dashboard", "Home")" class="btn btn-secondary">
                        <i class="fas fa-home me-2"></i> Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
