
@model List<MuhleOP.ViewModels.ApplicationStatusViewModel>
@{
    ViewBag.Title = "My Applications";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>My Applications</h2>
        <p class="text-muted">Track the status of all your job applications</p>
    </div>
    <a href="@Url.Action("BrowseJobs", "Candidate")" class="btn btn-primary">
        <i class="fas fa-search me-2"></i> Browse More Jobs
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Job Title</th>
                            <th>Date Applied</th>
                            <th>Status</th>
                            <th>Score</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model)
                        {
                            <tr class="@(app.InterviewScheduled ? "table-info" : app.IsShortlisted ? "table-success" : "")">
                                <td>
                                    <strong>@app.JobTitle</strong>
                                    @if (app.InterviewScheduled && app.InterviewDateTime.HasValue)
                                    {
                                        <br />
                                        <small class="text-muted">
                                            <i class="fas fa-calendar-check text-info me-1"></i>
                                            Interview: @app.InterviewDateTime.Value.ToString("dd MMM yyyy HH:mm")
                                        </small>
                                    }
                                </td>
                                <td>@app.ApplicationDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (app.InterviewScheduled)
                                    {
                                        <span class="badge bg-info">Interview Scheduled</span>
                                    }
                                    else if (app.IsShortlisted)
                                    {
                                        <span class="badge bg-success">Shortlisted</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-@(app.Status == "Pending" ? "warning" : "secondary")">
                                            @app.Status
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (app.RankingScore > 0)
                                    {
                                        <div class="d-flex align-items-center">
                                            <span class="fw-bold me-2">@app.RankingScore</span>
                                            <div class="progress" style="width:60px;height:6px;">
                                                <div class="progress-bar bg-@(app.RankingScore >= 70 ? "success" : app.RankingScore >= 50 ? "warning" : "danger")"
                                                     style="width:@(app.RankingScore)%;"
                                                     role="progressbar"
                                                     aria-valuenow="@app.RankingScore"
                                                     aria-valuemin="0"
                                                     aria-valuemax="100">
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td>
                                    <a href="@Url.Action("ApplicationStatus", "Candidate", new { id = app.ApplicationId })" class="btn btn-sm btn-primary">
                                        <i class="fas fa-eye me-1"></i> View Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
                <h4>No Applications Yet</h4>
                <p class="text-muted">You haven't applied for any jobs yet.</p>
                <a href="@Url.Action("BrowseJobs", "Candidate")" class="btn btn-primary mt-2">
                    <i class="fas fa-search me-2"></i> Browse Jobs
                </a>
            </div>
        }
    </div>
</div>

<style>
    .table-success {
        background-color: var(--bg-success, rgba(28, 200, 138, 0.1)) !important;
    }

    .table-info {
        background-color: var(--bg-info, rgba(54, 185, 204, 0.1)) !important;
    }

    [data-theme="dark"] .table-success {
        background-color: rgba(28, 200, 138, 0.2) !important;
    }

    [data-theme="dark"] .table-info {
        background-color: rgba(54, 185, 204, 0.2) !important;
    }

    .badge {
        font-size: 11px;
        padding: 5px 10px;
    }

        .badge.bg-warning {
            color: #fff;
        }

        .badge.bg-info {
            color: #fff;
        }

        .badge.bg-success {
            color: #fff;
        }

        .badge.bg-secondary {
            color: #fff;
        }

    .progress {
        background-color: var(--bg-hover);
    }

    .btn-sm {
        padding: 4px 10px;
        font-size: 12px;
    }
</style>