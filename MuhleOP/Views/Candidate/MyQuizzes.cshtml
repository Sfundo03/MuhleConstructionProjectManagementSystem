@model List<MuhleOP.ViewModels.QuizAttemptViewModel>
@{
    ViewBag.Title = "My Quizzes";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>My Quizzes</h2>
        <p class="text-muted">
            <i class="fas fa-brain me-2"></i>
            View all your quiz attempts and results
        </p>
    </div>
    <a href="@Url.Action("AllApplications")" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back to Applications
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">&times;</button>
    </div>
}

@if (Model != null && Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Quiz Title</th>
                            <th>Position</th>
                            <th>Date</th>
                            <th>Score</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var attempt in Model)
                        {
                            <tr>
                                <td><strong>@attempt.QuizTitle</strong></td>
                                <td>@attempt.JobTitle</td>
                                <td>
                                    @if (attempt.Status == "Available")
                                    {
                                        <span class="text-muted">Not started yet</span>
                                    }
                                    else
                                    {
                                        @attempt.StartTime.ToString("dd MMM yyyy HH:mm")
                                    }
                                </td>
                                <td>
                                    @if (attempt.Score.HasValue)
                                    {
                                        <span class="badge @(attempt.Passed == true ? "bg-success" : "bg-danger")">
                                            @attempt.Score%
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">N/A</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-@attempt.StatusBadgeColor">
                                        @(attempt.Status == "Available" ? "Not Started" : attempt.Status)
                                    </span>
                                </td>
                                <td>
                                    @if (attempt.Status == "Available")
                                    {
                                        <a href="@Url.Action("TakeQuiz", "Candidate", new { id = attempt.ApplicationId })" class="btn btn-sm btn-primary">
                                            <i class="fas fa-play"></i> Take Quiz
                                        </a>
                                    }
                                    else if (attempt.Status == "Completed")
                                    {
                                        <a href="@Url.Action("QuizResult", "Candidate", new { id = attempt.AttemptId })" class="btn btn-sm btn-outline-info">
                                            <i class="fas fa-eye"></i> View Result
                                        </a>
                                    }
                                    else if (attempt.Status == "InProgress")
                                    {
                                        <a href="@Url.Action("ResumeQuiz", "Candidate", new { id = attempt.AttemptId })" class="btn btn-sm btn-warning">
                                            <i class="fas fa-play"></i> Resume
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="fas fa-brain fa-4x text-muted mb-3" style="opacity:0.3;"></i>
            <h4>No Quiz Attempts</h4>
            <p class="text-muted">You haven't taken any quizzes yet.</p>
            <a href="@Url.Action("BrowseJobs")" class="btn btn-primary">
                <i class="fas fa-briefcase me-2"></i> Browse Jobs
            </a>
        </div>
    </div>
}