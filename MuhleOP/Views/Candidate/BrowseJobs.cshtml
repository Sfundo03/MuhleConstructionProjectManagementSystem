﻿@model List<MuhleOP.ViewModels.JobPostSummaryViewModel>
@{
    ViewBag.Title = "Browse Jobs";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Available Positions</h2>
        <p class="text-muted">
            <i class="fas fa-briefcase me-2"></i>
            Browse and apply for open positions at Muhle Building
        </p>
    </div>
    <div>
        <a href="@Url.Action("Dashboard", "Home")" class="btn btn-secondary me-2">
            <i class="fas fa-home"></i> Dashboard
        </a>
        <a href="@Url.Action("AllApplications", "Candidate")" class="btn btn-outline-primary">
            <i class="fas fa-file-alt"></i> My Applications
        </a>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">&times;</button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">&times;</button>
    </div>
}

<div class="row">
    @if (Model != null && Model.Any())
    {
        foreach (var job in Model)
        {
            <div class="col-lg-6 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <h5 class="card-title mb-2">@job.JobTitle</h5>
                            <span class="badge @(job.DaysLeft > 7 ? "bg-success" : job.DaysLeft > 3 ? "bg-warning" : "bg-danger")">
                                @if (job.DaysLeft > 0)
                                {
                                    <text>@job.DaysLeft days left</text>
                                }
                                else
                                {
                                    <text>Closing soon</text>
                                }
                            </span>
                        </div>

                        <p class="text-muted small mb-2">
                            <i class="fas fa-building me-1"></i>@(job.Department ?? "N/A")
                            <i class="fas fa-map-marker-alt ms-2 me-1"></i>@(job.Location ?? "N/A")
                        </p>

                        <div class="mb-3">
                            <span class="badge bg-secondary">@job.JobType</span>
                            <span class="badge bg-info">Closes: @job.ClosingDate.ToString("dd MMM yyyy")</span>
                            <span class="badge bg-primary">@job.ApplicationCount applications</span>
                            @if (job.HasApplied)
                            {
                                <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i> Applied</span>
                            }
                        </div>

                        <div class="d-flex gap-2">
                            <a href="@Url.Action("JobDetails", new { id = job.Id })" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-eye"></i> View Details
                            </a>
                            @if (job.HasApplied)
                            {
                                <a href="@Url.Action("ApplicationStatus", "Candidate", new { id = 0 })" class="btn btn-outline-info btn-sm">
                                    <i class="fas fa-chart-line"></i> Check Status
                                </a>
                            }
                            else
                            {
                                <a href="@Url.Action("Apply", new { id = job.Id })" class="btn btn-success btn-sm">
                                    <i class="fas fa-paper-plane"></i> Apply Now
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="fas fa-search fa-4x text-muted mb-3" style="opacity:0.3;"></i>
                    <h4>No Jobs Available</h4>
                    <p class="text-muted">There are currently no open positions. Please check back later.</p>
                    <a href="@Url.Action("Dashboard", "Home")" class="btn btn-primary">
                        <i class="fas fa-arrow-left"></i> Back to Dashboard
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .badge {
        font-size: 11px;
        padding: 5px 10px;
    }

        .badge.bg-warning {
            color: #fff;
        }

        .badge.bg-info {
            color: #fff;
        }

        .badge.bg-success {
            color: #fff;
        }

        .badge.bg-danger {
            color: #fff;
        }

        .badge.bg-secondary {
            color: #fff;
        }

        .badge.bg-primary {
            color: #fff;
        }

    .btn-sm {
        padding: 4px 12px;
        font-size: 12px;
    }
</style>