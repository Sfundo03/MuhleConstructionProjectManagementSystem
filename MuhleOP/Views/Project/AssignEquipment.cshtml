@model MuhleOP.ViewModels.AssignEquipmentViewModel
@{
    ViewBag.Title = "Assign Equipment - " + Model.ProjectName;
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Assign Equipment to Project</h2>
        <p class="text-muted">
            <i class="fas fa-tools me-2"></i>
            @Model.ProjectName - Allocate available equipment to the project
        </p>
    </div>
    <div>
        <a href="@Url.Action("Details", "Project", new { id = Model.ProjectId })" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Project
        </a>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary ms-2">
            <i class="fas fa-list"></i> All Projects
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-transparent border-0">
                <h6 class="mb-0"><i class="fas fa-plus-circle text-gold me-2"></i>Assign New Equipment</h6>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("AssignEquipment", "Project", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.ProjectId)
                    @Html.HiddenFor(m => m.ProjectName)
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.EquipmentId, new { @class = "form-label fw-bold" })
                        @Html.DropDownListFor(m => m.EquipmentId, Model.AvailableEquipment, "-- Select Equipment --", new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.EquipmentId, "", new { @class = "text-danger" })
                        <small class="text-muted d-block mt-1">Only equipment marked Available and not already assigned is listed.</small>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(m => m.StartDate, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                            @Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(m => m.EndDate, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                            @Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "text-danger" })
                            <small class="text-muted">Leave blank for ongoing assignment.</small>
                        </div>
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.ConditionOnAssignment, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.ConditionOnAssignment, new { @class = "form-control", placeholder = "e.g. Good, Excellent (leave blank to use current equipment condition)" })
                        @Html.ValidationMessageFor(m => m.ConditionOnAssignment, "", new { @class = "text-danger" })
                    </div>

                    if (Model.CertificationWarnings != null && Model.CertificationWarnings.Any())
                    {
                        <div class="alert alert-warning">
                            <strong>Certification Warning:</strong> Required certifications missing for assigned project staff: @string.Join(", ", Model.CertificationWarnings)
                        </div>
                        <div class="mb-3 form-check">
                            @Html.CheckBoxFor(m => m.OverrideCertification, new { @class = "form-check-input" })
                            @Html.LabelFor(m => m.OverrideCertification, new { @class = "form-check-label fw-bold text-warning" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(m => m.CertificationOverrideReason, new { @class = "form-label fw-bold" })
                            @Html.TextAreaFor(m => m.CertificationOverrideReason, new { @class = "form-control", rows = "2", placeholder = "Provide justification for overriding..." })
                            @Html.ValidationMessageFor(m => m.CertificationOverrideReason, "", new { @class = "text-danger" })
                        </div>
                    }

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Notes, new { @class = "form-label fw-bold" })
                        @Html.TextAreaFor(m => m.Notes, new { @class = "form-control", rows = "3", placeholder = "Any notes about this assignment..." })
                        @Html.ValidationMessageFor(m => m.Notes, "", new { @class = "text-danger" })
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-check"></i> Assign Equipment
                    </button>
                    <a href="@Url.Action("Details", "Project", new { id = Model.ProjectId })" class="btn btn-outline-secondary ms-2">Cancel</a>
                }
            </div>
        </div>

        @if (Model.WaitlistSuggestions != null && Model.WaitlistSuggestions.Any())
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-transparent border-0">
                    <h6 class="mb-0 text-info"><i class="fas fa-clock me-2"></i>Alternatives Available Soon</h6>
                </div>
                <div class="card-body">
                    <p class="text-muted small">No equipment is currently available, but the following items are expected to be free within 14 days:</p>
                    <ul class="list-group list-group-flush">
                        @foreach (var w in Model.WaitlistSuggestions)
                        {
                            <li class="list-group-item d-xl-flex justify-content-between align-items-center px-0">
                                <div>
                                    <strong>@w.EquipmentName</strong> (@w.EquipmentCode)<br />
                                    <small class="text-muted">Currently on: @w.CurrentProjectName</small>
                                </div>
                                <span class="badge bg-info">Free by: @(w.ExpectedFreeDate.HasValue ? w.ExpectedFreeDate.Value.ToString("dd MMM yyyy") : "Soon")</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }

        @if (Model.UnderRepairEquipment != null && Model.UnderRepairEquipment.Any())
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-transparent border-0">
                    <h6 class="mb-0 text-danger"><i class="fas fa-wrench me-2"></i>Not Available — Under Repair / Damaged</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Equipment</th>
                                    <th>Code</th>
                                    <th>Status</th>
                                    <th>Condition</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.UnderRepairEquipment)
                                {
                                    <tr>
                                        <td>@r.EquipmentName</td>
                                        <td>@r.EquipmentCode</td>
                                        <td><span class="badge bg-danger">@r.Status</span></td>
                                        <td>@r.Condition</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0">
                <h6 class="mb-0"><i class="fas fa-tools text-gold me-2"></i>Currently Assigned (@(Model.CurrentAssignments?.Count ?? 0))</h6>
            </div>
            <div class="card-body">
                @if (Model.CurrentAssignments != null && Model.CurrentAssignments.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Equipment</th>
                                    <th>Dates</th>
                                    <th>Condition</th>
                                    <th>Flags</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.CurrentAssignments)
                                {
                                    <tr>
                                        <td>
                                            <strong>@item.EquipmentName</strong><br />
                                            <small class="text-muted">@item.EquipmentCode</small>
                                        </td>
                                        <td>
                                            <small>@item.StartDate.ToString("dd MMM") — @(item.EndDate.HasValue ? item.EndDate.Value.ToString("dd MMM yyyy") : "Ongoing")</small>
                                        </td>
                                        <td>@item.ConditionOnAssignment</td>
                                        <td>
                                            @if (item.HasSecondaryApprovalRequest)
                                            {
                                                <span class="badge bg-warning mb-1" title="Secondary Approval Requested">Sec. Approval</span>
                                            }
                                            @if (item.HasTransportNote)
                                            {
                                                <span class="badge bg-secondary" title="Transport Required">Transport</span>
                                            }
                                            @if (!item.HasSecondaryApprovalRequest && !item.HasTransportNote)
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-3">
                        <i class="fas fa-tools fa-2x text-muted mb-2" style="opacity:0.3;"></i>
                        <p class="text-muted mb-0">No equipment currently assigned.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .text-gold {
        color: var(--primary-gold, #F5A623);
    }
</style>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}