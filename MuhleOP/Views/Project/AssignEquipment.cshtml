﻿@model MuhleOP.ViewModels.AssignEquipmentViewModel
@{
    ViewBag.Title = "Assign Equipment";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Assign Equipment to Project</h2>
        <p class="text-muted">
            <i class="fas fa-tools me-2"></i>
            @Model.ProjectName - Assign equipment to the project
        </p>
    </div>
    <div>
        <a href="@Url.Action("Details", new { id = Model.ProjectId })" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Project
        </a>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary ms-2">
            <i class="fas fa-list"></i> All Projects
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">&times;</button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">&times;</button>
    </div>
}

<div class="row">
    <div class="col-lg-7">
        <!-- Assign New Equipment -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0">
                <h6 class="mb-0"><i class="fas fa-tools text-gold me-2"></i>Assign New Equipment</h6>
            </div>
            <div class="card-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.ProjectId)
                    @Html.HiddenFor(m => m.ProjectName)

                    <div class="mb-3">
                        @Html.LabelFor(m => m.EquipmentId, new { @class = "form-label fw-bold" })
                        @Html.DropDownListFor(m => m.EquipmentId, Model.AvailableEquipment, "-- Select Equipment --", new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.EquipmentId, "", new { @class = "text-danger" })
                        @if (!Model.AvailableEquipment.Any())
                        {
                            <small class="text-warning d-block mt-1">No equipment available for assignment</small>
                        }
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.ExpectedReturnDate, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.ExpectedReturnDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(m => m.ExpectedReturnDate, "", new { @class = "text-danger" })
                        <small class="text-muted d-block mt-1">Expected return date for the equipment</small>
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.ConditionOnAssignment, new { @class = "form-label fw-bold" })
                        @Html.DropDownListFor(m => m.ConditionOnAssignment,
                            new SelectList(new[] { "Excellent", "Good", "Fair", "Poor" }),
                            "-- Select Condition --",
                            new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.ConditionOnAssignment, "", new { @class = "text-danger" })
                        <small class="text-muted d-block mt-1">Condition of the equipment when assigned</small>
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Notes, new { @class = "form-label fw-bold" })
                        @Html.TextAreaFor(m => m.Notes, new { @class = "form-control", rows = "3", placeholder = "Any notes about this assignment..." })
                        @Html.ValidationMessageFor(m => m.Notes, "", new { @class = "text-danger" })
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-tools"></i> Assign Equipment
                    </button>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <!-- Current Assignments -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0">
                <h6 class="mb-0"><i class="fas fa-tools text-gold me-2"></i>Currently Assigned (@(Model.CurrentAssignments?.Count ?? 0))</h6>
            </div>
            <div class="card-body">
                @if (Model.CurrentAssignments != null && Model.CurrentAssignments.Any())
                {
                    @foreach (var assignment in Model.CurrentAssignments)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2 p-2 border-bottom">
                            <div>
                                <span class="fw-bold">@assignment.EquipmentName</span>
                                <br />
                                <small class="text-muted">@assignment.EquipmentCode</small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-@(assignment.IsActive ? "success" : "secondary")">
                                    @(assignment.IsActive ? "Active" : "Returned")
                                </span>
                                <br />
                                <small class="text-muted">
                                    @assignment.AssignedDate.ToString("dd MMM")
                                    @if (assignment.ExpectedReturnDate.HasValue)
                                    {
                                        <text>- @assignment.ExpectedReturnDate.Value.ToString("dd MMM")</text>
                                    }
                                </small>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-3">
                        <i class="fas fa-tools fa-2x text-muted mb-2" style="opacity:0.3;"></i>
                        <p class="text-muted">No equipment assigned yet</p>
                    </div>
                }
            </div>
        </div>

        <!-- Quick Stats -->
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-body">
                <h6 class="card-title"><i class="fas fa-info-circle me-2"></i>Equipment Assignment Tips</h6>
                <ul class="list-unstyled small">
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Check equipment availability
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Record condition on assignment
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Set expected return date
                    </li>
                    <li>
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Track equipment usage
                    </li>
                </ul>
            </div>
        </div>

        <!-- Available Equipment Count -->
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Available Equipment</span>
                    <span class="badge bg-primary" style="font-size:16px;padding:8px 16px;">@Model.AvailableEquipment.Count</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .text-gold {
        color: var(--primary-gold, #F5A623);
    }

    .form-control, .form-select {
        font-size: 14px;
        padding: 10px 14px;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary-gold, #F5A623);
            box-shadow: 0 0 0 3px rgba(245, 166, 35, 0.1);
        }

    .badge {
        font-size: 11px;
        padding: 5px 10px;
    }

        .badge.bg-info {
            color: #fff;
        }

        .badge.bg-success {
            color: #fff;
        }

        .badge.bg-secondary {
            color: #fff;
        }

        .badge.bg-primary {
            color: #fff;
        }

    .border-bottom {
        border-bottom: 1px solid var(--border-color) !important;
    }
</style>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}