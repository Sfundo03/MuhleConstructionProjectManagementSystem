@model MuhleOP.ViewModels.AssignEquipmentViewModel
@{
    ViewBag.Title = "Assign Equipment - " + Model.ProjectName;
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Assign Equipment to Project</h2>
        <p class="text-muted">
            <i class="fas fa-tools me-2"></i>
            @Model.ProjectName - Allocate available equipment to the project
        </p>
    </div>
    <div>
        <a href="@Url.Action("Details", "Project", new { id = Model.ProjectId })" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Project
        </a>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary ms-2">
            <i class="fas fa-list"></i> All Projects
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0">
                <h6 class="mb-0"><i class="fas fa-plus-circle text-gold me-2"></i>Assign New Equipment</h6>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("AssignEquipment", "Project", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.ProjectId)
                    @Html.HiddenFor(m => m.ProjectName)
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.EquipmentId, new { @class = "form-label fw-bold" })
                        @Html.DropDownListFor(m => m.EquipmentId, Model.AvailableEquipment, "-- Select Equipment --", new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.EquipmentId, "", new { @class = "text-danger" })
                        <small class="text-muted d-block mt-1">Only equipment marked Available and not already assigned is listed.</small>
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.ExpectedReturnDate, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.ExpectedReturnDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(m => m.ExpectedReturnDate, "", new { @class = "text-danger" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.ConditionOnAssignment, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.ConditionOnAssignment, new { @class = "form-control", placeholder = "e.g. Good, Excellent (leave blank to use current equipment condition)" })
                        @Html.ValidationMessageFor(m => m.ConditionOnAssignment, "", new { @class = "text-danger" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Notes, new { @class = "form-label fw-bold" })
                        @Html.TextAreaFor(m => m.Notes, new { @class = "form-control", rows = "3", placeholder = "Any notes about this assignment..." })
                        @Html.ValidationMessageFor(m => m.Notes, "", new { @class = "text-danger" })
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-check"></i> Assign Equipment
                    </button>
                    <a href="@Url.Action("Details", "Project", new { id = Model.ProjectId })" class="btn btn-outline-secondary ms-2">Cancel</a>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0">
                <h6 class="mb-0"><i class="fas fa-tools text-gold me-2"></i>Currently Assigned (@(Model.CurrentAssignments?.Count ?? 0))</h6>
            </div>
            <div class="card-body">
                @if (Model.CurrentAssignments != null && Model.CurrentAssignments.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Equipment</th>
                                    <th>Code</th>
                                    <th>Assigned</th>
                                    <th>Expected Return</th>
                                    <th>Condition</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.CurrentAssignments)
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(m => item.EquipmentName)</td>
                                        <td>@Html.DisplayFor(m => item.EquipmentCode)</td>
                                        <td>@item.AssignedDate.ToString("dd MMM yyyy")</td>
                                        <td>@(item.ExpectedReturnDate.HasValue ? item.ExpectedReturnDate.Value.ToString("dd MMM yyyy") : "—")</td>
                                        <td>@Html.DisplayFor(m => item.ConditionOnAssignment)</td>
                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="badge bg-primary">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-3">
                        <i class="fas fa-tools fa-2x text-muted mb-2" style="opacity:0.3;"></i>
                        <p class="text-muted mb-0">No equipment currently assigned.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .text-gold {
        color: var(--primary-gold, #F5A623);
    }
</style>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}