﻿@model MuhleOP.ViewModels.InitiateProjectViewModel
@{
    ViewBag.Title = "Initiate Project";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Initiate Project</h2>
        <p class="text-muted">
            <i class="fas fa-rocket me-2"></i>
            Create a new construction project
        </p>
    </div>
    <a href="@Url.Action("Index")" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back to Projects
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <!-- Project Details -->
            <h5 class="mb-3"><i class="fas fa-info-circle text-gold me-2"></i>Project Details</h5>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.ProjectName, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.ProjectName, new { @class = "form-control", placeholder = "e.g. Riverside Mall Development" })
                        @Html.ValidationMessageFor(m => m.ProjectName, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.ProjectLocation, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.ProjectLocation, new { @class = "form-control", placeholder = "e.g. Cape Town, South Africa" })
                        @Html.ValidationMessageFor(m => m.ProjectLocation, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.ClientId, new { @class = "form-label fw-bold" })
                        @Html.DropDownListFor(m => m.ClientId, Model.Clients, "-- Select Client --", new { @class = "form-select", id = "clientDropdown" })
                        @Html.ValidationMessageFor(m => m.ClientId, "", new { @class = "text-danger" })
                        <small class="text-muted d-block mt-1">Only clients with a signed contract are listed</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.ContractId, new { @class = "form-label fw-bold" })
                        @Html.DropDownListFor(m => m.ContractId, Model.Contracts, "-- Select Contract --", new { @class = "form-select", id = "contractDropdown" })
                        @Html.ValidationMessageFor(m => m.ContractId, "", new { @class = "text-danger" })
                        <small class="text-muted d-block mt-1" id="contractHint">Select a client first</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.EstimatedCost, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.EstimatedCost, new { @class = "form-control", type = "number", step = "0.01", placeholder = "e.g. 5000000", id = "estimatedCostInput" })
                        @Html.ValidationMessageFor(m => m.EstimatedCost, "", new { @class = "text-danger" })
                        <small class="text-muted d-block mt-1" id="budgetHint">Estimated project cost in ZAR - cannot exceed the contract value</small>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.ProjectManagerId, new { @class = "form-label fw-bold" })
                        @Html.DropDownListFor(m => m.ProjectManagerId, Model.ProjectManagers, "-- Select Project Manager --", new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.ProjectManagerId, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.SiteManagerId, new { @class = "form-label fw-bold" })
                        @Html.DropDownListFor(m => m.SiteManagerId, Model.SiteManagers, "-- Select Site Manager --", new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.SiteManagerId, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.BudgetCategory, new { @class = "form-label fw-bold" })
                        @Html.DropDownListFor(m => m.BudgetCategory,
                            new SelectList(new[] { "Labour", "Materials", "Equipment", "Subcontractors", "Overhead" }),
                            "-- Select Budget Category --",
                            new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.BudgetCategory, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.StartDate, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.EstimatedEndDate, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.EstimatedEndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(m => m.EstimatedEndDate, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <!-- Scope Definition -->
            <h5 class="mb-3 mt-4"><i class="fas fa-list-check text-gold me-2"></i>Scope Definition</h5>

            <div class="mb-3">
                @Html.LabelFor(m => m.Objectives, new { @class = "form-label fw-bold" })
                @Html.TextAreaFor(m => m.Objectives, new { @class = "form-control", rows = "3", placeholder = "Define the project objectives and goals..." })
                @Html.ValidationMessageFor(m => m.Objectives, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.ScopeDefinition, new { @class = "form-label fw-bold" })
                @Html.TextAreaFor(m => m.ScopeDefinition, new { @class = "form-control", rows = "4", placeholder = "Describe the full scope of work..." })
                @Html.ValidationMessageFor(m => m.ScopeDefinition, "", new { @class = "text-danger" })
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.OutOfScope, new { @class = "form-label fw-bold" })
                        @Html.TextAreaFor(m => m.OutOfScope, new { @class = "form-control", rows = "3", placeholder = "What is explicitly out of scope..." })
                        @Html.ValidationMessageFor(m => m.OutOfScope, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Assumptions, new { @class = "form-label fw-bold" })
                        @Html.TextAreaFor(m => m.Assumptions, new { @class = "form-control", rows = "3", placeholder = "List key assumptions..." })
                        @Html.ValidationMessageFor(m => m.Assumptions, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Constraints, new { @class = "form-label fw-bold" })
                @Html.TextAreaFor(m => m.Constraints, new { @class = "form-control", rows = "3", placeholder = "List project constraints..." })
                @Html.ValidationMessageFor(m => m.Constraints, "", new { @class = "text-danger" })
            </div>

            <!-- Deliverables -->
            <h5 class="mb-3 mt-4"><i class="fas fa-box text-gold me-2"></i>Deliverables</h5>

            <div class="mb-3">
                @Html.LabelFor(m => m.Deliverables, new { @class = "form-label fw-bold" })
                @Html.TextAreaFor(m => m.Deliverables, new { @class = "form-control", rows = "4", placeholder = "List all project deliverables (one per line)..." })
                @Html.ValidationMessageFor(m => m.Deliverables, "", new { @class = "text-danger" })
                <small class="text-muted d-block mt-1">Enter each deliverable on a new line</small>
            </div>

            <div class="alert alert-info mt-3">
                <i class="fas fa-info-circle me-2"></i>
                <strong>Note:</strong> Selecting a client narrows the Contract list to that client's signed contracts. Selecting a contract
                auto-fills Objectives, Scope Definition and Deliverables from it (still fully editable), and caps Estimated Cost at the
                contract value. The project is created with "Initiated" status; you can assign staff and equipment after creation.
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-rocket"></i> Initiate Project
                </button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="fas fa-times"></i> Cancel
                </a>
            </div>
        }
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0">
                <h6 class="mb-0"><i class="fas fa-lightbulb text-gold me-2"></i>Project Initiation Tips</h6>
            </div>
            <div class="card-body">
                <ul class="list-unstyled small">
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Ensure client and contract are selected
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Assign a Project Manager
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Define clear objectives and scope
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        List all expected deliverables
                    </li>
                    <li>
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Review budget and timeline
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<style>
    .text-gold {
        color: var(--primary-gold, #F5A623);
    }

    .form-control, .form-select {
        font-size: 14px;
        padding: 10px 14px;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary-gold, #F5A623);
            box-shadow: 0 0 0 3px rgba(245, 166, 35, 0.1);
        }
</style>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        // Cascading Client -> Contract -> auto-filled Scope/Objectives/Deliverables.
        // Every auto-filled field remains a normal editable textarea - the
        // Project Manager can adjust anything before submitting.
        (function () {
            var clientDropdown = document.getElementById('clientDropdown');
            var contractDropdown = document.getElementById('contractDropdown');
            var contractHint = document.getElementById('contractHint');
            var estimatedCostInput = document.getElementById('estimatedCostInput');
            var budgetHint = document.getElementById('budgetHint');
            var objectivesField = document.getElementById('Objectives');
            var scopeField = document.getElementById('ScopeDefinition');
            var deliverablesField = document.getElementById('Deliverables');
            var contractValue = null;

            function resetContractDropdown(placeholderText) {
                contractDropdown.innerHTML = '<option value="">' + placeholderText + '</option>';
            }

            function loadContractsForClient(clientId) {
                if (!clientId) {
                    resetContractDropdown('-- Select Client First --');
                    return;
                }
                resetContractDropdown('-- Loading contracts... --');
                fetch('@Url.Action("GetClientContracts", "Project")?clientId=' + encodeURIComponent(clientId))
                    .then(function (r) { return r.json(); })
                    .then(function (contracts) {
                        resetContractDropdown('-- Select Contract --');
                        contracts.forEach(function (c) {
                            var opt = document.createElement('option');
                            opt.value = c.id;
                            opt.textContent = c.text;
                            contractDropdown.appendChild(opt);
                        });
                        contractHint.textContent = contracts.length
                            ? 'Signed contracts for this client'
                            : 'This client has no signed contracts';
                    })
                    .catch(function () {
                        resetContractDropdown('-- Unable to load contracts --');
                    });
            }

            function loadContractDetails(contractId) {
                if (!contractId) {
                    contractValue = null;
                    estimatedCostInput.removeAttribute('max');
                    budgetHint.textContent = 'Estimated project cost in ZAR - cannot exceed the contract value';
                    return;
                }
                fetch('@Url.Action("GetContractDetails", "Project")?contractId=' + encodeURIComponent(contractId))
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (!data.success) { return; }
                        contractValue = data.contractValue;
                        estimatedCostInput.max = contractValue;
                        budgetHint.textContent = 'Contract value: R' + Number(contractValue).toLocaleString(undefined, { minimumFractionDigits: 2 }) + ' - estimated cost cannot exceed this.';

                        // Auto-fill (still fully editable) from the signed contract.
                        if (objectivesField && !objectivesField.value.trim()) { objectivesField.value = data.objectives || ''; }
                        if (scopeField && !scopeField.value.trim()) { scopeField.value = data.scopeDefinition || ''; }
                        if (deliverablesField && !deliverablesField.value.trim()) { deliverablesField.value = data.deliverables || ''; }
                    });
            }

            if (clientDropdown) {
                clientDropdown.addEventListener('change', function () {
                    loadContractsForClient(this.value);
                });
            }

            if (contractDropdown) {
                contractDropdown.addEventListener('change', function () {
                    loadContractDetails(this.value);
                });
            }

            if (estimatedCostInput) {
                estimatedCostInput.addEventListener('input', function () {
                    if (contractValue !== null && parseFloat(this.value) > contractValue) {
                        this.setCustomValidity('Estimated cost cannot exceed the contract value of R' + contractValue);
                    } else {
                        this.setCustomValidity('');
                    }
                });
            }
        })();
    </script>
}