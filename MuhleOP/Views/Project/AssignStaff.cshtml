﻿@model MuhleOP.ViewModels.AssignStaffViewModel
@{
    ViewBag.Title = "Assign Staff";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Assign Staff to Project</h2>
        <p class="text-muted">
            <i class="fas fa-user-plus me-2"></i>
            @Model.ProjectName - Assign staff members to the project
        </p>
    </div>
    <div>
        <a href="@Url.Action("Details", new { id = Model.ProjectId })" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Project
        </a>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary ms-2">
            <i class="fas fa-list"></i> All Projects
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">&times;</button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">&times;</button>
    </div>
}

@if (Model.ConflictWarnings != null && Model.ConflictWarnings.Any())
{
    <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle me-2"></i><strong>Scheduling conflict detected:</strong>
        <ul class="mb-0 mt-2">
            @foreach (var warning in Model.ConflictWarnings)
            {
                <li>@warning</li>
            }
        </ul>
        <div class="mt-2">Tick <strong>Override Conflict</strong> below and provide a justification if you have permission to proceed anyway.</div>
    </div>
}

<div class="row">
    <div class="col-lg-7">
        <!-- Assign New Staff -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0">
                <h6 class="mb-0"><i class="fas fa-user-plus text-gold me-2"></i>Assign New Staff Member</h6>
            </div>
            <div class="card-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.ProjectId)
                    @Html.HiddenFor(m => m.ProjectName)

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                @Html.LabelFor(m => m.StaffId, new { @class = "form-label fw-bold" })
                                <select name="StaffId" id="StaffId" class="form-select">
                                    <option value="">-- Select Staff --</option>
                                    @foreach (var group in Model.AvailableStaffByRole)
                                    {
                                        <optgroup label="@group.Role (@group.Staff.Count available)">
                                            @foreach (var item in group.Staff)
                                            {
                                                if (item.Value == Model.StaffId.ToString())
                                                {
                                                    <option value="@item.Value" selected="selected">@item.Text</option>
                                                }
                                                else
                                                {
                                                    <option value="@item.Value">@item.Text</option>
                                                }
                                            }
                                        </optgroup>
                                    }
                                </select>
                                @Html.ValidationMessageFor(m => m.StaffId, "", new { @class = "text-danger" })
                                <small class="text-muted d-block mt-1">Grouped by role - Site Managers, Crew Members, Finance Officers, Procurement Officers, Project Managers. "CONFLICT" means they're already booked on another project for these dates.</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                @Html.LabelFor(m => m.Role, new { @class = "form-label fw-bold" })
                                @Html.DropDownListFor(m => m.Role, Model.AvailableRoles, "-- Select Role --", new { @class = "form-select" })
                                @Html.ValidationMessageFor(m => m.Role, "", new { @class = "text-danger" })
                                <small class="text-muted d-block mt-1">Only one active Project Manager and one active Site Manager per project</small>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                @Html.LabelFor(m => m.AllocationPercentage, new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(m => m.AllocationPercentage, new { @class = "form-control", type = "number", min = "0", max = "100" })
                                @Html.ValidationMessageFor(m => m.AllocationPercentage, "", new { @class = "text-danger" })
                                <small class="text-muted d-block mt-1">% of time allocated</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                @Html.LabelFor(m => m.StartDate, new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                                @Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                @Html.LabelFor(m => m.EndDate, new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                                @Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Notes, new { @class = "form-label fw-bold" })
                        @Html.TextAreaFor(m => m.Notes, new { @class = "form-control", rows = "3", placeholder = "Any notes about this assignment..." })
                        @Html.ValidationMessageFor(m => m.Notes, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-check mb-2">
                        @Html.CheckBoxFor(m => m.OverrideConflict, new { @class = "form-check-input" })
                        @Html.LabelFor(m => m.OverrideConflict, "Override Conflict (I have permission to assign this staff member despite the scheduling conflict shown above)", new { @class = "form-check-label" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.OverrideReason, "Override Justification (required if overriding)", new { @class = "form-label fw-bold" })
                        @Html.TextAreaFor(m => m.OverrideReason, new { @class = "form-control", rows = "2", placeholder = "e.g. Approved by Admin - staff will split time between projects" })
                        @Html.ValidationMessageFor(m => m.OverrideReason, "", new { @class = "text-danger" })
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-user-plus"></i> Assign Staff
                    </button>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <!-- Current Assignments -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0">
                <h6 class="mb-0"><i class="fas fa-users text-gold me-2"></i>Currently Assigned (@(Model.CurrentAssignments?.Count ?? 0))</h6>
            </div>
            <div class="card-body">
                @if (Model.CurrentAssignments != null && Model.CurrentAssignments.Any())
                {
                    foreach (var assignment in Model.CurrentAssignments)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2 p-2 border-bottom">
                            <div>
                                <span class="fw-bold">@assignment.StaffName</span>
                                <br />
                                <small class="text-muted">@assignment.Role</small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-info">@assignment.AllocationPercentage%</span>
                                <br />
                                <small class="text-muted">@assignment.StartDate.ToString("dd MMM") - @(assignment.EndDate?.ToString("dd MMM yyyy") ?? "Ongoing")</small>
                                <br />
                                @using (Html.BeginForm("DeassignStaff", "Project", FormMethod.Post, new { @class = "deassign-form" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("allocationId", assignment.Id)
                                    @Html.Hidden("projectId", Model.ProjectId)
                                    <button type="submit" class="btn btn-sm btn-outline-danger mt-1" data-staff-name="@assignment.StaffName">
                                        <i class="fas fa-user-minus"></i> Deassign
                                    </button>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-3">
                        <i class="fas fa-users fa-2x text-muted mb-2" style="opacity:0.3;"></i>
                        <p class="text-muted">No staff assigned yet</p>
                    </div>
                }
            </div>
        </div>

        <!-- Quick Stats -->
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-body">
                <h6 class="card-title"><i class="fas fa-info-circle me-2"></i>Assignment Tips</h6>
                <ul class="list-unstyled small">
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Assign appropriate roles
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Set realistic allocation percentages
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Ensure staff availability
                    </li>
                    <li>
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Review assignments regularly
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<style>
    .text-gold {
        color: var(--primary-gold, #F5A623);
    }

    .form-control, .form-select {
        font-size: 14px;
        padding: 10px 14px;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary-gold, #F5A623);
            box-shadow: 0 0 0 3px rgba(245, 166, 35, 0.1);
        }

    .badge {
        font-size: 11px;
        padding: 5px 10px;
    }

        .badge.bg-info {
            color: #fff;
        }

    .border-bottom {
        border-bottom: 1px solid var(--border-color) !important;
    }
</style>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.deassign-form').forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    var btn = form.querySelector('button[type="submit"]');
                    var name = btn ? btn.getAttribute('data-staff-name') : 'this staff member';
                    if (!confirm('Remove ' + name + ' from this project? They will become available for other assignments.')) {
                        e.preventDefault();
                    }
                });
            });

            // Only require/reveal the override justification once a conflict
            // exists or the checkbox is actually ticked.
            var overrideCheckbox = document.getElementById('OverrideConflict');
            var overrideReason = document.getElementById('OverrideReason');
            function syncOverrideState() {
                if (overrideCheckbox && overrideReason) {
                    overrideReason.closest('.mb-3').style.display = overrideCheckbox.checked ? '' : 'none';
                }
            }
            if (overrideCheckbox) {
                overrideCheckbox.addEventListener('change', syncOverrideState);
                syncOverrideState();
            }
        });
    </script>
}