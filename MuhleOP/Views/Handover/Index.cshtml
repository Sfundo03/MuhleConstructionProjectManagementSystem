@model MuhleOP.ViewModels.HandoverIndexViewModel
@{
    ViewBag.Title = "Project Handovers";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">Project Handovers</h4>
        <p class="text-muted mb-0">Manage final inspections, client sign-off and project closure</p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Project Manager") || User.IsInRole("Site Manager"))
    {
        <a href="@Url.Action("InitiateHandover")" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Initiate Handover
        </a>
    }
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small">Pending Handovers</div>
                        <div class="fs-3 fw-bold">@Model.PendingCount</div>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3">
                        <i class="fas fa-hourglass-half text-warning"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small">Awaiting Client Sign-off</div>
                        <div class="fs-3 fw-bold">@Model.AwaitingClientSignOffCount</div>
                    </div>
                    <div class="rounded-circle bg-info bg-opacity-10 p-3">
                        <i class="fas fa-signature text-info"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small">Completed This Month</div>
                        <div class="fs-3 fw-bold">@Model.CompletedThisMonthCount</div>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 p-3">
                        <i class="fas fa-check-circle text-success"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small">Total Documents</div>
                        <div class="fs-3 fw-bold">@Model.TotalDocumentsCount</div>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                        <i class="fas fa-folder-open text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Active Handovers</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Items == null || !Model.Items.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="fas fa-inbox fa-2x mb-3 opacity-50"></i>
                <p class="mb-0">No handovers yet. Initiate one for a completed project.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Project</th>
                            <th>Client</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Client Sign-off</th>
                            <th>Documents</th>
                            <th>Date</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@item.ProjectName</div>
                                    <small class="text-muted">@item.ProjectCode</small>
                                </td>
                                <td>@(item.ClientName ?? "—")</td>
                                <td>@item.HandoverType</td>
                                <td>
                                    <span class="badge bg-@item.StatusBadgeColor">@item.Status</span>
                                </td>
                                <td>
                                    <span class="badge bg-@item.ClientSignOffBadgeColor">@item.ClientSignOffStatus</span>
                                </td>
                                <td>@item.DocumentCount</td>
                                <td>@item.HandoverDate.ToString("dd MMM yyyy")</td>
                                <td class="text-end">
                                    <a href="@Url.Action("HandoverDetails", new { id = item.Id })" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>