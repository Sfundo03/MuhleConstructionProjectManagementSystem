
@model MuhleOP.ViewModels.ClientSignOffViewModel
@{
    ViewBag.Title = "Client Sign-off";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">Project Sign-off</h4>
        <p class="text-muted mb-0">@Model.ProjectName (@Model.ProjectCode) — @Model.HandoverType handover</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card mb-3">
            <div class="card-header fw-semibold">Project Summary</div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.FinalInspectionFindings))
                {
                    <div class="mb-3">
                        <div class="text-muted small">Final Inspection Findings</div>
                        <div>@Model.FinalInspectionFindings</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.CompletionNotes))
                {
                    <div class="mb-3">
                        <div class="text-muted small">Completion Notes</div>
                        <div style="white-space: pre-wrap;">@Model.CompletionNotes</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.LessonsLearned))
                {
                    <div class="mb-3">
                        <div class="text-muted small">Lessons Learned</div>
                        <div>@Model.LessonsLearned</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Recommendations))
                {
                    <div class="mb-3">
                        <div class="text-muted small">Recommendations</div>
                        <div>@Model.Recommendations</div>
                    </div>
                }
                <div class="row">
                    <div class="col-md-4">
                        <div class="text-muted small">Warranty Period</div>
                        <div>@(Model.WarrantyPeriodDays.HasValue ? Model.WarrantyPeriodDays + " days" : "—")</div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Warranty Start</div>
                        <div>@(Model.WarrantyStartDate.HasValue ? Model.WarrantyStartDate.Value.ToString("dd MMM yyyy") : "—")</div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Warranty End</div>
                        <div>@(Model.WarrantyEndDate.HasValue ? Model.WarrantyEndDate.Value.ToString("dd MMM yyyy") : "—")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header fw-semibold">Handover Documents</div>
            <div class="card-body p-0">
                @if (Model.Documents == null || !Model.Documents.Any())
                {
                    <div class="text-center text-muted py-4">No documents available.</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var doc in Model.Documents)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">@doc.DocumentName</div>
                                    <small class="text-muted">@doc.DocumentType · @doc.UploadDate.ToString("dd MMM yyyy")</small>
                                </div>
                                <a href="@Url.Action("DownloadDocument", new { id = doc.Id })" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-download"></i>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-header fw-semibold">Digital Sign-off</div>
            <div class="card-body">
                @using (Html.BeginForm("ClientSignOff", "Handover", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.HandoverId)
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                    <div class="mb-3 form-check">
                        @Html.CheckBoxFor(m => m.AcceptTerms, new { @class = "form-check-input", id = "AcceptTerms" })
                        <label class="form-check-label" for="AcceptTerms">
                            I accept the project as completed and confirm that the works meet the agreed requirements.
                        </label>
                        @Html.ValidationMessageFor(m => m.AcceptTerms, "", new { @class = "text-danger small d-block" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Html.DisplayNameFor(m => m.ClientFeedback)</label>
                        @Html.TextAreaFor(m => m.ClientFeedback, new { @class = "form-control", rows = 3, placeholder = "Optional feedback about the project..." })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Html.DisplayNameFor(m => m.ClientSignOffNotes)</label>
                        @Html.TextAreaFor(m => m.ClientSignOffNotes, new { @class = "form-control", rows = 2, placeholder = "Any additional notes..." })
                    </div>

                    <button type="submit" class="btn btn-success w-100">
                        <i class="fas fa-signature me-1"></i> Confirm Sign-off
                    </button>
                }
            </div>
        </div>
    </div>
</div>