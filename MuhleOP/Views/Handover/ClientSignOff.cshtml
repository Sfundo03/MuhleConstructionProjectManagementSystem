@model MuhleOP.ViewModels.ClientSignOffViewModel
@{
    ViewBag.Title = "Client Sign-off";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">Project Sign-off</h4>
        <p class="text-muted mb-0">@Model.ProjectName (@Model.ProjectCode) — @Model.HandoverType handover</p>
    </div>
</div>

@if (Model.HasOpenCriticalSnags)
{
    <div class="alert alert-danger mb-4" role="alert">
        <strong>Action Blocked:</strong> There are unresolved critical snag(s). The Site Manager must resolve them before you can sign off.
    </div>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card mb-3">
            <div class="card-header fw-semibold">Project Summary</div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.FinalInspectionFindings))
                {
                    <div class="mb-3">
                        <div class="text-muted small">Final Inspection Findings</div>
                        <div>@Model.FinalInspectionFindings</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.CompletionNotes))
                {
                    <div class="mb-3">
                        <div class="text-muted small">Completion Notes</div>
                        <div style="white-space: pre-wrap;">@Model.CompletionNotes</div>
                    </div>
                }
            </div>
        </div>

        <!-- Snag Review & Client Add Snag -->
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Recorded Snags</span>
                <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#clientAddSnag">
                    <i class="fas fa-plus me-1"></i> Report Snag
                </button>
            </div>
            <div class="card-body">
                <div class="collapse mb-3 p-3 bg-light rounded" id="clientAddSnag">
                    @using (Html.BeginForm("AddSnag", "Handover", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="handoverId" value="@Model.HandoverId" />
                        <div class="row g-2">
                            <div class="col-12">
                                <label class="form-label small">Description</label>
                                <input type="text" name="description" class="form-control form-control-sm" required maxlength="300" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">Location</label>
                                <input type="text" name="location" class="form-control form-control-sm" maxlength="200" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">Severity</label>
                                <select name="severity" class="form-select form-select-sm">
                                    <option value="Minor">Minor</option>
                                    <option value="Major">Major</option>
                                    <option value="Critical">Critical</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">Responsible Party</label>
                                <input type="text" name="responsibleParty" class="form-control form-control-sm" value="Contractor" required maxlength="150" />
                            </div>
                            <div class="col-12 mt-2">
                                <button type="submit" class="btn btn-sm btn-primary">Submit Snag</button>
                            </div>
                        </div>
                    }
                </div>

                @if (Model.Snags == null || !Model.Snags.Any())
                {
                    <div class="text-muted small">No snags recorded.</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var s in Model.Snags)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <code>@s.ReferenceNumber</code> — @s.Description
                                    <span class="badge bg-@(s.Severity == "Critical" ? "danger" : "secondary") ms-1">@s.Severity</span>
                                </div>
                                <span class="badge bg-info">@s.Status</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header fw-semibold">Handover Documents</div>
            <div class="card-body p-0">
                @if (Model.Documents == null || !Model.Documents.Any())
                {
                    <div class="text-center text-muted py-4">No documents available.</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var doc in Model.Documents)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">@doc.DocumentName</div>
                                    <small class="text-muted">@doc.DocumentType</small>
                                </div>
                                <a href="@Url.Action("DownloadDocument", new { id = doc.Id })" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-download"></i>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card mb-3">
            <div class="card-header fw-semibold">Digital Sign-off</div>
            <div class="card-body">
                @using (Html.BeginForm("ClientSignOff", "Handover", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.HandoverId)
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                    <div class="mb-3 form-check">
                        @Html.CheckBoxFor(m => m.AcceptTerms, new { @class = "form-check-input", id = "AcceptTerms", @disabled = Model.HasOpenCriticalSnags ? "disabled" : null })
                        <label class="form-check-label" for="AcceptTerms">
                            I accept the project as completed and confirm that the works meet agreed requirements.
                        </label>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Html.DisplayNameFor(m => m.ClientFeedback)</label>
                        @Html.TextAreaFor(m => m.ClientFeedback, new { @class = "form-control", rows = 3 })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Html.DisplayNameFor(m => m.ClientSignOffNotes)</label>
                        @Html.TextAreaFor(m => m.ClientSignOffNotes, new { @class = "form-control", rows = 2 })
                    </div>

                    <button type="submit" class="btn btn-success w-100 @(Model.HasOpenCriticalSnags ? "disabled" : "")" @(Model.HasOpenCriticalSnags ? "disabled" : "")>
                        <i class="fas fa-signature me-1"></i> Confirm Sign-off
                    </button>
                }
            </div>
        </div>

        <!-- Refusal Panel -->
        <div class="card border-danger">
            <div class="card-header bg-danger text-white fw-semibold">Refuse Sign-off</div>
            <div class="card-body">
                <button class="btn btn-outline-danger w-100 mb-2" type="button" data-bs-toggle="collapse" data-bs-target="#refusalForm">
                    Refuse Sign-off
                </button>
                <div class="collapse" id="refusalForm">
                    @using (Html.BeginForm("RefuseSignOff", "Handover", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="HandoverId" value="@Model.HandoverId" />
                        <div class="mb-2">
                            <label class="form-label small">Reason for Refusal</label>
                            <textarea name="RefusalReason" class="form-control form-control-sm" rows="3" required maxlength="1000"></textarea>
                        </div>
                        <button type="submit" class="btn btn-danger btn-sm w-100">Submit Refusal</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>