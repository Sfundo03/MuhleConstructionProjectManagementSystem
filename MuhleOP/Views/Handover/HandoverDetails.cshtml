@model MuhleOP.ViewModels.HandoverDetailsViewModel
@{
    ViewBag.Title = "Handover Details";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var canManage = User.IsInRole("Admin") || User.IsInRole("Project Manager") || User.IsInRole("Site Manager");
    var canClose = User.IsInRole("Admin") || User.IsInRole("Project Manager");
    var isClient = User.IsInRole("Client");
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.IsPracticalCompletionPending)
{
    <div class="alert alert-warning border-warning mb-4" role="alert">
        <h5 class="alert-heading"><i class="fas fa-exclamation-triangle me-1"></i> Practical Completion Pending</h5>
        <p class="mb-0">Client refused sign-off — project remains at Practical Completion pending resolution.</p>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">@Model.ProjectName</h4>
        <p class="text-muted mb-0">
            @Model.ProjectCode
            <span class="badge bg-@Model.StatusBadgeColor ms-2">@Model.Status</span>
            <span class="badge bg-@Model.ClientSignOffBadgeColor ms-1">Sign-off: @Model.ClientSignOffStatus</span>
        </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (canManage && Model.Status != "Closed")
        {
            if (Model.ClientSignOffStatus == "Pending" && !Model.ClientInvitedToSignOff)
            {
                using (Html.BeginForm("InviteClientToSignOff", "Handover", FormMethod.Post, new { @class = "d-inline" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-envelope me-1"></i> Invite Client to Sign Off
                    </button>
                }
            }
            else if (Model.ClientSignOffStatus == "Pending" && Model.ClientInvitedToSignOff)
            {
                <button type="button" class="btn btn-secondary" disabled>
                    Client Invited ✓ (@(Model.ClientInvitedDate.HasValue ? Model.ClientInvitedDate.Value.ToString("dd MMM yyyy HH:mm") : "—"))
                </button>
            }
            else if (Model.ClientSignOffStatus == "Rejected")
            {
                using (Html.BeginForm("InviteClientToSignOff", "Handover", FormMethod.Post, new { @class = "d-inline w-100" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    if (!string.IsNullOrWhiteSpace(Model.CompletionNotes))
                    {
                        <div class="w-100 mb-2">
                            <details class="small bg-light p-2 rounded border">
                                <summary class="text-danger fw-semibold" style="cursor: pointer;">Previous refusals / notes</summary>
                                <div class="mt-1 text-muted" style="white-space: pre-wrap;">@Model.CompletionNotes</div>
                            </details>
                        </div>
                    }
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-redo me-1"></i> Re-invite Client to Sign Off
                    </button>
                }
            }
            <a href="@Url.Action("UploadDocument", new { id = Model.Id })" class="btn btn-outline-primary">
                <i class="fas fa-upload me-1"></i> Upload Document
            </a>
        }
        @if (isClient && Model.ClientSignOffStatus == "Pending")
        {
            <a href="@Url.Action("ClientSignOff", new { id = Model.Id })" class="btn btn-success">
                <i class="fas fa-signature me-1"></i> Sign Off
            </a>
        }
        @if (canClose && Model.ClientSignOffStatus == "Signed" && Model.Status != "Closed")
        {
            var hasBlockers = Model.OpenCriticalSnagCount > 0 || Model.MissingRequiredDocumentTypes.Any() || (Model.OpenVariations != null && Model.OpenVariations.Any());
            using (Html.BeginForm("CloseProject", "Handover", FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Close this project permanently?');" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-danger @(hasBlockers ? "disabled" : "")" @(hasBlockers ? "disabled title=Blocking open critical items exist" : "")>
                    <i class="fas fa-lock me-1"></i> Close Project
                </button>
            }
        }
        @if (canManage)
        {
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Back
            </a>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header fw-semibold">Handover Summary</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="text-muted small">Client</div>
                        <div>@(Model.ClientName ?? "—")</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Project Manager</div>
                        <div>@(Model.ProjectManagerName ?? "—")</div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Handover Type</div>
                        <div>@Model.HandoverType</div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Handover Date</div>
                        <div>@Model.HandoverDate.ToString("dd MMM yyyy HH:mm")</div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Final Inspection</div>
                        <div>@(Model.FinalInspectionDate.HasValue ? Model.FinalInspectionDate.Value.ToString("dd MMM yyyy") : "—")</div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.FinalInspectionFindings))
                    {
                        <div class="col-12">
                            <div class="text-muted small">Inspection Findings</div>
                            <div>@Model.FinalInspectionFindings</div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.CompletionNotes))
                    {
                        <div class="col-12">
                            <div class="text-muted small">Completion Notes</div>
                            <div style="white-space: pre-wrap;">@Model.CompletionNotes</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Snag List Card -->
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Snag List (Critical: @Model.OpenCriticalSnagCount, Major: @Model.OpenMajorSnagCount, Minor: @Model.OpenMinorSnagCount)</span>
                @if (canManage && Model.Status != "Closed")
                {
                    <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#addSnagForm">
                        <i class="fas fa-plus me-1"></i> Add Snag
                    </button>
                }
            </div>
            <div class="card-body">
                @if (canManage && Model.Status != "Closed")
                {
                    <div class="collapse mb-3 p-3 bg-light rounded" id="addSnagForm">
                        @using (Html.BeginForm("AddSnag", "Handover", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="handoverId" value="@Model.Id" />
                            <div class="row g-2">
                                <div class="col-md-12">
                                    <label class="form-label small">Description</label>
                                    <input type="text" name="description" class="form-control form-control-sm" required maxlength="300" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small">Location</label>
                                    <input type="text" name="location" class="form-control form-control-sm" maxlength="200" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small">Severity</label>
                                    <select name="severity" class="form-select form-select-sm">
                                        <option value="Minor">Minor</option>
                                        <option value="Major">Major</option>
                                        <option value="Critical">Critical</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small">Responsible Party</label>
                                    <input type="text" name="responsibleParty" class="form-control form-control-sm" required maxlength="150" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small">Due Date</label>
                                    <input type="date" name="dueDate" class="form-control form-control-sm" />
                                </div>
                                <div class="col-12 mt-2">
                                    <button type="submit" class="btn btn-sm btn-primary">Save Snag</button>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (Model.Snags == null || !Model.Snags.Any())
                {
                    <div class="text-center text-muted py-3">No snags recorded.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Ref</th>
                                    <th>Description</th>
                                    <th>Severity</th>
                                    <th>Responsible</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var snag in Model.Snags)
                                {
                                    <tr>
                                        <td><code>@snag.ReferenceNumber</code></td>
                                        <td>@snag.Description <br /><small class="text-muted">@snag.Location</small></td>
                                        <td>
                                            <span class="badge bg-@(snag.Severity == "Critical" ? "danger" : snag.Severity == "Major" ? "warning" : "secondary")">
                                                @snag.Severity
                                            </span>
                                        </td>
                                        <td>@snag.ResponsibleParty</td>
                                        <td><span class="badge bg-info">@snag.Status</span></td>
                                        <td>
                                            @if (canManage && Model.Status != "Closed")
                                            {
                                                using (Html.BeginForm("UpdateSnagStatus", "Handover", FormMethod.Post, new { @class = "d-inline" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="snagId" value="@snag.Id" />
                                                    <select name="newStatus" class="form-select form-select-sm d-inline w-auto" onchange="this.form.submit()">
                                                        <option value="" disabled selected>Change Status...</option>
                                                        <option value="In Progress">In Progress</option>
                                                        <option value="Fixed">Fixed</option>
                                                        <option value="Verified">Verified</option>
                                                        <option value="Rejected">Rejected</option>
                                                    </select>
                                                }
                                                if (snag.Status == "Open")
                                                {
                                                    using (Html.BeginForm("DeleteSnag", "Handover", FormMethod.Post, new { @class = "d-inline" }))
                                                    {
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="snagId" value="@snag.Id" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this snag?');">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    }
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Handover Documents & Package Checklist</span>
                <span class="badge bg-secondary">@(Model.Documents?.Count ?? 0)</span>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="fw-semibold small text-muted mb-2">Required Document Checklist:</div>
                    <ul class="list-unstyled mb-3">
                        @foreach (var reqType in new[] { "As-Built Drawings", "Warranty Certificates", "Operation Manuals", "Compliance Certificates" })
                        {
                            bool present = Model.Documents != null && Model.Documents.Any(d => string.Equals(d.DocumentType, reqType, StringComparison.OrdinalIgnoreCase));
                            <li>
                                <i class="fas fa-@(present ? "check text-success" : "times text-danger") me-1"></i> @reqType
                            </li>
                        }
                    </ul>
                </div>

                @if (Model.Documents == null || !Model.Documents.Any())
                {
                    <div class="text-center text-muted py-3">No documents uploaded yet.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Name</th>
                                    <th>Type</th>
                                    <th>Uploaded</th>
                                    <th>By</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var doc in Model.Documents)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@doc.DocumentName</div>
                                        </td>
                                        <td>@doc.DocumentType</td>
                                        <td>@doc.UploadDate.ToString("dd MMM yyyy")</td>
                                        <td>@doc.UploadedBy</td>
                                        <td class="text-end">
                                            <a href="@Url.Action("DownloadDocument", new { id = doc.Id })" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-download"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header fw-semibold">Sign-off Status & Legal Traceability</div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="text-muted small">Client Sign-off</div>
                    <span class="badge bg-@Model.ClientSignOffBadgeColor">@Model.ClientSignOffStatus</span>
                    @if (Model.ClientSignOffDate.HasValue)
                    {
                        <div class="small text-muted mt-1">@Model.ClientSignOffDate.Value.ToString("dd MMM yyyy HH:mm")</div>
                    }
                </div>
                @if (canManage && !string.IsNullOrEmpty(Model.ClientSignatureIpAddress))
                {
                    <div class="p-2 bg-light rounded small mb-3">
                        <div><strong>IP Address:</strong> @Model.ClientSignatureIpAddress</div>
                        <div><strong>User Agent:</strong> @Model.ClientSignatureUserAgent</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.ClientFeedback))
                {
                    <div class="mb-3">
                        <div class="text-muted small">Client Feedback</div>
                        <div>@Model.ClientFeedback</div>
                    </div>
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header fw-semibold">Reports & Documentation</div>
            <div class="card-body d-flex flex-column gap-2">
                @if (!string.IsNullOrEmpty(Model.SignedHandoverPdfPath))
                {
                    <a href="@Model.SignedHandoverPdfPath" target="_blank" class="btn btn-sm btn-outline-secondary">
                        <i class="fas fa-file-pdf me-1"></i> Signed Handover PDF
                    </a>
                }
                @if (!string.IsNullOrEmpty(Model.ClientAcceptanceLetterPath))
                {
                    <a href="@Model.ClientAcceptanceLetterPath" target="_blank" class="btn btn-sm btn-outline-secondary">
                        <i class="fas fa-file-pdf me-1"></i> Client Acceptance Letter
                    </a>
                }
                @if (!string.IsNullOrEmpty(Model.ClosureReportPath))
                {
                    <a href="@Url.Action("DownloadClosureReport", new { id = Model.Id })" class="btn btn-sm btn-primary">
                        <i class="fas fa-download me-1"></i> Download Closure Report
                    </a>
                }
            </div>
        </div>
    </div>
</div>