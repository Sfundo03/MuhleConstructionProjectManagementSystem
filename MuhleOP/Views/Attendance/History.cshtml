
@model MuhleOP.ViewModels.AttendanceHistoryViewModel
@{
    ViewBag.Title = "Attendance History";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="fas fa-history me-2"></i>Attendance History</h4>
</div>

<div class="card mb-4">
    <div class="card-body">
        @using (Html.BeginForm("History", "Attendance", FormMethod.Get, new { @class = "row g-2 align-items-end" }))
        {
            <div class="col-md-3">
                <label class="form-label">From</label>
                <input type="date" name="from" class="form-control"
                       value="@(Model.FromDate.HasValue ? Model.FromDate.Value.ToString("yyyy-MM-dd") : "")" />
            </div>
            <div class="col-md-3">
                <label class="form-label">To</label>
                <input type="date" name="to" class="form-control"
                       value="@(Model.ToDate.HasValue ? Model.ToDate.Value.ToString("yyyy-MM-dd") : "")" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Project</label>
                @Html.DropDownList("projectId", Model.Projects, "All projects", new { @class = "form-control" })
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
            </div>
        }
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <div class="card text-center">
            <div class="card-body">
                <div class="text-muted small">Sessions</div>
                <div class="h4 mb-0">@Model.SessionCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card text-center">
            <div class="card-body">
                <div class="text-muted small">Total Hours</div>
                <div class="h4 mb-0">@Model.TotalHoursSum.ToString("N2") h</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Crew Member</th>
                        <th>Project</th>
                        <th>Check-In</th>
                        <th>Check-Out</th>
                        <th>Hours</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Records.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No records in this range.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var r in Model.Records)
                        {
                            <tr>
                                <td>@r.CheckInTime.ToString("dd MMM yyyy")</td>
                                <td>@r.StaffName</td>
                                <td>@r.ProjectName</td>
                                <td>@r.CheckInTime.ToString("HH:mm")</td>
                                <td>@(r.CheckOutTime.HasValue ? r.CheckOutTime.Value.ToString("HH:mm") : "—")</td>
                                <td>@(r.TotalHours.HasValue ? r.TotalHours.Value.ToString("N2") : "—")</td>
                                <td><span class="badge bg-@r.StatusBadgeColor">@r.Status</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>