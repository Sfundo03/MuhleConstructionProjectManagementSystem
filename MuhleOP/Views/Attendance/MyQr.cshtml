@model MuhleOP.ViewModels.MyQrViewModel
@{
    ViewBag.Title = "My QR Code";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    .qr-card {
        max-width: 480px;
        margin: 0 auto;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        box-shadow: 0 4px 24px var(--shadow-color);
        padding: 28px 24px 32px;
        text-align: center;
        position: relative;
    }

    .qr-title {
        font-size: 1.5rem;
        font-weight: 800;
        letter-spacing: 0.5px;
        margin-bottom: 6px;
        color: var(--text-primary);
    }

    .qr-subtitle {
        font-size: 0.9rem;
        color: var(--text-secondary);
        margin-bottom: 16px;
    }

    #qrImg {
        width: 100%;
        max-width: 320px;
        height: auto;
        background: #fff;
        border-radius: 8px;
        margin: 12px auto;
        display: block;
        border: 4px solid var(--border-color);
    }

    .live-time {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 10px 0 4px;
        font-variant-numeric: tabular-nums;
    }

    .refresh-countdown {
        font-size: 0.95rem;
        color: var(--text-secondary);
        margin: 4px 0 8px;
        font-variant-numeric: tabular-nums;
    }

        .refresh-countdown strong {
            color: var(--primary-gold, #c9a227);
        }

    .qr-meta {
        font-size: 0.95rem;
        color: var(--text-secondary);
        margin-top: 12px;
        line-height: 1.6;
    }

        .qr-meta strong {
            color: var(--text-primary);
        }

    .issued-date {
        font-size: 0.8rem;
        color: var(--text-secondary);
        margin-top: 6px;
    }

    .info-box {
        max-width: 480px;
        margin: 20px auto 0;
        padding: 14px 16px;
        border-radius: 8px;
        background: var(--bg-hover);
        border: 1px solid var(--border-color);
        font-size: 0.85rem;
        color: var(--text-secondary);
        text-align: left;
        line-height: 1.5;
    }

        .info-box i {
            color: var(--primary-gold);
            margin-right: 6px;
        }

    .btn-row {
        display: flex;
        gap: 10px;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 18px;
    }

    /* Real-time scan confirmation overlay */
    #scanOverlay {
        display: none;
        position: absolute;
        inset: 0;
        border-radius: 12px;
        background: rgba(16, 24, 32, 0.92);
        z-index: 20;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        padding: 24px;
        animation: overlayIn 0.35s ease;
    }

        #scanOverlay.show {
            display: flex;
        }

    @@keyframes overlayIn {
        from { opacity: 0; transform: scale(0.96); }
        to { opacity: 1; transform: scale(1); }
    }

    #overlayIcon {
        font-size: 64px;
        margin-bottom: 12px;
    }

    #overlayTitle {
        font-size: 1.6rem;
        font-weight: 800;
        margin-bottom: 8px;
    }

    #overlayDetail {
        font-size: 1.05rem;
        color: #cfd8dc;
        text-align: center;
        line-height: 1.5;
    }
</style>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible">@TempData["ErrorMessage"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="fas fa-qrcode me-2"></i>My QR Code</h4>
    <a href="@Url.Action("MyHours")" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-clock me-1"></i> My Hours
    </a>
</div>

<div class="qr-card" id="qrCard">
    <!-- Success overlay (hidden until Site Manager scans) -->
    <div id="scanOverlay">
        <div id="overlayIcon"></div>
        <div id="overlayTitle"></div>
        <div id="overlayDetail"></div>
    </div>

    <div class="qr-title">ATTENDANCE QR</div>
    <p class="qr-subtitle">Show this to your Site Manager</p>

    @if (Model.HasToken && !string.IsNullOrEmpty(Model.QrImageBase64))
    {
        <img id="qrImg" src="@Model.QrImageBase64" alt="Attendance QR Code" width="320" height="320" />
    }
    else
    {
        <div class="text-muted py-5">QR code could not be generated.</div>
    }

    <div class="live-time" id="liveTime">--:--:--</div>
    <div class="refresh-countdown">
        Refreshes in <strong id="countdownText">--:--</strong>
    </div>

    <div class="qr-meta">
        <strong>@Model.StaffName</strong><br />
        @if (!string.IsNullOrEmpty(Model.EmployeeId))
        {
            <text>Employee ID: @Model.EmployeeId</text><br />
        }
    </div>

    @if (Model.TokenCreatedDate.HasValue)
    {
        <div class="issued-date">
            Seed issued: @Model.TokenCreatedDate.Value.ToString("dd MMM yyyy HH:mm")
        </div>
    }

    <div class="btn-row">
        <button type="button" class="btn btn-outline-secondary" onclick="window.location.reload();">
            <i class="fas fa-sync-alt me-1"></i> Refresh
        </button>

        @using (Html.BeginForm("RegenerateToken", "Attendance", FormMethod.Post, new { id = "regenerateForm", style = "display:inline;" }))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-warning"
                    onclick="return confirm('Regenerate your QR code? The old seed will stop working immediately. Anyone who still has a screenshot of a previous code will no longer be able to check you in or out.');">
                <i class="fas fa-key me-1"></i> Regenerate QR Code
            </button>
        }
    </div>
</div>

<div class="info-box">
    <i class="fas fa-info-circle"></i>
    This QR code changes every <strong>5 minutes</strong>. Screenshots expire automatically.
    First scan = check <strong>IN</strong>, second scan = check <strong>OUT</strong>.
    Keep this private — anyone with a live code can check you in or out.
</div>

@section scripts {
    <!-- qrcode.js for client-side QR redraw without a full page reload -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        (function () {
            var secondsRemaining = @(Model.SecondsRemaining > 0 ? Model.SecondsRemaining : 300);
            var lastEventKey = null;
            var overlayTimer = null;
            var tokenUrl = '@Url.Action("GetCurrentQrToken", "Attendance")';
            var statusUrl = '@Url.Action("GetAttendanceStatus", "Attendance")';
            var canvasHost = null;

            function pad(n) { return n < 10 ? '0' + n : '' + n; }

            function updateLiveTime() {
                var d = new Date();
                var el = document.getElementById('liveTime');
                if (el) {
                    el.textContent =
                        pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
                }
            }

            function formatCountdown(sec) {
                var m = Math.floor(sec / 60);
                var s = sec % 60;
                return m + ':' + pad(s);
            }

            function tickCountdown() {
                var el = document.getElementById('countdownText');
                if (el) el.textContent = formatCountdown(Math.max(0, secondsRemaining));
                if (secondsRemaining <= 0) {
                    fetchFreshToken();
                } else {
                    secondsRemaining--;
                }
            }

            function fetchFreshToken() {
                fetch(tokenUrl, { credentials: 'same-origin' })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (!data.success || !data.token) return;
                        secondsRemaining = data.secondsRemaining || 300;
                        redrawQr(data.token);
                    })
                    .catch(function () { /* retry next tick */ });
            }

            function redrawQr(token) {
                var img = document.getElementById('qrImg');
                if (!img) return;

                // Use a temporary div + qrcodejs, then copy data URL into the <img>
                if (!canvasHost) {
                    canvasHost = document.createElement('div');
                    canvasHost.style.display = 'none';
                    document.body.appendChild(canvasHost);
                }
                canvasHost.innerHTML = '';
                try {
                    new QRCode(canvasHost, {
                        text: token,
                        width: 320,
                        height: 320,
                        correctLevel: QRCode.CorrectLevel.Q
                    });
                    // qrcodejs creates a canvas or img inside
                    setTimeout(function () {
                        var canvas = canvasHost.querySelector('canvas');
                        var nestedImg = canvasHost.querySelector('img');
                        if (canvas) {
                            img.src = canvas.toDataURL('image/png');
                        } else if (nestedImg) {
                            img.src = nestedImg.src;
                        }
                    }, 50);
                } catch (e) {
                    // Fallback: reload page if client QR lib fails
                    console.warn('QR redraw failed', e);
                }
            }

            function pollAttendanceStatus() {
                fetch(statusUrl, { credentials: 'same-origin' })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (!data.success || !data.hasEvent || !data.eventKey) return;
                        if (lastEventKey === null) {
                            // First poll: remember current state, don't flash overlay for old events
                            lastEventKey = data.eventKey;
                            return;
                        }
                        if (data.eventKey !== lastEventKey) {
                            lastEventKey = data.eventKey;
                            showScanOverlay(data);
                        }
                    })
                    .catch(function () { });
            }

            function showScanOverlay(data) {
                var overlay = document.getElementById('scanOverlay');
                var icon = document.getElementById('overlayIcon');
                var title = document.getElementById('overlayTitle');
                var detail = document.getElementById('overlayDetail');

                var isIn = (data.action === 'CheckIn');
                icon.innerHTML = isIn
                    ? '<i class="fas fa-sign-in-alt" style="color:#1cc88a;"></i>'
                    : '<i class="fas fa-sign-out-alt" style="color:#4e73df;"></i>';
                title.textContent = isIn ? '✓ Checked IN' : '✓ Checked OUT';
                title.style.color = isIn ? '#1cc88a' : '#4e73df';

                var line = (data.timestamp || '') + ' · ' + (data.projectName || '');
                if (!isIn && data.hoursWorked != null) {
                    line += '<br><strong>' + data.hoursWorked + ' hours worked</strong>';
                }
                detail.innerHTML = line;

                overlay.classList.add('show');

                try {
                    if (navigator.vibrate) navigator.vibrate([120, 60, 120]);
                    var ctx = new (window.AudioContext || window.webkitAudioContext)();
                    var osc = ctx.createOscillator();
                    osc.frequency.value = isIn ? 880 : 660;
                    osc.connect(ctx.destination);
                    osc.start();
                    setTimeout(function () { osc.stop(); }, 150);
                } catch (e) { }

                if (overlayTimer) clearTimeout(overlayTimer);
                overlayTimer = setTimeout(function () {
                    overlay.classList.remove('show');
                }, 8000);
            }

            document.addEventListener('DOMContentLoaded', function () {
                updateLiveTime();
                setInterval(updateLiveTime, 1000);
                tickCountdown();
                setInterval(tickCountdown, 1000);
                // Poll status every 3 seconds for real-time confirmation
                pollAttendanceStatus();
                setInterval(pollAttendanceStatus, 3000);
            });
        })();
    </script>
}