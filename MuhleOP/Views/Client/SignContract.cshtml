﻿@model MuhleOP.ViewModels.SignContractViewModel
@{
    ViewBag.Title = "Sign Contract";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Sign Contract</h2>
        <p class="text-muted">
            <i class="fas fa-signature me-2"></i>
            Review and electronically sign the contract
        </p>
    </div>
    <a href="@Url.Action("ContractDetails", new { id = Model.ContractId })" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back to Contract
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>Contract:</strong> @Model.ContractNumber - @Model.ProjectName
                    <br />
                    <strong>Client:</strong> @Model.ClientName
                    <br />
                    <strong>Value:</strong> @Model.ContractValue.ToString("C")
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.ContractId)

                    <!-- Contract Summary -->
                    <div class="mb-4">
                        <h5><i class="fas fa-file-contract text-gold me-2"></i>Contract Summary</h5>
                        <div class="bg-hover p-3 rounded">
                            <dl class="row">
                                <dt class="col-sm-4">Project</dt>
                                <dd class="col-sm-8">@Model.ProjectName</dd>
                                <dt class="col-sm-4">Contract Value</dt>
                                <dd class="col-sm-8">@Model.ContractValue.ToString("C")</dd>
                                <dt class="col-sm-4">Start Date</dt>
                                <dd class="col-sm-8">@Model.StartDate.ToString("dd MMM yyyy")</dd>
                                <dt class="col-sm-4">End Date</dt>
                                <dd class="col-sm-8">@Model.EndDate.ToString("dd MMM yyyy")</dd>
                            </dl>
                        </div>
                    </div>

                    <!-- Scope Preview -->
                    <div class="mb-4">
                        <h5><i class="fas fa-list-check text-gold me-2"></i>Project Scope</h5>
                        <div class="bg-hover p-3 rounded" style="max-height:200px;overflow-y:auto;">
                            <p style="white-space: pre-wrap; line-height: 1.8;">@Model.ProjectScope</p>
                        </div>
                    </div>

                    <!-- Payment Terms Preview -->
                    <div class="mb-4">
                        <h5><i class="fas fa-credit-card text-gold me-2"></i>Payment Terms</h5>
                        <div class="bg-hover p-3 rounded" style="max-height:150px;overflow-y:auto;">
                            <p style="white-space: pre-wrap; line-height: 1.8;">@Model.PaymentTerms</p>
                        </div>
                    </div>

                    <hr />

                    <!-- Signature Section -->
                    <h5 class="mb-3"><i class="fas fa-pen text-gold me-2"></i>Electronic Signature</h5>

                    <div class="mb-3 form-check">
                        @Html.CheckBoxFor(m => m.AcceptTerms, new { @class = "form-check-input", id = "AcceptTerms" })
                        @Html.LabelFor(m => m.AcceptTerms, new { @class = "form-check-label", @for = "AcceptTerms" })
                        @Html.ValidationMessageFor(m => m.AcceptTerms, "", new { @class = "text-danger" })
                        <small class="text-muted d-block mt-1">By checking this box, you agree to all terms and conditions of this contract</small>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                @Html.LabelFor(m => m.SignerName, new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(m => m.SignerName, new { @class = "form-control", placeholder = "Your full name" })
                                @Html.ValidationMessageFor(m => m.SignerName, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                @Html.LabelFor(m => m.SignerEmail, new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(m => m.SignerEmail, new { @class = "form-control", type = "email", placeholder = "Your email address" })
                                @Html.ValidationMessageFor(m => m.SignerEmail, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.SignatureData, new { @class = "form-label fw-bold" })
                        <div class="signature-pad-wrapper">
                            <canvas id="signatureCanvas" width="400" height="150" style="border:2px solid var(--border-color);border-radius:4px;width:100%;height:150px;cursor:crosshair;background:#fff;"></canvas>
                            <div class="mt-2">
                                <button type="button" class="btn btn-sm btn-secondary" onclick="clearSignature()">
                                    <i class="fas fa-eraser"></i> Clear
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="undoSignature()">
                                    <i class="fas fa-undo"></i> Undo
                                </button>
                            </div>
                            @Html.HiddenFor(m => m.SignatureData)
                        </div>
                        @Html.ValidationMessageFor(m => m.SignatureData, "", new { @class = "text-danger" })
                        <small class="text-muted d-block mt-1">Draw your signature in the box above</small>
                    </div>

                    <div class="alert alert-warning mt-3">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Legal Notice:</strong> By signing this contract, you agree to all terms and conditions. This is a legally binding document.
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-success" id="signButton">
                            <i class="fas fa-signature"></i> Sign Contract
                        </button>
                        <a href="@Url.Action("ContractDetails", new { id = Model.ContractId })" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Cancel
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <h6 class="card-title"><i class="fas fa-info-circle me-2"></i>Contract Information</h6>
                <dl class="row small">
                    <dt class="col-5">Contract</dt>
                    <dd class="col-7"><code>@Model.ContractNumber</code></dd>
                    <dt class="col-5">Project</dt>
                    <dd class="col-7">@Model.ProjectName</dd>
                    <dt class="col-5">Client</dt>
                    <dd class="col-7">@Model.ClientName</dd>
                    <dt class="col-5">Value</dt>
                    <dd class="col-7">@Model.ContractValue.ToString("C")</dd>
                    <dt class="col-5">Status</dt>
                    <dd class="col-7">
                        <span class="badge bg-@(Model.Status == "Draft" ? "secondary" : Model.Status == "Sent" ? "info" : "primary")">
                            @Model.Status
                        </span>
                    </dd>
                </dl>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="card-title"><i class="fas fa-lightbulb text-gold me-2"></i>Signature Tips</h6>
                <ul class="list-unstyled small">
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Use your mouse or touch to sign
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Sign clearly and legibly
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Accept the terms before signing
                    </li>
                    <li>
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Review all details before signing
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<style>
    .text-gold {
        color: var(--primary-gold, #F5A623);
    }

    .bg-hover {
        background: var(--bg-hover, #f8f9fa);
    }

    [data-theme="dark"] .bg-hover {
        background: var(--bg-hover, #2d3748);
    }

    [data-theme="dark"] #signatureCanvas {
        background: #1a202c;
        border-color: var(--border-color);
    }

    .badge {
        font-size: 11px;
        padding: 5px 10px;
    }

        .badge.bg-warning {
            color: #fff;
        }

        .badge.bg-info {
            color: #fff;
        }

        .badge.bg-success {
            color: #fff;
        }

        .badge.bg-secondary {
            color: #fff;
        }

        .badge.bg-primary {
            color: #fff;
        }

    code {
        background: var(--bg-hover);
        padding: 2px 6px;
        border-radius: 3px;
        font-size: 12px;
    }

    [data-theme="dark"] code {
        background: var(--bg-hover, #2d3748);
    }

    .form-control:focus {
        border-color: var(--primary-gold, #F5A623);
        box-shadow: 0 0 0 3px rgba(245, 166, 35, 0.1);
    }
</style>

@section Scripts {
    <script>
        let isDrawing = false;
        let lastX = 0;
        let lastY = 0;
        let signaturePoints = [];

        const canvas = document.getElementById('signatureCanvas');
        const ctx = canvas.getContext('2d');
        const signatureDataInput = document.getElementById('SignatureData');

        function resizeCanvas() {
            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width;
            canvas.height = 150;
        }

        function getCanvasCoordinates(e) {
            const rect = canvas.getBoundingClientRect();
            const x = (e.clientX || e.touches[0].clientX) - rect.left;
            const y = (e.clientY || e.touches[0].clientY) - rect.top;
            return { x, y };
        }

        function startDrawing(e) {
            e.preventDefault();
            isDrawing = true;
            const coords = getCanvasCoordinates(e);
            lastX = coords.x;
            lastY = coords.y;
            signaturePoints.push({ x: lastX, y: lastY });
        }

        function draw(e) {
            e.preventDefault();
            if (!isDrawing) return;
            const coords = getCanvasCoordinates(e);
            ctx.beginPath();
            ctx.moveTo(lastX, lastY);
            ctx.lineTo(coords.x, coords.y);
            ctx.strokeStyle = '#14181D';
            ctx.lineWidth = 2;
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';
            ctx.stroke();
            lastX = coords.x;
            lastY = coords.y;
            signaturePoints.push({ x: lastX, y: lastY });
        }

        function stopDrawing(e) {
            e.preventDefault();
            if (isDrawing) {
                isDrawing = false;
                updateSignatureData();
            }
        }

        function updateSignatureData() {
            const dataUrl = canvas.toDataURL('image/png');
            signatureDataInput.value = dataUrl;
        }

        function clearSignature() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            signaturePoints = [];
            signatureDataInput.value = '';
        }

        function undoSignature() {
            if (signaturePoints.length < 2) {
                clearSignature();
                return;
            }
            // Remove last 5 points
            const removeCount = Math.min(5, signaturePoints.length);
            signaturePoints = signaturePoints.slice(0, -removeCount);
            redrawSignature();
        }

        function redrawSignature() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            if (signaturePoints.length < 2) return;
            ctx.beginPath();
            ctx.moveTo(signaturePoints[0].x, signaturePoints[0].y);
            for (let i = 1; i < signaturePoints.length; i++) {
                ctx.lineTo(signaturePoints[i].x, signaturePoints[i].y);
            }
            ctx.strokeStyle = '#14181D';
            ctx.lineWidth = 2;
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';
            ctx.stroke();
            updateSignatureData();
        }

        // Mouse events
        canvas.addEventListener('mousedown', startDrawing);
        canvas.addEventListener('mousemove', draw);
        canvas.addEventListener('mouseup', stopDrawing);
        canvas.addEventListener('mouseleave', stopDrawing);

        // Touch events
        canvas.addEventListener('touchstart', startDrawing);
        canvas.addEventListener('touchmove', draw);
        canvas.addEventListener('touchend', stopDrawing);

        // Resize canvas on load
        window.addEventListener('resize', resizeCanvas);
        setTimeout(resizeCanvas, 100);

        // Form validation
        document.getElementById('signButton').addEventListener('click', function(e) {
            const acceptTerms = document.getElementById('AcceptTerms').checked;
            const signatureData = document.getElementById('SignatureData').value;

            if (!acceptTerms) {
                e.preventDefault();
                alert('Please accept the terms and conditions before signing.');
                return false;
            }

            if (!signatureData || signatureData === '') {
                e.preventDefault();
                alert('Please draw your signature before signing.');
                return false;
            }

            if (!confirm('Are you sure you want to sign this contract? This is a legally binding document.')) {
                e.preventDefault();
                return false;
            }
        });

        // Dark mode support for canvas
        function updateCanvasTheme() {
            const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            ctx.strokeStyle = isDark ? '#FFFFFF' : '#14181D';
        }

        // Observe theme changes
        const observer = new MutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
                if (mutation.attributeName === 'data-theme') {
                    updateCanvasTheme();
                    redrawSignature();
                }
            });
        });
        observer.observe(document.documentElement, { attributes: true });
        setTimeout(updateCanvasTheme, 200);
    </script>
}

<script>
    $(document).ready(function() {
        // Auto-populate signer name and email from model
        @if (!string.IsNullOrEmpty(Model.SignerName))
        {
            <text>$('#SignerName').val('@Model.SignerName');</text>
        }
        @if (!string.IsNullOrEmpty(Model.SignerEmail))
        {
            <text>$('#SignerEmail').val('@Model.SignerEmail');</text>
        }
    });
</script>