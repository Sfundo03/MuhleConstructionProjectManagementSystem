﻿@model IEnumerable<MuhleOP.ViewModels.ClientViewModel>
@{
    ViewBag.Title = "Clients";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Clients</h2>
        <p class="text-muted">
            <i class="fas fa-building me-2"></i>
            Manage all registered client companies
        </p>
    </div>
    <div>
        <a href="@Url.Action("Register")" class="btn btn-primary">
            <i class="fas fa-user-plus"></i> Register New Client
        </a>
        <a href="@Url.Action("Index", "JobPost")" class="btn btn-secondary ms-2">
            <i class="fas fa-arrow-left"></i> Back
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">&times;</button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">&times;</button>
    </div>
}

@if (TempData["RoleAssignmentWarning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="fas fa-triangle-exclamation me-2"></i> @TempData["RoleAssignmentWarning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">&times;</button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover" id="clientsTable">
                <thead>
                    <tr>
                        <th>Company</th>
                        <th>Contact Person</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Contracts</th>
                        <th>Projects</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var client in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@client.CompanyName</strong>
                                    <br />
                                    <small class="text-muted">@client.RegistrationNumber</small>
                                </td>
                                <td>@client.PrimaryContactName</td>
                                <td>@client.ContactEmail</td>
                                <td>@client.ContactPhone</td>
                                <td>
                                    <span class="badge bg-info">@client.ContractCount</span>
                                </td>
                                <td>
                                    <span class="badge bg-primary">@client.ProjectCount</span>
                                </td>
                                <td>
                                    @if (client.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a href="@Url.Action("Details", new { id = client.Id })" class="btn btn-outline-info" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="@Url.Action("Contracts", new { id = client.Id })" class="btn btn-outline-primary" title="View Contracts">
                                            <i class="fas fa-file-contract"></i>
                                        </a>
                                        <a href="@Url.Action("CreateContract", new { clientId = client.Id })" class="btn btn-outline-success" title="Create Contract">
                                            <i class="fas fa-plus-circle"></i>
                                        </a>
                                        <button onclick="toggleActive(@client.Id, '@client.CompanyName')"
                                                class="btn btn-outline-@(client.IsActive ? "warning" : "success")"
                                                title="@(client.IsActive ? "Deactivate" : "Activate")">
                                            <i class="fas fa-@(client.IsActive ? "user-slash" : "user-check")"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <i class="fas fa-building fa-3x text-muted mb-3" style="opacity:0.3;"></i>
                                <h4>No Clients Registered</h4>
                                <p class="text-muted">Register your first client to get started.</p>
                                <a href="@Url.Action("Register")" class="btn btn-primary">
                                    <i class="fas fa-user-plus"></i> Register Client
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .badge {
        font-size: 11px;
        padding: 5px 10px;
    }

        .badge.bg-warning {
            color: #fff;
        }

        .badge.bg-info {
            color: #fff;
        }

        .badge.bg-success {
            color: #fff;
        }

        .badge.bg-secondary {
            color: #fff;
        }

        .badge.bg-primary {
            color: #fff;
        }

    .btn-group .btn {
        margin: 1px;
    }

    .btn-outline-info {
        color: #36b9cc;
        border-color: #36b9cc;
    }

        .btn-outline-info:hover {
            background-color: #36b9cc;
            color: #fff;
        }

    .btn-outline-primary {
        color: #4e73df;
        border-color: #4e73df;
    }

        .btn-outline-primary:hover {
            background-color: #4e73df;
            color: #fff;
        }

    .btn-outline-success {
        color: #1cc88a;
        border-color: #1cc88a;
    }

        .btn-outline-success:hover {
            background-color: #1cc88a;
            color: #fff;
        }

    .btn-outline-warning {
        color: #f6c23e;
        border-color: #f6c23e;
    }

        .btn-outline-warning:hover {
            background-color: #f6c23e;
            color: #fff;
        }

    .btn-outline-secondary {
        color: #858796;
        border-color: #858796;
    }

        .btn-outline-secondary:hover {
            background-color: #858796;
            color: #fff;
        }
</style>

@section Scripts {
    <script>
        function toggleActive(id, companyName) {
            const status = document.querySelector(`button[onclick*="toggleActive(${id}"]`)?.closest('tr')?.querySelector('.badge')?.textContent;
            const action = status === 'Active' ? 'deactivate' : 'activate';

            if (!confirm(`Are you sure you want to ${action} ${companyName}?`)) {
                return;
            }

            fetch('@Url.Action("ToggleActive")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ id: id })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred. Please try again.');
            });
        }
    </script>
}