﻿@model MuhleOP.ViewModels.ClientRegistrationViewModel
@{
    ViewBag.Title = "Register Client";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Register Client</h2>
        <p class="text-muted">
            <i class="fas fa-user-plus me-2"></i>
            Register a new client company in the system
        </p>
    </div>
    <a href="@Url.Action("Index")" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back to Clients
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <!-- Company Information -->
            <h5 class="mb-3"><i class="fas fa-building text-gold me-2"></i>Company Information</h5>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.CompanyName, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.CompanyName, new { @class = "form-control", placeholder = "e.g. ABC Construction (Pty) Ltd" })
                        @Html.ValidationMessageFor(m => m.CompanyName, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.RegistrationNumber, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.RegistrationNumber, new { @class = "form-control", placeholder = "e.g. 2020/123456/07" })
                        @Html.ValidationMessageFor(m => m.RegistrationNumber, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.TaxIdNumber, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.TaxIdNumber, new { @class = "form-control", placeholder = "e.g. 1234567890" })
                        @Html.ValidationMessageFor(m => m.TaxIdNumber, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Industry, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.Industry, new { @class = "form-control", placeholder = "e.g. Construction" })
                        @Html.ValidationMessageFor(m => m.Industry, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.CompanySize, new { @class = "form-label fw-bold" })
                        @Html.DropDownListFor(m => m.CompanySize,
                            new SelectList(new[] { "Small (1-50)", "Medium (51-200)", "Large (201-500)", "Enterprise (500+)" }),
                            "-- Select Company Size --",
                            new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.CompanySize, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Website, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.Website, new { @class = "form-control", placeholder = "https://www.example.com" })
                        @Html.ValidationMessageFor(m => m.Website, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <!-- Contact Information -->
            <h5 class="mb-3 mt-4"><i class="fas fa-address-card text-gold me-2"></i>Contact Information</h5>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.PrimaryContactName, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.PrimaryContactName, new { @class = "form-control", placeholder = "e.g. John Doe" })
                        @Html.ValidationMessageFor(m => m.PrimaryContactName, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.ContactEmail, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.ContactEmail, new { @class = "form-control", type = "email", placeholder = "john.doe@company.com" })
                        @Html.ValidationMessageFor(m => m.ContactEmail, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.ContactPhone, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.ContactPhone, new { @class = "form-control", placeholder = "+27 82 123 4567" })
                        @Html.ValidationMessageFor(m => m.ContactPhone, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.AlternativePhone, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.AlternativePhone, new { @class = "form-control", placeholder = "+27 82 765 4321" })
                        @Html.ValidationMessageFor(m => m.AlternativePhone, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <!-- Address Information -->
            <h5 class="mb-3 mt-4"><i class="fas fa-map-pin text-gold me-2"></i>Address Information</h5>

            <div class="mb-3">
                @Html.LabelFor(m => m.PhysicalAddress, new { @class = "form-label fw-bold" })
                @Html.TextAreaFor(m => m.PhysicalAddress, new { @class = "form-control", rows = "3", placeholder = "123 Main Street, Cape Town, 8001" })
                @Html.ValidationMessageFor(m => m.PhysicalAddress, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.PostalAddress, new { @class = "form-label fw-bold" })
                @Html.TextAreaFor(m => m.PostalAddress, new { @class = "form-control", rows = "2", placeholder = "PO Box 123, Cape Town, 8001" })
                @Html.ValidationMessageFor(m => m.PostalAddress, "", new { @class = "text-danger" })
            </div>

            <!-- Billing Information -->
            <h5 class="mb-3 mt-4"><i class="fas fa-credit-card text-gold me-2"></i>Billing Information</h5>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.BillingInformation, new { @class = "form-label fw-bold" })
                        @Html.TextAreaFor(m => m.BillingInformation, new { @class = "form-control", rows = "3", placeholder = "Billing address, VAT number, etc." })
                        @Html.ValidationMessageFor(m => m.BillingInformation, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.PaymentTerms, new { @class = "form-label fw-bold" })
                        @Html.DropDownListFor(m => m.PaymentTerms,
                            new SelectList(new[] { "Net 30", "Net 45", "Net 60", "On Completion", "Milestone Based" }),
                            "-- Select Payment Terms --",
                            new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.PaymentTerms, "", new { @class = "text-danger" })
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(m => m.CreditLimit, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.CreditLimit, new { @class = "form-control", type = "number", step = "0.01", placeholder = "e.g. 500000" })
                        @Html.ValidationMessageFor(m => m.CreditLimit, "", new { @class = "text-danger" })
                        <small class="text-muted d-block mt-1">Maximum credit limit for this client</small>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Register Client
                </button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="fas fa-times"></i> Cancel
                </a>
            </div>
        }
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0">
                <h6 class="mb-0"><i class="fas fa-lightbulb text-gold me-2"></i>Registration Tips</h6>
            </div>
            <div class="card-body">
                <ul class="list-unstyled small">
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Ensure all company details are accurate
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Registration number must be valid
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Contact email will receive login credentials
                    </li>
                    <li class="mb-2">
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Set appropriate credit limit
                    </li>
                    <li>
                        <i class="fas fa-check-circle text-success me-2"></i>
                        Review all information before submitting
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<style>
    .text-gold {
        color: var(--primary-gold, #F5A623);
    }

    .form-control, .form-select {
        font-size: 14px;
        padding: 10px 14px;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary-gold, #F5A623);
            box-shadow: 0 0 0 3px rgba(245, 166, 35, 0.1);
        }
</style>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}